@@ -0,0 +1,253 @@
+/* DMO Design — screen-only presentation. See docs/design/CONTINUAR.md.
+   Domain state colours and print layouts remain owned by the application. */
+:root {
+  --design-blue: #4f6f9c;
+  --design-medium: #779ecb;
+  --design-pale: #b7c9e2;
+  --design-navy: #1b263b;
+  --design-ink: #0b1320;
+  --dmo-palette-slate: var(--design-blue);
+  --dmo-palette-ocean: var(--design-blue);
+  --dmo-palette-steel: var(--design-medium);
+  --dmo-palette-mist: var(--design-pale);
+  --dmo-palette-sky: var(--design-pale);
+  --dmo-brand-950: var(--design-ink);
+  --dmo-brand-900: var(--design-navy);
+  --dmo-brand-800: var(--design-navy);
+  --dmo-brand-700: var(--design-blue);
+  --dmo-brand-600: var(--design-blue);
+  --dmo-brand-500: var(--design-medium);
+  --dmo-brand-400: var(--design-medium);
+  --dmo-brand-300: var(--design-pale);
+  --dmo-brand-200: color-mix(in srgb, var(--design-pale) 40%, white);
+  --dmo-brand-100: color-mix(in srgb, var(--design-pale) 24%, white);
+  --dmo-brand-050: color-mix(in srgb, var(--design-pale) 12%, white);
+  --dmo-page: #f5f7fa;
+  --dmo-card: #fff;
+  --dmo-bar: #fff;
+  --dmo-field: #fff;
+  --dmo-subtle: #f1f4f8;
+  --dmo-border: #e1e7ef;
+  --dmo-text: var(--design-ink);
+  --dmo-muted: #59677b;
+  --dmo-row-hover: var(--dmo-brand-050);
+  --dmo-focus-ring: color-mix(in srgb, var(--design-medium) 30%, transparent);
+  --dmo-r-card: 8px;
+  --dmo-r-control: 6px;
+  --dmo-shadow: none;
+  --dmo-sidebar-width: 244px;
+}
+:root[data-theme="dark"] {
+  --dmo-page: var(--design-ink); --dmo-card: var(--design-navy);
+  --dmo-bar: var(--design-navy); --dmo-field: #172235;
+  --dmo-subtle: #233149; --dmo-border: #35445d;
+  --dmo-text: #edf2f8; --dmo-muted: var(--design-pale);
+  --dmo-brand-950: #edf2f8; --dmo-brand-900: #edf2f8;
+  --dmo-brand-800: var(--design-pale); --dmo-brand-700: var(--design-pale);
+  --dmo-brand-600: var(--design-medium);
+  --dmo-brand-200: #35445d; --dmo-brand-100: #2b3c56;
+  --dmo-brand-050: #233149;
+}
+/* The logo, module tabs and real signed-in account share the first row. */
+html body .dmo-shell-header {
+  display: grid; grid-template-columns: 36px minmax(0,1fr) auto auto;
+  align-items: center; gap: 0 20px; height: auto; min-height: 58px;
+  padding: 0 24px; background: var(--dmo-card); border-bottom: 1px solid var(--dmo-border);
+}
+html body .dmo-shell-header .dmo-shell-logo {width:36px;height:36px;grid-column:1;grid-row:1}
+html body .dmo-shell-header .dmo-shell-identity {display:none}
+html body .dmo-shell-header .dmo-shell-navigation {display:contents}
+html body .dmo-shell-header .dmo-primary-nav {
+  grid-column:2;grid-row:1;display:flex;align-items:stretch;gap:20px;
+  height:58px;min-height:58px;margin:0;padding:0;border:0;background:none;overflow:visible;
+}
+html body .dmo-shell-header .dmo-secondary-nav {
+  grid-column:1/-1;grid-row:2;display:flex;gap:24px;align-items:stretch;
+  min-height:42px;height:auto;padding:0;margin:0;border:0;border-top:1px solid var(--dmo-border);background:none;
+}
+html body .dmo-shell-header :is(.dmo-primary-nav,.dmo-secondary-nav) > :is(a,button),
+html body .dmo-shell-header .dmo-secondary-nav > details > summary {
+  display:inline-flex;align-items:center;min-height:42px;padding:0 2px;
+  background:transparent;color:var(--dmo-muted);border:0;border-bottom:3px solid transparent;
+  border-radius:0;box-shadow:none;font-size:13px;font-weight:500;white-space:nowrap;
+}
+html body .dmo-shell-header :is(.dmo-primary-nav,.dmo-secondary-nav) > :is(.active,[aria-current="page"]) {
+  color:var(--dmo-brand-700);border-bottom-color:var(--design-blue);background:none;font-weight:650;
+}
+html body .dmo-shell-header :is(.dmo-primary-nav,.dmo-secondary-nav) a:hover {color:var(--dmo-text);background:var(--dmo-brand-050)}
+html body .dmo-shell-header .dmo-env-badge {grid-column:3;grid-row:1;margin:0;padding:2px 7px;min-height:20px;font-size:9px;letter-spacing:0;border-radius:4px}
+html body .dmo-shell-header .dmo-shell-conta {grid-column:4;grid-row:1;max-width:230px;margin:5px 0}
+html body .dmo-shell-header .dmo-shell-user {white-space:normal;overflow-wrap:anywhere}
+html body .dmo-shell-header .dmo-shell-user strong {font-size:12px}
+html body .dmo-shell-header .dmo-shell-user span {font-size:10px}
+html body .dmo-shell-header .dmo-shell-sessao {font-size:9px}
+html body .dmo-shell-header .dmo-shell-logout {font-size:11px}
+/* Shared workspaces: neutral surfaces, restrained headings and clear actions. */
+html body :is(.dmo-workspace,.beta-light-main,.beta-bq-layout>.main) {padding:20px 24px 28px;gap:16px}
+html body :is(.dmo-page-head,.page-head,.page-heading,.beta-light-heading) h1 {font-size:26px!important;font-weight:650!important;letter-spacing:-.035em}
+html body :is(.dmo-card,.ferr-card,.resumo-card,.beta-bq-layout .card) {box-shadow:none;border-color:var(--dmo-border);border-radius:8px;background:var(--dmo-card)}
+html body :is(.dmo-card-topo,.card-header) {background:transparent}
+html body :is(.dmo-button,.button,.btn) {border-radius:6px;font-size:13px;font-weight:550;box-shadow:none}
+html body :is(.dmo-button,.button,.btn):not(.danger):not(.success):not(:disabled):not([aria-disabled="true"]) {background:var(--dmo-card);color:var(--dmo-text);border-color:var(--dmo-border)}
+html body :is(.dmo-button,.button,.btn):not(:disabled):not([aria-disabled="true"]):hover {background:var(--dmo-brand-100);border-color:var(--design-medium)}
+html body :is(button[type="submit"],.design-primary).dmo-button,
+html body :is(button[type="submit"],.design-primary).btn {background:var(--design-navy);border-color:var(--design-navy);color:#fff}
+html body :is(.dmo-button,.button,.btn):focus-visible,
+html body .dmo-shell-header :is(a,summary):focus-visible {outline:2px solid var(--design-medium);outline-offset:3px}
+html body .dmo-table thead th {background:var(--dmo-subtle);text-transform:none;letter-spacing:0;font-weight:600;color:var(--dmo-muted)}
+html body .dmo-table tbody tr {background:var(--dmo-card)}
