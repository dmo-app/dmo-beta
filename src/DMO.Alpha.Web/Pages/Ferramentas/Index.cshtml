@page "/Ferramentas"
@model DMO.Alpha.Web.Pages.Ferramentas.IndexModel
@using DMO.Alpha.Core.Tools
@{
    Layout = "_DmoShellLayout";

}
@section Head {
  <link rel="stylesheet" href="~/css/dmo-ferramentas.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/dmo-ferramenta-form.css" asp-append-version="true" />
}

<main data-dmo-troca class="ferr-page dmo-workspace" aria-labelledby="ferr-title">

  <div class="page-head">
    <div>
      @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título
       (no Registar ferramenta, ao title da referência e do Registar). *@
      @* O título bate com o separador: Pesquisar → «Ferramentas», Criar → «Criar ferramenta». *@
      <h2 id="ferr-title" title="Registo das ferramentas CM, BQ e MF.">@(Model.ShowCreate ? "Criar ferramenta" : "Ferramentas")</h2>
    </div>
  </div>

  @* As mensagens numa zona sem caixa (dmo-zona): o «Registar ferramenta»
     grava pela fila da página e a mesma recusa duas vezes seguidas
     mostra-se as duas vezes (deep sweep, 18/10/2026, B-ferramentas-2). *@
  <div id="ferrAvisos" class="dmo-zona" data-dmo-regiao>
  @if (Model.DeletedNote)
  {
    <div data-dmo-toast="ok" class="ferr-nota" role="status">Ferramenta eliminada. Os registos de consumo que a referiam foram reatribuídos à linha de removidos e conservam os factos humanos (referência e lote) congelados à criação — a verdade histórica intacta.</div>
  }

  @if (Model.CreateRefusal is not null)
  {
    <div data-dmo-toast="erro" class="ferr-aviso" role="alert">@Model.CreateRefusalMessage@if (Model.ExistingToolId is { } existente)
    {<text> </text><a class="dmo-aviso-link" href="@Url.Page("/Ferramentas/Ficha", new { tool_id = existente })">Abrir a ferramenta existente</a>
      @if (Model.ReturnTemplate is { } regresso)
      {<text> · </text><a class="dmo-aviso-link" href="@regresso.Replace("{tool_id}", existente)">Usar a existente</a>}
    }</div>
  }
  </div>

  @* ------------------------------------------------------------------ *@
  @* 1. Descoberta: filtros explícitos que apenas REDUZEM candidatos.     *@
  @* ------------------------------------------------------------------ *@
  @if (!Model.ShowCreate)
  {
  @* Sem título (Diogo, 28/10/2026: «remover filtrar ferramentas»). *@
  <section class="dmo-card ferr-card" aria-label="Procurar ferramentas">
    @* TUDO NUMA LINHA (Diogo, 19/10/2026: «aqui no ver ferramentas podemos
       meter tudo numa fila incluindo os botões», «reduzindo por página e
       resto»): os filtros com a largura do conteúdo e os dois botões no fim
       da mesma linha, encostados à direita. Os links abrem a página inteira
       (data-dmo-completa): o formulário troca só a lista dos resultados. *@
    <form method="get" asp-page="/Ferramentas/Index" id="ferrFiltros" class="ferr-filters" data-dmo-fica data-dmo-parcial data-dmo-handler="Resultados" data-dmo-alvo="ferrResultados" data-dmo-ao-escrever="ferrResultados">
      @if (Model.ReturnTemplate is not null)
      {
        <input type="hidden" name="return" value="@Model.ReturnTemplate" />
      }
      @* A Referência primeiro (Diogo, 23/10/2026: «começar com campo de filtrar»). *@
      <div class="dmo-field ferr-w-ref">
        <label for="ferr-reference">Referência<partial name="_DmoHelp" model="@("A referência da ferramenta ou a referência MF em que encaixa (por exemplo 5447, T194 ou 5810).")" /></label>
        <input id="ferr-reference" data-dmo-maiusculas autocapitalize="characters" name="reference" value="@(Model.RequestedReference ?? (Model.ShowCreate ? null : Model.RequestedMfReference))" placeholder="5447 · T194" />
      </div>
      <div class="dmo-field ferr-w-lot">
        <label for="ferr-lot">Lote</label>
        <input id="ferr-lot" name="lot" value="@Model.RequestedLot" placeholder="3" />
      </div>
      <div class="dmo-field ferr-w-type">
        <label for="ferr-type">Tipo</label>
        <select id="ferr-type" name="type" data-dmo-autosubmit>
          <option value="">Todos</option>
          <option value="CM" selected="@(Model.RequestedTypeToken == "CM")">CM — Contra-molde</option>
          <option value="BQ" selected="@(Model.RequestedTypeToken == "BQ")">BQ — Boquilha</option>
          <option value="MF" selected="@(Model.RequestedTypeToken == "MF")">MF — Molde final</option>
        </select>
      </div>
      <div class="dmo-field ferr-w-machine">
        <label for="ferr-machine">Linha</label>
        <select id="ferr-machine" name="machine_id" data-dmo-autosubmit>
          <option value="">Todas</option>
          @foreach (var machine in Model.Machines)
          {
            <option value="@machine.MachineId" selected="@(Model.RequestedMachineId == machine.MachineId)">@machine.Code</option>
          }
        </select>
      </div>
      <div class="ferr-filter-actions">
        <a class="dmo-button" data-dmo-completa href="@Url.Page("/Ferramentas/Index", new { @return = Model.ReturnTemplate, por_pagina = Model.PageSize })">Limpar filtros</a>
        <a class="dmo-button" id="ferrCriarFerramenta" data-dmo-completa href="@Url.Page("/Ferramentas/Index", new { criar = 1, @return = Model.ReturnTemplate })">Criar ferramenta</a>
      </div>
    </form>
  </section>
  }

  @* ------------------------------------------------------------------ *@
  @* 2. Registo de uma ferramenta real — o ato canónico do Owner.         *@
  @*    A TAB CRIAR (o Owner 2026-10-13: «um tab para criar e outro      *@
  @*    para ver o que existe»): o form vive na ?criar=1; o VER (o       *@
  @*    default) mostra a procura e a lista — nunca tudo misturado.      *@
  @*    A criação é contextual: o ?return= (validado local-only) devolve *@
  @*    o tool_id novo ao fluxo chamador, que nunca minta identidade.     *@
  @* ------------------------------------------------------------------ *@
  @if (Model.ShowCreate && Model.LoteNovo is { } loteNovo)
  {
    @* O LOTE NOVO DO ARMAZÉM (Diogo, 22/10/2026): o aviso do Sumário abre
       aqui com o tipo, a referência e o lote escritos. Ao registar, a
       entrada fica na posição guardada; se a ferramenta já existe, liga-se
       a ela em vez de criar outra. *@
    var loteTexto = $"{DMO.Alpha.Core.Armazem.ArmazemTextos.Tipo(loteNovo.Tipo)} {loteNovo.Referencia} lote {loteNovo.Lote}";
  <section class="dmo-card ferr-card" id="ferrLoteNovo" aria-labelledby="ferr-lote-novo-title" data-dmo-lote-novo="@loteNovo.Id">
    <div class="dmo-card-topo">
      <h3 id="ferr-lote-novo-title">Lote novo registado no Armazém</h3>
      @if (Model.LoteNovoExistente is not null)
      {
        <div class="dmo-card-topo-acoes">
          <button type="submit" form="ferr-lote-novo-ligar" class="dmo-button" id="ferrLoteNovoLigar">Ligar à existente</button>
        </div>
      }
    </div>
    <p class="dmo-aviso warn">@loteTexto, posição @loteNovo.Posicao@(loteNovo.RegistadoPor is { } por ? $", registado por {por}" : null) em @DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(loteNovo.RegistadoEmUtc).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture). Complete o que falta e registe: a entrada no Armazém fica nessa posição.</p>
    @if (Model.LoteNovoExistente is { } existenteLote)
    {
      <p class="dmo-aviso warn" id="ferrLoteNovoExiste">Já existe @loteTexto nas Ferramentas. Ligue o registo a ela em vez de criar outra.<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.FichaFerramenta(existenteLote, "Abrir a ferramenta")" /></p>
      <form id="ferr-lote-novo-ligar" method="post" asp-page="/Ferramentas/Index" asp-page-handler="LigarLoteNovo">
        <input type="hidden" name="lote_novo" value="@loteNovo.Id" />
      </form>
    }
  </section>
  }

  @if (Model.ShowCreate)
  {
  <section class="dmo-card ferr-card" aria-labelledby="ferr-create-title">
    @* UMA SÓ PÁGINA (Diogo, 18/10/2026: «criaram páginas de ferramentas
       diferentes», uma vinda do Job On e outra das Ferramentas): o título, o
       formulário e o dropdown do Tipo são sempre os mesmos. Vindo do cartão
       CM, MF ou BQ do Job On, o tipo vem escolhido e os outros ficam
       indisponíveis (17/10: «deve ser o CM e não voltar a escolher»). O botão
       fica no canto superior direito do card (18/10). *@
    @{ var tipoFixo = Model.ReturnTemplate is not null ? Model.RequestedTypeToken : null; }
    <div class="dmo-card-topo">
      <h3 id="ferr-create-title">Registar ferramenta</h3>
      <div class="dmo-card-topo-acoes">
        <button type="submit" form="ferr-create-form" class="dmo-button" title="@(Model.ReturnTemplate is null ? null : "Ao registar, regressa ao fluxo que abriu o Ferramentas com a ferramenta escolhida.")">Registar</button>
      </div>
    </div>

    @* beta.34: uma linha com os campos curtos, cada um com a largura do seu conteúdo
       (lote até 3 dígitos, referência de 4 caracteres). A «Referência MF associada»
       só existe para a CM; o servidor ignora-a nos outros tipos.
       CLIQUES REPETIDOS (deep sweep, 18/10/2026, B-ferramentas-2): o registo
       grava pela fila da página (data-dmo-parcial). Um segundo clique igual
       em «Registar ferramenta», enquanto o primeiro não respondeu, não sai, e
       a ficha abre com «Ferramenta registada.» em vez de «já estava
       registada». A ficha é outra página: abre-se inteira, como antes. *@
    <form id="ferr-create-form" method="post" asp-page="/Ferramentas/Index" asp-page-handler="Create" class="ferr-create-form" data-dmo-parcial>
      @if (Model.ReturnTemplate is not null)
      {
        <input type="hidden" name="return" value="@Model.ReturnTemplate" />
      }
      @if (Model.LoteNovo is { } loteNovoCriar)
      {
        <input type="hidden" name="lote_novo" value="@loteNovoCriar.Id" />
      }
      @* Os mesmos campos do Editar da ficha (um só formulário de ferramenta,
         Diogo, 20/10/2026). *@
      <partial name="_FerramentaFactos" model="@(new FerramentaFactosForm("ferr-new", true, Model.RequestedTypeToken ?? "CM", tipoFixo,
          Model.RequestedReference, Model.RequestedLot, Model.RequestedLotQuantity, Model.RequestedQuantityManual,
          Model.RequestedMfReference, Model.RequestedTechnicalName, Model.Machines,
          id => Model.RequestedMachineIds?.Contains(id.ToString()) == true, UsoPercentagem: Model.RequestedUsoPercentagem,
          QuantidadeAn: Model.RequestedAnQuantity))" />
      @* A INFORMAÇÃO TÉCNICA NO REGISTO (o Diogo, 17/10/2026: «nao temos
         forma de inserir informaçao tecnica nas ferramentas»): opcional e
         fechada (a decisão de 16/10: só aparece quando se pede); cada tipo
         mostra só os seus campos, os mesmos da ficha. *@
      <details class="ferr-create-tech" open="@(Model.RequestedTechnicalOpen ? "open" : null)">
        <summary><span class="dmo-caret" aria-hidden="true"></span>Informação técnica (opcional)</summary>
        <partial name="_FerramentaTecnica" model="@(new FerramentaTecnicaForm("ferr-new", true, Model.RequestedTypeToken ?? "CM",
            nome => Model.RequestedTechnical(nome), _ => null, null, null))" />
      </details>
    </form>
  </section>
  }

  @* ------------------------------------------------------------------ *@
  @* 3. Ferramentas registadas — A LISTA VIVE SÓ NO VER (o Owner
  @*    2026-10-13: «deixaste a lista das ferramentas no criar») e à
  @*    GRAMÁTICA GLOBAL (o Owner: «tem botoes abrir ficha, quando ja
  @*    tinhamos falado no duplo click e no click carregar no botao fora»):
  @*    NAS TABELAS NÃO EXISTEM BOTÕES — o radio escondido, a linha
  @*    seleciona (o invertido), o DUPLO abre a ficha; o botão [Abrir
  @*    ficha] vive FORA, com a linha escolhida. A coluna «Ficha» morre.  *@
  @* ------------------------------------------------------------------ *@
  @if (!Model.ShowCreate)
  {
  <partial name="_FerramentasResultados" model="Model" />
  }

  @* A utilização pelo SAP: ao abrir, a pasta do SAP ligada nas Definições é lida
     (ferramentas-sap.js), sem pedir nada se o browser já deu acesso. *@
  <div hidden data-ferr-sap-auto>@Html.AntiForgeryToken()</div>
</main>

<script src="~/ferramentas-live.js" asp-append-version="true"></script>
<script src="~/js/tool-lot-quantity.js" asp-append-version="true"></script>
<script src="~/js/ferramentas-sap.js" asp-append-version="true"></script>
