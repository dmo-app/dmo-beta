@page "/Ferramentas/Historico"
@model DMO.Alpha.Web.Pages.Ferramentas.HistoricoModel
@using DMO.Alpha.Core.Tools
@using DMO.Alpha.Web.Pages.Ferramentas
@{
    Layout = "_DmoShellLayout";
    var ferramenta = Model.Ferramenta;
    var procura = ferramenta is null && !Model.FerramentaNaoExiste;
    // A coluna destacada: a ferramenta vista, ou o tipo escolhido no filtro.
    ToolType? destaque = ferramenta?.Tipo ?? Model.Tipo;
    var temMenu = Model.AbreControlo || Model.AbreReparacao || Model.AbreJobOn || Model.AbreBoquilhas;
}
@section Head {
<link rel="stylesheet" href="~/css/paginas/ferramentas-historico.css" asp-append-version="true">
}

<main class="hist-page dmo-workspace" aria-labelledby="hist-title">
  <div class="page-head">
    <div>
      @* «← Voltar» discreto por cima do título, como nas outras páginas (Diogo, 27/10/2026); o título bate com o separador. *@
      @if (ferramenta is not null)
      {
        <a class="dmo-voltar-texto" id="histFicha" href="/Ferramentas/Ficha?tool_id=@Uri.EscapeDataString(ferramenta.ToolId)">Voltar</a>
      }
      <h1 id="hist-title">Histórico das Ferramentas</h1>
    </div>
  </div>

  @if (procura)
  {
    @* A linha de procura (posições fixas): o texto primeiro, depois os filtros, o «Limpar filtros»; os filtros aplicam ao escolher, a referência com Enter ou a sugestão. *@
    <section class="dmo-card hist-filtros-card" aria-label="Procurar no histórico">
      <form id="histFiltros" method="get" asp-page="/Ferramentas/Historico" class="dmo-filter-bar" role="search">
        <div class="dmo-field hist-w-referencia">
          <label for="histReferencia">Referência</label>
          <input id="histReferencia" name="referencia" value="@Model.Referencia" placeholder="Ex.: 5447" autocomplete="off" data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
        </div>
        <div class="dmo-field hist-w-lote">
          <label for="histLote">Lote</label>
          <input id="histLote" name="lote" value="@Model.Lote" placeholder="Ex.: 3" maxlength="6" inputmode="numeric" autocomplete="off" data-dmo-autosubmit />
        </div>
        <div class="dmo-field hist-w-tipo">
          <label for="histTipo">Tipo</label>
          <select id="histTipo" name="tipo" data-dmo-autosubmit>
            <option value="" selected="@(Model.Tipo is null)">Todos</option>
            <option value="CM" selected="@(Model.Tipo == ToolType.Cm)">CM</option>
            <option value="MF" selected="@(Model.Tipo == ToolType.Mf)">MF</option>
            <option value="BQ" selected="@(Model.Tipo == ToolType.Bq)">BQ</option>
          </select>
        </div>
        <div class="dmo-field hist-w-linha">
          <label for="histLinha">Linha</label>
          <select id="histLinha" name="linha" data-dmo-autosubmit>
            <option value="" selected="@string.IsNullOrWhiteSpace(Model.Linha)">Todas</option>
            @foreach (var m in Model.Maquinas)
            {
              <option value="@m.Code" selected="@string.Equals(m.Code, Model.Linha, StringComparison.OrdinalIgnoreCase)">@m.Code</option>
            }
          </select>
        </div>
        <div class="dmo-field hist-w-data">
          <label for="histDe">De</label>
          <input id="histDe" name="de" type="date" data-dmo-autosubmit value="@HistoricoModel.Data(Model.De)" />
        </div>
        <div class="dmo-field hist-w-data">
          <label for="histAte">Até</label>
          <input id="histAte" name="ate" type="date" data-dmo-autosubmit value="@HistoricoModel.Data(Model.Ate)" />
        </div>
        <div class="hist-acoes">
          <a class="dmo-button" id="histLimpar" href="@Url.Page("/Ferramentas/Historico")">Limpar filtros</a>
        </div>
      </form>
    </section>
  }

  <section id="histResultados" class="dmo-card hist-card" aria-labelledby="hist-lista-title">
    <div class="dmo-card-topo">
      <h3 id="hist-lista-title">@(ferramenta is null ? "Produções" : $"Produções — {HistoricoModel.Nome(ferramenta)}")</h3>
    </div>
    @* O aviso do limite também quando as primeiras ferramentas lidas não têm Job On (as seguintes podem ter). *@
    @if (Model.Cortada)
    {
      <p class="dmo-aviso warn" id="histCortada" role="status">Há mais resultados: escreva mais da referência ou escolha mais filtros.</p>
    }
    @if (Model.FerramentaNaoExiste)
    {
      <p class="hist-vazia" id="histNaoExiste">Esta ferramenta já não existe.</p>
    }
    else if (procura && !Model.ComFiltro)
    {
      <p class="hist-vazia" id="histConvite">Escreva a referência (Enter) ou escolha os filtros.</p>
    }
    else if (Model.Linhas.Count == 0)
    {
      <p class="hist-vazia" id="histVazia">@(procura ? "Nenhuma produção com estes filtros." : "Esta ferramenta ainda não trabalhou em nenhum Job On.")</p>
    }
    else
    {
      <div class="dmo-table-wrap">
        <table class="dmo-table" id="histLista" data-dmo-list="Histórico">
          <thead>
            <tr>
              <th>Referência</th><th>Produção</th><th>Linha</th><th>Data</th><th>Dias</th>
              @foreach (var t in HistoricoModel.Colunas)
              {
                <th class="@(destaque == t ? "hist-destaque" : null)" data-hist-tipo="@HistoricoModel.Token(t)">@HistoricoModel.Token(t)</th>
              }
            </tr>
          </thead>
          <tbody>
          @foreach (var l in Model.Linhas)
          {
            var producao = l.Producao;
            // Sem tipo escolhido, a coluna destacada é a da ferramenta encontrada.
            var destaqueLinha = destaque ?? l.Ferramenta.Tipo;
            <tr data-hist-linha="@l.JobOnId">
              <td>@l.Referencia</td>
              <td>
                @if (temMenu)
                {
                  <details class="dmo-options hist-menu">
                    <summary aria-label="Abrir a produção @l.Referencia @producao"><span class="dmo-caret" aria-hidden="true"></span>@producao</summary>
                    <div class="dmo-options-list" role="menu">
                      @* Sempre as quatro, pela mesma ordem (Diogo, 29/10/2026: «aqui deve aparecer
                         Job On, Controlo, Reparação e Boquilhas»); sem acesso, ou sem BQ, fica apagada. *@
                      @if (Model.AbreJobOn) { <a class="dmo-options-item" role="menuitem" href="@HistoricoModel.JobOnUrl(l)">Job On</a> } else { <span class="dmo-options-item hist-menu-off" role="menuitem" aria-disabled="true">Job On</span> }
                      @if (Model.AbreControlo) { <a class="dmo-options-item" role="menuitem" href="@HistoricoModel.ControloUrl(l)">Controlo</a> } else { <span class="dmo-options-item hist-menu-off" role="menuitem" aria-disabled="true">Controlo</span> }
                      @if (Model.AbreReparacao) { <a class="dmo-options-item" role="menuitem" href="@HistoricoModel.ReparacaoUrl(l)">Reparação</a> } else { <span class="dmo-options-item hist-menu-off" role="menuitem" aria-disabled="true">Reparação</span> }
                      @if (Model.AbreBoquilhas && HistoricoModel.BoquilhasUrl(l) is { } bqUrl) { <a class="dmo-options-item" role="menuitem" href="@bqUrl">Boquilhas</a> } else { <span class="dmo-options-item hist-menu-off" role="menuitem" aria-disabled="true">Boquilhas</span> }
                    </div>
                  </details>
                }
                else
                {
                  @producao
                }
              </td>
              <td>@l.Maquina</td>
              <td>@HistoricoModel.Datas(l.InicioEm, l.FimEm)</td>
              <td>@(l.Dias()?.ToString() ?? "—")</td>
              @foreach (var t in HistoricoModel.Colunas)
              {
                var deste = l.DoTipo(t);
                <td class="@(destaqueLinha == t ? "hist-destaque" : null)">
                  @if (deste.Count == 0) { @("—") }
                  @for (var i = 0; i < deste.Count; i++) { <span class="hist-ferr@(i > 0 ? " hist-trocada" : "")">@HistoricoModel.Nome(deste[i])<span class="hist-uso"> · @DMO.Alpha.Web.Presentation.UsoFerramenta.Link(deste[i].ToolId, HistoricoModel.Uso(l.UsoDe(deste[i].ToolId)))</span></span> }
                </td>
              }
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </section>
</main>
<script>
// Clicar na linha abre o menu dela (e fecha os outros); fora fecha.
(function () {
  var lista = document.getElementById('histLista');
  if (!lista) return;
  lista.addEventListener('click', function (e) {
    if (e.target.closest('.dmo-options-list') || e.target.closest('summary')) return;
    var tr = e.target.closest('tr[data-hist-linha]');
    var menu = tr && tr.querySelector('details.hist-menu');
    if (!menu) return;
    lista.querySelectorAll('details.hist-menu[open]').forEach(function (d) { if (d !== menu) d.open = false; });
    menu.open = !menu.open;
  });
  // O menu fica por cima da tabela (a caixa da tabela rola e cortava-o).
  function colocar(d) {
    var r = d.querySelector('summary').getBoundingClientRect();
    var l = d.querySelector('.dmo-options-list');
    l.style.position = 'fixed';
    l.style.top = (r.bottom + 2) + 'px';
    l.style.left = Math.max(8, Math.min(r.left, window.innerWidth - l.offsetWidth - 8)) + 'px';
  }
  lista.addEventListener('toggle', function (e) {
    if (!e.target.open) return;
    lista.querySelectorAll('details.hist-menu[open]').forEach(function (d) { if (d !== e.target) d.open = false; });
    colocar(e.target);
  }, true);
  window.addEventListener('scroll', function () { lista.querySelectorAll('details.hist-menu[open]').forEach(function (d) { d.open = false; }); }, true);
  document.addEventListener('click', function (e) {
    if (!e.target.closest('#histLista')) lista.querySelectorAll('details.hist-menu[open]').forEach(function (d) { d.open = false; });
  });
})();
</script>
