@page "/Ferramentas/Utilizacao"
@model DMO.Alpha.Web.Pages.Ferramentas.UtilizacaoModel
@{
    Layout = "_DmoShellLayout";
    var sheet = Model.Sheet!;
    var nome = $"{FichaModel.TokenTypeFor(sheet.Type)} {sheet.Reference} · lote {sheet.Lot}";
}
@section Head {
<link rel="stylesheet" href="~/css/paginas/ferramentas-utilizacao.css" asp-append-version="true">
}
@* O histórico do uso de uma ferramenta (Diogo, 27/10/2026): abre no painel a
   partir de qualquer «% uso» (Shared/_UsoFerramenta). Só leitura. *@
<dmo-pagina titulo="Utilização · @nome" titulo-id="ferr-uso-title" class="ferr-uso-page dmo-workspace" aria-labelledby="ferr-uso-title" data-tool-id="@sheet.ToolId">
  <dmo-acoes><a class="dmo-button" href="@Url.Page("/Ferramentas/Ficha", new { tool_id = sheet.ToolId })" id="ferrUsoFicha">Ficha da ferramenta</a></dmo-acoes>
  <section class="dmo-card ferr-uso-cartao" id="ferrProducoes" aria-label="Utilização por produção">
    <partial name="_UtilizacaoProducoes" model="new DMO.Alpha.Web.Presentation.UtilizacaoProducoesView(Model.Producoes!, Model.Utilizacao?.Ultima)" />
  </section>
</dmo-pagina>
