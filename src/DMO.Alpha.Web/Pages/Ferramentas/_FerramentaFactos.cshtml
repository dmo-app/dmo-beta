@model DMO.Alpha.Web.Pages.Ferramentas.FerramentaFactosForm
@* UM SÓ FORMULÁRIO DE FERRAMENTA (Diogo, 20/10/2026): os campos do Criar e do
   Editar da ficha. Uma linha com os campos curtos, cada um com a largura do
   seu conteúdo. A Quantidade do lote vem antes da Ref. MF associada, que
   raramente se usa; a Ref. MF só existe para a CM (o servidor ignora-a nos
   outros tipos). *@
@{
    var p = Model.Prefixo;
    var tipoFixo = Model.TipoFixo;
}
@* AS LINHAS POR CIMA (Diogo, 22/10/2026): os campos e a Informação opcional
   numa só linha, alinhados pelas caixas. *@
<div class="ferr-create-row ferr-create-row-machines">
  <div class="dmo-field">
    <span class="dmo-label" id="@(p)-machines">Linhas compatíveis</span>
    <div class="ferr-checks" role="group" aria-labelledby="@(p)-machines">
      @if (Model.Maquinas.Count == 0)
      {
        <span class="ferr-hint" style="margin:0">Sem máquinas registadas — pode registar a ferramenta agora e associar máquinas depois, na sua ficha.</span>
      }
      @foreach (var machine in Model.Maquinas)
      {
        <label class="ferr-check">
          <input type="checkbox" name="machine_ids" value="@machine.MachineId" checked="@Model.MaquinaEscolhida(machine.MachineId)" />
          <span>@machine.Code</span>
        </label>
      }
    </div>
  </div>
  @if (Model.Criar)
  {
    <div class="ferr-quantity-suggestion">
      <p id="ferr-quantity-notice" class="ferr-hint" role="status" aria-live="polite"></p>
      <div id="ferr-quantity-choices" class="ferr-quantity-choices"></div>
    </div>
  }
</div>
<div class="ferr-editar-linha">
<div class="ferr-create-row ferr-editar-principal">
  <div class="dmo-field ferr-w-type">
    <label for="@(p)-type">Tipo</label>
    <select id="@(p)-type" name="type_token" required data-ferr-tipo-fixo="@tipoFixo">
      <option value="CM" selected="@(Model.Tipo == "CM")" disabled="@(tipoFixo is not null && tipoFixo != "CM")">CM — Contra-molde</option>
      <option value="BQ" selected="@(Model.Tipo == "BQ")" disabled="@(tipoFixo is not null && tipoFixo != "BQ")">BQ — Boquilha</option>
      <option value="MF" selected="@(Model.Tipo == "MF")" disabled="@(tipoFixo is not null && tipoFixo != "MF")">MF — Molde final</option>
    </select>
  </div>
  <div class="dmo-field ferr-w-ref">
    <label for="@(p)-reference">Referência</label>
    @* A referência sempre toda (Diogo, 19/10/2026): as ferramentas do
       tipo (a CM também pela Ref. MF associada, com o nome original) e as produções.
       O ferramentas-live.js muda o tipo da procura com o Tipo. *@
    <input id="@(p)-reference" data-dmo-maiusculas autocapitalize="characters" name="reference" value="@Model.Referencia" required placeholder="5447 · T194" data-dmo-suggest="referencias_registo" data-dmo-suggest-tipo="@Model.Tipo.ToLowerInvariant()" title="@(Model.Criar ? "A referência toda, como no desenho: 1075C142, 5447T173 ou ST100." : null)" />
  </div>
  <div class="dmo-field ferr-w-lot">
    <label for="@(p)-lot">Lote</label>
    <input id="@(p)-lot" name="lot" value="@Model.Lote" maxlength="3" inputmode="numeric" placeholder="3" title="Obrigatório na BQ; na CM e na MF, vazio grava «s/lote»" />
  </div>
  @* Não diz «opcional» (Diogo, 20/10/2026): sem ela grava-se na mesma, mas a
     Fabricação das Boquilhas não é calculada e a ficha da BQ avisa. *@
  <div class="dmo-field ferr-w-qty">
    @* Na ficha sem o círculo da ajuda (Diogo, 27/10/2026: o rótulo não fica
       mais largo do que o campo de 3 dígitos); o texto passa ao title do campo.
       No ecrã o rótulo mostra «Qtd. lote» (d1366-boquilhas-ferramentas.css). *@
    <label for="@(p)-qty">Quantidade do lote@(Model.Criar ? await Html.PartialAsync("_DmoHelp", "Vem preenchida com o total do lote das máquinas escolhidas (Ferramentas → Definições) e pode ser mudada. Se faltar o total de uma máquina, aparece um aviso.") : null)</label>
    <input id="@(p)-qty" name="bq_quantity" type="text" inputmode="numeric" value="@Model.Quantidade" title="@(Model.Criar ? null : "Quantidade do lote. Numa BQ, sem ela a Fabricação das Boquilhas não é calculada.")" />
    @if (Model.Criar)
    {
      <input id="ferr-quantity-manual" type="hidden" name="quantity_manual" value="@(Model.QuantidadeManual ?? "0")" />
    }
  </div>
  @* OS AN DO LOTE (Diogo, 28/10/2026: «vamos passar a registar AN»): só na BQ,
     ao lado da quantidade das BQ, que é outra (B1: 120 BQ, 180 AN). No Criar o
     tipo mostra-o ou esconde-o (data-ferr-tech-tipo, ferramentas-live.js). *@
  @if (Model.Criar || Model.Tipo == "BQ")
  {
    <div class="dmo-field ferr-w-qty ferr-w-an" id="@(p)-an-field" data-ferr-tech-tipo="@(Model.Criar ? "BQ" : null)" hidden="@(Model.Criar && Model.Tipo != "BQ" ? true : null)">
      <label for="@(p)-an">Qtd. AN</label>
      <input id="@(p)-an" name="an_quantity" type="text" inputmode="numeric" value="@Model.QuantidadeAn" title="Quantidade de AN (anéis) do lote." />
    </div>
  }
  @* O % DE USO (Diogo, 22/10/2026): escrito à mão, opcional, gravado com o
     «Guardar» do Editar como uma leitura nova (origem manual). Vazio ou igual
     não grava; acima de 100 grava e avisa. *@
  @* Também no Criar (Diogo, 23/10/2026: «não tem a percentagem de uso»):
     grava como a primeira leitura da ferramenta. *@
    <div class="dmo-field ferr-w-uso">
      @{ var usoAjuda = Model.UsoData is { } dataUso ? $"Última leitura: {dataUso}. Um valor novo fica como leitura de hoje." : "Ainda sem leitura. Um valor escrito fica como leitura de hoje."; }
      <label for="@(p)-uso">% uso@(Model.Criar ? await Html.PartialAsync("_DmoHelp", usoAjuda) : null)</label>
      @* maxlength 8: o aviso mostra o que se escreveu, sem cortar (ronda de 26/10/2026, J11). *@
      <input id="@(p)-uso" name="uso_percentagem" type="text" inputmode="numeric" maxlength="8" value="@Model.UsoPercentagem" placeholder="@(Model.Criar ? null : "sem registo")" class="@(!Model.Criar && string.IsNullOrEmpty(Model.UsoPercentagem) ? "ferr-sem-registo-campo" : null)" title="@(Model.Criar ? null : usoAjuda)" />
    </div>
</div>
<span class="ferr-tech-sep ferr-editar-sep" aria-hidden="true"></span>
@* INFORMAÇÃO OPCIONAL (Diogo, 22/10/2026): a Ref. MF, o nome técnico e a
   fábrica de origem num bloco à parte, ao lado, com o traço vertical das colunas da Informação técnica (Diogo, 22/10/2026). *@
<fieldset class="ferr-tech-bloco ferr-opcional" id="@(p)-opcional">
  @* O triângulo abre e fecha o bloco (Diogo, 27/10/2026: «adiciona o triângulo de minimizar»). *@
  <legend class="ferr-tech-titulo ferr-opcional-titulo" role="button" tabindex="0" aria-expanded="true" aria-controls="@(p)-opcional-campos"><span class="dmo-caret" aria-hidden="true"></span>Informação opcional</legend>
  <div class="ferr-tech-campos" id="@(p)-opcional-campos">
    <div class="dmo-field ferr-w-ref" id="@(p)-mf-field" hidden="@(Model.Tipo != "CM")">
      <label for="@(p)-mf">Ref. MF associada</label>
      <input id="@(p)-mf" data-dmo-maiusculas autocapitalize="characters" name="mf_reference" value="@Model.RefMf" title="Só quando difere da referência MF em que encaixa" data-dmo-suggest="ferramentas" data-dmo-suggest-tipo="mf" />
    </div>
    @* O NOME TÉCNICO (o código do desenho — o código de produção; o Owner:
       «se introduzirmos o nome tecnico, ou seja o que esta no sap.
       apresenta logo tudo»): no Criar, ao escrever, o vivo decodifica e
       propõe o tipo; vazio = o formato simples. *@
    <div class="dmo-field ferr-w-sap">
      <label for="@(p)-technical">Nome técnico (produção)</label>
      <input id="@(p)-technical" data-dmo-maiusculas autocapitalize="characters" name="technical_name" value="@Model.NomeTecnico" placeholder="Ex.: M107544MFNNV" />
    </div>
    @if (!Model.Criar)
    {
      <div class="dmo-field ferr-w-fab">
        @* Sem o círculo da ajuda (Diogo, 27/10/2026); o texto passa ao title do campo. *@
        <label for="@(p)-fabrica">Fábrica de origem</label>
        <input id="@(p)-fabrica" data-dmo-maiusculas autocapitalize="characters" name="fabrica_origem" value="@Model.FabricaOrigem" maxlength="32" placeholder="MG" title="A fábrica dona da ferramenta (ex.: MG). Ajuda a separar as ferramentas emprestadas." />
      </div>
    }
  </div>
</fieldset>
</div>
<script>
  // Um só ouvinte para os blocos «Informação opcional» da página (Criar e Editar).
  if (!window.ferrOpcionalLigado) {
    window.ferrOpcionalLigado = true;
    const alternar = titulo => {
      const aberto = titulo.getAttribute('aria-expanded') !== 'true';
      titulo.setAttribute('aria-expanded', aberto ? 'true' : 'false');
      const campos = document.getElementById(titulo.getAttribute('aria-controls'));
      if (campos) campos.hidden = !aberto;
    };
    document.addEventListener('click', e => { const t = e.target.closest('.ferr-opcional-titulo'); if (t) alternar(t); });
    document.addEventListener('keydown', e => {
      const t = e.target.closest?.('.ferr-opcional-titulo');
      if (t && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); alternar(t); }
    });
  }
</script>
@if (Model.Criar)
{
  <p class="ferr-hint" id="ferr-technical-notice" role="status" aria-live="polite"></p>
}
