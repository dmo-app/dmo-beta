@page "/Ferramentas/Ficha"
@model DMO.Alpha.Web.Pages.Ferramentas.FichaModel
@using DMO.Alpha.Core.Production
@using DMO.Alpha.Core.Tools
@{
    Layout = "_DmoShellLayout";
    var pt = DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture;
    // Ponto decimal canónico, precisão TOTAL dos factos
    // registados (28.84061800082953 nunca é arredondado na exibição).
    var fmt = new Func<decimal, string>(v => v.ToString(pt));
    var fmtOptional = new Func<decimal?, string>(v => v is null ? "—" : fmt(v.Value));
    // TechnicalValue uses the decimal-point convention and restores refused input.
    var tokenOf = new Func<ToolType, string>(FichaModel.TokenTypeFor);
    var sheet = Model.Sheet;
    var humanFacts = sheet is null ? "" : $"{tokenOf(sheet.Type)} · {sheet.Reference} · lote {sheet.Lot}";
    var machineCodes = sheet is null || sheet.Machines.Count == 0 ? "—" : string.Join(" · ", sheet.Machines.Select(m => m.Code));
}
@section Head {
<link rel="stylesheet" href="~/css/dmo-ferramenta-form.css" asp-append-version="true" />
<style>
/* O % da Utilização abre a janela das produções (Diogo, 21/10/2026). */
.ferr-utilizacao-abrir{all:unset;cursor:pointer;font-weight:800;color:var(--dmo-link,var(--dmo-brand-600));text-decoration:underline;text-underline-offset:3px}
.ferr-utilizacao-abrir:focus-visible{outline:2px solid var(--dmo-focus-ring);outline-offset:2px}
.ferr-producoes-janela .ferr-producoes-lista{max-height:min(60vh,420px);overflow:auto}
.ferr-producoes-janela .dmo-table{min-width:0}
.ferr-producao-maquina{color:var(--dmo-muted);font-size:12px}
.ferr-armazem-link{color:var(--dmo-brand-900);font-weight:600}
.ferr-page{max-width:1240px;margin:0 auto;padding:24px 22px 40px;display:grid;gap:16px}
.ferr-page .page-head h2{margin:0;font-size:23px;color:var(--dmo-brand-700,#193046)}
.ferr-page .page-head p{margin:4px 0 0;color:var(--dmo-muted)}
.ferr-card .dmo-card-topo-acoes .dmo-options-list{left:auto;right:0}
#ferr-delete-dialog .dmo-aviso-discreto{margin:8px 0 22px}
.ferr-card{padding:18px}
.ferr-card h3{margin:0;font-size:16px}
/* A linha do título com os botões do card (.dmo-card-topo, canto superior direito). */
.ferr-card .dmo-card-topo{margin-bottom:12px}
.ferr-card details:not([open])>summary.dmo-card-topo{margin-bottom:0}
.ferr-card .dmo-facts{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}
.ferr-card .card-note{margin:3px 0 14px;color:var(--dmo-muted);font-size:12.5px}
.ferr-aviso{padding:11px 13px;border-left:4px solid var(--dmo-danger,#9a625d);background:var(--dmo-danger-soft);border-radius:8px}
/* O aviso âmbar (o mesmo de .jobon-aviso.warn / .peg-aviso.warn): o trabalho foi gravado, o aviso diz o que ficou de fora. */
.ferr-aviso.warn{border-left-color:var(--dmo-warning);background:var(--dmo-warning-soft)}
.ferr-nota{padding:11px 13px;border-left:4px solid var(--dmo-ok);background:var(--dmo-ok-soft);border-radius:8px}
.ferr-nota.avisoria{border-left-color:var(--dmo-warning);background:var(--dmo-warning-soft)}
.ferr-hint{color:var(--dmo-muted);font-size:11.5px;margin:10px 0 0}
.ferr-vazia{padding:38px 20px;text-align:center;color:var(--dmo-muted);border:1px dashed var(--dmo-border,#d9e6f2);border-radius:12px}
.ferr-subtitle{margin:20px 0 8px;padding-top:16px;border-top:1px solid var(--dmo-border);font-size:14px}
.ferr-danger{background:var(--dmo-danger,#9a625d)}
.ferr-danger:hover{background:color-mix(in srgb,var(--dmo-danger) 80%,#000)}
.ferr-cancel{font-size:12.5px;color:var(--dmo-brand-600,#3c73a8);font-weight:700}
</style>
}

@* GRAVAR SEM RECARREGAR (Diogo, 17/10/2026: «atualizar só o que muda»):
   guardar o Editar ou a Informação técnica troca só as zonas
   (data-dmo-regiao) que mudaram: a secção guardada, as mensagens e o que
   mostra os factos. A outra secção fica como o operador a deixou, com o que
   lá estiver escrito; a Informação técnica fica aberta ou fechada como
   estava (data-dmo-fica). Mudar o tipo, a referência ou o lote abre a
   página inteira: o nome da ferramenta também está na pergunta de
   eliminar, fora das zonas (as «Opções» estão no Geral, uma zona). Duplicar e eliminar abrem outra
   página, como sempre; gravam pela fila da página (um clique repetido não
   grava duas vezes). Ver docs/ui-reference/atualizar-so-o-que-muda.md. *@
<main class="ferr-page dmo-workspace" aria-labelledby="ferr-title" data-dmo-troca>

  @* OS BOTÕES NO CANTO SUPERIOR DIREITO DE CADA CARD (Diogo, 18/10/2026:
     «metem os botões em baixo aumenta espaço, sempre canto superior direito
     dentro dos cards»): o «Opções» e o «Voltar à lista» saíram daqui para o
     primeiro card da ficha; os «Guardar» estão na linha do título do card. *@
  <div class="page-head">
    <div>
      <h2 id="ferr-title">Ficha de ferramenta</h2>
    </div>
  </div>

  @if (sheet is not null)
  {
    @* CLIQUES REPETIDOS (deep sweep, 18/10/2026, B-ferramentas-3): o
       «Duplicar» grava pela fila da página (data-dmo-parcial). Um segundo
       clique igual, enquanto o primeiro não respondeu, não sai, e a ficha
       nova abre com «Ferramenta registada.» em vez do aviso «O lote já
       estava registado». A resposta abre sempre a página inteira, como
       antes: a ficha de outra ferramenta muda fora das zonas (a pergunta de
       eliminar tem o nome dela); a desta mesma ficha (o lote novo é o desta
       ferramenta) troca a zona da janela, que é uma janela que pode abrir
       com a página (data-dmo-dialog-aberta), e essa só vem com a página
       inteira. Sem a zona (dmo-zona, sem caixa), a resposta desta ficha
       trocava só os avisos e a janela ficava aberta por cima. *@
    <div id="ferrDuplicar" class="dmo-zona" data-dmo-regiao>
    <dialog id="ferr-duplicate-dialog" class="dmo-dialog" aria-labelledby="ferr-duplicate-title" data-dmo-dialog-aberta="@(Model.DuplicateRefusal is not null ? "1" : null)">
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="Duplicate" data-dmo-parcial>
        <h3 id="ferr-duplicate-title">Duplicar para lote novo<partial name="_DmoHelp" model="@("Cria uma ferramenta nova com os mesmos dados e o lote indicado. Esta ferramenta fica como está.")" /></h3>
        @if (Model.DuplicateRefusal is not null)
        {
          <div class="ferr-aviso" role="alert">@Model.DuplicateRefusalMessage@if (Model.ExistingToolId is { } existenteLote)
          {<text> </text><a class="dmo-aviso-link" href="@Url.Page("/Ferramentas/Ficha", new { tool_id = existenteLote })">Abrir a ferramenta existente</a>}</div>
        }
        <input type="hidden" name="tool_id" value="@sheet.ToolId" />
        <div class="dmo-field">
          <label for="ferr-new-lot">Lote novo</label>
          <input id="ferr-new-lot" name="new_lot" required placeholder="Ex.: 4" />
        </div>
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
          <button type="submit" class="dmo-button">Duplicar</button>
        </div>
      </form>
    </dialog>
    </div>
  }

  @if (sheet is not null)
  {
    @* Só um aviso curto antes de eliminar (Diogo, 17/10/2026: «não precisa
       desta informação toda, basta um warning se quer mesmo eliminar»).
       CLIQUES REPETIDOS (deep sweep, 18/10/2026, B-ferramentas-4): o
       «Eliminar» grava pela fila da página (data-dmo-parcial). Um segundo
       clique igual, enquanto o primeiro não respondeu, não sai: a lista abre
       com «Ferramenta eliminada…», em vez de o segundo pedido já não
       encontrar a ferramenta e dizer «Nenhuma eliminação foi feita». A
       lista é outra página: abre-se inteira, como antes. *@
    <dialog id="ferr-delete-dialog" class="dmo-dialog" aria-labelledby="ferr-delete-title" data-dmo-dialog-aberta="@(Model.ConfirmDelete ? "1" : null)">
      <h3 id="ferr-delete-title">Eliminar ferramenta</h3>
      <p class="dmo-aviso-discreto">Quer mesmo eliminar @humanFacts?</p>
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="Delete" data-dmo-parcial>
        <input type="hidden" name="tool_id" value="@sheet.ToolId" />
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
          <button type="submit" class="dmo-button ferr-danger">Eliminar</button>
        </div>
      </form>
    </dialog>
  }

  @* ------------------------------------------------------------------ *@
  @* 0. Sem ferramenta: a ficha resolve-se pelo tool_id — nada é       *@
  @*    inventado.                                                       *@
  @* ------------------------------------------------------------------ *@
  @if (sheet is null && Model.RequestedToolId is null)
  {
    <section class="dmo-card ferr-card" aria-labelledby="ferr-empty-title">
      <div class="dmo-card-topo">
        <h3 id="ferr-empty-title">Ficha de ferramenta</h3>
        <div class="dmo-card-topo-acoes">
          <a class="dmo-button" href="@Url.Page("/Ferramentas/Index")">Voltar à lista</a>
        </div>
      </div>
      <div class="ferr-vazia">Nenhuma ferramenta selecionada. Abra a lista do Ferramentas e escolha a ficha pelo nome — tipo, referência e lote.</div>
    </section>
  }
  else if (sheet is null)
  {
    <section class="dmo-card ferr-card" aria-labelledby="ferr-missing-title">
      <div class="dmo-card-topo">
        <h3 id="ferr-missing-title">Ficha de ferramenta</h3>
        <div class="dmo-card-topo-acoes">
          <a class="dmo-button" href="@Url.Page("/Ferramentas/Index")">Voltar à lista</a>
        </div>
      </div>
      <div class="ferr-aviso" role="alert">A ferramenta indicada não existe no registo. Nenhuma ficha foi aberta e nenhuma ferramenta foi inventada.</div>
      @if (Model.DeleteRefusal is not null)
      {
        <div data-dmo-toast="erro" class="ferr-aviso" role="alert" style="margin-top:10px">@Model.DeleteRefusalMessage</div>
      }
    </section>
  }

  @if (sheet is { } tool)
  {
    @* As mensagens: uma zona sem caixa (dmo-zona), a grelha da página fica
       como estava. A confirmação de guardar vai para o canto. *@
    <div id="ferrAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.CreatedNote)
    {
      @* Sem aviso de «formato canónico» (Diogo, 17/10/2026: um CM pode ter
         referências próprias como ST100 ou ST62; a ligação à referência MF
         faz-se pela «Ref. MF associada»). *@
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Ferramenta registada.</div>
    }
    else if (Model.ExistedNote)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Esta ferramenta já estava registada (mesmos tipo, referência e lote) — nada foi duplicado; as máquinas indicadas foram acrescentadas às ligações dela.</div>
    }

    @if (Model.SavedSection == FichaModel.SavedGeneral)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Dados gerais guardados.</div>
    }
    else if (Model.SavedSection == FichaModel.SavedTechnical)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Informação técnica guardada.</div>
    }
    else if (Model.SavedSection == FichaModel.SavedDuplicateWarningCleared)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Aviso de ferramenta repetida limpo.</div>
    }
    else if (Model.SavedSection == FichaModel.SavedUtilizacaoPedida)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status" id="ferrUtilizacaoPedida">Utilização pedida ao SAP: vem na próxima leitura.</div>
    }

    @* Avisos (beta.63, regra do Owner «tentar sempre warning»): o trabalho
       foi gravado; o aviso âmbar diz o que ficou de fora. Vão para o canto,
       como as outras mensagens (beta.199, Diogo, 17/10/2026: «os elementos
       têm de ficar fixos»): na grelha empurravam os cartões 56 a 77 px.
       Ficam até se fecharem no × ou até à gravação seguinte do mesmo cartão. *@
    @if (Model.LotDefaultedWarning)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.LotDefaultedMessage</div>
    }

    @if (Model.UnreadableQuantity is not null)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.UnreadableQuantityMessage</div>
    }

    @* O tipo de uma ferramenta já usada mudou (sweep de 19/10/2026, F-1):
       gravou-se, e o link leva ao Editar para voltar ao tipo anterior. *@
    @if (Model.TypeChangedWarning is { } tipoMudou)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@tipoMudou<partial name="_DmoAvisoLink" model="@(new DMO.Alpha.Web.Pages.Shared.DmoAvisoLink("Corrigir em Editar", "#ferrEditar"))" /></div>
    }

    @if (Model.DuplicateExistedWarning)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">O lote «@tool.Lot» já estava registado para esta referência: abriu-se a ferramenta existente. Nada foi duplicado nem alterado.</div>
    }

    @if (Model.UnreadableTechnical.Count > 0)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.UnreadableTechnicalMessage</div>
    }

    @if (Model.ImpossibleTechnical.Count > 0)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.ImpossibleTechnicalMessage</div>
    }

    @if (Model.ContinueUrl is { } continueUrl)
    {
      <p class="ferr-hint" style="margin:0"><a class="ferr-cancel" href="@continueUrl">Continuar no fluxo que abriu o Ferramentas →</a></p>
    }

    @if (Model.FactsRefusal is not null)
    {
      <div data-dmo-toast="erro" class="ferr-aviso" role="alert">@Model.FactsRefusalMessage @if (Model.ExistingToolId is { } existingId)
      {<a class="dmo-aviso-link" href="@Url.Page("/Ferramentas/Ficha", new { tool_id = existingId })">Abrir a ferramenta existente</a>}</div>
    }

    @if (Model.TechnicalRefusal is not null)
    {
      <div data-dmo-toast="erro" class="ferr-aviso" role="alert">@Model.TechnicalRefusalMessage</div>
    }
    </div>

    @* ---------------------------------------------------------------- *@
    @* 1. GERAL — os factos humanos do registo (o Owner 2026-10-12:      *@
    @*    «ficha tecnica da ferramenta deve ter 2 tipos de informaçao, o   *@
    @*    geral Tipo CM MF BQ etc, referencia lote e maquinas em que pode *@
    @*    trabalhar, sendo que certas referencias podem trabalhar em mais *@
    @*    que uma maquina»): o Tipo, a referência, o lote, AS MÁQUINAS    *@
    @*    (o link n-n — todas as que a ficha ligar).                      *@
    @* ---------------------------------------------------------------- *@
    @* FERRAMENTA REPETIDA (o proprietário, 18/10/2026): alguém tentou
       registar outra com o mesmo tipo, referência e lote e foi recusado. A
       errada pode ser esta: quem confirmar que está certa limpa o aviso (o
       botão grava sem recarregar; a zona fica vazia). *@
    <div id="ferrRepetida" class="dmo-zona" data-dmo-regiao>
    @if (tool.DuplicateWarningAtUtc is { } avisoEm)
    {
      <section class="dmo-card ferr-card" aria-labelledby="ferr-repetida-title" data-dmo-parcial>
        <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="ClearDuplicateWarning">
          <input type="hidden" name="tool_id" value="@tool.ToolId" />
          <div class="dmo-card-topo">
            <h3 id="ferr-repetida-title">Possível ferramenta repetida</h3>
            <div class="dmo-card-topo-acoes">
              <button type="submit" class="dmo-button" id="ferr-repetida-limpar">Limpar aviso</button>
            </div>
          </div>
          <div class="ferr-aviso warn ferr-repetida-texto" role="status">Em @FichaModel.FormatWarningMoment(avisoEm), @(tool.DuplicateWarningBy ?? "alguém") tentou registar outra ferramenta @humanFacts, e não foi registada. A errada pode ser esta: confirme o tipo, a referência, o lote e as máquinas. Se estiver certa, limpe o aviso; se não, corrija-a em Editar.</div>
        </form>
      </section>
    }
    </div>

    <section id="ferrGeral" class="dmo-card ferr-card" aria-labelledby="ferr-facts-title" data-dmo-regiao>
      <div class="dmo-card-topo">
        <h3 id="ferr-facts-title">Geral — @humanFacts</h3>
        <div class="dmo-card-topo-acoes">
          @* AÇÕES RARAS NO «OPÇÕES» (Diogo, 17/10/2026: «criar opções pode ir
             para topo lado direito, e nas opções meter o duplicar e eliminar»):
             cada uma abre numa janela pequena (as janelas ficam fora das zonas;
             os botões que as abrem ligam-se por delegação). *@
          <details class="dmo-options" data-dmo-tab-menu>
            <summary class="dmo-button" aria-label="Opções da ferramenta @humanFacts">Opções<span class="dmo-options-caret" aria-hidden="true">▾</span></summary>
            <div class="dmo-options-list" id="ferrOpcoes">
              <button type="button" class="dmo-options-item" data-dmo-dialog="ferr-duplicate-dialog">Duplicar para lote novo</button>
              <button type="button" class="dmo-options-item" data-dmo-dialog="ferr-delete-dialog">Eliminar ferramenta</button>
              @* Pedir a utilização ao SAP: abre o lembrete, como a Entrada
                 vinda da Produção (só um aberto de cada vez). *@
              @if (Model.Utilizacao?.LembreteDesdeUtc is null)
              {
              <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="PedirUtilizacao" id="ferr-pedir-utilizacao">
                <input type="hidden" name="tool_id" value="@tool.ToolId" />
                <button type="submit" class="dmo-options-item" id="ferr-pedir-utilizacao-botao">Pedir a utilização ao SAP</button>
              </form>
              }
            </div>
          </details>
          <a class="dmo-button" href="@Url.Page("/Ferramentas/Index")">Voltar à lista</a>
        </div>
      </div>
      <div class="dmo-facts">
        <div class="dmo-fact"><span>Tipo</span><strong>@(tokenOf(tool.Type) switch { "CM" => "CM — Contra-molde", "BQ" => "BQ — Boquilha", _ => "MF — Molde final" })</strong></div>
        <div class="dmo-fact"><span>Referência</span><strong>@tool.Reference</strong></div>
        <div class="dmo-fact"><span>Lote</span><strong>@tool.Lot</strong></div>
        <div class="dmo-fact"><span>Máquinas / linhas</span><strong>@machineCodes</strong></div>
        @* Só a CM com uma referência diferente da do MF (Diogo, 21/10/2026). *@
        @if (tool.Type == ToolType.Cm && !string.IsNullOrWhiteSpace(tool.AssociatedMfReference)
            && !string.Equals(tool.AssociatedMfReference.Trim(), tool.Reference.Trim(), StringComparison.OrdinalIgnoreCase))
        {
          <div class="dmo-fact"><span>Referência MF associada</span><strong>@tool.AssociatedMfReference</strong></div>
        }
        <div class="dmo-fact"><span>Quantidade</span><strong>@(tool.BqAccountedQuantity?.ToString(pt) ?? "—")</strong></div>
        @if (Model.Armazem is { } arm)
        {
          @* Onde está e o estado, pelo Armazém (só a quem tem o Armazém). *@
          <div class="dmo-fact" id="ferrLocalizacao"><span>Localização</span><strong data-dmo-localizacao><a class="ferr-armazem-link" href="@Url.Page("/Armazem/Movimentos", new { ferramenta = arm.ToolId })">@(arm.NoArmazem ? $"Armazém · posição {arm.Posicao}" : DMO.Alpha.Core.Armazem.ArmazemTextos.Localizacao(arm.Localizacao, arm.LocalizacaoReparador))</a></strong></div>
          <div class="dmo-fact" id="ferrEstadoArmazem"><span>Estado</span><strong>@(arm.Estado is { } estadoArm ? DMO.Alpha.Core.Armazem.ArmazemTextos.Estado(estadoArm) : "—")</strong></div>
          <div class="dmo-fact"><span>Movimentos</span><strong><a class="ferr-armazem-link" id="ferrHistoricoArmazem" href="@Url.Page("/Armazem/Historico", new { ferramenta = arm.ToolId })">Ver o histórico</a></strong></div>
        }
        @if (Model.Utilizacao is { Ultima: not null } or { LembreteDesdeUtc: not null } || Model.Producoes is { Pagina.TotalCount: > 0 })
        {
          @* A UTILIZAÇÃO (blueprint ferramentas/ESTADO-E-UTILIZACAO §2.2): a
             última leitura, de onde veio e quando; o SAP dá também as peças
             feitas e as previstas. O lembrete aberto diz que está à espera. *@
          var leituraUtil = Model.Utilizacao?.Ultima;
          @* Só o % de uso, o que mais importa (Diogo, 21/10/2026); um clique
             abre a janela com as produções, o produzido e o delta. *@
          <div class="dmo-fact" id="ferrUtilizacao"><span>Utilização</span><button type="button" class="ferr-utilizacao-abrir" id="ferr-utilizacao-detalhes" data-dmo-dialog="ferrProducoes" aria-label="Utilização por produção">@(leituraUtil is null ? "—" : leituraUtil.Percentagem.ToString("0.##", pt) + " %")</button></div>
        }
      </div>

      @* SEM MÁQUINAS (Diogo, 19/10/2026: «essa regra pode ficar aplicada a de
         todas as maquinas mas acrescentar um aviso com link que envia para a
         pagina onde pode ser alterado»): sem máquinas, a ferramenta conta em
         todas para a ferramenta repetida; o link leva ao Editar. *@
      @if (tool.Machines.Count == 0)
      {
        <div class="ferr-aviso warn ferr-sem-maquinas" role="status" style="margin-top:12px">Sem máquinas: conta como estando em todas, por isso outra com o mesmo tipo, referência e lote é recusada. <a class="ferr-cancel" href="#ferrEditar" id="ferr-sem-maquinas-editar">Acrescentar as máquinas</a></div>
      }

      @* SEM QUANTIDADE (Diogo, 20/10/2026: «nao pode ser optional pq da erro se
         nao tiver»): grava-se sem ela, mas nas Boquilhas a Fabricação da BQ
         fica por calcular; o link leva ao Editar. *@
      @if (tool.Type == ToolType.Bq && tool.BqAccountedQuantity is null)
      {
        <div class="ferr-aviso warn ferr-sem-quantidade" role="status" style="margin-top:12px">Sem quantidade do lote: nas Boquilhas, a Fabricação desta BQ não é calculada. <a class="ferr-cancel" href="#ferrEditar" id="ferr-sem-quantidade-editar">Acrescentar a quantidade</a></div>
      }

      @* À ESPERA DA UTILIZAÇÃO (o lembrete): aberto pela Entrada vinda da
         Produção ou pelo «Pedir a utilização ao SAP»; fecha-se com a leitura
         seguinte. O link leva às Definições, onde se lê a pasta do SAP. *@
      @if (Model.Utilizacao?.LembreteDesdeUtc is { } lembreteDesde)
      {
        <div class="ferr-aviso warn ferr-utilizacao-lembrete" role="status" id="ferrUtilizacaoLembrete" style="margin-top:12px">Utilização por atualizar desde @DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(lembreteDesde).ToString("dd/MM/yyyy", pt): vem na próxima leitura do SAP. <a class="ferr-cancel" href="@Url.Page("/Ferramentas/Definicoes")#ferrDefSap" id="ferr-utilizacao-ler">Ler a pasta do SAP</a></div>
      }

      @* O NOME TÉCNICO (o código do desenho do SAP) e o DECODE canónico
         (o Owner: «se introduzirmos o nome tecnico... apresenta logo
         tudo»): os factos que a gramática OP 99 revela — a proposta que
         o operador confirma. *@
      @if (tool.TechnicalName is { } technicalName)
      {
        var decoded = TechnicalNameParser.Decode(technicalName);
        <div style="margin-top:12px;padding:11px 13px;border-left:4px solid var(--dmo-brand-600,#3c73a8);background:var(--dmo-brand-050,#e8eff7);border-radius:8px">
          <strong style="overflow-wrap:anywhere">Nome técnico: @technicalName</strong>
          <div style="margin-top:6px;color:var(--dmo-muted);font-size:12.5px">
            @(decoded.Family)@(decoded.InferredType is { } inferred ? $" · tipo inferido {tokenOf(inferred)}" : null)@(decoded.InferredReference is { } inferredRef ? $" · referência {inferredRef}" : null)@(decoded.Dimension is { } dimension ? $" · {dimension}" : null)@(decoded.Process is { } process ? $" · {process}" : null)@(decoded.Ventilation is { } ventilation ? $" · ventilação {ventilation}" : null)
          </div>
        </div>
      }
    </section>

    @* AS PRODUÇÕES DA FERRAMENTA (Diogo, 21/10/2026: «associar um Job On
       ao uso por produção, o que produziu»): os Job On em que ela foi a CM,
       o MF ou a BQ e o que o relatório de fabrico do SAP diz que se produziu
       (a mesma referência, máquina e datas). Abre-se numa janela pequena
       com um clique no % da Utilização (Diogo: «a app seja uma web e não
       um caminho»: da produção vai-se à ficha do Job On). O quadro de detalhes (Diogo, 21/10/2026:
       «% uso, mas um box que mostra detalhes: o que fabricou naquela
       produção, o delta e o total»): o delta é quanto a utilização subiu
       nessa produção; o total soma todas as produções. *@
    @if (Model.Producoes is { } producoesTudo)
    {
      var producoesFerr = producoesTudo.Pagina;
      var pecasProd = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
      var leituraJanela = Model.Utilizacao?.Ultima;
      <dialog id="ferrProducoes" class="dmo-dialog ferr-producoes-janela" aria-labelledby="ferr-producoes-title" data-dmo-dialog-aberta="@(Model.ProducoesAbertas ? "1" : null)">
        <h3 id="ferr-producoes-title">Utilização por produção<partial name="_DmoHelp" model="@("Os Job On em que esta ferramenta foi a CM, o MF ou a BQ. O produzido é a produção bruta (o total, com que se calcula o uso) do relatório de fabrico do SAP (a mesma referência, máquina e datas). O delta é quanto a utilização subiu nessa produção. Um clique na produção abre a ficha do Job On.")" /></h3>
        @if (leituraJanela is not null)
        {
          <p class="ferr-nota" id="ferrProducoesHoje">Hoje <strong>@leituraJanela.Percentagem.ToString("0.##", pt) %</strong>@(leituraJanela is { Consumo: { } feitas, VidaPrevista: { } vida } ? $" · {feitas.ToString("#,0", pecasProd)} de {vida.ToString("#,0", pecasProd)} peças" : null) · @(leituraJanela.Origem == DMO.Alpha.Core.Tools.FerramentaUtilizacao.OrigemSap ? "SAP" : leituraJanela.Origem), @DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(leituraJanela.RegistadaEmUtc).ToString("dd/MM/yyyy", pt)</p>
        }
        @if (producoesFerr.TotalCount == 0)
        {
          <p class="ferr-nota" id="ferrProducoesVazio">Esta ferramenta ainda não esteve em nenhum Job On.</p>
        }
        else
        {
          <div class="dmo-table-wrap ferr-producoes-lista">
            <table class="dmo-table" data-dmo-list="Produções da ferramenta">
              <thead>
                <tr>
                  <th>Produção</th>
                  <th>Produzido</th>
                  <th>Delta</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var prod in producoesFerr.Items)
                {
                  <tr data-dmo-row data-id="@prod.JobOnId" data-dmo-open="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"
                      title="@prod.Maquina · @(prod.InicioEm?.ToString("dd/MM/yyyy") ?? "—") a @(prod.FimEm?.ToString("dd/MM/yyyy") ?? "em curso")"
                      aria-label="Produção @prod.Producao — um clique abre a ficha do Job On">
                    <td><a class="ferr-armazem-link" href="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"><strong>@prod.Producao</strong></a> <small class="ferr-producao-maquina">@prod.Maquina</small></td>
                    <td>@(prod.ProducaoBruta?.ToString("#,0", pecasProd) ?? "—")</td>
                    <td>@(prod.DeltaUtilizacao is { } delta ? (delta >= 0 ? "+" : "") + delta.ToString("0.##", pt) + " %" : "—")</td>
                  </tr>
                }
              </tbody>
              <tfoot id="ferrProducoesTotal">
                <tr>
                  <th scope="row">Total · @producoesFerr.TotalCount @(producoesFerr.TotalCount == 1 ? "produção" : "produções")</th>
                  <td><strong>@(producoesTudo.TotalBruta?.ToString("#,0", pecasProd) ?? "—")</strong></td>
                  <td><strong>@(leituraJanela is { } atual ? atual.Percentagem.ToString("0.##", pt) + " %" : "—")</strong></td>
                </tr>
              </tfoot>
            </table>
          </div>
          @if (producoesFerr.Items.Any(p => p.LinhasSap == 0))
          {
            <p class="ferr-nota" id="ferrProducoesSemSap" style="margin-top:8px">«—» no produzido: ainda não há o produzido dessa produção. <a class="ferr-cancel" href="@Url.Page("/Ferramentas/Definicoes")#ferrDefSap">Ler a pasta do SAP</a></p>
          }
        }
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button" data-dmo-dialog-close id="ferrProducoesFechar">Fechar</button>
        </div>
      </dialog>
      @* A janela abre com o foco no «Fechar», não na ajuda (que abriria o balão). *@
      <script>
        (function () {
          var janela = document.getElementById('ferrProducoes');
          if (!janela || !window.MutationObserver) { return; }
          new MutationObserver(function () {
            if (janela.open) { document.getElementById('ferrProducoesFechar').focus(); }
          }).observe(janela, { attributes: true, attributeFilter: ['open'] });
        })();
      </script>
    }

    @* ---------------------------------------------------------------- *@
    @* 2. Editar factos: full-replace no MESMO tool_id.                   *@
    @* ---------------------------------------------------------------- *@
    <section id="ferrEditar" class="dmo-card ferr-card" aria-labelledby="ferr-edit-facts-title" data-dmo-regiao data-dmo-parcial>
      @* O título e o «Guardar» ficam dentro do formulário: o botão é o mesmo
         botão de sempre (gravar sem recarregar, fila, foco no mesmo id). *@
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="EditFacts">
        <div class="dmo-card-topo">
          <h3 id="ferr-edit-facts-title">Editar</h3>
          <div class="dmo-card-topo-acoes">
            <button type="submit" class="dmo-button" id="ferr-edit-guardar">Guardar</button>
          </div>
        </div>
        <input type="hidden" name="tool_id" value="@tool.ToolId" />
        @* A versão aberta: se outra pessoa gravar entretanto, nada se grava por cima. *@
        <input type="hidden" name="versao" value="@tool.Version" />
        @* O regresso ao fluxo que abriu a ficha fica depois de guardar. *@
        @if (Model.ContinueUrl is { } regressoFactos)
        {
          <input type="hidden" name="continuar" value="@regressoFactos" />
        }
        @* Os mesmos campos do Criar (um só formulário de ferramenta, Diogo,
           20/10/2026), com o Nome técnico (SAP) também aqui. *@
        <partial name="_FerramentaFactos" model="@(new FerramentaFactosForm("ferr-edit", false, Model.FactsType(tool.Type), null,
            Model.FactsReference(tool.Reference), Model.FactsLot(tool.Lot), Model.FactsQuantity(tool.BqAccountedQuantity), null,
            Model.FactsMf(tool.AssociatedMfReference), Model.FactsTechnicalName(tool.TechnicalName), Model.Machines,
            id => Model.FactsMachine(id, tool.Machines.Any(m => m.MachineId == id))))" />
      </form>

    </section>

    @* ---------------------------------------------------------------- *@
    @* 3. TÉCNICA — os valores técnicos Tool-owned (o Owner 2026-10-12:   *@
    @*    «segundo tipo de informaçao da ferramenta é o tecnico, peso      *@
    @*    nominal gargalos, tampao etc»): a precisão REAL dos factos e    *@
    @*    os RÓTULOS HUMANOS da oficina — nunca nomes de coluna da BD     *@
    @*    (P2-9) — incl. o TAMPÃO (a geometria TP do desenho).            *@
    @* ---------------------------------------------------------------- *@
    @* Aberta ou fechada como o operador a deixou (data-dmo-fica): guardar o
       Editar não a fecha nem mexe no que lá está escrito. O título (a dica
       muda com o tipo) e o formulário são zonas. *@
    <section class="dmo-card ferr-card dmo-card-dobravel" aria-labelledby="ferr-tech-title" data-dmo-fica data-dmo-parcial>
      <details open="@Model.ShowTechnical">
      <summary id="ferrTecnicaTitulo" class="dmo-card-topo" data-dmo-regiao><h3 id="ferr-tech-title">Informação técnica<partial name="_DmoHelp" view-data="@(new ViewDataDictionary(ViewData) { ["EmSumario"] = true })" model="@((tool.Type == ToolType.Cm ? "Valores da CM e do tampão. No Job On, a calote da produção dá o volume desse controlo." : tool.Type == ToolType.Bq ? "Valores da boquilha. Os campos da CM não se aplicam a este tipo." : "Valores do molde final. Os campos da CM não se aplicam a este tipo.") + " Campo vazio limpa o valor.")" /></h3></summary>
      @{
          // Cada tipo só tem os seus campos (os valores ficam na linha do próprio tool_id):
          // CM → processo, peso nominal, punção, gargalo e tampão; BQ → marisa e gargalo; MF → gargalo.
          var tech = tool.Technical;
          var isCm = tool.Type == ToolType.Cm;
          var isBq = tool.Type == ToolType.Bq;
          // O volume do tampão é calculado (PesoCapCalculation.Cap, a fórmula do apoio TP/calote):
          // V = π·h·(3a² + h²)/6000 cm³, a = D/2. No Job On a calote da produção substitui esta.
          var volumeTampao = tech?.TpDiametroMm is { } tpD && tpD > 0m && tech.TpSagittaMm is { } tpH && tpH >= 0m
              ? DMO.Alpha.Core.Controlo.PesoCapCalculation.Cap(tpD, tpH).VolumeCm3
              : (decimal?)null;
      }

      <div id="ferrTecnica" data-dmo-regiao>
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="EditTechnical" id="ferr-tech-form">
        <input type="hidden" name="tool_id" value="@tool.ToolId" />
        <input type="hidden" name="versao" value="@tool.TechnicalVersion" />
        @if (Model.ContinueUrl is { } regresso)
        {
          <input type="hidden" name="continuar" value="@regresso" />
        }
        @* Os mesmos campos do Criar, só os do tipo desta ferramenta. *@
        <partial name="_FerramentaTecnica" model="@(new FerramentaTecnicaForm("ferr-tech", false, tokenOf(tool.Type),
            nome => nome == "process_token" ? Model.TechnicalProcessValue(tech?.Process) : Model.TechnicalValue(nome, nome switch
            {
                "nominal_weight" => tech?.NominalWeightGrams,
                "volume_puncao" => tech?.VolumePuncaoCm3,
                "volume_marisa" => tech?.VolumeMarisaCm3,
                "diametro_gargalo" => tech?.DiametroGargaloMm,
                "tp_diametro" => tech?.TpDiametroMm,
                "tp_sagitta" => tech?.TpSagittaMm,
                _ => null,
            }),
            Model.TechnicalInvalid, Model.TechnicalFocus,
            isCm ? (volumeTampao is { } vt ? vt.ToString("0.###", pt) : "—") : null))" />
      </form>
      </div>
      </details>
      @* O «Guardar» na linha do título, à direita (Diogo, 18/10/2026). Não vai
         dentro do <summary> (nada interativo lá dentro): fica a seguir ao
         <details>, sobre a linha do título (.dmo-card-dobravel), e grava o
         formulário da técnica pelo atributo form, aberta ou fechada, sem a
         abrir nem fechar. Fica fora das zonas: não muda ao gravar. *@
      <div class="dmo-card-topo-acoes">
        <button type="submit" class="dmo-button" id="ferr-tech-guardar" form="ferr-tech-form">Guardar</button>
      </div>
    </section>


  }

</main>
