@page "/Ferramentas/Ficha"
@model DMO.Alpha.Web.Pages.Ferramentas.FichaModel
@using DMO.Alpha.Core.Production
@using DMO.Alpha.Core.Tools
@{
    Layout = "_DmoShellLayout";
    var pt = DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture;
    // Ponto decimal canónico, precisão TOTAL dos factos
    // registados (28.84061800082953 nunca é arredondado na exibição).
    var fmt = new Func<decimal, string>(v => v.ToString(pt));
    var fmtOptional = new Func<decimal?, string>(v => v is null ? "—" : fmt(v.Value));
    // TechnicalValue uses the decimal-point convention and restores refused input.
    var tokenOf = new Func<ToolType, string>(FichaModel.TokenTypeFor);
    var sheet = Model.Sheet;
    var humanFacts = sheet is null ? "" : $"{tokenOf(sheet.Type)} · {sheet.Reference} · lote {sheet.Lot}";
    var machineCodes = sheet is null || sheet.Machines.Count == 0 ? "—" : string.Join(" · ", sheet.Machines.Select(m => m.Code));
}
@section Head {
<link rel="stylesheet" href="~/css/dmo-ferramenta-form.css" asp-append-version="true" />
<style>
/* O % da Utilização abre a janela das produções (Diogo, 21/10/2026). */
.ferr-utilizacao-abrir{all:unset;cursor:pointer;font-weight:800;color:var(--dmo-link,var(--dmo-brand-600));text-decoration:none}
.ferr-utilizacao-abrir:hover{color:var(--dmo-text)}
html body .dmo-table tbody tr[data-dmo-row]:hover :is(.ferr-utilizacao-abrir,.ferr-producao-maquina){color:#fff}
.ferr-utilizacao-abrir:focus-visible{outline:2px solid var(--dmo-focus-ring);outline-offset:2px}
/* As janelas da Utilização e do Peso abrem como painel deslizante pela direita (Diogo,
   27/10/2026: «abre um slide»), com o aspeto da estrutura dos painéis (dmo-estrutura.css):
   título em cima, «Fechar» no canto superior direito, só a lista desliza. */
html body dialog.dmo-dialog.ferr-producoes-janela{position:fixed;inset:0 0 0 auto;margin:0;box-sizing:border-box;width:min(640px,calc(100vw - 48px));max-width:none;height:100dvh;max-height:none;padding:0;border:0;border-left:1px solid var(--dmo-border);border-radius:0;box-shadow:none;background:var(--dmo-card);color:var(--dmo-text);overflow:hidden;transition:transform .22s ease}
html body dialog.dmo-dialog.ferr-producoes-janela[open]{display:flex;flex-direction:column;gap:12px}
@@starting-style{html body dialog.dmo-dialog.ferr-producoes-janela[open]{transform:translateX(100%)}}
html body dialog.dmo-dialog.ferr-producoes-janela::backdrop{background:var(--dmo-painel-fundo,rgba(11,19,32,.24))}
html body dialog.ferr-producoes-janela>h3{flex:0 0 auto;margin:0;padding:12px 20px;min-height:calc(var(--dmo-control-height,34px) + 24px);box-sizing:border-box;display:flex;align-items:center;padding-right:300px;border-bottom:1px solid var(--dmo-border);font-size:17px;font-weight:650;line-height:1.25}
html body dialog.ferr-producoes-janela>.dmo-dialog-actions{position:absolute;top:12px;right:20px;margin:0;display:flex;align-items:center;gap:12px}
html body dialog.ferr-producoes-janela>:not(h3,.dmo-dialog-actions){margin-left:20px;margin-right:20px}
html body dialog.ferr-producoes-janela .ferr-nota{margin-top:0;margin-bottom:0}
html body dialog.ferr-producoes-janela [data-ferr-peso-lugar]{min-height:0;overflow:auto}
html body dialog.ferr-producoes-janela .ferr-producoes-lista{flex:0 1 auto;min-height:0;max-height:none;overflow:auto}
@@media (prefers-reduced-motion:reduce){html body dialog.dmo-dialog.ferr-producoes-janela{transition:none}}
.ferr-producoes-janela .dmo-table{min-width:0}
.ferr-producao-maquina{color:var(--dmo-muted);font-size:12px}
.ferr-armazem-link{color:var(--dmo-brand-900);font-weight:600}
.ferr-page{max-width:1240px;margin:0 auto;padding:24px 22px 40px;display:grid;gap:16px}
.ferr-page .page-head h2{margin:0;font-size:23px;color:var(--dmo-brand-700,#193046)}
.ferr-page .page-head p{margin:4px 0 0;color:var(--dmo-muted)}
.ferr-card .dmo-card-topo-acoes .dmo-options-list{left:auto;right:0}
#ferr-delete-dialog .dmo-aviso-discreto{margin:8px 0 22px}
.ferr-card{padding:18px}
.ferr-card h3{margin:0;font-size:16px}
/* A linha do título com os botões do card (.dmo-card-topo, canto superior direito). */
.ferr-card .dmo-card-topo{margin-bottom:12px}
.ferr-card details:not([open])>summary.dmo-card-topo{margin-bottom:0}
.ferr-card .dmo-facts{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}
.ferr-card .card-note{margin:3px 0 14px;color:var(--dmo-muted);font-size:12.5px}
.ferr-aviso{padding:11px 13px;border-left:4px solid var(--dmo-danger,#9a625d);background:var(--dmo-danger-soft);border-radius:8px}
/* O aviso âmbar (o mesmo de .jobon-aviso.warn / .peg-aviso.warn): o trabalho foi gravado, o aviso diz o que ficou de fora. */
.ferr-aviso.warn{border-left-color:var(--dmo-warning);background:var(--dmo-warning-soft)}
.ferr-nota{padding:11px 13px;border-left:4px solid var(--dmo-ok);background:var(--dmo-ok-soft);border-radius:8px}
.ferr-nota.avisoria{border-left-color:var(--dmo-warning);background:var(--dmo-warning-soft)}
.ferr-hint{color:var(--dmo-muted);font-size:11.5px;margin:10px 0 0}
.ferr-vazia{padding:38px 20px;text-align:center;color:var(--dmo-muted);border:1px dashed var(--dmo-border,#d9e6f2);border-radius:12px}
.ferr-subtitle{margin:20px 0 8px;padding-top:16px;border-top:1px solid var(--dmo-border);font-size:14px}
.ferr-danger{background:var(--dmo-danger,#9a625d)}
.ferr-danger:hover{background:color-mix(in srgb,var(--dmo-danger) 80%,#000)}
.ferr-link-botao{all:unset;cursor:pointer;margin-right:auto}
.ferr-link-botao:hover{color:var(--dmo-text)}
.ferr-link-botao:focus-visible{outline:2px solid var(--dmo-focus-ring);outline-offset:2px}
.ferr-cancel{font-size:12.5px;color:var(--dmo-brand-600,#3c73a8);font-weight:700}
/* No painel de apoio a regra «.dmo-workspace» do dmo-design.css (padding 16px 18px 24px) ganhava à da estrutura e
   deixava uma faixa de 18 px à direita e à esquerda: o espaço é o do corpo (20 px), o <main> fica sem margem. */
html[data-dmo-embedded="true"] body main.ferr-page:has(>.dmo-pagina-topo){padding:0}
/* O «← Voltar» está no cabeçalho fixo (<dmo-voltar>); o botão do cartão Geral fica escondido. */
html body main.ferr-page #ferrVoltar{display:none}
/* A Informação opcional na mesma linha de Tipo, Referência, Lote, Qtd. lote e % uso. */
html body main.ferr-page #ferrEditar .ferr-editar-linha{flex-wrap:nowrap;align-items:flex-end}
html body main.ferr-page #ferrEditar .ferr-editar-linha>.ferr-editar-principal{flex:0 0 auto}
html body main.ferr-page #ferrEditar .ferr-editar-linha>.ferr-opcional{flex:0 1 auto;margin:0;padding:0 0 0 24px;border-top:0;border-left:1px solid var(--dmo-border)}
html body main.ferr-page #ferrEditar .ferr-editar-linha>.ferr-opcional>.ferr-tech-campos{flex-wrap:nowrap}
/* O título «Informação opcional» sobe para o espaço livre à direita das linhas, por cima dos campos. */
html body main.ferr-page #ferrEditar .ferr-opcional{position:relative}
html body main.ferr-page #ferrEditar .ferr-opcional>legend{position:absolute;top:-24px;left:24px;margin:0}
html body main.ferr-page #ferrTecnica .ferr-tech-titulo{margin-bottom:4px}
</style>
}

@* GRAVAR SEM RECARREGAR (Diogo, 17/10/2026: «atualizar só o que muda»):
   guardar o Editar ou a Informação técnica troca só as zonas
   (data-dmo-regiao) que mudaram: a secção guardada, as mensagens e o que
   mostra os factos. A outra secção fica como o operador a deixou, com o que
   lá estiver escrito; a Informação técnica fica aberta ou fechada como
   estava (data-dmo-fica). Mudar o tipo, a referência ou o lote abre a
   página inteira: o nome da ferramenta também está na pergunta de
   eliminar, fora das zonas (as «Opções» estão no Geral, uma zona). Duplicar e eliminar abrem outra
   página, como sempre; gravam pela fila da página (um clique repetido não
   grava duas vezes). Ver docs/ui-reference/atualizar-so-o-que-muda.md. *@
<dmo-pagina titulo="Ficha de ferramenta" titulo-id="ferr-title" class="ferr-page dmo-workspace" aria-labelledby="ferr-title" data-dmo-troca>

  @* OS BOTÕES NO CANTO SUPERIOR DIREITO DE CADA CARD (Diogo, 18/10/2026:
     «metem os botões em baixo aumenta espaço, sempre canto superior direito
     dentro dos cards»): o «Opções» e o «Voltar à lista» saíram daqui para o
     primeiro card da ficha; os «Guardar» estão na linha do título do card. *@
  @* «← Voltar» discreto por cima do título, como nas outras páginas (Diogo, 27/10/2026). O destino é o
     do botão «Voltar» do cartão Geral (que fica escondido, é o que os leitores e os testes conhecem). *@
  @if (sheet is not null)
  {
    <dmo-voltar><a class="dmo-voltar-texto" id="ferrVoltarTexto" href="@(Model.VoltarJobOn ?? Url.Page("/Ferramentas/Index"))" data-dmo-voltar="@sheet.ToolId" data-dmo-voltar-ignorar="/Ferramentas/Ficha /Ferramentas/Historico"><span>Voltar</span></a></dmo-voltar>
  }
  @* O título passou para o cabeçalho fixo da estrutura (<dmo-pagina titulo=…>, o h1). O cabeçalho antigo
     fica escondido, só para o teste que o procura (FerramentasFichaTrocaTests); não aparece nem se lê. *@
  <div hidden><div class="page-head">
    <div>
      <h2 id="ferr-title">Ficha de ferramenta</h2>
    </div>
  </div></div>

  @if (sheet is not null)
  {
    @* CLIQUES REPETIDOS (deep sweep, 18/10/2026, B-ferramentas-3): o
       «Duplicar» grava pela fila da página (data-dmo-parcial). Um segundo
       clique igual, enquanto o primeiro não respondeu, não sai, e a ficha
       nova abre com «Ferramenta registada.» em vez do aviso «O lote já
       estava registado». A resposta abre sempre a página inteira, como
       antes: a ficha de outra ferramenta muda fora das zonas (a pergunta de
       eliminar tem o nome dela); a desta mesma ficha (o lote novo é o desta
       ferramenta) troca a zona da janela, que é uma janela que pode abrir
       com a página (data-dmo-dialog-aberta), e essa só vem com a página
       inteira. Sem a zona (dmo-zona, sem caixa), a resposta desta ficha
       trocava só os avisos e a janela ficava aberta por cima. *@
    <div id="ferrDuplicar" class="dmo-zona" data-dmo-regiao>
    <dialog id="ferr-duplicate-dialog" class="dmo-dialog" aria-labelledby="ferr-duplicate-title" data-dmo-dialog-aberta="@(Model.DuplicateRefusal is not null ? "1" : null)">
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="Duplicate" data-dmo-parcial>
        @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
        <h3 id="ferr-duplicate-title" title="Cria uma ferramenta nova com os mesmos dados e o lote indicado. Esta ferramenta fica como está.">Duplicar para lote novo</h3>
        @if (Model.DuplicateRefusal is not null)
        {
          <div class="ferr-aviso" role="alert">@Model.DuplicateRefusalMessage@if (Model.ExistingToolId is { } existenteLote)
          {<text> </text><a class="dmo-aviso-link" href="@Url.Page("/Ferramentas/Ficha", new { tool_id = existenteLote })">Abrir a ferramenta existente</a>}</div>
        }
        <input type="hidden" name="tool_id" value="@sheet.ToolId" />
        <div class="dmo-field">
          <label for="ferr-new-lot">Lote novo</label>
          <input id="ferr-new-lot" name="new_lot" required placeholder="Ex.: 4" />
        </div>
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
          <button type="submit" class="dmo-button">Duplicar</button>
        </div>
      </form>
    </dialog>
    </div>
  }

  @if (sheet is not null)
  {
    @* Só um aviso curto antes de eliminar (Diogo, 17/10/2026: «não precisa
       desta informação toda, basta um warning se quer mesmo eliminar»).
       CLIQUES REPETIDOS (deep sweep, 18/10/2026, B-ferramentas-4): o
       «Eliminar» grava pela fila da página (data-dmo-parcial). Um segundo
       clique igual, enquanto o primeiro não respondeu, não sai: a lista abre
       com «Ferramenta eliminada…», em vez de o segundo pedido já não
       encontrar a ferramenta e dizer «Nenhuma eliminação foi feita». A
       lista é outra página: abre-se inteira, como antes. *@
    @* O «Código SAP» (DMO-586): o que o script procura na ZPPG, quando não é o que a tabela do Admin › SAP dá. *@
    <dialog id="ferr-codigo-sap-dialog" class="dmo-dialog" aria-labelledby="ferr-codigo-sap-title">
      <h3 id="ferr-codigo-sap-title">Código SAP</h3>
      <p class="dmo-aviso-discreto">O script procura <strong id="ferrCodigoSapAtual">@(Model.CodigoSap.Codigo ?? "nada (falta o nome técnico ou o lote)")</strong>@(Model.CodigoSap.AMao is null ? " (da tabela do Admin › SAP)" : " (escrito aqui)"). Escreva outro para esta ferramenta, ou deixe vazio para usar a tabela.</p>
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="CodigoSap" data-dmo-parcial>
        <input type="hidden" name="tool_id" value="@sheet.ToolId" />
        <input type="text" name="codigo_sap" class="dmo-input" value="@Model.CodigoSap.AMao" maxlength="64" size="24" autocomplete="off" aria-label="Código SAP" />
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
          <button type="submit" class="dmo-button">Guardar</button>
        </div>
      </form>
    </dialog>
    <dialog id="ferr-delete-dialog" class="dmo-dialog" aria-labelledby="ferr-delete-title" data-dmo-dialog-aberta="@(Model.ConfirmDelete ? "1" : null)">
      <h3 id="ferr-delete-title">Eliminar ferramenta</h3>
      <p class="dmo-aviso-discreto">Quer mesmo eliminar @humanFacts?</p>
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="Delete" data-dmo-parcial>
        <input type="hidden" name="tool_id" value="@sheet.ToolId" />
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
          <button type="submit" class="dmo-button ferr-danger">Eliminar</button>
        </div>
      </form>
    </dialog>
  }

  @* ------------------------------------------------------------------ *@
  @* 0. Sem ferramenta: a ficha resolve-se pelo tool_id — nada é       *@
  @*    inventado.                                                       *@
  @* ------------------------------------------------------------------ *@
  @if (sheet is null && Model.RequestedToolId is null)
  {
    <section class="dmo-card ferr-card" aria-labelledby="ferr-empty-title">
      <div class="dmo-card-topo">
        <h3 id="ferr-empty-title">Ficha de ferramenta</h3>
        <div class="dmo-card-topo-acoes">
          <a class="dmo-button" href="@Url.Page("/Ferramentas/Index")">Voltar</a>
        </div>
      </div>
      <div class="ferr-vazia">Nenhuma ferramenta selecionada. Abra a lista do Ferramentas e escolha a ficha pelo nome — tipo, referência e lote.</div>
    </section>
  }
  else if (sheet is null)
  {
    <section class="dmo-card ferr-card" aria-labelledby="ferr-missing-title">
      <div class="dmo-card-topo">
        <h3 id="ferr-missing-title">Ficha de ferramenta</h3>
        <div class="dmo-card-topo-acoes">
          <a class="dmo-button" href="@Url.Page("/Ferramentas/Index")">Voltar</a>
        </div>
      </div>
      <div class="ferr-aviso" role="alert">A ferramenta indicada não existe no registo. Nenhuma ficha foi aberta e nenhuma ferramenta foi inventada.</div>
      @if (Model.DeleteRefusal is not null)
      {
        <div data-dmo-toast="erro" class="ferr-aviso" role="alert" style="margin-top:10px">@Model.DeleteRefusalMessage</div>
      }
    </section>
  }

  @if (sheet is { } tool)
  {
    @* As mensagens: uma zona sem caixa (dmo-zona), a grelha da página fica
       como estava. A confirmação de guardar vai para o canto. *@
    <div id="ferrAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.CreatedNote)
    {
      @* Sem aviso de «formato canónico» (Diogo, 17/10/2026: um CM pode ter
         referências próprias como ST100 ou ST62; a ligação à referência MF
         faz-se pela «Ref. MF associada»). *@
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Ferramenta registada.</div>
    }
    else if (Model.ExistedNote)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Esta ferramenta já estava registada (mesmos tipo, referência e lote) — nada foi duplicado; as máquinas indicadas foram acrescentadas às ligações dela.</div>
    }

    @if (Model.EntradaArmazem is { } posicaoArmazem)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status" id="ferrEntradaArmazem">Lote novo do Armazém resolvido: a entrada ficou registada na posição @posicaoArmazem.</div>
    }
    @foreach (var avisoArmazem in Model.AvisosArmazem)
    {
      <p class="dmo-aviso warn" data-dmo-aviso>@avisoArmazem</p>
    }

    @if (Model.SavedSection == FichaModel.SavedGeneral)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Dados gerais guardados.</div>
    }
    else if (Model.SavedSection == FichaModel.SavedTechnical)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Informação técnica guardada.</div>
    }
    else if (Model.SavedSection == FichaModel.SavedDuplicateWarningCleared)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status">Aviso de ferramenta repetida limpo.</div>
    }
    else if (Model.SavedSection == FichaModel.SavedCodigoSap)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status" id="ferrCodigoSapGuardado">Código SAP guardado.</div>
    }
    else if (Model.SavedSection == FichaModel.SavedUtilizacaoPedida)
    {
      <div data-dmo-toast="ok" class="ferr-nota" role="status" id="ferrUtilizacaoPedida">Utilização pedida à produção: vem na próxima leitura.</div>
    }

    @* Avisos (beta.63, regra do Owner «tentar sempre warning»): o trabalho
       foi gravado; o aviso âmbar diz o que ficou de fora. Vão para o canto,
       como as outras mensagens (beta.199, Diogo, 17/10/2026: «os elementos
       têm de ficar fixos»): na grelha empurravam os cartões 56 a 77 px.
       Ficam até se fecharem no × ou até à gravação seguinte do mesmo cartão. *@
    @if (Model.LotDefaultedWarning)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.LotDefaultedMessage</div>
    }

    @if (Model.UsoAvisoMessage is { } usoAvisoTexto)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status" id="ferrUsoAviso">@usoAvisoTexto</div>
    }

    @if (Model.UnreadableQuantity is not null)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.UnreadableQuantityMessage</div>
    }

    @* O tipo de uma ferramenta já usada mudou (sweep de 19/10/2026, F-1):
       gravou-se, e o link leva ao Editar para voltar ao tipo anterior. *@
    @if (Model.TypeChangedWarning is { } tipoMudou)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@tipoMudou<partial name="_DmoAvisoLink" model="@(new DMO.Alpha.Web.Pages.Shared.DmoAvisoLink("Corrigir em Editar", "#ferrEditar"))" /></div>
    }

    @if (Model.DuplicateExistedWarning)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">O lote «@tool.Lot» já estava registado para esta referência: abriu-se a ferramenta existente. Nada foi duplicado nem alterado.</div>
    }

    @if (Model.UnreadableTechnical.Count > 0)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.UnreadableTechnicalMessage</div>
    }

    @if (Model.ImpossibleTechnical.Count > 0)
    {
      <div data-dmo-toast="aviso" class="ferr-aviso warn" role="status">@Model.ImpossibleTechnicalMessage</div>
    }

    @if (Model.ContinueUrl is { } continueUrl)
    {
      <p class="ferr-hint" style="margin:0"><a class="ferr-cancel" href="@continueUrl">Continuar no fluxo que abriu o Ferramentas</a></p>
    }

    @if (Model.FactsRefusal is not null)
    {
      <div data-dmo-toast="erro" class="ferr-aviso" role="alert">@Model.FactsRefusalMessage @if (Model.ExistingToolId is { } existingId)
      {<a class="dmo-aviso-link" href="@Url.Page("/Ferramentas/Ficha", new { tool_id = existingId })">Abrir a ferramenta existente</a>}</div>
    }

    @if (Model.TechnicalRefusal is not null)
    {
      <div data-dmo-toast="erro" class="ferr-aviso" role="alert">@Model.TechnicalRefusalMessage</div>
    }
    </div>

    @* ---------------------------------------------------------------- *@
    @* 1. GERAL — os factos humanos do registo (o Owner 2026-10-12:      *@
    @*    «ficha tecnica da ferramenta deve ter 2 tipos de informaçao, o   *@
    @*    geral Tipo CM MF BQ etc, referencia lote e maquinas em que pode *@
    @*    trabalhar, sendo que certas referencias podem trabalhar em mais *@
    @*    que uma maquina»): o Tipo, a referência, o lote, AS MÁQUINAS    *@
    @*    (o link n-n — todas as que a ficha ligar).                      *@
    @* ---------------------------------------------------------------- *@
    @* FERRAMENTA REPETIDA (o proprietário, 18/10/2026): alguém tentou
       registar outra com o mesmo tipo, referência e lote e foi recusado. A
       errada pode ser esta: quem confirmar que está certa limpa o aviso (o
       botão grava sem recarregar; a zona fica vazia). *@
    <div id="ferrRepetida" class="dmo-zona" data-dmo-regiao>
    @if (tool.DuplicateWarningAtUtc is { } avisoEm)
    {
      <section class="dmo-card ferr-card" aria-labelledby="ferr-repetida-title" data-dmo-parcial>
        <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="ClearDuplicateWarning">
          <input type="hidden" name="tool_id" value="@tool.ToolId" />
          <div class="dmo-card-topo">
            <h3 id="ferr-repetida-title">Possível ferramenta repetida</h3>
            <div class="dmo-card-topo-acoes">
              <button type="submit" class="dmo-button" id="ferr-repetida-limpar">Limpar aviso</button>
            </div>
          </div>
          <div class="ferr-aviso warn ferr-repetida-texto" role="status">Em @FichaModel.FormatWarningMoment(avisoEm), @(tool.DuplicateWarningBy ?? "alguém") tentou registar outra ferramenta @humanFacts, e não foi registada. A errada pode ser esta: confirme o tipo, a referência, o lote e as máquinas. Se estiver certa, limpe o aviso; se não, corrija-a em Editar.</div>
        </form>
      </section>
    }
    </div>

    <section id="ferrGeral" class="dmo-card ferr-card" aria-labelledby="ferr-facts-title" data-dmo-regiao>
      <div class="dmo-card-topo">
        @* SEM REPETIR O TÍTULO (Diogo, 26/10/2026: «tínhamos decidido retirar
           estes porque repete a informação de cima»): o tipo, a referência e o
           lote ficam só aqui; a cor leve dos 100% de uso também. *@
        @{ var usoCheio = DMO.Alpha.Web.Presentation.UsoCheio.ClasseDe(Model.Utilizacao?.Ultima?.Percentagem); }
        @if (usoCheio is null)
        {
          <h3 id="ferr-facts-title">Geral — @humanFacts</h3>
        }
        else
        {
          <h3 id="ferr-facts-title">Geral — <span class="@usoCheio">@humanFacts</span></h3>
        }
        <div class="dmo-card-topo-acoes">
          @* AÇÕES RARAS NO «OPÇÕES» (Diogo, 17/10/2026: «criar opções pode ir
             para topo lado direito, e nas opções meter o duplicar e eliminar»):
             cada uma abre numa janela pequena (as janelas ficam fora das zonas;
             os botões que as abrem ligam-se por delegação). *@
          @* O HISTÓRICO (Diogo, 22/10/2026): os Job On desta ferramenta numa página própria, nada na ficha. *@
          <a class="dmo-button" id="ferrHistorico" href="@Url.Page("/Ferramentas/Historico", new { tool_id = tool.ToolId })">Histórico</a>
          <details class="dmo-options" data-dmo-tab-menu>
            <summary class="dmo-button" aria-label="Opções da ferramenta @humanFacts"><span class="dmo-caret" aria-hidden="true"></span>Opções</summary>
            <div class="dmo-options-list" id="ferrOpcoes">
              @* Só «Duplicar» e «Eliminar», sem repetir «ferramenta» (Diogo, 28/10/2026: «já sabemos que é a ferramenta»); Eliminar em último. *@
              @* «Atualizar informação do SAP» (Diogo, 28/10/2026): abre o lembrete, como a Entrada
                 vinda da Produção (só um aberto de cada vez). *@
              @if (Model.Utilizacao?.LembreteDesdeUtc is null)
              {
              <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="PedirUtilizacao" id="ferr-pedir-utilizacao">
                <input type="hidden" name="tool_id" value="@tool.ToolId" />
                <button type="submit" class="dmo-options-item" id="ferr-pedir-utilizacao-botao">Atualizar informação do SAP</button>
              </form>
              }
              <button type="button" class="dmo-options-item" data-dmo-dialog="ferr-codigo-sap-dialog">Código SAP</button>
              <button type="button" class="dmo-options-item" data-dmo-dialog="ferr-duplicate-dialog">Duplicar</button>
              <button type="button" class="dmo-options-item" data-dmo-dialog="ferr-delete-dialog">Eliminar</button>
            </div>
          </details>
          @* UM SÓ «VOLTAR» (Diogo, 26/10/2026: «o voltar depende da página»):
             volta à página de onde se veio, com os filtros; sem origem
             conhecida, à folha do Job On de onde se abriu ou à lista. O
             Histórico da ficha não conta como origem. *@
          @if (Model.VoltarJobOn is { } voltarJobOn)
          {
            <a class="dmo-button" id="ferrVoltar" href="@voltarJobOn" data-ferr-voltar-jobon data-dmo-voltar="@tool.ToolId" data-dmo-voltar-ignorar="/Ferramentas/Ficha /Ferramentas/Historico" data-dmo-voltar-texto="Voltar">Voltar</a>
          }
          else
          {
            <a class="dmo-button" id="ferrVoltar" href="@Url.Page("/Ferramentas/Index")" data-dmo-voltar="@tool.ToolId" data-dmo-voltar-ignorar="/Ferramentas/Ficha /Ferramentas/Historico" data-dmo-voltar-texto="Voltar">Voltar</a>
          }
        </div>
      </div>
      <div class="dmo-facts">
        <div class="dmo-fact"><span>Linhas</span><strong>@machineCodes</strong></div>
        @* Só a CM com uma referência diferente da do MF (Diogo, 21/10/2026). *@
        @if (tool.Type == ToolType.Cm && !string.IsNullOrWhiteSpace(tool.AssociatedMfReference)
            && !string.Equals(tool.AssociatedMfReference.Trim(), tool.Reference.Trim(), StringComparison.OrdinalIgnoreCase))
        {
          <div class="dmo-fact"><span>Referência MF associada</span><strong>@tool.AssociatedMfReference</strong></div>
        }
        @* Com AN (Diogo, 28/10/2026): «24 BQ · 24 AN». *@
        <div class="dmo-fact"><span>Quantidade</span><strong>@(tool.BqAccountedQuantity?.ToString(pt) ?? "—")@(tool.AnQuantity is int anFicha ? $" BQ · {anFicha.ToString(pt)} AN" : null)</strong></div>
        @* A POSIÇÃO E O ESTADO (Diogo, 22/10/2026): do Armazém, a todos; «—» sem registo. *@
        <div class="dmo-fact" id="ferrPosicao"><span>Posição</span><strong>@(Model.Armazem?.Posicao ?? "—")</strong></div>
        @{ var estadoTexto = Model.Armazem?.Estado is { } estadoFicha ? DMO.Alpha.Core.Armazem.ArmazemTextos.Estado(estadoFicha) : "—"; }
        <div class="dmo-fact" id="ferrEstadoArmazem"><span>Estado</span><strong>@if (Model.ArmazemGestao && Model.Armazem is { } armEstado)
        {<a class="ferr-armazem-link" href="@Url.Page("/Armazem/Movimentos", new { ferramenta = armEstado.ToolId })">@estadoTexto</a>}
        else
        {@estadoTexto}</strong></div>
        @if (Model.ArmazemGestao && Model.Armazem is { } arm)
        {
          @* Onde está e o estado, pelo Armazém (só a quem tem o Armazém). *@
          <div class="dmo-fact" id="ferrLocalizacao"><span>Localização</span><strong data-dmo-localizacao><a class="ferr-armazem-link" href="@Url.Page("/Armazem/Movimentos", new { ferramenta = arm.ToolId })">@arm.OndeEsta</a></strong></div>
          <div class="dmo-fact"><span>Movimentos</span><strong><a class="ferr-armazem-link" id="ferrHistoricoArmazem" href="@Url.Page("/Armazem/Ultimos", new { ferramenta = arm.ToolId })">Ver os movimentos</a></strong></div>
        }
        @if (Model.Utilizacao is { Ultima: not null } or { LembreteDesdeUtc: not null } || Model.Producoes is { Pagina.TotalCount: > 0 })
        {
          @* A UTILIZAÇÃO (blueprint ferramentas/ESTADO-E-UTILIZACAO §2.2): a
             última leitura, de onde veio e quando; o SAP dá também as peças
             feitas e as previstas. O lembrete aberto diz que está à espera. *@
          var leituraUtil = Model.Utilizacao?.Ultima;
          @* Só o % de uso, o que mais importa (Diogo, 21/10/2026); um clique
             abre a janela com as produções, o produzido e o delta. *@
          <div class="dmo-fact" id="ferrUtilizacao"><span>Utilização</span><button type="button" class="ferr-utilizacao-abrir" id="ferr-utilizacao-detalhes" data-dmo-dialog="ferrProducoes" aria-label="Utilização por produção">@(leituraUtil is null ? "—" : leituraUtil.Percentagem.ToString("0.##", pt) + " %")</button></div>
        }
      </div>

      @* SEM MÁQUINAS (Diogo, 19/10/2026: «essa regra pode ficar aplicada a de
         todas as maquinas mas acrescentar um aviso com link que envia para a
         pagina onde pode ser alterado»): sem máquinas, a ferramenta conta em
         todas para a ferramenta repetida; o link leva ao Editar. *@
      @if (tool.Machines.Count == 0)
      {
        <div class="ferr-aviso warn ferr-sem-maquinas" role="status">Sem máquinas: conta como estando em todas, por isso outra com o mesmo tipo, referência e lote é recusada. <a class="ferr-cancel" href="#ferrEditar" id="ferr-sem-maquinas-editar">Acrescentar as máquinas</a></div>
      }

      @* SEM QUANTIDADE (Diogo, 20/10/2026: «nao pode ser optional pq da erro se
         nao tiver»): grava-se sem ela, mas nas Boquilhas a Fabricação da BQ
         fica por calcular; o link leva ao Editar. *@
      @if (tool.Type == ToolType.Bq && tool.BqAccountedQuantity is null)
      {
        <div class="ferr-aviso warn ferr-sem-quantidade" role="status">Sem quantidade do lote: nas Boquilhas, a Fabricação desta BQ não é calculada. <a class="ferr-cancel" href="#ferrEditar" id="ferr-sem-quantidade-editar">Acrescentar a quantidade</a></div>
      }

      @* À ESPERA DA UTILIZAÇÃO (o lembrete): aberto pela Entrada vinda da
         Produção ou pelo «Pedir a utilização ao SAP»; fecha-se com a leitura
         seguinte. O link leva às Definições, onde se lê a pasta do SAP. *@
      @if (Model.Utilizacao?.LembreteDesdeUtc is { } lembreteDesde)
      {
        <div class="ferr-aviso warn ferr-utilizacao-lembrete" role="status" id="ferrUtilizacaoLembrete">Utilização por atualizar desde @DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(lembreteDesde).ToString("dd/MM/yyyy", pt): vem na próxima leitura da produção. <a class="ferr-cancel" href="/Definicoes?secao=computador" id="ferr-utilizacao-ler">Ler a pasta da produção</a></div>
      }

      @* O NOME TÉCNICO (o código do desenho do SAP) e o DECODE canónico
         (o Owner: «se introduzirmos o nome tecnico... apresenta logo
         tudo»): os factos que a gramática OP 99 revela — a proposta que
         o operador confirma. *@
      @if (tool.TechnicalName is { } technicalName)
      {
        var decoded = TechnicalNameParser.Decode(technicalName);
        <div class="ferr-nome-tecnico">
          <strong>Nome técnico: @technicalName</strong>
          <div class="ferr-nome-tecnico-decode">
            @(decoded.Family == "desconhecido" ? null : decoded.Family)@(decoded.InferredType is { } inferred ? $" · tipo inferido {tokenOf(inferred)}" : null)@(decoded.InferredReference is { } inferredRef ? $" · referência {inferredRef}" : null)@(decoded.Dimension is { } dimension ? $" · {dimension}" : null)@(decoded.Process is { } process ? $" · {process}" : null)@(decoded.Ventilation is { } ventilation ? $" · ventilação {ventilation}" : null)
          </div>
          @if (TechnicalNameParser.Aviso(tool.Type, technicalName) is { } avisoNome)
          {
            <p class="ferr-aviso warn" id="ferrNomeTecnicoAviso" role="status">@avisoNome</p>
          }
        </div>
      }
    </section>

    @* AS PRODUÇÕES DA FERRAMENTA (Diogo, 21/10/2026: «associar um Job On
       ao uso por produção, o que produziu»): os Job On em que ela foi a CM,
       o MF ou a BQ e o que o relatório de fabrico do SAP diz que se produziu
       (a mesma referência, máquina e datas). Abre-se numa janela pequena
       com um clique no % da Utilização (Diogo: «a app seja uma web e não
       um caminho»: da produção vai-se à ficha do Job On). O quadro de detalhes (Diogo, 21/10/2026:
       «% uso, mas um box que mostra detalhes: o que fabricou naquela
       produção, o delta e o total»): o delta é quanto a utilização subiu
       nessa produção; o total soma todas as produções. *@
    @if (Model.Producoes is { } producoesTudo)
    {
      var leituraJanela = Model.Utilizacao?.Ultima;
      <dialog id="ferrProducoes" class="dmo-dialog ferr-producoes-janela" aria-labelledby="ferr-producoes-title" data-dmo-dialog-aberta="@(Model.ProducoesAbertas ? "1" : null)">
        <h3 id="ferr-producoes-title" title="Os Job On em que esta ferramenta foi a CM, o MF ou a BQ. O produzido é a produção bruta (o total, com que se calcula o uso) do relatório de fabrico da produção (a mesma referência, máquina e datas). O delta é quanto a utilização subiu nessa produção. Um clique na produção abre a ficha do Job On.">Utilização por produção</h3>
        <partial name="_UtilizacaoProducoes" model="new DMO.Alpha.Web.Presentation.UtilizacaoProducoesView(producoesTudo, leituraJanela)" />
        <div class="dmo-dialog-actions">
          <button type="button" class="ferr-cancel ferr-link-botao" id="ferrProducoesHistorico" aria-controls="ferrHistoricoProducoes">Ver o Histórico de produções</button>
          <button type="button" class="dmo-button" data-dmo-dialog-close id="ferrProducoesFechar">Fechar</button>
        </div>
      </dialog>
      @* A janela abre com o foco no «Fechar», não na ajuda (que abriria o balão). *@
      @* O % da Utilização leva também ao Histórico de produções (Diogo,
         27/10/2026): abre-o e desce até ele por trás da janela; ao fechar a
         janela fica-se lá. O «Ver o Histórico de produções» fecha a janela. *@
      <script>
        (function () {
          function abrirHistorico() {
            var historico = document.getElementById('ferrHistoricoProducoes');
            if (!historico) { return; }
            var dobra = historico.querySelector('details');
            if (dobra) { dobra.open = true; }
            historico.scrollIntoView({ block: 'start' });
          }
          document.addEventListener('click', function (event) {
            if (event.target.closest && event.target.closest('#ferr-utilizacao-detalhes, #ferrProducoesHistorico')) { abrirHistorico(); }
            if (event.target.closest && event.target.closest('#ferrProducoesHistorico')) {
              var janela = document.getElementById('ferrProducoes');
              if (janela && janela.open) { janela.close(); }
              abrirHistorico();
            }
          });
        })();
        (function () {
          var janela = document.getElementById('ferrProducoes');
          if (!janela || !window.MutationObserver) { return; }
          new MutationObserver(function () {
            if (janela.open) { document.getElementById('ferrProducoesFechar').focus(); }
          }).observe(janela, { attributes: true, attributeFilter: ['open'] });
        })();
      </script>
    }

    @* ---------------------------------------------------------------- *@
    @* 2. Editar factos: full-replace no MESMO tool_id.                   *@
    @* ---------------------------------------------------------------- *@
    <section id="ferrEditar" class="dmo-card ferr-card" aria-labelledby="ferr-edit-facts-title" data-dmo-regiao data-dmo-parcial>
      @* O título e o «Guardar» ficam dentro do formulário: o botão é o mesmo
         botão de sempre (gravar sem recarregar, fila, foco no mesmo id). *@
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="EditFacts">
        <div class="dmo-card-topo">
          <h3 id="ferr-edit-facts-title">Editar</h3>
          <div class="dmo-card-topo-acoes">
            <button type="submit" class="dmo-button" id="ferr-edit-guardar">Guardar</button>
          </div>
        </div>
        <input type="hidden" name="tool_id" value="@tool.ToolId" />
        @* A versão aberta: se outra pessoa gravar entretanto, nada se grava por cima. *@
        <input type="hidden" name="versao" value="@tool.Version" />
        @* O regresso ao fluxo que abriu a ficha fica depois de guardar. *@
        @if (Model.ContinueUrl is { } regressoFactos)
        {
          <input type="hidden" name="continuar" value="@regressoFactos" />
        }
        @* Os mesmos campos do Criar (um só formulário de ferramenta, Diogo,
           20/10/2026), com o Nome técnico (SAP) também aqui. *@
        <partial name="_FerramentaFactos" model="@(new FerramentaFactosForm("ferr-edit", false, Model.FactsType(tool.Type), null,
            Model.FactsReference(tool.Reference), Model.FactsLot(tool.Lot), Model.FactsQuantity(tool.BqAccountedQuantity), null,
            Model.FactsMf(tool.AssociatedMfReference), Model.FactsTechnicalName(tool.TechnicalName), Model.Machines,
            id => Model.FactsMachine(id, tool.Machines.Any(m => m.MachineId == id)),
            Model.FactsFabricaOrigem(tool.FabricaOrigem),
            Model.FactsUso(Model.Utilizacao?.Ultima?.Percentagem),
            Model.Utilizacao?.Ultima is { } usoData ? DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(usoData.RegistadaEmUtc).ToString("dd/MM/yyyy", pt) : null,
            Model.FactsAnQuantity(tool.AnQuantity), Model.Fabricas))" />
      </form>

    </section>

    @* ---------------------------------------------------------------- *@
    @* 3. TÉCNICA — os valores técnicos Tool-owned (o Owner 2026-10-12:   *@
    @*    «segundo tipo de informaçao da ferramenta é o tecnico, peso      *@
    @*    nominal gargalos, tampao etc»): a precisão REAL dos factos e    *@
    @*    os RÓTULOS HUMANOS da oficina — nunca nomes de coluna da BD     *@
    @*    (P2-9) — incl. o TAMPÃO (a geometria TP do desenho).            *@
    @* ---------------------------------------------------------------- *@
    @* Aberta ou fechada como o operador a deixou (data-dmo-fica): guardar o
       Editar não a fecha nem mexe no que lá está escrito. O título e o
       formulário são zonas. Sem o círculo da ajuda no título (Diogo, 27/10/2026). *@
    <section class="dmo-card ferr-card dmo-card-dobravel" aria-labelledby="ferr-tech-title" data-dmo-fica data-dmo-parcial>
      <details open="@Model.ShowTechnical">
      <summary id="ferrTecnicaTitulo" class="dmo-card-topo" data-dmo-regiao><h3 id="ferr-tech-title"><span class="dmo-caret" aria-hidden="true"></span>Informação técnica</h3></summary>
      @{
          // Cada tipo só tem os seus campos (os valores ficam na linha do próprio tool_id):
          // CM → processo, peso nominal, punção, gargalo e tampão; BQ → marisa e gargalo; MF → gargalo.
          var tech = tool.Technical;
          var isCm = tool.Type == ToolType.Cm;
          var isBq = tool.Type == ToolType.Bq;
          // O volume do tampão é calculado (PesoCapCalculation.Cap, a fórmula do apoio TP/calote):
          // V = π·h·(3a² + h²)/6000 cm³, a = D/2. No Job On a calote da produção substitui esta.
          var volumeTampao = tech?.TpDiametroMm is { } tpD && tpD > 0m && tech.TpSagittaMm is { } tpH && tpH >= 0m
              ? DMO.Alpha.Core.Controlo.PesoCapCalculation.Cap(tpD, tpH).VolumeCm3
              : (decimal?)null;
      }

      <div id="ferrTecnica" data-dmo-regiao>
      <form method="post" asp-page="/Ferramentas/Ficha" asp-page-handler="EditTechnical" id="ferr-tech-form">
        <input type="hidden" name="tool_id" value="@tool.ToolId" />
        <input type="hidden" name="versao" value="@tool.TechnicalVersion" />
        @if (Model.ContinueUrl is { } regresso)
        {
          <input type="hidden" name="continuar" value="@regresso" />
        }
        @* Os mesmos campos do Criar, só os do tipo desta ferramenta. *@
        <partial name="_FerramentaTecnica" model="@(new FerramentaTecnicaForm("ferr-tech", false, tokenOf(tool.Type),
            nome => nome == "process_token" ? Model.TechnicalProcessValue(tech?.Process) : Model.TechnicalValue(nome, nome switch
            {
                "nominal_weight" => tech?.NominalWeightGrams,
                "volume_puncao" => tech?.VolumePuncaoCm3,
                "volume_marisa" => tech?.VolumeMarisaCm3,
                "diametro_gargalo" => tech?.DiametroGargaloMm,
                "tp_diametro" => tech?.TpDiametroMm,
                "tp_sagitta" => tech?.TpSagittaMm,
                _ => null,
            }),
            Model.TechnicalInvalid, Model.TechnicalFocus,
            isCm ? (volumeTampao is { } vt ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(vt) : "—") : null))" />
      </form>
      </div>
      </details>
      @* O «Guardar» na linha do título, à direita (Diogo, 18/10/2026). Não vai
         dentro do summary (nada interativo lá dentro): fica a seguir ao
         <details>, sobre a linha do título (.dmo-card-dobravel), e grava o
         formulário da técnica pelo atributo form, aberta ou fechada, sem a
         abrir nem fechar. Fica fora das zonas: não muda ao gravar. *@
      <div class="dmo-card-topo-acoes">
        <button type="submit" class="dmo-button" id="ferr-tech-guardar" form="ferr-tech-form">Guardar</button>
      </div>
    </section>

    @* Histórico de produções (Diogo, 26/10/2026): por baixo da informação
       técnica, dobrável como ela. Cada Job On em que a ferramenta esteve,
       com o que o relatório de produções diz: garrafas, peso e a % de uso. *@
    @if (Model.Producoes is { } historico)
    {
      var pecasHist = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
      <section class="dmo-card ferr-card dmo-card-dobravel" aria-labelledby="ferr-historico-title" id="ferrHistoricoProducoes" data-dmo-fica>
        <details>
        <summary class="dmo-card-topo"><h3 id="ferr-historico-title" title="Os Job On em que esta ferramenta esteve, do mais recente para o mais antigo. Garrafas = produção bruta; Δ garrafas = contra a produção anterior; % = quanto o uso subiu nela. Um clique no peso médio abre o peso de todas as produções: a média, a moda e o Δ contra a anterior. A cadência é a moda do SAP em cada produção; um clique abre a média, a moda e o Δ de todas. O total soma as garrafas e mostra a % de hoje."><span class="dmo-caret" aria-hidden="true"></span>Histórico de produções</h3></summary>
        @if (historico.Pagina.TotalCount == 0)
        {
          <p class="ferr-nota">Esta ferramenta ainda não esteve em nenhum Job On.</p>
        }
        else
        {
          @* Todas as referências em que a ferramenta trabalhou, não só a do
             Job On de agora (Diogo, 28/10/2026: «a tool_id tem de mostrar
             todas as referências que trabalhou e não apenas um Job On»). *@
          var hojeHist = DateOnly.FromDateTime(DMO.Alpha.Core.Runtime.DmoBusinessTime.Now);
          var referenciasHist = historico.Pagina.Items
              .GroupBy(p => p.Referencia.ToUpperInvariant())
              .Select(g => (Referencia: g.First().Referencia, Producoes: g.Count()))
              .OrderByDescending(r => r.Producoes).ThenBy(r => r.Referencia, StringComparer.Ordinal)
              .ToList();
          <p class="ferr-nota" id="ferrHistoricoReferencias">@(referenciasHist.Count == 1 ? "Referência" : $"{referenciasHist.Count} referências"): @string.Join(" · ", referenciasHist.Select(r => $"{r.Referencia} ({r.Producoes})"))</p>
          <div class="dmo-table-wrap">
            <table class="dmo-table" data-dmo-list="Histórico de produções">
              <thead><tr><th>Produção</th><th>Datas</th><th>Garrafas (bruto)</th><th>Δ garrafas</th><th>% uso</th><th>Peso médio</th><th title="A cadência do SAP em cada produção (a moda: a das ordens com mais dias)">Cadência</th></tr></thead>
              <tbody>
                @{ var itensHist = historico.Pagina.Items.ToList(); }
                @for (var i = 0; i < itensHist.Count; i++)
                {
                  var prod = itensHist[i];
                  var peso = Model.PesoProducoes.TryGetValue(prod.JobOnId, out var ps) ? ps : null;
                  // Contra a produção anterior (a seguinte na lista, mais antiga).
                  var brutaAnterior = i + 1 < itensHist.Count ? itensHist[i + 1].ProducaoBruta : null;
                  var deltaGarrafas = prod.ProducaoBruta is { } b && brutaAnterior is { } ba ? b - ba : (long?)null;
                  <tr data-dmo-row data-id="@prod.JobOnId" data-dmo-open="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })">
                    <td><a class="ferr-armazem-link" href="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"><strong>@prod.Producao</strong></a> @* O artigo de cada produção: a mesma ferramenta
                       serve vários artigos e o nº de produção repete-se entre eles
                       (Diogo, 28/10/2026: «produção não faz sentido»). *@<small class="ferr-producao-maquina">@prod.Referencia · @prod.Maquina</small></td>
                    @* «em curso» também na produção que está na máquina hoje, com o fim
                       previsto (Diogo, 28/10/2026: «o que está em curso é o 202605»). *@
                    <td>@(prod.InicioEm?.ToString("dd/MM/yyyy") ?? "—") a @(prod.FimEm?.ToString("dd/MM/yyyy") ?? "em curso")@(prod.FimEm is { } fimHist && prod.InicioEm <= hojeHist && fimHist >= hojeHist ? " · em curso" : null)</td>
                    <td><strong>@(prod.ProducaoBruta?.ToString("#,0", pecasHist) ?? "—")</strong></td>
                    <td><strong>@(deltaGarrafas is { } dg ? (dg >= 0 ? "+" : "−") + Math.Abs(dg).ToString("#,0", pecasHist) : "—")</strong></td>
                    @* Um clique no % uso abre a Utilização por produção (Diogo, 27/10/2026:
                       «qualquer % uso de uma ferramenta abre um slide com esse historial»). *@
                    @* Sem as leituras antes e depois, o «≈» da janela da utilização (a parte
                       do % de hoje pelo que a produção fez), como lá (Diogo, 28/10/2026:
                       «as nossas consultas ao SAP não estão a funcionar bem»: aqui ficava «—»). *@
                    <td>@if (prod.DeltaUtilizacao is { } delta) {<button type="button" class="ferr-utilizacao-abrir" aria-label="Utilização por produção" data-dmo-dialog="ferrProducoes"><strong>@((delta >= 0 ? "+" : "") + DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(delta) + " %")</strong></button>} else if (historico.DeltaPeloProduzido(prod, Model.Utilizacao?.Ultima?.Percentagem) is { } estimado) {<button type="button" class="ferr-utilizacao-abrir" aria-label="Utilização por produção" data-dmo-dialog="ferrProducoes"><strong>@("≈ +" + DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(estimado) + " %")</strong></button>} else {<strong>—</strong>}</td>
                    <td>
                      @if (peso is null)
                      {
                        @("—")
                      }
                      else
                      {
                        @* Um clique abre a janela do peso de todas as produções
                           (Diogo, 27/10/2026: «abrir slide para ver Moda, Média
                           e delta da produção anterior ... da mesma forma que
                           fazemos com produzido»). *@
                        <button type="button" class="ferr-utilizacao-abrir ferr-peso-abrir" aria-label="Peso por produção (@prod.Producao)" data-dmo-dialog="ferrPeso@(prod.JobOnId)">@(DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(peso.MediaGramas)) g</button>
                      }
                    </td>
                    @* A cadência usada em cada produção (Diogo, 28/10/2026: «uma versão como
                       a do peso [...] média e moda, mas mostrar o que foi usado em cada
                       produção»): a moda; um clique abre a janela da cadência. *@
                    <td>
                      @if (prod.Cadencia is { } cad)
                      {
                        <button type="button" class="ferr-utilizacao-abrir ferr-peso-abrir" aria-label="Cadência por produção (@prod.Producao)" data-dmo-dialog="ferrCadencia@(prod.JobOnId)">@cad.Moda</button>
                      }
                      else
                      {
                        @("—")
                      }
                    </td>
                  </tr>
                }
              </tbody>
              <tfoot id="ferrHistoricoTotal">
                <tr>
                  <th scope="row" colspan="2">Total · @historico.Pagina.TotalCount @(historico.Pagina.TotalCount == 1 ? "produção" : "produções")</th>
                  <td><strong>@(historico.TotalBruta?.ToString("#,0", pecasHist) ?? "—")</strong></td>
                  <td></td>
                  <td>@if (Model.Utilizacao?.Ultima is { } atualHist) {<button type="button" class="ferr-utilizacao-abrir" aria-label="Utilização por produção" data-dmo-dialog="ferrProducoes"><strong>@(DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(atualHist.Percentagem) + " %")</strong></button>} else {<strong>—</strong>}</td>
                  <td></td>
                  <td></td>
                </tr>
              </tfoot>
            </table>
          </div>
        }
        </details>
          @* A JANELA DO PESO (Diogo, 27/10/2026: «abrir slide para ver Moda,
             Média e delta da produção anterior comparado com as outras
             produções da mesma forma que fazemos com produzido»), como a
             «Utilização por produção». Cada peso abre a sua janela: em cima,
             o peso dessa produção (média, moda e Δ, como antes); por baixo, a
             tabela de todas as produções — uma só, que muda para a janela
             aberta. Média e moda do peso do SAP; o Δ é a média contra a da
             produção anterior (a seguinte na lista, mais antiga), em g e em %.
             Sem peso do SAP, «—». Fora do <details>: dentro, fechado, não se via. *@
          @{
          var itensHistJanela = historico.Pagina.Items.ToList();
          string DeltaPeso(PesoSapResumo? atual, PesoSapResumo? anterior)
          {
              if (atual is null || anterior is null) { return "—"; }
              var g = atual.MediaGramas - anterior.MediaGramas;
              var texto = (g >= 0 ? "+" : "−") + DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(Math.Abs(g)) + " g";
              if (anterior.MediaGramas > 0)
              {
                  var pct = Math.Round(g / anterior.MediaGramas * 100, 2);
                  texto += " · " + (pct >= 0 ? "+" : "−") + DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(Math.Abs(pct)) + " %";
              }
              return texto;
          }
          PesoSapResumo? PesoDe(int i) => i < itensHistJanela.Count && Model.PesoProducoes.TryGetValue(itensHistJanela[i].JobOnId, out var r) ? r : null;
          }
          @if (itensHistJanela.Any(p => Model.PesoProducoes.ContainsKey(p.JobOnId)))
          {
            <div class="dmo-table-wrap ferr-producoes-lista" id="ferrPesoTabela" hidden>
              <table class="dmo-table" data-dmo-list="Peso por produção">
                <thead><tr><th>Produção</th><th>Média</th><th>Moda</th><th>Δ anterior</th></tr></thead>
                <tbody>
                  @for (var i = 0; i < itensHistJanela.Count; i++)
                  {
                    var prod = itensHistJanela[i];
                    var peso = PesoDe(i);
                    <tr data-dmo-row data-id="@prod.JobOnId" data-dmo-open="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"
                        aria-label="Produção @prod.Producao — um clique abre a ficha do Job On">
                      <td><a class="ferr-armazem-link" href="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"><strong>@prod.Producao</strong></a> <small class="ferr-producao-maquina">@prod.Maquina</small></td>
                      <td>@(peso is null ? "—" : DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(peso.MediaGramas) + " g")</td>
                      <td>@(peso is null ? "—" : DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(peso.ModaGramas) + " g")</td>
                      <td>@DeltaPeso(peso, PesoDe(i + 1))</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
            @for (var i = 0; i < itensHistJanela.Count; i++)
            {
              var prod = itensHistJanela[i];
              if (PesoDe(i) is not { } peso) { continue; }
              <dialog id="ferrPeso@(prod.JobOnId)" class="dmo-dialog ferr-producoes-janela ferr-peso-janela" aria-labelledby="ferrPesoTitulo@(prod.JobOnId)">
                <h3 id="ferrPesoTitulo@(prod.JobOnId)" title="O peso médio do relatório de produções do SAP em cada Job On: a média pesada pelos dias e a moda (o peso que se repete mais). O Δ é a média contra a da produção anterior, em gramas e em %. Um clique na produção abre a ficha do Job On.">Peso por produção</h3>
                <p class="ferr-nota">Produção <strong>@prod.Producao</strong> · Média <strong>@DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(peso.MediaGramas) g</strong> · Moda <strong>@DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(peso.ModaGramas) g</strong> · Δ anterior <strong>@DeltaPeso(peso, PesoDe(i + 1))</strong></p>
                <div data-ferr-peso-lugar></div>
                <div class="dmo-dialog-actions">
                  <button type="button" class="dmo-button" data-dmo-dialog-close data-ferr-peso-fechar>Fechar</button>
                </div>
              </dialog>
            }
            <script>
              (function () {
                var tabela = document.getElementById('ferrPesoTabela');
                if (!tabela || !window.MutationObserver) { return; }
                document.querySelectorAll('dialog.ferr-peso-janela').forEach(function (janela) {
                  new MutationObserver(function () {
                    if (!janela.open) { return; }
                    janela.querySelector('[data-ferr-peso-lugar]').appendChild(tabela);
                    tabela.hidden = false;
                    janela.querySelector('[data-ferr-peso-fechar]').focus();
                  }).observe(janela, { attributes: true, attributeFilter: ['open'] });
                });
              })();
            </script>
          }
          @* A JANELA DA CADÊNCIA (Diogo, 28/10/2026), como a do peso: em cima, a
             cadência dessa produção (média pesada pelos dias, moda e Δ da moda
             contra a produção anterior); por baixo, a tabela de todas. *@
          @{
          CadenciaSapResumo? CadenciaDe(int i) => i < itensHistJanela.Count ? itensHistJanela[i].Cadencia : null;
          string DeltaCadencia(CadenciaSapResumo? atual, CadenciaSapResumo? anterior) =>
              atual is null || anterior is null ? "—" : (atual.Moda - anterior.Moda >= 0 ? "+" : "−") + Math.Abs(atual.Moda - anterior.Moda);
          }
          @if (itensHistJanela.Any(p => p.Cadencia is not null))
          {
            <div class="dmo-table-wrap ferr-producoes-lista" id="ferrCadenciaTabela" hidden>
              <table class="dmo-table" data-dmo-list="Cadência por produção">
                <thead><tr><th>Produção</th><th>Média</th><th>Moda</th><th>Δ anterior</th></tr></thead>
                <tbody>
                  @for (var i = 0; i < itensHistJanela.Count; i++)
                  {
                    var prod = itensHistJanela[i];
                    var cad = CadenciaDe(i);
                    <tr data-dmo-row data-id="@prod.JobOnId" data-dmo-open="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"
                        aria-label="Produção @prod.Producao — um clique abre a ficha do Job On">
                      <td><a class="ferr-armazem-link" href="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"><strong>@prod.Producao</strong></a> <small class="ferr-producao-maquina">@prod.Maquina</small></td>
                      <td>@(cad is null ? "—" : DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(cad.Media))</td>
                      <td>@(cad is null ? "—" : cad.Moda.ToString(System.Globalization.CultureInfo.InvariantCulture))</td>
                      <td>@DeltaCadencia(cad, CadenciaDe(i + 1))</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
            @for (var i = 0; i < itensHistJanela.Count; i++)
            {
              var prod = itensHistJanela[i];
              if (CadenciaDe(i) is not { } cad) { continue; }
              <dialog id="ferrCadencia@(prod.JobOnId)" class="dmo-dialog ferr-producoes-janela ferr-cadencia-janela" aria-labelledby="ferrCadenciaTitulo@(prod.JobOnId)">
                <h3 id="ferrCadenciaTitulo@(prod.JobOnId)" title="A cadência do relatório de produções do SAP em cada Job On: a média pesada pelos dias e a moda (a das ordens com mais dias). O Δ é a moda contra a da produção anterior. Um clique na produção abre a ficha do Job On.">Cadência por produção</h3>
                <p class="ferr-nota">Produção <strong>@prod.Producao</strong> · Média <strong>@DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(cad.Media)</strong> · Moda <strong>@cad.Moda</strong> · Δ anterior <strong>@DeltaCadencia(cad, CadenciaDe(i + 1))</strong></p>
                <div data-ferr-cadencia-lugar></div>
                <div class="dmo-dialog-actions">
                  <button type="button" class="dmo-button" data-dmo-dialog-close data-ferr-cadencia-fechar>Fechar</button>
                </div>
              </dialog>
            }
            <script>
              (function () {
                var tabela = document.getElementById('ferrCadenciaTabela');
                if (!tabela || !window.MutationObserver) { return; }
                document.querySelectorAll('dialog.ferr-cadencia-janela').forEach(function (janela) {
                  new MutationObserver(function () {
                    if (!janela.open) { return; }
                    janela.querySelector('[data-ferr-cadencia-lugar]').appendChild(tabela);
                    tabela.hidden = false;
                    janela.querySelector('[data-ferr-cadencia-fechar]').focus();
                  }).observe(janela, { attributes: true, attributeFilter: ['open'] });
                });
              })();
            </script>
          }
      </section>
    }


  }

</dmo-pagina>
