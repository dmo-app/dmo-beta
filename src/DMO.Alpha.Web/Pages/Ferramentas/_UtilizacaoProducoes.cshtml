@model DMO.Alpha.Web.Presentation.UtilizacaoProducoesView
@* O quadro «Utilização por produção» (Diogo, 21/10/2026: «% uso, mas um box que
   mostra detalhes: o que fabricou naquela produção, o delta e o total»; 27/10/2026:
   cada produção com o Job On, o produzido e o uso que foi acumulando). Serve a
   janela da ficha da ferramenta e a página /Ferramentas/Utilizacao, que o «% uso»
   de qualquer página abre no painel. *@
@{
    var pt = DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture;
    var pecasProd = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
    var producoesTudo = Model.Producoes;
    var producoesFerr = producoesTudo.Pagina;
    var leituraJanela = Model.Leitura;
    var usoDepois = DMO.Alpha.Web.Presentation.UsoFerramenta.UsoDepois(producoesTudo, leituraJanela?.Percentagem);
}
@if (producoesFerr.TotalCount == 0)
{
  <p class="ferr-nota" id="ferrProducoesVazio">Esta ferramenta ainda não esteve em nenhum Job On.</p>
}
else
{
  <div class="dmo-table-wrap ferr-producoes-lista">
    <table class="dmo-table" data-dmo-list="Produções da ferramenta">
      <thead>
        <tr>
          @* R1 (Diogo, 30/10/2026): Referência, Produção (mais pequena), Linha e o n.º da produção (1, 2, 3…); a mais antiga em cima e a mais recente em baixo, junto ao total. *@
          <th>Referência</th>
          <th>Produção</th>
          <th>Linha</th>
          <th title="Ordem das produções desta ferramenta">N.º</th>
          <th>Datas</th>
          <th>Garrafas</th>
          <th>Delta</th>
          <th title="O uso da ferramenta no fim de cada produção">Uso</th>
        </tr>
      </thead>
      <tbody>
        @{ var primeiroNumero = producoesFerr.TotalCount - (producoesFerr.PageNumber - 1) * producoesFerr.PageSize; }
        @foreach (var (prod, indice) in producoesFerr.Items.Select((p, i) => (p, i)).Reverse())
        {
          <tr data-dmo-row data-id="@prod.JobOnId" data-dmo-open="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"
              title="@prod.Maquina · @(prod.InicioEm?.ToString("dd/MM/yyyy") ?? "—") a @(prod.FimEm?.ToString("dd/MM/yyyy") ?? "em curso")"
              aria-label="Produção @prod.Producao — um clique abre a ficha do Job On">
            <td><a class="ferr-armazem-link" href="@Url.Page("/JobOn/Index", new { jobon_id = prod.JobOnId })"><strong>@prod.Referencia</strong></a></td>
            <td><small class="ferr-producao-maquina">@prod.Producao</small></td>
            <td>@prod.Maquina</td>
            <td>@(primeiroNumero - indice)</td>
            <td>@DMO.Alpha.Web.Presentation.UsoFerramenta.Datas(prod.InicioEm, prod.FimEm, DateOnly.FromDateTime(DMO.Alpha.Core.Runtime.DmoBusinessTime.Now))</td>
            <td>@(prod.ProducaoBruta?.ToString("#,0", pecasProd) ?? "—")</td>
            @* Sem as leituras antes e depois (só o % de hoje), o delta
               estima-se pelo produzido: a parte do % atual que cabe
               a esta produção (marcada com «≈»). *@
            <td>@(prod.DeltaUtilizacao is { } delta ? (delta >= 0 ? "+" : "") + delta.ToString("0.##", pt) + " %" : producoesTudo.DeltaPeloProduzido(prod, leituraJanela?.Percentagem) is { } estimado ? "≈ +" + estimado.ToString("0.##", pt) + " %" : "—")</td>
            <td>@(usoDepois.TryGetValue(prod.JobOnId, out var depois) ? (depois.Estimado ? "≈ " : "") + depois.Valor.ToString("0.##", pt) + " %" : "—")</td>
          </tr>
        }
      </tbody>
      <tfoot id="ferrProducoesTotal">
        <tr>
          <th scope="row" colspan="5">Total · @producoesFerr.TotalCount @(producoesFerr.TotalCount == 1 ? "produção" : "produções")</th>
          <td><strong>@(producoesTudo.TotalBruta?.ToString("#,0", pecasProd) ?? "—")</strong></td>
          <td></td>
          <td><strong>@(leituraJanela is { } atual ? atual.Percentagem.ToString("0.##", pt) + " %" : "—")</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  @if (producoesFerr.Items.Any(p => p.LinhasSap == 0))
  {
    <p class="ferr-nota" id="ferrProducoesSemSap">«—» no produzido: ainda não há o produzido dessa produção. <a class="ferr-cancel" href="/Definicoes?secao=computador">Ler a pasta da produção</a></p>
  }
}
