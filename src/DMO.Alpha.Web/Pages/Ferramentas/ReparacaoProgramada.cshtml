@page "/Ferramentas/ReparacaoProgramada"
@model DMO.Alpha.Web.Pages.Ferramentas.ReparacaoProgramadaModel
@using DMO.Alpha.Core.Armazem
@using DMO.Alpha.Web.Pages.Ferramentas
@{
    Layout = "_DmoShellLayout";
    var lista = Model.Lista;
}
@section Head {
<style>
.dmo-ferr-ref{font-size:12px;font-weight:500;color:var(--dmo-muted);margin-left:4px}
.rp-page{display:flex;flex-direction:column;gap:14px;min-width:0}
.rp-card{padding:18px;min-width:0}
.rp-card .dmo-card-topo{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:0 0 12px}
.rp-card .dmo-card-topo h3{margin:0;font-size:16px}
.rp-acoes{display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin-left:auto}
.rp-acoes .dmo-field{margin:0}
.rp-filtros{display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin:0 0 12px}
.rp-filtros .dmo-field{margin:0;min-width:0}
html body .rp-filtros .dmo-field input.rp-curto{width:10ch}
html body .rp-filtros .dmo-field input.rp-lote{width:6ch}
html body .rp-page .dmo-field select{width:auto;max-width:22ch}
.rp-card .dmo-table td{padding:6px 8px;vertical-align:middle}
html body #rpCandidatas .rp-marca{display:none}
/* A linha marcada fica escura, como a escolhida nas outras tabelas (R16, Diogo 27/10/2026). */
html body #rpCandidatas tbody tr:has(>td>input[data-rp-marca]:checked)>td{background:var(--dmo-brand-600);color:var(--dmo-text-on-color);border-top-color:transparent}
html body #rpCandidatas tbody tr:has(>td>input[data-rp-marca]:checked) :is(td,strong,span){color:var(--dmo-text-on-color)}
html body #rpCandidatas tbody tr:has(>td>input[data-rp-marca]:checked)>td:nth-child(2){border-radius:7px 0 0 7px}
html body #rpCandidatas tbody tr:has(>td>input[data-rp-marca]:checked)>td:last-child{border-radius:0 7px 7px 0}
.rp-pos{font-variant-numeric:tabular-nums;font-weight:700}
.rp-contents{display:contents}
.rp-oculto{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
#rpHistLinhas{margin:0}
#rpLista .dmo-table-wrap+.rp-cabecalho{margin-top:12px}
.rp-modo-direita{margin-left:auto;align-self:end}
.rp-modo{display:flex;gap:8px;align-items:center}
html body .rp-card .dmo-table tbody tr.rp-hist-aberta td{background:var(--dmo-neutral-soft)}
.rp-procura-topo{margin-top:14px!important;padding-top:12px;border-top:1px solid var(--dmo-border)}
.rp-procura-topo h4{margin:0;font-size:14px}
.rp-cabecalho{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin:0 0 12px;color:var(--dmo-muted);font-size:13px}
#rpListaAtiva{display:inline-flex;align-items:center}
#rpListaAtiva .dmo-pill{margin:0;line-height:1.2;vertical-align:middle}
.rp-cabecalho strong{color:var(--dmo-text)}
html body .rp-card .dmo-table tbody tr.rp-entrou td{color:var(--dmo-muted);background:var(--dmo-neutral-soft)}
html body .rp-card .dmo-table tbody tr.rp-entrou td strong{color:var(--dmo-muted);font-weight:600}
.rp-saiu{font-weight:700;color:var(--dmo-amber)}
@@media (max-width:720px){.rp-acoes{margin-left:0}}
</style>
}

@* A Reparação Programada (Diogo, 22/10/2026). Em cima a procura (abre
   vazia; filtros, lista, reparador, «Associar» e «Limpar filtros» numa
   só linha seguida) e o associar: marcam-se
   as ferramentas e «Associar» junta-as a uma lista nova do reparador ou a
   uma lista ativa. Em baixo a lista, que só os movimentos do Armazém
   atualizam. Sem botões nas linhas: a linha abre a ficha da ferramenta; a
   caixa de marcar só marca. Cada cartão troca só a sua zona. *@
<main class="dmo-workspace rp-page" aria-labelledby="rp-title" data-dmo-troca>

  <div class="page-head">
    <div>
      @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
      <h1 id="rp-title" title="Procure as CM e os MF a enviar ao reparador, marque-os e adicione-os a uma lista. Imprima a lista para quem vai retirar do armazém: cada Saída no Armazém atualiza a lista, e cada Entrada pinta a linha de cinza. A lista fecha quando a última ferramenta dá entrada.">Registar Reparação</h1>
    </div>
  </div>

  <div id="rpAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.Mensagem is { } mensagem)
    {
      <div data-dmo-toast="ok" class="dmo-aviso" role="status" id="rpAssociadas">@mensagem</div>
    }
    @if (Model.Recusa is { } recusa)
    {
      <div data-dmo-toast="erro" class="dmo-aviso" role="alert" id="rpRecusa">@recusa</div>
    }
    @foreach (var aviso in Model.Avisos)
    {
      <p class="dmo-aviso warn" data-dmo-aviso>@aviso</p>
    }
  </div>

  <section id="rpProcura" class="dmo-card rp-card" aria-labelledby="rp-lista-title" data-dmo-regiao data-dmo-parcial>
    @* Listas | Histórico (Diogo, 22/10/2026): dois botões, o escolhido com
       o aspeto invertido. Nas Listas escolhe-se uma lista ativa ou cria-se
       uma nova (reparador e «Criar»); por baixo a tabela e a procura com
       «Adicionar». No Histórico só os filtros (abre vazio) e as listas
       fechadas; a linha abre a lista, só para ver. *@
      <h3 id="rp-lista-title" class="rp-oculto">Registar Reparação</h3>
    @{ Func<object?, object> modoListas = @<text>
      <div class="rp-modo rp-modo-direita" role="group" aria-label="Listas ou histórico">
        <a class="dmo-button@(!Model.VerFechadas ? " rp-modo-ativo" : null)" id="rpModoListas" aria-pressed="@(!Model.VerFechadas ? "true" : "false")" href="@Url.Page("/Ferramentas/ReparacaoProgramada")">Listas</a>
        @* A ajuda encostada ao botão a que pertence (.dmo-com-ajuda, regra partilhada; Diogo, 24/10/2026). *@
        <span class="dmo-com-ajuda"><a class="dmo-button@(Model.VerFechadas ? " rp-modo-ativo" : null)" id="rpModoHistorico" aria-pressed="@(Model.VerFechadas ? "true" : "false")" href="@Url.Page("/Ferramentas/ReparacaoProgramada", new { vista = "fechadas" })">Histórico</a><partial name="_DmoHelp" model="@("A Saída no Armazém mostra «Saída» e o dia; a Entrada pinta a linha de cinza, com o dia, a posição e quem deu entrada. Um clique na linha abre a ficha da ferramenta.")" /></span>
      </div>
    </text>; }
    <div id="rpLista" class="rp-lista-zona-topo" aria-label="Lista">
    @if (Model.VerFechadas)
    {
    <form id="rpEscolherLista" method="get" asp-page="/Ferramentas/ReparacaoProgramada" class="rp-filtros">
      <input type="hidden" name="vista" value="fechadas" />
      <div class="dmo-field">
        <label for="rpHistReparador">Reparador</label>
        <select id="rpHistReparador" name="hist_reparador" data-dmo-autosubmit>
          <option value="" selected="@string.IsNullOrWhiteSpace(Model.HistReparador)">Todos</option>
          @foreach (var n in Model.HistReparadores)
          {
            <option value="@n" selected="@(string.Equals(Model.HistReparador, n, StringComparison.OrdinalIgnoreCase))">@n</option>
          }
        </select>
      </div>
      <div class="dmo-field">
        <label for="rpHistDesde">Desde</label>
        <input id="rpHistDesde" name="hist_desde" type="date" value="@Model.HistDesde?.ToString("yyyy-MM-dd")" data-dmo-autosubmit />
      </div>
      <div class="dmo-field">
        <label for="rpHistAte">Até</label>
        <input id="rpHistAte" name="hist_ate" type="date" value="@Model.HistAte?.ToString("yyyy-MM-dd")" data-dmo-autosubmit />
      </div>
      <a class="dmo-button" id="rpHistLimpar" href="@Url.Page("/Ferramentas/ReparacaoProgramada", new { vista = "fechadas" })">Limpar filtros</a>
      @modoListas(null)
    </form>
    @if (Model.HistoricoPedido && Model.Fechadas.Count > 0)
    {
      <div class="dmo-table-wrap">
        <table class="dmo-table" id="rpHistLinhas" data-dmo-list="Listas fechadas">
          <thead><tr><th>Reparador</th><th>Criada</th><th>Por</th><th>Fechada</th></tr></thead>
          <tbody>
          @foreach (var h in Model.Fechadas)
          {
            <tr data-dmo-row data-dmo-historico="@h.Id" class="@(lista?.Lista.Id == h.Id ? "rp-hist-aberta" : null)" data-dmo-open="@Url.Page("/Ferramentas/ReparacaoProgramada", new { vista = "fechadas", hist_reparador = Model.HistReparador, hist_desde = Model.HistDesde?.ToString("yyyy-MM-dd"), hist_ate = Model.HistAte?.ToString("yyyy-MM-dd"), lista = h.Id })">
              <td><strong>@h.Reparador</strong></td>
              <td>@ReparacaoProgramadaModel.Dia(h.CriadaEmUtc)</td>
              <td>@(h.CriadaPor ?? "—")</td>
              <td>@(h.FechadaEmUtc is { } f ? ReparacaoProgramadaModel.Dia(f) : "—")</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
    }
    else
    {
    <div class="rp-filtros" id="rpListaLinha">
    <form id="rpEscolherLista" method="get" asp-page="/Ferramentas/ReparacaoProgramada" class="rp-contents">
      <input type="hidden" name="tipo" value="@Model.TipoTexto" />
      <input type="hidden" name="referencia" value="@Model.Referencia" />
      <input type="hidden" name="lote" value="@Model.Lote" />
      <input type="hidden" name="linha" value="@Model.Linha" />
      <input type="hidden" name="estado" value="@Model.EstadoTexto" />
      <div class="dmo-field">
        <label for="rpListaEscolha">Lista</label>
        <select id="rpListaEscolha" name="lista" data-dmo-autosubmit>
          @foreach (var a in Model.Ativas)
          {
            <option value="@a.Id" selected="@(lista?.Lista.Id == a.Id)">@ReparacaoProgramadaModel.Titulo(a)</option>
          }
          <option value="0" selected="@Model.NovaLista">Nova lista</option>
        </select>
      </div>
    </form>
    @if (Model.NovaLista)
    {
    <form id="rpCriar" method="post" asp-page="/Ferramentas/ReparacaoProgramada" asp-page-handler="Criar" class="rp-contents">
      <div class="dmo-field">
        <label for="rpReparador">Reparador</label>
        <select id="rpReparador" name="reparador">
          <option value="">Escolha…</option>
          @foreach (var r in Model.Reparadores)
          {
            <option value="@r.Id">@r.Nome</option>
          }
        </select>
      </div>
      <span class="dmo-com-ajuda"><button type="submit" class="dmo-button" id="rpCriarBotao">Criar</button><partial name="_DmoHelp" model="@("Escolha o reparador (Armazém › Definições) e crie a lista. A lista fica com o nome do reparador e o dia, por exemplo «Moldes do Norte · 23/10/2026».")" /></span>
    </form>
    }
      @if (lista is not null)
      {
        <a class="dmo-button" id="rpImprimir" data-dmo-completa target="_blank" rel="noopener" href="@Url.Page("/Ferramentas/ReparacaoProgramadaImprimir", new { lista = lista.Lista.Id })">Imprimir</a>
      }
    @modoListas(null)
    </div>
    }

    @if (lista is null)
    {
      @if (Model.VerFechadas && !Model.HistoricoPedido)
      {
        <p id="rpHistVazio"><em>Escolha o reparador ou as datas.</em></p>
      }
      else if (Model.VerFechadas && Model.Fechadas.Count == 0)
      {
        <p id="rpHistNada"><em>Nenhuma lista fechada com esses filtros.</em></p>
      }
    }
    else
    {
      <div class="rp-cabecalho" id="rpListaCabecalho" data-dmo-lista="@lista.Lista.Id">
        <span>Reparador <strong>@lista.Lista.Reparador</strong></span>
        <span>Criada <strong>@ReparacaoProgramadaModel.Dia(lista.Lista.CriadaEmUtc)</strong>@(lista.Lista.CriadaPor is { } por ? $" por {por}" : null)</span>
        @if (lista.Lista.FechadaEmUtc is { } fechada)
        {
          <span id="rpListaFechada">Fechada <strong>@ReparacaoProgramadaModel.Dia(fechada)</strong>: todas deram entrada</span>
        }
        else
        {
          <span id="rpListaAtiva"><span class="dmo-pill">Ativa</span></span>
        }
      </div>
      <div class="dmo-table-wrap">
        <table class="dmo-table" id="rpListaLinhas" data-dmo-list="Ferramentas da lista">
          <thead><tr><th>Ferramenta</th><th>% uso</th><th>Linha</th><th>Posição atual</th><th>Estado</th><th>Movimento</th></tr></thead>
          <tbody>
          @foreach (var i in lista.Linhas)
          {
            var classe = i.Entrou ? "rp-entrou" : null;
            if (i.ToolId is { } toolId)
            {
            <tr data-dmo-row class="@classe" data-dmo-item="@i.Id" data-dmo-open="@Url.Page("/Ferramentas/Ficha", new { tool_id = toolId })">
              <td>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.Nome(i.Tipo, i.Referencia, i.Lote)</td>
              <td>@ReparacaoProgramadaModel.Uso(i.Utilizacao)</td>
              <td>@(i.Linhas ?? "—")</td>
              <td>@i.OndeEsta</td>
              <td>@(i.Estado is { } est ? ArmazemTextos.Estado(est) : "—")</td>
              <td data-dmo-progresso class="@(i.Saiu && !i.Entrou ? "rp-saiu" : null)">@ReparacaoProgramadaModel.Progresso(i)</td>
            </tr>
            }
            else
            {
            <tr data-dmo-row class="@classe" data-dmo-item="@i.Id">
              <td>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.Nome(i.Tipo, i.Referencia, i.Lote) <span class="muted">(eliminada)</span></td>
              <td>@ReparacaoProgramadaModel.Uso(i.Utilizacao)</td>
              <td>@(i.Linhas ?? "—")</td>
              <td>—</td>
              <td>—</td>
              <td data-dmo-progresso>@ReparacaoProgramadaModel.Progresso(i)</td>
            </tr>
            }
          }
          </tbody>
        </table>
      </div>
    }
    </div>
    @if (!Model.VerFechadas)
    {
    <div class="dmo-card-topo rp-procura-topo">
      <h4 id="rp-procura-title" title="Só CM e MF (as BQ vão ao reparador pelas Boquilhas). Os dropdowns aplicam logo; a referência e o lote com Enter. Marque as ferramentas e «Adicionar» junta-as à lista escolhida em cima.">Procurar ferramentas</h4>
    </div>

    <form id="rpFiltros" method="get" asp-page="/Ferramentas/ReparacaoProgramada" class="rp-filtros" role="search">
      @if (Model.ListaId is { } listaAtual)
      {
        <input type="hidden" name="lista" value="@listaAtual" />
      }
      <div class="dmo-field">
        <label for="rpReferencia">Referência</label>
        <input id="rpReferencia" name="referencia" class="rp-curto" value="@Model.Referencia" autocomplete="off" data-dmo-maiusculas autocapitalize="characters" placeholder="5447" />
      </div>
      <div class="dmo-field">
        <label for="rpLote">Lote</label>
        <input id="rpLote" name="lote" class="rp-lote" value="@Model.Lote" autocomplete="off" data-dmo-maiusculas autocapitalize="characters" placeholder="3" />
      </div>
      <div class="dmo-field">
        <label for="rpTipo">Tipo</label>
        <select id="rpTipo" name="tipo" data-dmo-autosubmit>
          <option value="" selected="@(Model.Tipo is null)">Todos</option>
          <option value="CM" selected="@(Model.TipoTexto == "CM")">CM</option>
          <option value="MF" selected="@(Model.TipoTexto == "MF")">MF</option>
        </select>
      </div>
      <div class="dmo-field">
        <label for="rpLinha">Linha</label>
        <select id="rpLinha" name="linha" data-dmo-autosubmit>
          <option value="" selected="@string.IsNullOrWhiteSpace(Model.Linha)">Todas</option>
          @foreach (var l in Model.Linhas)
          {
            <option value="@l" selected="@(Model.Linha == l)">@l</option>
          }
        </select>
      </div>
      <div class="dmo-field">
        <label for="rpEstado">Estado</label>
        <select id="rpEstado" name="estado" data-dmo-autosubmit>
          <option value="" selected="@(Model.Estado is null)">Todos</option>
          @foreach (var e in ReparacaoProgramadaModel.Estados)
          {
            <option value="@e" selected="@(Model.Estado == e)">@ArmazemTextos.Estado(e)</option>
          }
        </select>
      </div>
      <button type="submit" form="rpAssociar" class="dmo-button" id="rpAssociarBotao">Adicionar</button>
      <a class="dmo-button" id="rpLimpar" href="@Url.Page("/Ferramentas/ReparacaoProgramada", new { lista = Model.ListaId })">Limpar filtros</a>
    </form>

    <form id="rpAssociar" method="post" asp-page="/Ferramentas/ReparacaoProgramada" asp-page-handler="Associar">
      <input type="hidden" name="tipo" value="@Model.TipoTexto" />
      <input type="hidden" name="referencia" value="@Model.Referencia" />
      <input type="hidden" name="lote" value="@Model.Lote" />
      <input type="hidden" name="linha" value="@Model.Linha" />
      <input type="hidden" name="estado" value="@Model.EstadoTexto" />
      @* «Adicionar» junta à lista escolhida em cima; sem lista, avisa. *@
      <input type="hidden" name="destino" value="@(lista is { Lista.Ativa: true } ? lista.Lista.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)" />
    </form>

    @* Sem frases de ajuda no ecrã (Diogo, 23/10/2026: «remover comentários»): a procura vazia não mostra nada. *@
    @if (Model.Procura.Vazia)
    {
    }
    else if (Model.Candidatas.Count == 0)
    {
      <p id="rpProcuraNada"><em>Nenhuma CM ou MF com esses filtros.</em></p>
    }
    else
    {
      <div class="dmo-table-wrap">
        <table class="dmo-table" id="rpCandidatas" data-dmo-list="Ferramentas encontradas">
          <thead><tr><th class="rp-marca"><span class="sr-only">Marcar</span></th><th>Ferramenta</th><th>% uso</th><th>Linha</th><th>Posição atual</th><th>Estado</th><th>Lista</th></tr></thead>
          <tbody>
          @foreach (var c in Model.Candidatas)
          {
            <tr data-dmo-row data-dmo-candidata="@c.ToolId" data-dmo-open="@Url.Page("/Ferramentas/Ficha", new { tool_id = c.ToolId })">
              <td class="rp-marca"><input type="checkbox" name="ferramenta" value="@c.ToolId" form="rpAssociar" data-rp-marca aria-label="Marcar @ReparacaoProgramadaModel.Ferramenta(c.Tipo, c.Referencia, c.Lote)" /></td>
              <td>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.Nome(c.Tipo, c.Referencia, c.Lote)</td>
              <td>@ReparacaoProgramadaModel.Uso(c.Utilizacao)</td>
              <td>@(c.Linhas ?? "—")</td>
              <td>@if (c.Posicao is not null) {<span class="rp-pos">@c.Posicao</span>} else {@c.OndeEsta}</td>
              <td>@(c.Estado is { } est ? ArmazemTextos.Estado(est) : "—")</td>
              <td>@(c.EmLista ?? "—")</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }

    }
  </section>
</main>
<script>
  // O Enter na Referência e no Lote procura (teste no browser real, 22/10/2026:
  // não fazia nada). O rpFiltros tem dois campos de texto e nenhum botão seu (o
  // «Adicionar» é do rpAssociar), e aí o browser não submete com Enter. Por
  // delegação no document: a procura pode chegar numa zona trocada.
  if (!window.rpEnterLigado) {
    window.rpEnterLigado = true;
    document.addEventListener("keydown", function (event) {
      var campo = event.target;
      if (event.key !== "Enter" || event.defaultPrevented || event.isComposing) return;
      if (!campo || !campo.matches || !campo.matches("#rpFiltros input:not([type=hidden]):not([type=checkbox]):not([type=radio])")) return;
      event.preventDefault();
      if (campo.form.requestSubmit) campo.form.requestSubmit();
      else campo.form.submit();
    });
  }
  // ESCOLHER CLICANDO NA LINHA (Diogo, 27/10/2026, …ArwQ5cxnpV7LsWUeA9PZap: «nunca caixa nem
  // rádio»): a caixa de marcar fica escondida no markup (é o valor que o «Adicionar» envia). Um
  // clique na linha marca ou desmarca e a linha fica mais escura; o duplo clique e o Enter abrem
  // a ficha; o Espaço marca. Por delegação no document: a lista pode chegar numa zona trocada.
  if (!window.rpMarcaLigada) {
    window.rpMarcaLigada = true;
    var rpLinha = function (alvo) {
      return alvo && alvo.closest ? alvo.closest("#rpCandidatas tbody tr[data-dmo-candidata]") : null;
    };
    var rpMarcar = function (linha) {
      var caixa = linha.querySelector("input[data-rp-marca]");
      if (!caixa) return;
      caixa.checked = !caixa.checked;
      linha.setAttribute("aria-selected", caixa.checked ? "true" : "false");
      caixa.dispatchEvent(new Event("change", { bubbles: true }));
    };
    document.addEventListener("click", function (event) {
      var linha = rpLinha(event.target);
      if (!linha || event.target.closest("a,button,select,textarea")) return;
      event.stopPropagation();
      if (event.detail > 1) return;
      rpMarcar(linha);
    }, true);
    document.addEventListener("dblclick", function (event) {
      var linha = rpLinha(event.target);
      if (!linha || !linha.dataset.dmoOpen) return;
      event.stopPropagation();
      rpMarcar(linha);
      window.location.href = linha.dataset.dmoOpen;
    }, true);
    document.addEventListener("keydown", function (event) {
      var linha = rpLinha(event.target);
      if (!linha || event.target !== linha || event.key !== " ") return;
      event.preventDefault();
      rpMarcar(linha);
    });
  }
</script>
