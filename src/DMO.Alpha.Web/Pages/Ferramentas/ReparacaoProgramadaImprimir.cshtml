@page "/Ferramentas/ReparacaoProgramada/Imprimir"
@model DMO.Alpha.Web.Pages.Ferramentas.ReparacaoProgramadaImprimirModel
@using DMO.Alpha.Core.Armazem
@using DMO.Alpha.Web.Pages.Ferramentas
@{
    Layout = null;
    var l = Model.Lista.Lista;
    // Só as que ainda faltam retirar do armazém: nem as que já saíram, nem as que já entraram.
    var porRetirar = Model.Lista.Linhas.Where(i => !i.Saiu && !i.Entrou).ToList();
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Reparação Programada — @l.Reparador</title>
<partial name="_DmoTemaInicial" />
<link rel="stylesheet" href="~/0_ASSET_CANONICAL_DESIGN_SYSTEM.css" asp-append-version="true" />
<style>
.dmo-ferr-ref{font-size:12px;font-weight:500;color:var(--dmo-muted);margin-left:4px}
body{margin:0;padding:24px;background:var(--dmo-page);color:var(--dmo-text);font:14px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.rp-imp-folha{background:var(--dmo-card);border:1px solid var(--dmo-border);border-radius:var(--dmo-r-card);padding:18px;max-width:1100px;margin:0 auto}
.rp-imp-topo{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin:0 0 16px}
h1{font-size:20px;margin:0 0 4px}
.rp-imp-meta{color:var(--dmo-muted);font-size:13px}
.rp-imp-wrap{overflow-x:auto}
html body .rp-imp-folha .dmo-table{width:100%;min-width:0}
html body .rp-imp-folha .dmo-table td{padding:6px 8px;vertical-align:top}
td.rp-imp-visto{width:70px}
html body .rp-imp-folha .dmo-table tbody tr.rp-entrou td{color:var(--dmo-muted);background:var(--dmo-neutral-soft)}
.rp-imp-assina{margin-top:28px;display:flex;gap:40px;flex-wrap:wrap}
.rp-imp-assina div{min-width:220px;border-top:1px solid var(--dmo-text);padding-top:4px;font-size:12px;color:var(--dmo-muted)}
@@media (max-width:600px){body{padding:16px 8px}.rp-imp-folha{padding:12px}.rp-imp-topo{flex-direction:column}}
@@media print{body{padding:0;background:#fff;color:#000}.rp-imp-folha{border:0;padding:0;max-width:none;background:#fff}#rpImpImprimir{display:none}@@page{margin:14mm}tr{break-inside:avoid}html body .rp-imp-folha .dmo-table th,html body .rp-imp-folha .dmo-table td{border:1px solid #888;color:#000}html body .rp-imp-folha .dmo-table tbody tr.rp-entrou td{color:#666;background:#eee}}
</style>
</head>
<body>
  <div class="rp-imp-folha">
  <div class="rp-imp-topo">
    <div>
      <h1 id="rpImpTitulo">Reparação Programada · @l.Reparador</h1>
      <div class="rp-imp-meta">Lista criada a @ReparacaoProgramadaModel.Dia(l.CriadaEmUtc)@(l.CriadaPor is { } por ? $" por {por}" : null) · @porRetirar.Count por retirar de @Model.Lista.Linhas.Count@(l.FechadaEmUtc is { } f ? $" · fechada a {ReparacaoProgramadaModel.Dia(f)}" : null)</div>
    </div>
    <button type="button" class="dmo-button" id="rpImpImprimir" onclick="window.print()">Imprimir</button>
  </div>
  <div class="rp-imp-wrap">
  <table class="dmo-table" id="rpImpLinhas">
    <thead><tr><th>Ferramenta</th><th>% uso</th><th>Linha</th><th>Posição atual</th><th>Estado</th><th>Movimento</th><th>Visto</th></tr></thead>
    <tbody>
    @if (porRetirar.Count == 0)
    {
      <tr id="rpImpNada"><td colspan="7"><em>Nada por retirar: todas as ferramentas já saíram do armazém.</em></td></tr>
    }
    @foreach (var i in porRetirar)
    {
      <tr>
        <td>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.Nome(i.Tipo, i.Referencia, i.Lote)</td>
        <td>@ReparacaoProgramadaModel.Uso(i.Utilizacao)</td>
        <td>@(i.Linhas ?? "—")</td>
        <td>@i.OndeEsta</td>
        <td>@(i.Estado is { } est ? ArmazemTextos.Estado(est) : "—")</td>
        <td>@ReparacaoProgramadaModel.Progresso(i)</td>
        <td class="rp-imp-visto"></td>
      </tr>
    }
    </tbody>
  </table>
  </div>
  <div class="rp-imp-assina"><div>Retirado por</div><div>Data</div></div>
  </div>
  <script>window.addEventListener("load", function () { if (!/[?&]sem_imprimir=1/.test(location.search)) window.print(); });</script>
</body>
</html>
