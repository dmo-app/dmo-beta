@page "/Ferramentas/ReparacaoProgramada/Imprimir"
@model DMO.Alpha.Web.Pages.Ferramentas.ReparacaoProgramadaImprimirModel
@using DMO.Alpha.Core.Armazem
@using DMO.Alpha.Web.Pages.Ferramentas
@{
    Layout = null;
    var l = Model.Lista.Lista;
    // Só as que ainda faltam retirar do armazém: nem as que já saíram, nem as que já entraram.
    var porRetirar = Model.Lista.Linhas.Where(i => !i.Saiu && !i.Entrou).ToList();
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Reparação Programada — @l.Reparador</title>
<partial name="_DmoTemaInicial" />
<link rel="stylesheet" href="~/0_ASSET_CANONICAL_DESIGN_SYSTEM.css" asp-append-version="true" />
@* O «Imprimir» igual aos botões da app (altura, letra, canto e rato por cima). *@
<link rel="stylesheet" href="~/css/dmo-botoes.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/paginas/ferramentas-reparacaoprogramadaimprimir.css" asp-append-version="true">
</head>
<body>
  <div class="rp-imp-folha">
  <div class="rp-imp-topo">
    <div>
      <h1 id="rpImpTitulo">Reparação Programada · @l.Reparador</h1>
      <div class="rp-imp-meta">Lista criada a @ReparacaoProgramadaModel.Dia(l.CriadaEmUtc)@(l.CriadaPor is { } por ? $" por {por}" : null) · @porRetirar.Count por retirar de @Model.Lista.Linhas.Count@(l.FechadaEmUtc is { } f ? $" · fechada a {ReparacaoProgramadaModel.Dia(f)}" : null)</div>
    </div>
    <button type="button" class="dmo-button" id="rpImpImprimir" onclick="window.print()">Imprimir</button>
  </div>
  <div class="rp-imp-wrap">
  <table class="dmo-table" id="rpImpLinhas">
    <thead><tr><th>Ferramenta</th><th>% uso</th><th>Linha</th><th>Posição atual</th><th>Estado</th><th>Movimento</th><th>Visto</th></tr></thead>
    <tbody>
    @if (porRetirar.Count == 0)
    {
      <tr id="rpImpNada"><td colspan="7"><em>Nada por retirar: todas as ferramentas já saíram do armazém.</em></td></tr>
    }
    @foreach (var i in porRetirar)
    {
      <tr>
        <td>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.Nome(i.Tipo, i.Referencia, i.Lote)</td>
        <td>@ReparacaoProgramadaModel.Uso(i.Utilizacao)</td>
        <td>@(i.Linhas ?? "—")</td>
        <td>@i.OndeEsta</td>
        <td>@(i.Estado is { } est ? ArmazemTextos.Estado(est) : "—")</td>
        <td>@ReparacaoProgramadaModel.Progresso(i)</td>
        <td class="rp-imp-visto"></td>
      </tr>
    }
    </tbody>
  </table>
  </div>
  <div class="rp-imp-assina"><div>Retirado por</div><div>Data</div></div>
  </div>
  <script>window.addEventListener("load", function () { if (!/[?&]sem_imprimir=1/.test(location.search)) window.print(); });</script>
</body>
</html>
