@model DMO.Alpha.Web.Pages.Boquilhas.DefinicoesModel
<style>
.bq-def-page{display:flex;flex-direction:column;gap:14px}
.bq-def-card{padding:18px;width:fit-content;min-width:min(420px,100%);max-width:100%}
.bq-def-card h3{margin:0 0 12px;font-size:16px}
.bq-def-card .dmo-card-topo{margin-bottom:10px}
.bq-def-card .dmo-card-topo h3{margin:0}
.bq-def-criar{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin:0 0 14px}
.bq-def-criar .dmo-field{margin:0;min-width:220px}
.bq-def-lado{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap}
@@* Só cinco reparadores à vista; os outros com scroll (Diogo, 21/10/2026). *@@
html body .bq-def-card .dmo-table-wrap{max-width:420px;max-height:calc(5 * 34px + 32px);overflow:auto}
.bq-def-card .dmo-table td{padding:6px 10px;height:34px;box-sizing:border-box}
.bq-def-card tr[data-dmo-ficha]{cursor:pointer}
.bq-def-card tr[data-dmo-ficha]:hover td,.bq-def-card tr[data-dmo-ficha]:focus-visible td{background:var(--dmo-brand-50,#eef4fa)}
.bq-def-ficha .dmo-field{margin:0 0 4px}
.bq-def-ficha .dmo-dialog-actions{justify-content:space-between}
.bq-def-remover{background:var(--dmo-danger)}
.bq-def-excel-topo{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.bq-def-excel-topo h3{margin:0}
#bqDefExcel .card-note{margin:10px 0 0}
html body #bqDefExcel [hidden]{display:none}
/* As linhas B numa coluna e as C noutra (Diogo, 26/10/2026: «linha B de um lado e C do outro»). */
.bq-def-rotas{display:grid;grid-template-columns:repeat(2,minmax(0,160px));grid-template-rows:repeat(3,auto);grid-auto-flow:column;gap:10px 14px}
@@media(max-width:720px){.bq-def-rotas{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
  <div id="bqDefAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.SaveResultMessage.Length > 0)
    {
      <p data-dmo-toast="@(Model.SaveSucceeded ? "ok" : "erro")" role="@(Model.SaveSucceeded ? "status" : "alert")">@Model.SaveResultMessage</p>
    }
  </div>

  <div class="bq-def-lado">
  <section id="bqDefReparadores" class="dmo-card bq-def-card" aria-labelledby="boquilhas-repairers-title" data-dmo-regiao data-dmo-parcial>
    <div class="dmo-card-topo">
    @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
    <h3 id="boquilhas-repairers-title" title="As entidades para onde se enviam as boquilhas; a saída de cada linha usa o reparador configurado para ela. Escreva um nome para procurar; se não existir, «Criar reparador» cria-o. Clicar num reparador abre a ficha dele: mudar o nome ou remover. Mudar o nome não altera os movimentos passados.">Reparadores</h3>
      <div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" id="bqDefCriar" form="bqDefCriarForm">Criar reparador</button></div>
    </div>

    <form id="bqDefCriarForm" method="post" asp-page="/Boquilhas/Definicoes" asp-page-handler="CreateRepairer" class="bq-def-criar">
      <div class="dmo-field">
        <label for="repairerName">Reparador</label>
        <input id="repairerName" name="name" placeholder="Procurar ou criar" autocomplete="off" data-dmo-filtra="bqDefTabelaReparadores" required />
      </div>
    </form>

    @if (Model.Repairers.Count == 0)
    {
      <p><em>Sem reparadores criados. Crie o primeiro para configurar a rota de cada máquina.</em></p>
    }
    else
    {
      @* Um formulário por reparador: se o pedido JSON do nome falhar, o envio
         de recurso leva só este reparador. Com um só para a tabela, levava
         todos, o servidor gravava o primeiro com o nome que já tinha e dizia
         «Definição gravada.» (deep sweep, 18/10/2026, B-boquilhas-3). *@
      <div class="dmo-table-wrap">
        <table id="bqDefTabelaReparadores" class="dmo-table adm-repairer-list">
          @* Sem botões nas linhas (Diogo, 21/10/2026: nas tabelas nunca há
             botões repetidos): o clique ou o Enter abrem a ficha. *@
          <thead><tr><th>Reparador · clique para abrir a ficha</th></tr></thead>
          <tbody>
          @foreach (var repairer in Model.Repairers)
          {
            <tr data-dmo-ficha="bqDefFicha-@repairer.Id" tabindex="0" aria-label="Abrir a ficha do reparador @repairer.Name"><td data-dmo-espelho="bq-reparador-@repairer.Id">@repairer.Name</td></tr>
          }
          </tbody>
        </table>
      </div>
    }
    @* As janelas de remover ficam dentro da zona dos reparadores: criar um
       reparador traz a janela dele sem abrir a página inteira (os botões
       ligam-se por delegação). As saídas já feitas guardam o nome do
       reparador; as linhas que o usavam ficam sem reparador. *@
    @foreach (var repairer in Model.Repairers)
    {
      <dialog id="bqDefRemover-@repairer.Id" class="dmo-dialog" aria-labelledby="bqDefRemoverTitulo-@repairer.Id">
        <h3 id="bqDefRemoverTitulo-@repairer.Id">Remover reparador</h3>
        <p class="dmo-aviso-discreto">Quer mesmo remover «@repairer.Name»? As saídas já feitas continuam com este nome; as máquinas que o usam ficam sem reparador.</p>
        <form method="post" asp-page="/Boquilhas/Definicoes" asp-page-handler="DeleteRepairer">
          <input type="hidden" name="repairer_id" value="@repairer.Id" />
          <div class="dmo-dialog-actions">
            <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
            <button type="submit" class="dmo-button bq-def-remover">Remover</button>
          </div>
        </form>
      </dialog>
    }
    @* A ficha de cada reparador: o nome grava ao sair do campo (um
       formulário por reparador, data-dmo-valor) e remover pede confirmação. *@
    @foreach (var repairer in Model.Repairers)
    {
      <dialog id="bqDefFicha-@repairer.Id" class="dmo-dialog bq-def-ficha" aria-labelledby="bqDefFichaTitulo-@repairer.Id">
        <h3 id="bqDefFichaTitulo-@repairer.Id">Reparador</h3>
        <form id="bqDefReparador-@repairer.Id" method="post" asp-page="/Boquilhas/Definicoes" asp-page-handler="EditRepairer" class="dmo-field">
          <input type="hidden" name="repairer_id" value="@repairer.Id" />
          <label for="bq-reparador-@repairer.Id">Nome</label>
          <input id="bq-reparador-@repairer.Id" class="dmo-valor" data-dmo-valor name="name" value="@repairer.Name" autocomplete="off" aria-label="Nome do reparador @repairer.Name" required />
        </form>
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button bq-def-remover" data-dmo-dialog="bqDefRemover-@repairer.Id" aria-label="Remover o reparador @repairer.Name">Remover reparador</button>
          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Fechar</button>
        </div>
      </dialog>
    }
  </section>

  <section id="bqDefRotas" class="dmo-card bq-def-card" aria-labelledby="boquilhas-routing-title" data-dmo-regiao data-dmo-parcial>
    <h3 id="boquilhas-routing-title" title="O reparador usado pela saída de cada linha (B1 a C3); sem reparador configurado, a saída regista-se na mesma. «— sem reparador —» limpa a rota.">Linhas</h3>

    @if (Model.Repairers.Count == 0)
    {
      <p><em>Sem reparadores criados. Crie o primeiro ao lado para configurar as linhas.</em></p>
    }
    else
    {
      @* Sem botões: escolher o reparador de uma máquina grava logo a rota
         dela (Diogo, 17/10/2026: o dropdown aplica ao escolher). Um
         formulário por máquina: o POST leva só essa rota. Com um só para as
         seis, levava as outras como estavam ao abrir a página e repunha a
         que outra pessoa gravou entretanto (deep sweep, 18/10/2026, A1-M1).
         O id distingue os seis na fila de envios da página. *@
      <div class="bq-def-rotas">
        @foreach (var machineCode in DMO.Alpha.Core.Boquilhas.BqRepairerRouting.MachineCodes)
        {
          var configuredId = Model.MachineRepairerIds.TryGetValue(machineCode, out var value) ? value : null;
          <form id="bqDefRota-@machineCode" class="dmo-field" method="post" asp-page="/Boquilhas/Definicoes" asp-page-handler="SaveMachineRoutes">
            <label for="machine-route-@machineCode">Linha @machineCode</label>
            <select id="machine-route-@machineCode" name="machine_code" class="adm-route-select" data-dmo-autosubmit>
              <option value="@machineCode|">— sem reparador —</option>
              @foreach (var repairer in Model.Repairers)
              {
                <option value="@machineCode|@repairer.Id" selected="@(configuredId == repairer.Id)">@repairer.Name</option>
              }
            </select>
          </form>
        }
      </div>
    }
  </section>

  <section id="bqDefViragem" class="dmo-card bq-def-card" aria-labelledby="boquilhas-viragem-title" data-dmo-regiao data-dmo-parcial>
    <h3 id="boquilhas-viragem-title" title="A partir desta hora, as Boquilhas mostram a nova produção de cada máquina (nunca à meia-noite nem ao criar o Job On). O padrão é 8:00, a manhã da fábrica.">Hora de viragem do dia</h3>
    <form method="post" asp-page="/Boquilhas/Definicoes" asp-page-handler="SaveDayChangeHour">
      <div class="dmo-field">
        <label for="dayChangeHour">Hora de viragem</label>
        <select id="dayChangeHour" name="dayChangeHour" data-dmo-autosubmit>
          @for (var h = 0; h <= 23; h++)
          {
            <option value="@h" selected="@(Model.DayChangeHour == h || (Model.DayChangeHour is null && h == 8))">@h:00</option>
          }
        </select>
      </div>
    </form>
  </section>
  </div>
