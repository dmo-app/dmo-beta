@page "/Boquilhas"
@model DMO.Alpha.Web.Pages.Boquilhas.IndexModel
@using DMO.Alpha.Core.Boquilhas
@using DMO.Alpha.Web.Pages.Shared
@inject DMO.Alpha.Web.Services.CurrentUserCapabilities UserCapabilities
@{
    Layout = "_DmoShellLayout";
    var fmtDate = new Func<DateTime, string>(v =>
        DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(v).ToString("g", System.Globalization.CultureInfo.GetCultureInfo("pt-PT")));
    // A LINGUAGEM DOS MOVIMENTOS (o TYPES do dmo-html): os read models falam
    // DUAS línguas legítimas — os tokens canónicos de armazenamento (o
    // registo) e os nomes do enum (o Histórico). A tradução é UMA só em todo
    // o produto (BqMovementLabels) — o que o ecrã diz é o que o papel diz, e
    // nunca o cru visto pelo operador.
    var movementLabel = new Func<string, string>(BqMovementLabels.Of);
    var activeTab = Model.ShowHistory ? "historico" : Model.ShowFiles ? "boquilhas" : "registo";
}

@section Head {
    @* OS CSS DO PROTOTYPE 31_BOQUILHAS (o Owner 2026-10-13: «esta tudo
       fodido — nao tem css»): a página do transporte nasceu SEM o Head —
       os ficheiros que vestem as classes dele: o beta-adapter (as .tab /
       .lot / .register-search / .beta-light-*), o shell beta, o rail e o
       calendário. *@
    <link rel="stylesheet" href="~/beta-adapter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dmo-boquilhas-prototype.css" asp-append-version="true" />
}

@* O ESQUELETO DO PROTOTYPE 31_BOQUILHAS (o Owner 2026-10-13: «analisa a
   diferença deste ui para o que fizeste e começa a meter similar» — o
   html dele transportado: o layout beta-light com o rail das linhas à
   esquerda, as tabs de vista, as 4 views — com o BACKEND REAL da app. *@
<div class="beta-light-layout beta-bq-layout">
  @* ------------------------------------------------------------------ *@
  @* O RAIL DAS LINHAS (o aside do 31: as máquinas com a produção corrente *@
  @*    — o mesmo componente do Planeamento; os botões do desenho dele).   *@
  @* ------------------------------------------------------------------ *@
  @* Um clique numa máquina abre o registo dela; na vista Registo troca só o
     registo, sem recarregar (data-dmo-parcial; ver a vista Registo). *@

  <main class="main beta-light-main">
    @* AS TABS DE VISTA (o 31: a dmo-secondary-nav com os .tab). *@
    @* A barra de funcoes e gerida por _DmoNavigation/ShellStateFactory (o Codex: a barra duplicada fora). Definicoes fica como acao contextual nos cabecalhos. *@

    @* ---------------------------------------------------------------- *@
    @* VISTA REGISTO — a pesquisa da BQ, o registo aberto, os movimentos. *@
    @* ---------------------------------------------------------------- *@
    @if (activeTab == "registo")
    {
      @* GRAVAR SEM RECARREGAR (Diogo, 17/10/2026: «atualizar só o que muda»;
         o Diogo regista as guias em atraso movimento atrás de movimento).
         Guardar, corrigir e apagar movimentos, associar o Job On e escolher a
         boquilha (no painel lateral ou na procura) trocam só as zonas do
         registo (data-dmo-regiao); a procura fica como o operador a deixou
         (data-dmo-fica). No registo sem Job On, a procura da referência do
         «Associar Job On» também troca só o registo (deep sweep, 18/10/2026;
         as sugestões ligam-se na zona nova desde a beta.172).
         Ver docs/ui-reference/atualizar-so-o-que-muda.md. *@
      var trace = Model.RegistoTrace;
      <section id="registo" class="view active" data-dmo-troca>
        <div class="page-head">
          <div>
            <h2>Boquilhas · Registo de reparação</h2>
            <p>Abra uma boquilha no painel lateral para registar movimentos.</p>
          </div>
        </div>
        @* As linhas por baixo do título, como nos mockups (Owner, 26/10/2026): o mesmo painel, com os mesmos ids e zonas. *@
        <div class="dmo-zona" data-dmo-parcial><partial name="_DmoSidepanelBoquilhas" model="Model.Currents" /></div>

        @* AS ZONAS DO REGISTO (cada uma existe sempre, mesmo vazia): o
           cabeçalho, o formulário do movimento, os números e os últimos
           movimentos. Gravar troca a zona do formulário (volta limpo, a hora
           volta a «agora» e o foco ao primeiro campo, o tipo) e as que
           mudaram. *@
        <div id="bqRegistoAberto" class="dmo-zona" data-dmo-regiao>
        @if (trace is not null)
        {
          <div class="card register-open">
            <div class="card-head">
              <div>
                <h3>Registo — BQ @trace.ToolReference@(trace.ToolLot is null ? null : $" · Lote {trace.ToolLot}")</h3>
              </div>
              <div class="bq-register-head-actions">
                @* «Histórico» fora do menu (Diogo, 22/10/2026): um link à vista
                   que abre o Histórico filtrado por esta BQ e lote (só a BQ,
                   não o MF: a mesma BQ serve várias referências totais). *@
                @* «OPÇÕES» (Diogo, 26/10/2026: «onde tem movimentos meter opções,
                   uma passa a ser os movimentos e outra Alterar lote»). Alterar
                   lote só no bq_id que ainda é o da produção. *@
                @if (trace.ToolId is { } historyToolId)
                {
                  <details class="dmo-options" id="bqRegistoOpcoes">
                    <summary class="dmo-button" aria-label="Opções desta BQ e lote"><span class="dmo-caret" aria-hidden="true"></span>Opções</summary>
                    <div class="dmo-options-list">
                      <a class="dmo-options-item bq-register-history-link" href="/Boquilhas?historico=1&amp;bq_ferramenta=@Uri.EscapeDataString(historyToolId)" title="Movimentos desta BQ e lote">Movimentos</a>
                      @if (Model.LotesParaAlterar is not null)
                      {
                        <button type="button" class="dmo-options-item" id="bqAlterarLoteAbrir" data-dmo-dialog="bq-alterar-lote">Alterar lote</button>
                      }
                    </div>
                  </details>
                  @if (Model.LotesParaAlterar is { } lotes)
                  {
                    <dialog id="bq-alterar-lote" class="dmo-dialog" aria-labelledby="bq-alterar-lote-titulo">
                      <form method="post" asp-page="/Boquilhas/Index" asp-page-handler="AlterarLote">
                        <h3 id="bq-alterar-lote-titulo">Alterar lote<partial name="_DmoHelp" model="@("A BQ desta produção passa para o lote escolhido. Os movimentos já registados ficam no lote antigo e o Job On guarda os dois lotes.")" /></h3>
                        <input type="hidden" name="alterar_bq_id" value="@trace.BqContextId" />
                        @if (lotes.Outros.Count == 0)
                        {
                          <p class="muted" role="status">Não há outro lote da BQ @lotes.Reference em Ferramentas: crie-o lá primeiro, com «Duplicar para lote novo» na ficha desta BQ.</p>
                          <div class="dmo-dialog-actions">
                            <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Fechar</button>
                          </div>
                        }
                        else
                        {
                          <div class="dmo-field">
                            <label for="bqAlterarLoteNovo">BQ @lotes.Reference · lote @DMO.Alpha.Core.Tools.LoteExibido.Mostrar(lotes.Lot) passa para</label>
                            <select id="bqAlterarLoteNovo" name="tool_id" required>
                              @foreach (var outro in lotes.Outros)
                              {
                                <option value="@outro.ToolId">Lote @DMO.Alpha.Core.Tools.LoteExibido.Mostrar(outro.Lot)</option>
                              }
                            </select>
                          </div>
                          <div class="dmo-dialog-actions">
                            <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
                            <button type="submit" class="dmo-button" id="bqAlterarLoteGuardar">Guardar</button>
                          </div>
                        }
                      </form>
                    </dialog>
                  }
                }
              </div>
            </div>
            @* OS CARTÕES DO REGISTO (Diogo, 17/10/2026): só a referência
               total, a BQ com o lote, a produção e as datas; as máquinas
               compatíveis não têm relevância aqui. *@
            @{ var pt = System.Globalization.CultureInfo.GetCultureInfo("pt-PT"); }
            @* OS CARTÕES ABREM O QUE MOSTRAM (Diogo, 26/10/2026: «meter no BQ lote um link para ir à
               ferramenta em questão … metemos um link no resto que leva ao Job On», «o jobon_id, não o
               Job On geral»): a BQ · lote abre a ficha da ferramenta (o Voltar regressa aqui); a
               referência, a produção e as datas abrem esse Job On. O cartão inteiro é o link e enche-se
               com a cor da barra (a.dmo-fact-link). Sem destino, fica o cartão simples. *@
            @{
                // A ficha só para quem tem o módulo Ferramentas (só chefia); os outros veem o cartão simples.
                var fichaDaBq = trace.ToolId is { } fichaToolId && (await UserCapabilities.GetAsync()).Contains(DMO.Alpha.Core.Admin.DmoCapabilities.Ferramentas)
                    ? $"/Ferramentas/Ficha?tool_id={Uri.EscapeDataString(fichaToolId)}"
                    : null;
                var jobOnDoRegisto = Model.ProductionContext?.JobOnId is int jobOnId
                    ? Url.Page("/JobOn/Index", null, new { jobon_id = jobOnId }, null, null, "lightFicha")
                    : null;
                var bqLote = $"{trace.ToolReference}{(trace.ToolLot is null ? null : $" · Lote {trace.ToolLot}")}";
            }
            <div class="dmo-facts" id="bqRegisterFacts">
              @if (Model.ProductionContext is { } production)
              {
                <partial name="_BqRegistoFacto" model="@(("Referência", (string?)production.Reference, jobOnDoRegisto, "Abrir o Job On desta produção", false))" />
                <partial name="_BqRegistoFacto" model="@(("BQ · lote", (string?)bqLote, fichaDaBq, "Abrir a ficha desta BQ", false))" />
                <partial name="_BqRegistoFacto" model="@(("Produção", (string?)production.ProductionNumber, jobOnDoRegisto, "Abrir o Job On desta produção", false))" />
                @* O início e o fim são os do Job On (Diogo, 17/10/2026). Um Job On
                   sem data de início fica com um aviso amarelo discreto: falta
                   um dado que devia existir, e o fim não é «até aviso». *@
                if (production.InicioEm is { } inicio)
                {
                  <partial name="_BqRegistoFacto" model="@(("Início", (string?)inicio.ToString("dd/MM/yyyy", pt), jobOnDoRegisto, "Abrir o Job On desta produção", false))" />
                  <partial name="_BqRegistoFacto" model="@(("Fim", (string?)(production.FimEm?.ToString("dd/MM/yyyy", pt) ?? "Até aviso"), jobOnDoRegisto, "Abrir o Job On desta produção", false))" />
                }
                else
                {
                  <partial name="_BqRegistoFacto" model="@(("Início", (string?)"Sem data no Job On", jobOnDoRegisto, "Abrir o Job On desta produção", true))" />
                  <partial name="_BqRegistoFacto" model="@(("Fim", (string?)(production.FimEm?.ToString("dd/MM/yyyy", pt) ?? "—"), jobOnDoRegisto, "Abrir o Job On desta produção", false))" />
                }
              }
              else
              {
                <partial name="_BqRegistoFacto" model="@(("BQ · lote", (string?)bqLote, fichaDaBq, "Abrir a ficha desta BQ", false))" />
                <div class="dmo-fact"><span>Produção</span><strong>Por associar</strong></div>
              }
            </div>
            @if (Model.JobOnNotice is { } jobOnNotice)
            {
              <partial name="_JobOnChangeNotice" model="jobOnNotice" />
            }

            @* O FORM «Associar Job On a este registo» (o fim do ciclo do
               backfill — o Owner 14/10, verbatim: «criar um jobon, e poder
               associar um registo ao mesmo»; o pendingJobPanel do
               boquilhas.html): o POST pede APENAS FATOS HUMANOS (o nº de
               produção e a referência completa) — a página resolve o bq_id
               e o handler existente faz a associação; os movimentos, as
               datas e o lote mantêm-se. Só no registo ainda SEM produção:
               associado, o card da produção manda no cabeçalho. *@
            @if (trace.BqContextId is null)
            {
              <div class="filter-bar" style="margin:14px 0 0">
                @* Escolher a produção não associa: associa o botão «Associar»,
                   no canto do card (Diogo, 18/10/2026, pergunta 1 do deep
                   sweep). Assim uma escolha errada com o rato corrige-se antes. *@
                <div class="card-head" style="margin-bottom:10px">
                  <div>
                    <h3 style="margin:0">Associar Job On a este registo<partial name="_DmoHelp" model="@("Escreva a referência e escolha-a nas sugestões (ou carregue em Enter). Depois escolha a produção dela e carregue em «Associar». Os movimentos, as datas e o lote mantêm-se.")" /></h3>
                  </div>
                  @if (Model.AssociateProductions.Count > 0)
                  {
                    <button type="submit" form="bqAssociarJobOn" class="btn primary">Associar</button>
                  }
                </div>
                @* Dois passos (16/10/2026; Diogo, 17/10/2026: «referência e
                   depois produções»): a referência e depois só as produções
                   dela. Sem «Procurar»: escolher a sugestão ou o Enter
                   procuram (17/10/2026). A procura troca só o registo
                   (data-dmo-parcial; deep sweep, 18/10/2026): aparecem as
                   produções da referência e o foco fica na referência. *@
                <form method="get" asp-page="/Boquilhas/Index" data-dmo-parcial>
                  <input type="hidden" name="trace_id" value="@trace.BqRepairTraceId" />
                  <div class="filter-grid">
                    <div class="field dmo-field">
                      <label for="jobRef">Referência</label>
                      <input id="jobRef" data-dmo-maiusculas autocapitalize="characters" name="associar_ref" value="@Model.AssociateReference" placeholder="Ex.: 5447T173" data-dmo-suggest="referencias" data-dmo-suggest-submit />
                    </div>
                  </div>
                </form>
                @if (Model.AssociateReferenceWithoutProductions)
                {
                  <div class="jobon-aviso warn" role="status">Sem produções para «@Model.AssociateReference».<partial name="_DmoAvisoLink" model="@DmoAvisoLink.CriarJobOn(Model.AssociateReference)" /></div>
                }
                @if (Model.AssociateProductions.Count > 0)
                {
                  @* «Associar» grava sem recarregar (data-dmo-parcial). *@
                  <form id="bqAssociarJobOn" method="post" asp-page="/Boquilhas/Index" asp-page-handler="AssociateJobOn" data-dmo-parcial>
                    <input type="hidden" name="trace_id" value="@trace.BqRepairTraceId" />
                    <div class="filter-grid">
                      <div class="field dmo-field">
                        <label for="jobNumber">Produção</label>
                        @* Cada produção vai pelo seu Job On: o nº só é único junto com a
                           referência, e o texto escrito no passo 1 pode ser só o início dela
                           (deep sweep 2, F-1, 18/10/2026). *@
                        <select id="jobNumber" name="job_on_id" required aria-label="Produção a associar a este registo">
                          <option value="">Selecionar produção</option>
                          @foreach (var producao in Model.AssociateProductions)
                          {
                            <option value="@producao.JobOnId">@producao.Label</option>
                          }
                        </select>
                      </div>
                    </div>
                  </form>
                }
              </div>
            }

          </div>
        }
        else if (Model.TraceRequestedNotFound)
        {
          <div class="result" role="alert">O registo indicado não existe. Nenhum movimento foi registado.</div>
        }
        else
        {
          <div class="register-empty">Crie ou selecione um lote para ativar as ações do registo.</div>
        }
        </div>

        <div id="bqRegistoMovimento" class="dmo-zona" data-dmo-regiao data-dmo-parcial>
        @if (trace is not null)
        {
          <div class="card bq-movement-card">
            @if (Model.LoteAlterado is { } loteAlterado)
            {
              <div data-dmo-toast="ok" role="status" id="bqLoteAlterado">A BQ passou para o lote @DMO.Alpha.Core.Tools.LoteExibido.Mostrar(loteAlterado). Os movimentos já registados ficam no lote antigo.</div>
            }
            @if (Model.LoteRecusaMessage is { } loteRecusa)
            {
              <div data-dmo-toast="erro" class="result" role="alert">@loteRecusa</div>
            }
            @if (Model.MovementRefusal is not null)
            {
              <div data-dmo-toast="erro" class="result" role="alert">@Model.MovementRefusalMessage</div>
            }

            @* Os avisos (âmbar, nunca bloqueio): o movimento ou a associação
               ficaram gravados e o aviso explica o que foi ajustado. São o
               resultado da gravação: vão para o canto (data-dmo-toast="aviso",
               até se fecharem) e não empurram o formulário (regra 32,
               B-boquilhas-7, deep sweep 18/10/2026). *@
            @if (!Model.EditMovementsMode && Model.OccurrenceShiftWarningMessage is { } shiftWarning)
            {
              <div data-dmo-toast="aviso" role="status">@shiftWarning<partial name="_DmoAvisoLink" model="@(new DmoAvisoLink("Corrigir movimentos", Model.MovementCorrectionHref(trace.BqRepairTraceId, editMode: true) + "#bqLatest"))" /></div>
            }
            @if (!Model.EditMovementsMode && Model.FutureOccurrenceWarningMessage is { } futureWarning)
            {
              <div data-dmo-toast="aviso" role="status">@futureWarning<partial name="_DmoAvisoLink" model="@(new DmoAvisoLink("Corrigir movimentos", Model.MovementCorrectionHref(trace.BqRepairTraceId, editMode: true) + "#bqLatest"))" /></div>
            }

            @* A QUANTIDADE TOTAL DO LOTE EM FALTA (Diogo, 18/10/2026: «não
               apareceu alerta como deveria quando não tem»): aviso âmbar
               discreto, nunca bloqueio; o movimento grava na mesma e a
               Fabricação fica por calcular até a ficha ter a quantidade. *@
            @if (trace.ToolId is { } lotToolId && Model.RegisterLotQuantity is null)
            {
              <div class="jobon-aviso warn" role="status" id="bqLotQuantityMissing">Falta a quantidade total do lote desta BQ. Sem ela, a contagem da reparação não é calculada.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.FichaFerramenta(lotToolId, "Preencher na ficha da ferramenta", continuar: DmoAvisoLink.Aqui(ViewContext.HttpContext.Request))" /></div>
            }

            @if (Model.AssociationWarningMessage is { } associationWarning)
            {
              <div data-dmo-toast="aviso" role="status">@associationWarning</div>
            }

            @if (Model.AssociationRefusal is not null)
            {
              <div data-dmo-toast="erro" class="result" role="alert">@Model.AssociationRefusalMessage</div>
            }

            @if (Model.PendingUnresolvedTraceId is int unresolvedTraceId)
            {
              <p class="muted" role="status">Esta boquilha tem um registo sem Job On com @Model.PendingUnresolvedMovementCount @(Model.PendingUnresolvedMovementCount == 1 ? "movimento" : "movimentos"). Ao guardar o primeiro movimento desta produção, esse registo passa a ser desta produção, com os movimentos que já tem. <a href="@Url.Page("/Boquilhas/Index", null, new { ficheiros = 1, ferramenta = trace.ToolId }, null, null, "bqSemJobOnMovimentos")">Ver os movimentos sem Job On</a></p>
            }

            <form method="post" asp-page="/Boquilhas/Index" asp-page-handler="RegisterMovement" class="bq-movement-form">
              @* A máquina sem registo envia o bq_id: o primeiro movimento cria o registo. *@
              @if (Model.PendingRegisterBqContextId is int pendingBqId)
              {
                <input type="hidden" name="bq_id" value="@pendingBqId" />
              }
              else
              {
                <input type="hidden" name="trace_id" value="@trace.BqRepairTraceId" />
              }
              <div class="dmo-card-topo">
                <h3>Registar Entrada ou Saída<partial name="_DmoHelp" model="@(trace.BqContextId is null ? "Movimento associado à boquilha, lote e máquina. Número e referência de produção em branco." : "Produção, boquilha e lote associados ao movimento.")" /></h3>
              </div>
              @* SEM FOCO AUTOMÁTICO no tipo (Diogo, 22/10/2026): ao voltar do
                 Histórico pelo painel lateral, a «Saída» aparecia com o anel
                 de foco. O anel fica só para o teclado (:focus-visible).
                 A MÁQUINA vem da linha escolhida no painel lateral (o campo
                 «Máquina em uso» saiu do formulário): segue escondida. *@
              @{
                var maquinaDaLinha = Model.MovementMachineId
                    ?? Model.MovementMachines.FirstOrDefault(m => m.Code == Model.ProductionContext?.MachineCode)?.MachineId;
              }
              <input type="hidden" id="movementMachine" name="movement_machine_id" value="@maquinaDaLinha" />
              @* «Registar» à esquerda, antes da «Saída» (Diogo, 27/10/2026, …VhpNpJNmWffCnSnudseTKt);
                 depois o tipo, a quantidade e a data. *@
              <div class="bq-movement-line">
                <button type="submit" class="btn primary bq-line-save" aria-label="Registar o movimento">Registar</button>
                <fieldset class="bq-movement-types">
                  <legend class="visually-hidden">Movimento</legend>
                  <label><input type="radio" name="movement_type" value="saida" checked="@(Model.MovementFormType == "saida")" required /><span>Saída</span></label>
                  <label><input type="radio" name="movement_type" value="entrada" checked="@(Model.MovementFormType == "entrada")" /><span>Entrada</span></label>
                  <label><input type="radio" name="movement_type" value="entrada_sem_reparacao" checked="@(Model.MovementFormType == "entrada_sem_reparacao")" /><span>Entrada sem reparação</span></label>
                </fieldset>
                <div class="field dmo-field bq-line-quantity">
                  <label for="quantity">Quantidade</label>
                  <input id="quantity" name="quantity" type="number" lang="en" min="1" required placeholder="Ex.: 1" value="@Model.MovementFormQuantity" />
                </div>
                @* A DATA/HORA REAL do movimento (o equivalente ao «Data e
                   hora reais *» do boquilhas.html): pre-preenchida com o
                   agora do servidor — o uso diário não toca no campo; o
                   backfill dos ~2 meses de registos passados escreve a
                   data/hora real (o Owner 2026-10-14). Sem ids na folha:
                   o trace_id canónico segue no input hidden. *@
                <div class="field dmo-field bq-line-date">
                  <label for="occurredAt">Data e hora reais</label>
                  <input id="occurredAt" name="occurred_at" type="datetime-local" value="@Model.MovementFormOccurredAt" required />
                </div>
              </div>
            </form>
          </div>
        }
        </div>

        <div id="bqRegistoNumeros" class="dmo-zona" data-dmo-regiao data-dmo-parcial>
        @if (trace is not null)
        {
          <div class="card bq-metrics-card" id="bqMetrics">
            <h3>Valores desta boquilha / lote<partial name="_DmoHelp" model="@("Quantidades calculadas para este lote e contexto, com base na sequência de movimentos; não são stock editável.")" /></h3>
            @* O PAINEL DAS QUANTIDADES CALCULADAS (o card das metrics do
               dmo-html: «Quantidade do lote — Fabricação — Em reparação —
               Discrepância acumulada»): TODOS os valores vêm do backend (a
               quantidade contabilística da Tool e o fold dos movimentos do
               trace — BoquilhasCurrentQuery/BoquilhasRegistoQuery); o Em
               casa é a subtração feita no servidor (Razor), nunca no
               cliente; «—» quando o lote ainda não tem quantidade
               contabilística (truthful, nunca zero inventado). *@
            <div class="lot-data">
              <div><span>Quantidade do lote</span><strong>@(Model.RegisterLotQuantity is int lotQty ? lotQty.ToString() : "—")</strong></div>
              <div><span>Fabricação</span><strong>@(Model.RegisterLotQuantity is int lote && lote >= trace.QuantityLegitimatelyOut ? (lote - trace.QuantityLegitimatelyOut).ToString() : "—")</strong></div>
              <div><span>Em reparação</span><strong>@trace.QuantityLegitimatelyOut</strong></div>
              @* POSTA A ZERO (Diogo, 17/10/2026: «ao carregar nela poder fazer
                 reset»): um clique no valor abre a janela; depois conta só os
                 movimentos com data real posterior. *@
              @{
                var resetNote = Model.DiscrepancyResetNote;
                var resettable = trace.AccumulatedDiscrepancy is int nonZero && nonZero != 0 && trace.BqRepairTraceId > 0;
              }
              <div><span>@("Discrepância acumulada")@if (resetNote.Length > 0) {<partial name="_DmoHelp" model="resetNote" />}</span><strong>@if (resettable) {<a class="bq-reset-link" href="@(Model.DiscrepancyResetHref(trace.BqRepairTraceId, open: true))#bqMetrics" aria-label="Discrepância acumulada @trace.AccumulatedDiscrepancy — um clique para meter a zero">@trace.AccumulatedDiscrepancy</a>} else {@(trace.AccumulatedDiscrepancy is int shown ? shown.ToString() : "—")}</strong></div>
            </div>
            @if (Model.DiscrepancyResetOpen && trace.BqRepairTraceId > 0 && trace.AccumulatedDiscrepancy is int toReset && toReset != 0)
            {
              <div class="dmo-modal-backdrop open" id="bqDiscrepancyReset" role="dialog" aria-modal="true" aria-labelledby="bqDiscrepancyResetTitle">
                <div class="dmo-modal bq-reset-modal">
                  <div class="dmo-modal-head">
                    <h2 id="bqDiscrepancyResetTitle">Meter a discrepância a zero?<partial name="_DmoHelp" model="@("A discrepância acumulada passa a 0 e conta só os movimentos com data e hora depois de agora. Os movimentos, o saldo de cada linha e o «Em reparação» ficam como estão.")" /></h2>
                  </div>
                  <div class="dmo-modal-body">
                    <p>BQ @trace.ToolReference@(trace.ToolLot is null ? null : $" · Lote {trace.ToolLot}") · discrepância acumulada @toReset</p>
                    <div class="dmo-list-actions bq-correct-actions">
                      <form method="post" asp-page="/Boquilhas/Index" asp-page-handler="ResetDiscrepancy">
                        <input type="hidden" name="trace_id" value="@trace.BqRepairTraceId" />
                        <button type="submit" class="btn primary">Meter a zero</button>
                      </form>
                      <a class="btn" autofocus href="@(Model.DiscrepancyResetHref(trace.BqRepairTraceId, open: false))#bqMetrics">Cancelar</a>
                    </div>
                  </div>
                </div>
              </div>
            }

          </div>
        }
        </div>

        <div id="bqRegistoMovimentos" class="dmo-zona" data-dmo-regiao data-dmo-parcial>
        @if (trace is not null)
        {
          <div class="card bq-latest-card">
            @* OS ÚLTIMOS MOVIMENTOS (o html: «Últimos movimentos desta
               boquilha / produção — Mais recentes primeiro»; o facto
               humano: «Cada movimento mantém o lote, a máquina, a data e o
               reparador»): a DATA/HORA REAL do movimento (o OccurredAtUtc
               que o read model transporta — a lacuna apontada pelo R-A1),
               o reparador CONGELADO da saída e o Saldo (a discrepância
               anotada — «só aparece numa Entrada excecional», nunca zero
               exibido como facto). *@
              <div class="card-head bq-latest-head" id="bqLatest">
                <div>
                  <h3>Últimos movimentos desta boquilha / produção<partial name="_DmoHelp" model="@("Mais recentes primeiro, pela data e hora reais (à mesma hora, a saída conta antes da entrada), seja qual for a ordem em que foram registados; as contas refazem-se a cada movimento. O Saldo só aparece numa Entrada excecional e é negativo quando regressa mais quantidade do que pode ser justificada pelas Saídas anteriores. Não é o stock.")" /></h3>
                </div>
                @if (trace.MovementCount > 0)
                {
                  <a class="btn" href="@(Model.MovementCorrectionHref(trace.BqRepairTraceId, editMode: true))#bqLatest">Corrigir movimentos</a>
                }
              </div>
            @if (trace.MovementCount > 0)
            {
              @* As quantidades do registo contam todos os movimentos; a
                 consulta traz só os 25 da página que se vê. *@
              var traceMovementsPage = trace.MovementsPage;
              @* Cada linha diz a BQ e o lote (Diogo, 17/10/2026: ao descer
                 deixava de se ver qual estava a ser registada). *@
              void MovementCells(BoquilhasRegistoMovement movement)
              {
                <td>@fmtDate(movement.OccurredAtUtc)</td>
                <td>@trace.ToolReference@(trace.ToolLot is null ? null : $" · Lote {trace.ToolLot}")</td>
                <td>@movementLabel(movement.MovementType)</td>
                <td>@movement.Quantity</td>
                <td>@(movement.MachineCodeFrozen ?? "—")</td>
                <td>@(movement.BqRepairerNameFrozen ?? "—")</td>
                <td>@(movement.Discrepancy is int disc ? disc.ToString() : "—")</td>
              }
              const string movementsHead = "<tr><th>Data/hora</th><th>BQ · lote</th><th>Movimento</th><th>Qtd.</th><th>Máquina</th><th>Reparador</th><th>Saldo</th></tr>";
              <div class="dmo-table-wrap">
                <table class="dmo-table" id="bqTraceMovements">
                  <thead>@Html.Raw(movementsHead)</thead>
                  <tbody>
                    @foreach (var movement in traceMovementsPage.Items)
                    {
                      <tr>
                        @{ MovementCells(movement); }
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
              <partial name="_ListPager" model='ListPager.For(traceMovementsPage, "mov_pagina")' />

              @* CORRIGIR NUMA JANELA (Diogo, 17/10/2026: «corrigir deveria ser
                 uma pequena janela que abre os últimos movimentos»): o modo de
                 correção abre por cima da página, com os movimentos
                 selecionáveis e o movimento aberto com um clique. Fechar
                 volta aos últimos movimentos (#bqLatest). *@
              @if (Model.EditMovementsMode)
              {
                <div class="dmo-modal-backdrop open" id="bqCorrectMovements" role="dialog" aria-modal="true" aria-labelledby="bqCorrectTitle">
                  <div class="dmo-modal bq-correct-modal">
                    <div class="dmo-modal-head">
                      <h2 id="bqCorrectTitle">Corrigir movimentos — BQ @trace.ToolReference@(trace.ToolLot is null ? null : $" · Lote {trace.ToolLot}")<partial name="_DmoHelp" model="@($"Um clique abre o movimento para corrigir ou apagar. Ao apagar, a contagem e as discrepâncias do registo são recalculadas pela data real.")" /></h2>
                      @* O foco na janela: no tipo do movimento aberto, senão no «Fechar». *@
                      <a class="btn bq-correct-close" autofocus="@(Model.EditingMovement is null ? "autofocus" : null)" href="@(Model.MovementCorrectionHref(trace.BqRepairTraceId, editMode: false))#bqLatest">Fechar</a>
                    </div>
                    <div class="dmo-modal-body">
              @if (Model.EditRefusalMessage is { Length: > 0 } editRefusalMessage)
              {
                <div data-dmo-toast="erro" class="result" role="alert">@editRefusalMessage</div>
              }
              @if (Model.OccurrenceShiftWarningMessage is { } editShiftWarning)
              {
                <div data-dmo-toast="aviso" role="status">@editShiftWarning</div>
              }
              @if (Model.FutureOccurrenceWarningMessage is { } editFutureWarning)
              {
                <div data-dmo-toast="aviso" role="status">@editFutureWarning</div>
              }
              @if (Model.EditingMovement is { } editing)
              {
                @* A correção do movimento aberto com um clique; apagar só nos mais recentes. *@
                @* As ações da correção no canto superior direito, ao lado do título
                   (Diogo, 18/10/2026: «sempre canto superior direito dentro dos
                   cards»), afastadas dos campos e da tabela. Ficam fora do
                   formulário da correção porque o «Apagar» é outro formulário. *@
                <div class="dmo-card-topo bq-correct-topo">
                  <h3>Corrigir movimento</h3>
                  <div class="dmo-card-topo-acoes bq-correct-actions">
                    <button type="submit" class="btn primary" form="bqEditMovement">Guardar correção</button>
                    @* Apagar pede confirmação na janela da app, não na do browser. *@
                    <button type="button" class="btn" data-dmo-dialog="bq-apagar-movimento">Apagar movimento</button>
                    <dialog id="bq-apagar-movimento" class="dmo-dialog" aria-labelledby="bq-apagar-movimento-titulo">
                      <h3 id="bq-apagar-movimento-titulo">Apagar movimento</h3>
                      <p>Apagar este movimento? A contagem do registo é recalculada.</p>
                      <form method="post" asp-page="/Boquilhas/Index" asp-page-handler="DeleteMovement">
                        <input type="hidden" name="trace_id" value="@trace.BqRepairTraceId" />
                        <input type="hidden" name="movement_id" value="@editing.MovementId" />
                        <div class="dmo-dialog-actions">
                          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
                          <button type="submit" class="dmo-button">Apagar</button>
                        </div>
                      </form>
                    </dialog>
                    <a class="btn" href="@(Model.MovementCorrectionHref(trace.BqRepairTraceId, editMode: true))#bqLatest">Cancelar</a>
                  </div>
                </div>
                <form method="post" asp-page="/Boquilhas/Index" asp-page-handler="EditMovement" class="bq-movement-form" id="bqEditMovement">
                  <input type="hidden" name="trace_id" value="@trace.BqRepairTraceId" />
                  <input type="hidden" name="movement_id" value="@editing.MovementId" />
                  @if (Model.EditingMovementCorrectionNote is { Length: > 0 } correctionNote)
                  {
                    <p class="muted" id="bqMovementCorrectedBy" style="margin:0 0 8px">@correctionNote</p>
                  }
                  @* Os tipos com o tamanho do texto e a quantidade e a data na mesma
                     linha, como no Registar (Diogo, 26/10/2026: «botões de registo muito
                     grandes, meter tudo numa linha»). *@
                  <div class="bq-movement-line">
                  <fieldset class="bq-movement-types">
                    <legend class="visually-hidden">Movimento</legend>
                    <label><input type="radio" name="movement_type" value="saida" checked="@(editing.MovementType == "saida")" autofocus="@(editing.MovementType == "saida" ? "autofocus" : null)" required /><span>Saída</span></label>
                    <label><input type="radio" name="movement_type" value="entrada" checked="@(editing.MovementType == "entrada")" autofocus="@(editing.MovementType == "entrada" ? "autofocus" : null)" /><span>Entrada</span></label>
                    <label><input type="radio" name="movement_type" value="entrada_sem_reparacao" checked="@(editing.MovementType == "entrada_sem_reparacao")" autofocus="@(editing.MovementType == "entrada_sem_reparacao" ? "autofocus" : null)" /><span>Entrada sem reparação</span></label>
                  </fieldset>
                    <div class="field dmo-field bq-line-quantity">
                      <label for="editQuantity">Quantidade</label>
                      <input id="editQuantity" name="quantity" type="number" lang="en" min="1" required value="@editing.Quantity" />
                    </div>
                    <div class="field dmo-field bq-line-date">
                      <label for="editOccurredAt">Data e hora reais</label>
                      <input id="editOccurredAt" name="occurred_at" type="datetime-local" value="@Model.EditingMovementOccurredAt" required />
                    </div>
                  </div>
                </form>
              }
                                  <div class="dmo-table-wrap" style="margin-top:10px">
                        <table class="dmo-table" id="bqCorrectList" data-dmo-list="Movimentos">
                          <thead>@Html.Raw(movementsHead)</thead>
                          <tbody>
                            @foreach (var movement in traceMovementsPage.Items)
                            {
                              <tr data-dmo-row data-id="@movement.MovementId"
                                  data-dmo-open="@(Model.MovementCorrectionHref(trace.BqRepairTraceId, editMode: true, movement.MovementId))#bqLatest"
                                  class="@(Model.EditingMovement?.MovementId == movement.MovementId ? "selected" : null)"
                                  aria-label="Movimento de @fmtDate(movement.OccurredAtUtc) — um clique abre">
                                @{ MovementCells(movement); }
                              </tr>
                            }
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              }
            }
            else
            {
              <p class="muted" style="margin:12px 0 0">Ainda sem movimentos neste registo.</p>
            }


            @* ONDE ESTA BOQUILHA FOI USADA (Diogo, 17/10/2026: «não deve estar
               constantemente visível nos registos, pode ficar em opções»):
               abre numa janela a partir de «Opções» do registo. *@
            @if (Model.JobHistoryOpen && Model.JobHistory is { } history && history.TotalCount > 0)
            {
              <div class="dmo-modal-backdrop open" id="bqJobHistory" role="dialog" aria-modal="true" aria-labelledby="bqJobHistoryTitle">
                <div class="dmo-modal bq-correct-modal">
                  <div class="dmo-modal-head">
                    <h2 id="bqJobHistoryTitle">Onde esta boquilha foi usada — BQ @trace.ToolReference@(trace.ToolLot is null ? null : $" · Lote {trace.ToolLot}")</h2>
                    <a class="btn bq-correct-close" autofocus href="@Model.JobHistoryHref(open: false)">Fechar</a>
                  </div>
                  <div class="dmo-modal-body">
                    <div class="dmo-table-wrap">
                      <table class="dmo-table">
                        <thead>
                          <tr><th>Nº de produção</th><th>Referência</th><th>Máquina</th></tr>
                        </thead>
                        <tbody>
                          @foreach (var job in history.Items)
                          {
                            <tr>
                              <td>@job.ProductionNumber</td>
                              <td>@job.Reference</td>
                              <td>@job.MachineCode</td>
                            </tr>
                          }
                        </tbody>
                      </table>
                    </div>
                    <partial name="_ListPager" model='ListPager.For(history, "usos_pagina")' />
                  </div>
                </div>
              </div>
            }
          </div>
        }
        </div>
      </section>
    }

    @* ---------------------------------------------------------------- *@
    @* VISTA BOQUILHAS (os ficheiros: os lotes com os estados — o 31) e  *@
    @* A FICHA DA FERRAMENTA (o toolsTab do dmo-html: a ficha única por  *@
    @* BQ/lote, o «+ Registo com data antiga» e os registos dela).       *@
    @* ---------------------------------------------------------------- *@
    @if (activeTab == "boquilhas")
    {
      <section id="boquilhas" class="view active" data-dmo-troca>
        <partial name="_BqToolCatalog" model="Model" />
        <partial name="_BqSemJobOn" model="Model" />
        <div id="bq-catalog-sheet" data-dmo-regiao>
          <partial name="_BqToolSheet" model="Model" />
        </div>
      </section>
    }

    @* ---------------------------------------------------------------- *@
    @* VISTA HISTÓRICO (o historyTab do dmo-html): o calendário ligado,  *@
    @* os filtros do html, os contadores do filtro e as três vistas —    *@
    @* por máquina / Job On, o resumo diário e os movimentos detalhados. *@
    @* ---------------------------------------------------------------- *@
    @if (activeTab == "historico")
    {
      @* Atualizar só o que muda (Diogo, 18/10: «faz flash ao escolher dia do
         calendário»): um clique no calendário, no «Hoje», no «Todos os dias»
         ou na paginação troca só as zonas (data-dmo-regiao) que mudaram.
         Os filtros também (deep sweep, 18/10/2026): cada escolha pede a
         página com fetch e troca a lista, os totais, o dia e a contagem; os
         campos ficam como o operador os deixou (data-dmo-fica), com o foco
         no campo. *@
      <section id="historico" class="view active" data-dmo-troca>
        @{
          var houseMachines = new[] { "B1", "B2", "B3", "C1", "C2", "C3" };
          var viewHelp = Model.ShowMatrix
            ? "Dias em linhas, máquinas em colunas, todos os dias do período. As mudanças de BQ/lote aparecem separadas na mesma célula, em quantidade de BQs. Um clique numa referência abre o registo. O PDF usa esta vista."
            : Model.ShowMovements
            ? "Todos os movimentos do filtro, um por linha, do mais recente para o mais antigo. Um clique num dia do calendário mostra os movimentos desse dia; um clique numa linha abre a ficha da ferramenta. O PDF usa esta lista."
            : "Os movimentos agrupados por máquina, Job On e BQ/lote, cada grupo com o seu cabeçalho. Um clique num dia do calendário mostra as fichas de BQ usadas nesse dia; um clique numa ficha abre-a com todos os movimentos. O PDF mantém estes cabeçalhos.";
          // Só «ver»: as linhas não abrem nada, a ajuda não o promete.
          if (Model.OnlyView)
          {
            viewHelp = "Os movimentos do filtro, do mais recente para o mais antigo. Um clique num dia do calendário ou numa linha do painel filtra a lista. O PDF usa esta lista.";
          }
        }
        <div class="page-head">
          <div>
            <h2>Movimentos<partial name="_DmoHelp" model="@("Todos os movimentos, incluindo produções já retiradas do painel. A vista, a máquina, o tipo e as datas aplicam-se logo; a pesquisa e o reparador aplicam-se ao escrever. O mês muda-se no calendário.")" /></h2>
          </div>
          <div class="bq-page-actions"></div>
        </div>
        @* As linhas por baixo do título, como nos mockups (Owner, 26/10/2026): o mesmo painel, com os mesmos ids e zonas. *@
        <div class="dmo-zona" data-dmo-parcial><partial name="_DmoSidepanelBoquilhas" model="Model.Currents" /></div>

        @* Os campos ficam (data-dmo-fica); trocam só as zonas de dentro: o
           mês e o dia do calendário (escondidos), a contagem, os links (com
           os filtros atuais), a dica da vista e as datas, que o calendário,
           o «Hoje» e o «Todos os dias» limpam. «Limpar filtros» e o PDF abrem
           como sempre (data-dmo-completa). A pesquisa e o reparador aplicam-se
           ao escrever, 350 ms depois da última tecla (data-dmo-ao-escrever;
           deep sweep 2, 18/10/2026, F-10): antes o texto escrito sem Enter
           ficava no campo, mas a lista, a contagem e o PDF eram do filtro
           anterior. *@
        <div id="bqHistFiltros" class="dmo-zona" data-dmo-fica data-dmo-parcial>
        <div class="card bq-history-filters">
          <form method="get" asp-page="/Boquilhas/Index" id="bqHistoryFilters" data-dmo-ao-escrever="bqHistLista">
            <input type="hidden" name="historico" value="1" />
            <div id="bqHistContexto" class="dmo-zona" data-dmo-regiao>
            <input type="hidden" name="ano" value="@Model.HistoryYear" />
            <input type="hidden" name="mes" value="@Model.HistoryMonth" />
            @if (!Model.HistoryDayIsDefault && Model.HistoryDay is { } selectedDay)
            {
              <input type="hidden" name="dia" value="@selectedDay.Day" />
            }
            @if (Model.FilterJobOnId is int filterJobOnId)
            {
              <input type="hidden" name="jobon_id" value="@filterJobOnId" />
            }
            </div>
            @* Diogo, 18/10: a contagem e os botões no canto superior direito do
               card; os campos todos numa linha, a vista num dropdown antes da
               referência e sem «Selecionar mês» (o mês muda-se no calendário). *@
            <div class="bq-history-filters-head">
              <div id="bqHistContagem" class="dmo-zona" data-dmo-regiao>
              @if (Model.FilterJobOnLabel is { } filterJobOnLabel)
              {
                @* O filtro da produção (o painel das linhas): a produção e a linha, e o link para o tirar. *@
                @* Sem «Tirar filtro» (Diogo, 24/10/2026): o «Limpar filtros» tira-o. *@
                <span class="bq-history-tool-filter" data-dmo-filtro-producao>@filterJobOnLabel</span>
              }
              @if (Model.ShowMatrix || Model.HistorySearchApplied)
              {
                @if (Model.ListLimitWarning is { } limitWarning)
                {
                  @* Só filtros, sem período: os mais recentes, com a explicação na dica. *@
                  <span class="muted bq-history-count" role="status">Os @Model.HistoryMovementCount mais recentes<partial name="_DmoHelp" model="@limitWarning" /></span>
                }
                else
                {
                  <span class="muted bq-history-count" role="status">@Model.HistoryMovementCount @(Model.HistoryMovementCount == 1 ? "movimento" : "movimentos")</span>
                }
              }
              </div>
              <div id="bqHistAcoes" class="bq-history-actions" data-dmo-regiao data-dmo-completa>
                <a class="btn" href="/Boquilhas?historico=1&amp;vista=@Model.HistoryView">Limpar filtros</a>
                <a class="btn" href="@Model.PdfContextualHref" title="Imprimir / PDF (filtros atuais)">Imprimir / PDF</a>
              </div>
            </div>
            <div class="bq-history-filter-grid">
              <div class="field dmo-field"><label for="vista">Vista<span id="bqHistVistaAjuda" data-dmo-regiao><partial name="_DmoHelp" model="@viewHelp" /></span></label><select id="vista" name="vista" data-dmo-autosubmit>
                <option value="grupos" selected="@Model.ShowGrouped">Por linha / Job On</option>
                <option value="matriz" selected="@Model.ShowMatrix">Resumo diário · 6 máquinas</option>
                <option value="movimentos" selected="@Model.ShowMovements">Movimentos detalhados</option>
              </select></div>
              @* Referência e Lote em dois campos (Diogo, 24/10/2026); uma BQ escolhida noutro sítio vem preenchida aqui. *@
              <div class="field dmo-field"><label for="pesquisa">Referência</label><input id="pesquisa" data-dmo-maiusculas autocapitalize="characters" name="pesquisa" value="@Model.FilterText" placeholder="Ex.: T173" data-dmo-suggest="referencias_bq" data-dmo-suggest-submit /></div>
              <div class="field dmo-field"><label for="lote">Lote</label><input id="lote" name="lote" value="@Model.FilterLote" inputmode="numeric" autocomplete="off" placeholder="Ex.: 182" /></div>
              <div class="field dmo-field"><label for="maquina">Linha</label><select id="maquina" name="maquina" data-dmo-autosubmit><option value="">Todas</option>
                @foreach (var code in houseMachines)
                { <option value="@code" selected="@(Model.FilterMachine == code)">@code</option> }
              </select></div>
              <div class="field dmo-field"><label for="tipo">Tipo</label><select id="tipo" name="tipo" data-dmo-autosubmit>
                <option value="">Todos</option><option value="saida" selected="@(Model.FilterType == "saida")">Saída</option><option value="entrada" selected="@(Model.FilterType == "entrada")">Entrada</option><option value="entrada_sem_reparacao" selected="@(Model.FilterType == "entrada_sem_reparacao")">Sem reparação</option>
              </select></div>
              <div class="field dmo-field"><label for="reparador">Reparador</label><input id="reparador" name="reparador" value="@Model.FilterOperator" data-dmo-suggest="reparadores" data-dmo-suggest-submit /></div>
              <div id="bqHistDesdeZona" class="field dmo-field" data-dmo-regiao><label for="desde">Desde</label><input id="desde" name="desde" type="date" value="@(Model.FilterDesde?.ToString("yyyy-MM-dd"))" data-dmo-autosubmit /></div>
              <div id="bqHistAteZona" class="field dmo-field" data-dmo-regiao><label for="ate">Até</label><input id="ate" name="ate" type="date" value="@(Model.FilterAte?.ToString("yyyy-MM-dd"))" data-dmo-autosubmit /></div>
            </div>
          </form>
        </div>
        </div>

        @* O cartão do dia só existe na vista por máquina: uma zona que existe
           sempre, para mudar de vista trocar só as zonas. *@
        <div id="bqHistDiaCartao" class="dmo-zona" data-dmo-regiao>
        @if (!Model.ShowMatrix)
        {
          @* O DIA DO CALENDÁRIO (Diogo, 17/10): como as «Produções do dia» do
             Job On, uma linha por máquina na cor dela, com as fichas de BQ
             usadas nesse dia. Os movimentos todos estão na ficha. *@
          <div class="card bq-history-day">
            <div class="bq-history-day-grid">
              <div id="bqHistDia" class="bq-day-summary" data-dmo-regiao>
                <h3>@(Model.HistoryDay is { } titleDay ? $"Registo da {titleDay:dd/MM/yyyy}" : "Registo do dia")<partial name="_DmoHelp" model="@(Model.OnlyView ? "Clique num dia do calendário para ver as fichas de BQ usadas nesse dia, por linha. Clique outra vez no dia escolhido para tirar a seleção." : "Clique num dia do calendário para ver as fichas de BQ usadas nesse dia, por máquina. Clique outra vez no dia escolhido para tirar a seleção. Um clique ou Enter numa ficha abre-a com a produção, a máquina e todos os movimentos.")" /></h3>
                @if (Model.HistoryDay is null)
                {
                  <p class="muted">Escolha um dia no calendário.</p>
                }
                else
                {
                  <div class="beta-light-list beta-light-productions" data-dmo-list="Fichas de BQ usadas no dia">
                    @foreach (var machine in houseMachines.Cast<string?>().Append(null))
                    {
                      var machineGroups = Model.DayGroups.Where(g => g.MachineCode == machine).ToList();
                      if (machine is null && machineGroups.Count == 0)
                      {
                        continue;
                      }
                      <div class="beta-light-machine-row mch-@(machine ?? "none")">
                        @if (machineGroups.Count == 0)
                        {
                          <span class="beta-light-machine-empty" aria-label="@machine sem fichas neste dia"><strong>@machine</strong></span>
                        }
                        @foreach (var group in machineGroups)
                        {
                          <div class="beta-light-production" data-dmo-row data-id="@group.TraceId"
                               @(Model.OnlyView ? null : Html.Raw("data-dmo-open=\"" + System.Text.Encodings.Web.HtmlEncoder.Default.Encode((Url.Page("/Boquilhas/Index", new { trace_id = group.TraceId })) ?? string.Empty) + "\""))
                               aria-label="Ficha da BQ @group.ToolReference, lote @group.ToolLot na @(machine ?? "máquina por indicar") — selecionar e abrir">
                            <input type="radio" name="bq_day_trace" value="@group.TraceId" class="dmo-visually-hidden" aria-label="Ficha da BQ @group.ToolReference" />
                            <strong>@(machine ?? "Sem máquina")</strong>
                            <span>@(group.Reference ?? group.ToolReference)</span>
                            <span>@group.ToolReference · Lote @group.ToolLot</span>
                            <span>@(group.ProductionNumber is { } number ? $"Produção {number}" : "Sem Job On")</span>
                          </div>
                        }
                      </div>
                    }
                  </div>
                }
              </div>
              <div>
                @* «Hoje» e «Todos os dias» no canto superior direito do cartão,
                   na linha do título, por cima do calendário e não por baixo
                   (Diogo, 18/10/2026: «metem os botões em baixo aumenta
                   espaço, sempre canto superior direito dentro dos cards»). *@
                <div id="bqHistDiaAcoes" class="dmo-card-topo-acoes bq-calendar-actions" data-dmo-regiao data-dmo-parcial><a class="btn" href="@Model.HistoryTodayHref">Hoje</a><a class="btn" href="@Model.HistoryAllDaysHref">Todos os dias</a></div>
                <partial name="_DmoCalendar" model="Model.HistoryCalendar" />
              </div>
            </div>
          </div>
        }
        </div>
        <div id="bqHistTotais" class="card bq-metrics-card" data-dmo-regiao>
          <div class="lot-data">
            <div><span>Saídas</span><strong>@Model.FilteredSaidas</strong></div>
            <div><span>Entradas</span><strong>@Model.FilteredEntradas</strong></div>
            <div><span>Entradas sem reparação</span><strong>@Model.FilteredSemReparacao</strong></div>
          </div>
          <div class="dmo-help-corner"><partial name="_DmoHelp" model="@("Totais de movimentos do filtro, não saldos de stock.")" /></div>
        </div>

        <div id="bqHistLista" class="dmo-zona" data-dmo-regiao>
        @if (Model.ShowMatrix)
        {
            @* A GRELHA DO RESUMO DIÁRIO (o read model do backend — nada
               calculado no cliente): todos os dias do período na vertical,
               B1..C3 na horizontal, cada registo separado quando há mudança
               na mesma máquina; E = Entradas de reparação, S = Saídas,
               SR = Entradas sem reparação (zeros omitidos). O read model é o
               que o PDF da A5 consome — o gerador só formata. *@
            <div class="card movement-card">
              <div class="card-head bq-history-card-head">
                <h3>Resumo diário — B1, B2, B3, C1, C2, C3</h3>
                <span class="date-chip">Período: @Model.MatrixPeriodLabel</span>
              </div>
              @if (Model.MatrixPeriodWarning is { } periodWarning)
              {
                <div class="jobon-aviso warn" role="status" style="margin:12px 20px">@periodWarning</div>
              }
              @* Os movimentos sem máquina não têm coluna na grelha, mas contam
                 nos totais por cima (sweep de 19/10/2026, B-2): o link abre a
                 lista do mesmo período, onde estão em «Máquina Por indicar». *@
              @if (Model.MatrixWithoutMachineWarning is { } semMaquina && Model.MatrixWithoutMachineHref is { } semMaquinaHref)
              {
                <div class="jobon-aviso warn" role="status" style="margin:12px 20px">@semMaquina<partial name="_DmoAvisoLink" model="@(new DmoAvisoLink("Ver os movimentos", semMaquinaHref))" /></div>
              }
              <div class="dmo-table-wrap">
                <table class="dmo-table dmo-matrix" data-dmo-list="Resumo diário por máquina">
                  <thead>
                    <tr><th>Dia</th>@foreach (var machine in houseMachines) { <th>@machine</th> }</tr>
                  </thead>
                  <tbody>
                    @foreach (var matrixDay in Model.MatrixDays)
                    {
                      var dayEntries = Model.MatrixEntries.Where(e => e.Day == matrixDay).ToList();
                      <tr>
                        <td><strong>@matrixDay.ToString("dd/MM")</strong><div class="muted dmo-matrix-weekday">@matrixDay.ToString("dddd", System.Globalization.CultureInfo.GetCultureInfo("pt-PT")).Replace("-feira", "")</div></td>
                        @foreach (var machine in houseMachines)
                        {
                          var cellEntries = dayEntries.Where(e => e.MachineCode == machine).ToList();
                          <td>
                            @if (cellEntries.Count == 0)
                            {
                              <span class="muted">—</span>
                            }
                            else
                            {
                              @foreach (var entry in cellEntries)
                              {
                                <div data-dmo-row data-id="@entry.BqRepairTraceId"
                                      @(Model.OnlyView ? null : Html.Raw("data-dmo-open=\"" + System.Text.Encodings.Web.HtmlEncoder.Default.Encode((Url.Page("/Boquilhas/Index", new { trace_id = entry.BqRepairTraceId })) ?? string.Empty) + "\""))
                                      title="Um clique ou Enter abre o registo">
                                  <div><strong>@(entry.ProductionReference ?? entry.ToolReference)</strong></div>
                                  <div class="muted">BQ @entry.ToolReference@(entry.ToolLot is { } el ? $" · Lote {el}" : null)@(entry.ProductionNumber is string ejn ? $" · JO {ejn}" : " · Sem Job On")</div>
                                  <div class="muted">
                                    @if (entry.EntradasQuantidade > 0)
                                    {
                                      <span class="entry-e">E @entry.EntradasQuantidade</span>
                                    }
                                    @if (entry.SaidasQuantidade > 0)
                                    {
                                      <span class="entry-s">S @entry.SaidasQuantidade</span>
                                    }
                                    @if (entry.EntradasSemReparacaoQuantidade > 0)
                                    {
                                      <span class="entry-r">SR @entry.EntradasSemReparacaoQuantidade</span>
                                    }
                                    @if (entry.EntradasQuantidade == 0 && entry.SaidasQuantidade == 0 && entry.EntradasSemReparacaoQuantidade == 0)
                                    {
                                      <text>—</text>
                                    }
                                  </div>
                                </div>
                              }
                            }
                          </td>
                        }
                      </tr>
                    }
                  </tbody>
                  <tfoot>
                    <tr>
                      <td><strong>Total</strong></td>
                      @foreach (var machine in houseMachines)
                      {
                        var machineEntries = Model.MatrixEntries.Where(e => e.MachineCode == machine).ToList();
                        <td>
                          @if (machineEntries.Count == 0)
                          {
                            <span class="muted">—</span>
                          }
                          else
                          {
                            @* O tfoot do html: E e S sempre, o SR só
                               quando existe (o zero nunca é facto). *@
                            <span class="entry-e">E @machineEntries.Sum(e => e.EntradasQuantidade)</span>
                            <span class="entry-s">S @machineEntries.Sum(e => e.SaidasQuantidade)</span>
                            @if (machineEntries.Sum(e => e.EntradasSemReparacaoQuantidade) > 0)
                            {
                              <span class="entry-r">SR @machineEntries.Sum(e => e.EntradasSemReparacaoQuantidade)</span>
                            }
                          }
                        </td>
                      }
                    </tr>
                  </tfoot>
                </table>
              </div>
              <p class="muted bq-matrix-legend"><span class="entry-e">E</span> Entradas de reparação&nbsp; <span class="entry-s">S</span> Saídas&nbsp; <span class="entry-r">SR</span> Entradas sem reparação</p>
            </div>
          }
          else if (Model.ShowGrouped)
          {
            <div class="card movement-card">
              <div class="card-head bq-history-card-head">
                <h3>Movimentos agrupados por máquina e Job On</h3>
                <span class="date-chip">@Model.GroupedMovements.Count BQ / produção(ões)</span>
              </div>
              @* 25 grupos (registo × Job On) por página; os totais e o PDF
                 continuam a usar todos os movimentos do filtro. *@
              @{
                var groupedPage = DMO.Alpha.Core.Paging.PagedList<DMO.Alpha.Core.Boquilhas.BqHistoryMovementGroup>
                    .FromLoaded(Model.GroupedMovements, Model.HistoryListPage);
              }
              @foreach (var machineGroup in groupedPage.Items.GroupBy(g => g.MachineCode))
              {
                <section class="bq-machine-group">
                  <h3>Máquina @(machineGroup.Key ?? "Por indicar")</h3>
                  @foreach (var group in machineGroup)
                  {
                    <div class="bq-group-context"><strong>@(group.ProductionNumber is { } number ? $"Job On {number}" : "Sem Job On")</strong> · Referência @group.Reference · BQ @group.ToolReference · Lote @group.ToolLot · @group.Movements.Count @(group.Movements.Count == 1 ? "movimento" : "movimentos")</div>
                    <partial name="_BqHistoryMovements" model="group.Movements" />
                  }
                </section>
              }
              @if (Model.GroupedMovements.Count == 0)
              { <p class="muted">@(Model.HistorySearchApplied ? "Nenhum movimento encontrado com os filtros selecionados." : IndexModel.HistoryEmptyStateMessage)</p> }
              <partial name="_ListPager" model='ListPager.For(groupedPage, "hist_pagina")' />
            </div>
          }
          else
          {
            @* MOVIMENTOS DETALHADOS: um movimento por linha, 25 por página; os
               totais e o PDF continuam a usar todos os movimentos do filtro. *@
            <div class="card movement-card">
              <div class="card-head bq-history-card-head">
                <h3>Movimentos — um por linha</h3>
                <span class="date-chip">Período: @Model.HistoryPeriodLabel</span>
              </div>
              @{
                var movementsPage = DMO.Alpha.Core.Paging.PagedList<DMO.Alpha.Core.Boquilhas.BqHistoryMovementItem>
                    .FromLoaded(Model.Movements, Model.HistoryListPage);
              }
              @if (Model.Movements.Count == 0)
              { <p class="muted">@(Model.HistorySearchApplied ? "Nenhum movimento encontrado com os filtros selecionados." : IndexModel.HistoryEmptyStateMessage)</p> }
              else
              { <partial name="_BqHistoryMovements" model="movementsPage.Items" /> }
              <partial name="_ListPager" model='ListPager.For(movementsPage, "hist_pagina")' />
            </div>
          }
        </div>
      </section>
    }
  </main>
</div>

@if (activeTab == "registo")
{
  <script src="~/js/bq-registo.js" asp-append-version="true"></script>
}
@if (activeTab == "boquilhas")
{
  <script src="~/js/bq-sem-jobon.js" asp-append-version="true"></script>
}
@* O Excel das Boquilhas do chefe: depois de cada registo, se este
   computador tem o ficheiro ligado (Definições), escreve-o lá. *@
@if (!Model.OnlyView)
{
<script src="~/js/dmo-excel-bq.js" asp-append-version="true" data-bq-excel-url="@Url.Page("/Boquilhas/Definicoes")"></script>
}
