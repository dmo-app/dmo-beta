@* Aplica o modo escolhido (claro/escuro) antes de a página se desenhar, para
   não aparecer branca e mudar a meio. O botão está em js/dmo-tema.js. O modo
   guardado na conta (Definições → Pessoal; cookie escrito ao entrar e ao
   gravar) ganha ao deste navegador. *@
@{ var temaDaConta = DMO.Alpha.Web.Services.TemaPessoal.Ler(Context); }
@if (temaDaConta is not null)
{
<script>try{localStorage.setItem("dmo-tema","@temaDaConta")}catch(e){}</script>
}
<script>try{if(localStorage.getItem("dmo-tema")==="dark")document.documentElement.setAttribute("data-theme","dark")}catch(e){}</script>
