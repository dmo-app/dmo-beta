@* One contextual support surface. Pages inside remain real Razor Pages.
   Usa a estrutura fixa dos painéis deslizantes (<dmo-painel>, docs/design/estrutura.md). *@
<dmo-painel id="dmoSupport" titulo="Detalhe" largura="larga" class="dmo-support" data-dmo-painel-proprio>
  <dmo-acoes><a id="dmoSupportFull" class="dmo-button" target="_blank">Abrir página</a></dmo-acoes>
  <p class="dmo-support-loading" role="status">A carregar…</p>
  <iframe title="Página de apoio" class="dmo-support-frame"></iframe>
</dmo-painel>
<div class="dmo-support-refresh" hidden role="status">
  Foi enviada uma operação no painel de apoio.
  <button type="button" class="btn" data-support-refresh>Atualizar esta página</button>
  <button type="button" class="btn" data-support-dismiss>Dispensar</button>
</div>
