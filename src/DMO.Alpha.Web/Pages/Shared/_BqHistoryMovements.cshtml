@model IReadOnlyList<DMO.Alpha.Core.Boquilhas.BqHistoryMovementItem>
@using DMO.Alpha.Core.Boquilhas
@{
    var fmtDate = new Func<DateTime, string>(v => DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(v).ToString("g", System.Globalization.CultureInfo.GetCultureInfo("pt-PT")));
    var movementLabel = new Func<string, string>(BqMovementLabels.Of);
}
                <div class="dmo-table-wrap">
                  <table class="dmo-table" data-dmo-list="Movimentos detalhados">
                    <thead>
                      <tr><th>Data/hora</th><th>Boquilha / lote</th><th>Movimento</th><th>Qtd.</th><th>Reparador</th><th>Máquina</th><th>Produção</th><th>Saldo</th></tr>
                    </thead>
                    <tbody>
                      @foreach (var movement in Model)
                      {
                        @* Um clique abre a ficha da ferramenta (Diogo, 18/10/2026), não
                           o registo para lançar movimentos. *@
                        <tr data-dmo-row data-id="@movement.MovementId"
                            data-dmo-open="@(movement.ToolId is { } toolId ? Url.Page("/Ferramentas/Ficha", new { tool_id = toolId }) : Url.Page("/Boquilhas/Index", new { trace_id = movement.BqRepairTraceId }))"
                            title="@(movement.ToolId is null ? "Um clique ou Enter abre o registo do movimento" : "Um clique ou Enter abre a ficha da ferramenta")">
                          <td>@fmtDate(movement.OccurredAtUtc)</td>
                          <td>@movement.ToolReference@(movement.ToolLot is { } tl ? $" · Lote {tl}" : null)</td>
                          <td>@movementLabel(movement.MovementType)</td>
                          <td>@movement.Quantity</td>
                          <td>@(movement.BqRepairerNameFrozen ?? "—")</td>
                          <td>@(movement.MachineCode ?? "—")</td>
                          <td>@(movement.ProductionNumber is string pn && movement.Reference is string pr ? $"{pn} · {pr}" : movement.ProductionNumber ?? movement.Reference ?? "—")</td>
                          <td>@(movement.Discrepancy is int disc ? disc.ToString() : "—")</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
