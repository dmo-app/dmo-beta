@model DMO.Alpha.Web.Pages.Boquilhas.IndexModel
@inject DMO.Alpha.Web.Services.CurrentUserCapabilities UserCapabilities
<div class="page-head">
  <div>
    <h2>Ferramentas · Boquilhas<partial name="_DmoHelp" model="@("Cada ferramenta BQ/lote tem uma ficha única, reutilizável em vários Job Ons.")" /></h2>
  </div>
  @* «Registar sem Job On» (Diogo, 22/10/2026): uma janela pequena, aqui na
     página Boquilhas; o Registo é só para os registos de um Job On. *@
  @if (Model.SemJobOnTools.Count > 0)
  {
    <button type="button" class="bq-sem-jobon-link" data-dmo-dialog="bqSemJobOnDialog">Registar sem Job On</button>
  }
</div>
@* As linhas por baixo do título, como nos mockups (Owner, 26/10/2026): o mesmo painel, com os mesmos ids e zonas. *@
<div class="dmo-zona" data-dmo-parcial><partial name="_DmoSidepanelBoquilhas" model="Model.Currents" /></div>
<div id="bqCatalogoAvisos" class="dmo-zona" data-dmo-regiao>
@* Registada no Ferramentas, a boquilha volta aqui com a ficha aberta. *@
@if (Model.CatalogSaved == "created")
{
  <p data-dmo-toast="ok" class="result" role="status">Boquilha guardada. A ficha está disponível abaixo.</p>
}
</div>
@if (Model.ToolSheetNotFound)
{
  <p class="result" role="alert">A boquilha indicada não está registada no Ferramentas.</p>
}
@* CRIAR BOQUILHA (Diogo, 18/10/2026, pergunta 6 do deep sweep): uma só
   página de registar ferramenta, a das Ferramentas, que abre com o tipo BQ
   e a máquina do filtro já escolhidos e volta aqui com a ficha. O
   formulário curto que havia aqui saiu. O botão é uma zona: mudar a
   máquina do filtro troca-o com a lista, já com a máquina nova. Só aparece
   a quem tem o módulo Ferramentas; sem ele, o registo mandava-o para o
   primeiro módulo dele, sem aviso. *@
@{ var podeRegistar = (await UserCapabilities.GetAsync()).Contains(DMO.Alpha.Core.Admin.DmoCapabilities.Ferramentas, StringComparer.Ordinal); }
<div class="card">
  <div class="dmo-card-topo bq-tool-search-topo">
    @* A lista aparece quando se escreve a referência ou o lote; a máquina
       só reduz (deep sweep 2, 18/10/2026, F-16: a regra das Ferramentas,
       Diogo, 17/10 e 18/10: «não deve existir lista até procurar»). *@
    <h3>Procurar boquilha<partial name="_DmoHelp" model="@("A lista aparece quando escreve a referência ou o lote e muda enquanto escreve. A máquina só reduz a lista.")" /></h3>
    <div id="bqCriarBoquilha" class="dmo-card-topo-acoes" data-dmo-regiao>@if (podeRegistar)
    {<a class="btn primary" href="@Model.CreateToolLink()">Criar boquilha</a>}</div>
  </div>
  <form method="get" asp-page="/Boquilhas/Index" class="bq-tool-search" data-dmo-fica data-dmo-parcial data-dmo-ao-escrever="bq-tool-results">
    <input type="hidden" name="ficheiros" value="1" />
    <div class="field dmo-field">
      <label for="bq-tool-search">Pesquisar boquilhas</label>
      <input id="bq-tool-search" name="q" value="@Model.CatalogSearch" placeholder="Referência, lote ou linha" />
    </div>
    <div class="field dmo-field">
      <label for="bq-tool-lot">Lote</label>
      <input id="bq-tool-lot" name="lote" value="@Model.CatalogLot" placeholder="3" />
    </div>
    <div class="field dmo-field">
      <label for="bq-tool-machine">Máquina compatível</label>
      <select id="bq-tool-machine" name="machine_id" data-dmo-autosubmit>
        <option value="">Todas</option>
        @foreach (var machine in Model.CatalogMachines)
        {
          <option value="@machine.MachineId" selected="@(Model.CatalogMachineId == machine.MachineId)">@machine.Code</option>
        }
      </select>
    </div>
    @* O «Por página» é da página, junto da paginação, nunca nos filtros
       (Diogo, 23/10/2026); os filtros guardam-no ao pesquisar. *@
    <input type="hidden" name="por_pagina" value="@Model.CatalogPageSize" />
    <div class="bq-tool-actions">
      <a class="btn" href="@Url.Page("/Boquilhas/Index", new { ficheiros = 1, por_pagina = Model.CatalogPageSize })">Limpar</a>
    </div>
  </form>
</div>
<div class="card" id="bq-tool-results" hidden="@(!Model.CatalogSearched)" data-dmo-regiao>
  @if (Model.CatalogSearched)
  {
  <div class="card-head"><h3>Boquilhas registadas<partial name="_DmoHelp" model="@("Um clique ou Enter abre a ficha da ferramenta desta boquilha.")" /></h3><span>@Model.CatalogCount encontrada(s)</span></div>
  @if (Model.CatalogTools.Count == 0)
  {
    <p class="muted">Nenhuma boquilha encontrada com os filtros atuais.</p>
  }
  else
  {
    <div class="dmo-table-wrap">
      <table class="dmo-table" id="bqToolList" data-dmo-list="Boquilhas registadas">
        <thead><tr><th style="width:0"></th><th>Referência</th><th>Lote</th><th>Quantidade</th><th>Máquinas compatíveis</th><th>MF associada</th></tr></thead>
        <tbody>
          @foreach (var tool in Model.CatalogTools)
          {
            <tr data-dmo-row data-id="@tool.ToolId" data-dmo-open="@Url.Page("/Ferramentas/Ficha", new { tool_id = tool.ToolId })">
              <td><input type="radio" name="bq_tool" value="@tool.ToolId" aria-label="BQ @tool.Reference · lote @tool.Lot" /></td>
              <td><strong>@tool.Reference</strong></td><td>@tool.Lot</td>
              <td>@(tool.AccountedQuantity?.ToString() ?? "—")</td><td>@(string.IsNullOrWhiteSpace(tool.MachineCodes) ? "—" : tool.MachineCodes)</td><td>@(string.IsNullOrWhiteSpace(tool.AssociatedMfReference) ? "—" : tool.AssociatedMfReference)</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  <nav data-dmo-parcial class="bq-tool-pagination" aria-label="Paginação de boquilhas">
    <a class="btn dmo-arrow" href="@(Model.CatalogPageNumber > 1 ? Model.CatalogLink(Model.CatalogPageNumber - 1) : null)" aria-label="Página anterior" aria-disabled="@(Model.CatalogPageNumber <= 1 ? "true" : null)">←</a>
    <span aria-label="Página @Model.CatalogPageNumber de @Model.CatalogPages">@Model.CatalogPageNumber de @Model.CatalogPages</span>
    <a class="btn dmo-arrow" href="@(Model.CatalogPageNumber < Model.CatalogPages ? Model.CatalogLink(Model.CatalogPageNumber + 1) : null)" aria-label="Página seguinte" aria-disabled="@(Model.CatalogPageNumber >= Model.CatalogPages ? "true" : null)">→</a>
    @* Mudar o «Por página» mantém os filtros e volta à página 1. *@
    <form method="get" asp-page="/Boquilhas/Index" class="dmo-por-pagina" data-dmo-fica data-dmo-parcial>
      <input type="hidden" name="ficheiros" value="1" />
      @if (!string.IsNullOrEmpty(Model.CatalogSearch)) {<input type="hidden" name="q" value="@Model.CatalogSearch" />}
      @if (!string.IsNullOrEmpty(Model.CatalogLot)) {<input type="hidden" name="lote" value="@Model.CatalogLot" />}
      @if (Model.CatalogMachineId is { } maquinaFiltro) {<input type="hidden" name="machine_id" value="@maquinaFiltro" />}
      <label for="bq-tool-size">Por página</label>
      <select id="bq-tool-size" name="por_pagina" data-dmo-autosubmit>
        <option value="10" selected="@(Model.CatalogPageSize == 10)">10</option>
        <option value="20" selected="@(Model.CatalogPageSize == 20)">20</option>
      </select>
    </form>
  </nav>
  }
</div>
