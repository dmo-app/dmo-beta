@model IReadOnlyList<DMO.Alpha.Core.Production.ProductionContextReadModel>
@* O RAIL DO PLANEAMENTO («o sidepanel mostra o que vai entrar», o Owner
   14/10): as próximas produções desta semana, cada uma abre a sua ficha.
   O mesmo no Job On e no Sumário (Diogo, 21/10/2026: «na página do sumário
   não temos sidepanel do planeamento»). Só o que entra: o que já entrou sai
   (Diogo, 27/10/2026, DMO-506). *@
@{
    var railLinhas = Model
        .Select(entrada =>
        {
            var emCurso = entrada.InicioEm is { } inicio && inicio < DateOnly.FromDateTime(DMO.Alpha.Core.Runtime.DmoBusinessTime.Now);
            return new DMO.Alpha.Web.Presentation.DmoRailItem(
            Code: entrada.Machine ?? "—",
            // A referência e a produção numa linha, o estado noutra: nada cortado (Diogo, 26/10/2026).
            Detail: $"{entrada.Reference} · Produção {entrada.ProductionNumber}",
            Extra: emCurso
                ? $"Em curso desde {entrada.InicioEm?.ToString("dd/MM")}"
                : $"Entra a {entrada.InicioEm?.ToString("dd/MM")}",
            Href: $"/JobOn/Folha?jobon_id={entrada.JobOnId}",
            AriaLabel: emCurso
                ? $"Abrir a produção {entrada.ProductionNumber}, em curso na {entrada.Machine} desde {entrada.InicioEm?.ToString("dd/MM")}"
                : $"Abrir a produção {entrada.ProductionNumber}, que entra na {entrada.Machine} a {entrada.InicioEm?.ToString("dd/MM")}",
            Key: entrada.JobOnId.ToString(),
            CssClass: $"dmo-linha-cor mch-{entrada.Machine}");
        })
        .ToList();
    var rail = new DMO.Alpha.Web.Presentation.DmoRailPresentation(
        // «Planeamento», um link para o calendário do Job On (Diogo, 26/10/2026).
        Title: "Planeamento",
        Subtitle: "As produções que entram esta semana",
        AriaLabel: "Planeamento",
        Items: railLinhas,
        EmptyLabel: "Sem entradas esta semana.",
        // Só com o Job On ver, a página dele é a Folha (o Sumário diz qual).
        TitleHref: ViewData["RailPlaneamentoHref"] as string ?? "/JobOn");
}
<partial name="_DmoRail" model="@rail" />
