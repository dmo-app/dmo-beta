@model SessionPresentation
<partial name="_DmoVersionBadge" />
@* Um bloco à direita em duas linhas: o utilizador; por baixo só o «Sair» (Diogo,
   23/10/2026: «remover o link admin, deixar o sair»; o /Admin abre-se pelo menu
   e pelas Definições → Admin). O modo claro/escuro vive em Definições → Pessoal.
   Sem a hora da sessão: só «Nome · Título» e o Sair por baixo (Diogo, 26/10/2026). *@
<div class="dmo-shell-conta">
    <div class="dmo-shell-user admin-user">
        <strong data-user-profile-name>@Model.Name</strong>
        @* Sem título (o ADMIN não tem template), sem o «·» a mais. *@
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        {
            <span data-user-profile-title>@Model.Title</span>
        }
    </div>
    @if (Model.ShowLogout)
    {
        <div class="dmo-shell-acoes">
            <a class="dmo-shell-logout" href="@Model.LogoutHref" aria-label="Terminar sessão">Sair</a>
        </div>
    }
</div>

