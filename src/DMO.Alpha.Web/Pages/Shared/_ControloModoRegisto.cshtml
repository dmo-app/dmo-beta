@model (string Path, bool ModoJobOn)
@* A escolha do registo no Controlo (Peso, Pegamentos e PU NNPB), dentro do
   cartão do registo (Diogo, 17/10/2026: «podemos meter esses botoes dentro
   do card do registo»). NUM DROPDOWN (Diogo, 21/10/2026: «nestes casos usar
   sempre dropdowns evitar botoes por todo lado»): o botão diz o tipo
   escolhido e abre a lista com os dois; o escolhido fica marcado. *@
@{ var escolhido = Model.ModoJobOn ? "Associar Job On" : "Sem Job On"; }
<nav class="dmo-modo" aria-label="Tipo de registo" data-dmo-modo>
  <details class="dmo-options" data-dmo-tab-menu>
    <summary class="dmo-button" aria-label="Tipo de registo: @escolhido"><span class="dmo-caret" aria-hidden="true"></span>@escolhido</summary>
    <div class="dmo-options-list">
      <a class="dmo-options-item" href="@Model.Path" aria-current="@(Model.ModoJobOn ? null : "page")">Sem Job On</a>
      <a class="dmo-options-item" href="@(Model.Path)?modo=jobon" aria-current="@(Model.ModoJobOn ? "page" : null)">Associar Job On</a>
    </div>
  </details>
</nav>
