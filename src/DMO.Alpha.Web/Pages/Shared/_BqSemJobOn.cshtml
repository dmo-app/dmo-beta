@model DMO.Alpha.Web.Pages.Boquilhas.IndexModel
@* A JANELA «REGISTAR SEM JOB ON» (Diogo, 22/10/2026): só o essencial — a
   BQ e o lote, o movimento, a quantidade, a data e hora e «Registar». Grava
   pelo RegistarSemJobOn e volta a esta página com a ficha da BQ e os
   movimentos sem Job On dela. Com uma recusa, a janela abre outra vez com a
   frase. *@
<div id="bqSemJobOn" class="dmo-zona" data-dmo-regiao>
@if (Model.SemJobOnTools.Count > 0)
{
  var recusa = Model.SemJobOnResult is { Length: > 0 } r && r != "ok";
  var escolhida = Model.ToolSheet?.ToolId;
    @if (Model.SemJobOnResult == "ok")
    {
      <p data-dmo-toast="ok" class="result" role="status">@Model.SemJobOnMessage</p>
    }
    <dialog id="bqSemJobOnDialog" class="dmo-dialog bq-sem-jobon-janela" aria-labelledby="bqSemJobOnTitulo"@(recusa ? Html.Raw(" data-dmo-dialog-aberta=\"1\"") : null)>
      <form method="post" asp-page="/Boquilhas/Index" asp-page-handler="RegistarSemJobOn">
        <div class="bq-sem-jobon-topo">
          <h3 id="bqSemJobOnTitulo">Registar sem Job On</h3>
          <button type="button" class="dmo-dialog-fechar" data-dmo-dialog-close aria-label="Fechar">×</button>
          <button type="submit" class="dmo-button">Registar</button>
        </div>
        @if (recusa)
        {
          <div class="jobon-aviso warn" role="alert">@Model.SemJobOnMessage</div>
        }
        <div class="bq-sem-jobon-campos bq-sem-jobon-tres">
          @* Uma só escolha (Diogo, 22/10/2026: «ao procurar as boquilhas deve
             mostrar os elementos que identificam a boquilha»): cada opção é
             uma BQ (um tool_id), com a referência, o lote e o resto que a
             distingue. Com JavaScript, escreve-se para procurar. *@
          <div class="dmo-field bq-sem-jobon-bq">
            <label for="bqSemJobOnBq">BQ · lote<partial name="_DmoHelp" model="@("Escreva a referência ou o lote da boquilha; a lista só aparece depois de escrever.")" /></label>
            <select id="bqSemJobOnBq" name="tool_id" data-bq-escolha required>
              <option value="">Escolher</option>
              @foreach (var tool in Model.SemJobOnTools)
              {
                <option value="@tool.ToolId" data-procura="@tool.SearchText" selected="@(tool.ToolId == escolhida)">@tool.Label</option>
              }
            </select>
          </div>
          <div class="dmo-field">
            <label for="bqSemJobOnLinha">Linha</label>
            <select id="bqSemJobOnLinha" name="movement_machine_id" required>
              <option value="">Escolher</option>
              @foreach (var linha in Model.SemJobOnLines)
              {
                <option value="@linha.MachineId">@linha.Code</option>
              }
            </select>
          </div>
        </div>
        <fieldset class="bq-movement-types bq-sem-jobon-tipos">
          <legend class="visually-hidden">Movimento</legend>
          <label><input type="radio" name="movement_type" value="saida" checked required /><span>Saída</span></label>
          <label><input type="radio" name="movement_type" value="entrada" /><span>Entrada</span></label>
          <label><input type="radio" name="movement_type" value="entrada_sem_reparacao" /><span>Entrada sem reparação</span></label>
        </fieldset>
        <div class="bq-sem-jobon-campos">
          <div class="dmo-field">
            <label for="bqSemJobOnQtd">Quantidade</label>
            <input id="bqSemJobOnQtd" name="quantity" type="number" lang="en" min="1" required placeholder="Ex.: 1" />
          </div>
          <div class="dmo-field">
            <label for="bqSemJobOnData">Data e hora reais</label>
            <input id="bqSemJobOnData" name="occurred_at" type="datetime-local" value="@Model.MovementFormOccurredAt" required />
          </div>
        </div>
      </form>
    </dialog>
}
</div>
