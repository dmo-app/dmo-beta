@model DMO.Alpha.Web.Pages.Boquilhas.IndexModel
        @if (Model.ToolSheet is { } sheet)
        {
          <div class="card register-open" id="bq-tool-sheet">
            <div class="card-head">
              <div>
                <h3>Ficha da boquilha — @sheet.Reference@(sheet.Lot is { } sheetLot ? $" · Lote {sheetLot}" : null)</h3>
                <p>@(sheet.Machines.Count > 0 ? $"Máquinas compatíveis: {string.Join(", ", sheet.Machines)}" : "Sem máquinas compatíveis associadas no Ferramentas.")</p>
              </div>
              <a class="btn" href="@Model.CatalogLink(Model.CatalogPageNumber)">Fechar ficha</a>
            </div>
            <p><a class="btn" href="@Url.Page("/Ferramentas/Ficha", new { tool_id = sheet.ToolId })">Editar ficha / duplicar lote</a></p>
            <div class="lot-data">
              <div><span>Quantidade do lote</span><strong>@(sheet.AccountedQuantity is int sheetLotQty ? sheetLotQty.ToString() : "—")</strong></div>
              <div><span>Registos</span><strong>@sheet.Registers.TotalCount</strong></div>
            </div>

            <details class="filter-bar bq-historical-form" style="margin:14px 0 0">
              <summary>+ Registo com data antiga</summary>
              <h3 style="margin:0 0 10px">Recuperar movimentos antigos<partial name="_DmoHelp" model="@("Inicia um registo nesta boquilha sem preencher número ou referência de produção. Podes associar o Job On mais tarde.")" /></h3>
              <form method="post" asp-page="/Boquilhas/Index" asp-page-handler="OpenHistoricalRegister">
                <input type="hidden" name="tool_id" value="@sheet.ToolId" />
                <div class="filter-grid">
                  <div class="field dmo-field">
                    <label for="bqSheetMachines">Máquinas compatíveis<partial name="_DmoHelp" model="@("Máquina do movimento: escolha no registo, ao guardar a saída.")" /></label>
                    <input id="bqSheetMachines" value="@(sheet.Machines.Count > 0 ? string.Join(", ", sheet.Machines) : "—")" readonly />
                  </div>
                  <div class="field dmo-field">
                    <label for="firstOccurred">Data/hora do primeiro movimento</label>
                    <input id="firstOccurred" name="first_occurred" type="datetime-local" value="@Model.MovementFormOccurredAt" required />
                  </div>
                  <div class="field dmo-field">
                    <span class="dmo-label" aria-hidden="true">&nbsp;</span>
                    <button type="submit" class="btn primary">Abrir registo desta boquilha</button>
                  </div>
                </div>
              </form>
            </details>

            @if (sheet.Registers.TotalCount > 0)
            {
              <div class="card-head" style="margin:14px 0 4px">
                <div>
                  <h3>Registos desta boquilha<partial name="_DmoHelp" model="@("Um clique ou Enter abre o registo.")" /></h3>
                </div>
              </div>
              <div class="dmo-table-wrap">
                <table class="dmo-table" id="bqSheetRegisters" data-dmo-list="Registos da boquilha">
                  <thead>
                    <tr><th style="width:0"></th><th>Produção</th><th>Máquina</th><th>Estado</th><th>Movimentos</th></tr>
                  </thead>
                  <tbody>
                    @foreach (var register in sheet.Registers.Items)
                    {
                      <tr data-dmo-row data-id="@register.BqRepairTraceId"
                          data-dmo-open="@Url.Page("/Boquilhas/Index", new { trace_id = register.BqRepairTraceId })"
                          aria-label="Registo @(register.ProductionNumber is string rPn ? $"da produção {rPn}" : "sem Job On") — um clique abre">
                        <td><input type="radio" name="bq_sheet_register" value="@register.BqRepairTraceId" aria-label="Registo @(register.ProductionNumber is string rPn2 ? $"da produção {rPn2}" : "sem Job On")" /></td>
                        <td><strong>@(register.ProductionNumber is string pn ? $"Produção {pn}" : "—")@(register.ProductionReference is string pr ? $" · {pr}" : null)</strong></td>
                        <td>@(register.MachineCode ?? "—")</td>
                        <td>@register.State</td>
                        <td>@register.MovementCount</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
              <partial name="_ListPager" model='ListPager.For(sheet.Registers, "registos_pagina", "bq-tool-sheet")' />
            }
            else
            {
              <p class="muted" style="margin:12px 0 0">Ainda sem registos nesta boquilha — o «+ Registo com data antiga» abre o primeiro.</p>
            }
          </div>
        }
