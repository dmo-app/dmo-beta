@{
    var shell = (ShellPresentation)ViewData["Shell"]!;
    // Side panels are shell components with a shell-owned open/closed state.
    var openSidepanel = shell.Sidepanel is { Visible: true } panel ? panel : null;
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    @* A Inter carrega logo com a página: sem ela o texto aparecia primeiro
       noutra letra e mudava a meio (o «salto» que o Diogo viu no login). *@
    <link rel="preload" href="@Url.Content("~/fonts/inter-latin-wght-normal.woff2")" as="font" type="font/woff2" crossorigin>
    @* Sem flash ao mudar de separador (Diogo, 18/10/2026): o browser só
       desenha a página nova quando chega ao fim dela (#dmoFim, depois dos
       scripts). Até lá fica a página anterior no ecrã; sem isto, com o DEV
       longe, aparecia primeiro o cabeçalho sozinho e o painel lateral a
       encher máquina a máquina. *@
    <link rel="expect" href="#dmoFim" blocking="render">
    <partial name="_DmoTemaInicial" />
    <link rel="stylesheet" href="~/0_ASSET_CANONICAL_DESIGN_SYSTEM.css" asp-append-version="true">
    <link rel="stylesheet" href="~/0_ASSET_SHELL.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/beta-shell.css" asp-append-version="true">
    @* Estilo único para componentes partilhados: sem carregamentos duplicados por página. *@
    <link rel="stylesheet" href="~/beta-production-overview.css" asp-append-version="true">
    <link rel="stylesheet" href="~/beta-calendar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/shell-proof.css" asp-append-version="true">
    @* Normalização geral (tipografia, botões, campos): sempre a última folha. *@
    <link rel="stylesheet" href="~/css/dmo-normalize.css" asp-append-version="true">
</head>
<body data-dmo-account="@User.FindFirst(DMO.Alpha.Web.Services.DmoClaimTypes.ActorId)?.Value" data-beta-page="@ViewData["BetaPage"]" data-razor-shell="true" data-dmo-sidepanel="@(openSidepanel?.Kind.ToString().ToLowerInvariant())">
<div class="app">
    <header class="dmo-shell-header">
        <partial name="_DmoBranding" model="shell.CurrentModule" />
        <partial name="_DmoSessionUtilities" model="shell.Session" />
    </header>
    <partial name="_DmoNavigation" model="shell" />
    @* O AVISO DA MUDANÇA DE SENHA (a casa antiga era a home, que morreu —
       o Owner 2026-10-12: o login entra logo no Planeamento): o TempData
       vive no SHELL, onde quer que a aterragem seja. *@
    @if (TempData["PasswordChanged"] is not null)
    {
        <div data-dmo-toast="ok" role="status"><strong>Palavra-passe alterada com sucesso.</strong></div>
    }
    @* Módulo em desenvolvimento ligado (plano de uma versão, §2): uma faixa
       discreta no topo das suas páginas. *@
    @if (DMO.Alpha.Web.Services.ShellStateFactory.IsEmDesenvolvimento(shell.CurrentModule?.Key))
    {
        <div class="dmo-faixa-dev" role="note" data-dmo-em-desenvolvimento>Em desenvolvimento: pode mudar e os dados podem ser de teste</div>
    }
    @RenderBody()
</div>
@* F0: camada comum de comportamento vivo (interações canónicas + utilidades) — antes dos scripts de página *@
<script src="~/0_ASSET_CANONICAL_INTERACTIONS.js" asp-append-version="true"></script>
<script src="~/dmo-live.js" asp-append-version="true"></script>
<script src="~/js/dmo-suggest.js" asp-append-version="true"></script>
<script src="~/js/dmo-pasta-pdf.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<div id="dmoFim" hidden></div>
</body>
</html>
