@model DMO.Alpha.Web.Pages.JobOn.FolhaModel
@using DMO.Alpha.Web.Pages.JobOn
@using DMO.Alpha.Core.Production
@*
  AS FOLHAS DO IMPRIMIR (Diogo, 26/10/2026, pelo mapa das folhas): Ficha de
  Artigo, Trabalho de Equipa e Job-ON Moldes (duas cópias). Em «Todas as
  folhas» sai primeiro o Job-ON Moldes duas vezes, depois as outras duas. Levam o que o
  Job On tem; o que o Job On não tem fica em branco para escrever à mão
  («____» ou a caixa vazia). Ficam escondidas no ecrã: o botão Imprimir
  escolhe as folhas e o browser imprime-as (nunca PDF no servidor).
*@
@{
    var jobOn = Model.JobOn!;
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
    var cm = Model.Fact(jobOn.CmToolId);
    var mf = Model.Fact(jobOn.MfToolId);
    var bq = Model.Fact(jobOn.BqToolId);
    var referencia = Model.ReferenciaTotal;
    var calibres = Model.Folha.Cal.Where(l => !l.Extra && (V(l.Valor) is not null || V(l.QtdMaq) is not null)).ToList();
    var inicio = jobOn.InicioEm;
    var fim = jobOn.FimEm;
    string Dia(DateOnly? d) => d is { } x ? cultura.TextInfo.ToTitleCase(x.ToString("ddd", cultura).TrimEnd('.')) + " " + x.ToString("dd/MM/yyyy") : "";
    string Lote(JobOnToolFacts? f) => f is null ? "" : "Lote " + FolhaModel.Lote(f.Lot);
    string Peso() => F("cab_peso") is { Length: > 0 } p ? p + " g" : "";
    string Calote() => jobOn.CaloteMm is { } c ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(c) + " mm" : "";
    string Tol(string valor, string tol) => string.Join(" ", new[] { F(valor), V(Model.Folha.Valor(tol)) is { } t ? "(" + t + ")" : null }.Where(s => !string.IsNullOrEmpty(s)));
    string Folgas(string tipo) => string.Join(" · ", new[] { $"{tipo}_folga1", $"{tipo}_folga2", $"{tipo}_folga3" }.Select(F).Where(s => s.Length > 0));
}
@functions {
    private static string? V(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    // Os números como na folha do Job On: ponto e duas casas quando têm casas («70/69.40»).
    private static string N(string? v) => DMO.Alpha.Core.Runtime.DmoNumberFormat.FolhaTexto(v) ?? "";

    private string F(string chave) => N(Model.Folha.Valor(chave));

    private IEnumerable<string> Notas(string chave) =>
        (V(Model.Folha.Valor(chave)) ?? "").Split('\n').Select(l => N(l)).Where(l => l.Length > 0);
}
<div class="jof-impressao" data-jof-impressao hidden>
  @* ── JOB-ON MOLDES (FOR 05 MOL 001), sai em duas cópias como no Excel do Diogo de 21/10 ── *@
  @{
      void Cartao(string codigo, string nome, (string Rotulo, string Valor)[] topo, (string Rotulo, string Valor)[] dados, IEnumerable<string> notas,
          (string Codigo, string Nome, (string Rotulo, string Valor)[] Topo, IEnumerable<string> Notas)? baixo = null)
      {
          <div class="jfm-cartao">
            <div class="jfm-cab">
              <span class="jfm-cod">@codigo</span>
              <span class="jfm-nome">@nome</span>
            </div>
            @if (topo.Length > 0)
            {
              <div class="jfm-topo">@foreach (var (r, v) in topo) {<div><span>@r</span><b>@v</b></div>}</div>
            }
            @foreach (var (r, v) in dados)
            {
              <div class="jfm-kv"><span>@r</span><b>@v</b></div>
            }
            <div class="jfm-notas"><span>Notas</span>@foreach (var n in notas) {<div>@n</div>}</div>
            @* O anel vai por baixo da BQ e o ARR por baixo do PU (Diogo 26/10). *@
            @if (baixo is { } b)
            {
              <div class="jfm-cab jfm-baixo"><span class="jfm-cod">@b.Codigo</span><span class="jfm-nome">@b.Nome</span></div>
              <div class="jfm-topo">@foreach (var (r, v) in b.Topo) {<div><span>@r</span><b>@v</b></div>}</div>
              <div class="jfm-notas"><span>Notas</span>@foreach (var n in b.Notas) {<div>@n</div>}</div>
            }
          </div>
      }
  }
  @for (var copia = 1; copia <= 2; copia++)
  {
    <section class="jfi-folha jfi-densa" data-jof-folha="moldes" aria-label="Job-ON Moldes @copia de 2">
      <header class="jfi-topo">
        <div><div class="jfi-eyebrow">DMO-MG · JOB-ON MOLDES · CÓPIA @copia DE 2</div><div class="jfi-ref">@referencia</div></div>
        <div class="jfi-topo-dir"><div><span>LINHA</span><b class="jfi-linha">@jobOn.Machine</b></div><div><span>PRODUÇÃO</span><b>@jobOn.ProductionNumber</b></div></div>
      </header>
      <div class="jfi-factos jfm-factos">
        <div><span>Data entrada</span><b>@inicio?.ToString("dd/MM/yyyy")</b></div>
        <div><span>Dia da semana</span><b>@(inicio is { } dm ? cultura.TextInfo.ToTitleCase(dm.ToString("dddd", cultura)) : "")</b></div>
        <div><span>Data saída</span><b>@fim?.ToString("dd/MM/yyyy")</b></div>
        <div><span>Secções</span><b>@F("cab_seccoes")</b></div>
        <div><span>Gota</span><b>@F("cab_gota")</b></div>
        <div><span>Peso</span><b>@Peso()</b></div>
        <div><span>Cadência</span><b></b></div>
      </div>
      <div class="jfm-grelha">
        @{
            string U(string chave) => F(chave) is { Length: > 0 } u ? u.TrimEnd('%') + "%" : "";
            Cartao("CM", "Contra-moldes", [("Referência", cm?.Reference ?? ""), ("Lote", cm is null ? "" : FolhaModel.Lote(cm.Lot))],
                [("Utilização", U("cm_utilizacao")), ("Quantidade", F("cm_qtd_maq")), ("Reparador", F("cm_reparador")), ("Adaptador", F("cm_adaptador")), ("Inversão", F("cm_inversao")), ("Tipo", F("cm_tipo"))], Notas("cm_notas"));
            Cartao("MF", "Moldes finais", [("Referência", mf?.Reference ?? ""), ("Lote", mf is null ? "" : FolhaModel.Lote(mf.Lot))],
                [("Utilização", U("mf_utilizacao")), ("Quantidade", F("mf_qtd_maq")), ("Reparador", F("mf_reparador")), ("Fundo final", F("mf_fundo_final")), ("Adaptador", F("mf_adaptador")), ("Inversão", F("mf_inversao")), ("Tipo", F("mf_tipo"))], Notas("mf_notas"));
            Cartao("BQ", "Boquilhas", [("Referência", bq?.Reference ?? ""), ("Lote", bq is null ? "" : FolhaModel.Lote(bq.Lot))],
                [("Utilização", U("bq_utilizacao")), ("Quantidade", F("bq_qtd_maq"))], Notas("bq_notas"),
                ("AN", "Anel", [("Referência", F("an_referencia"))], Notas("an_notas")));
            Cartao("PU", "Punções", [("Referência", F("pu_referencia"))],
                [("Versão", F("pu_versao")), ("Quantidade", F("pu_qtd_maq"))], Notas("pu_notas"),
                ("ARR", "Arrefecedores", [("Referência", F("arr_referencia"))], Notas("arr_notas")));
            Cartao("TP", "Tampões", [("Referência", F("tp_referencia"))],
                [("Diâmetro", F("tp_diametro_ps")), ("Calote", Calote()), ("Quantidade", F("tp_qtd_maq"))], Notas("tp_notas"));
            Cartao("CS", "Cabeça de sopro", [("Referência", F("cs_referencia"))],
                [("Furos", F("cs_furos")), ("Tubo", F("cs_tubo")), ("Quantidade", F("cs_qtd_maq"))], Notas("cs_notas"));
            Cartao("PI", "Pinças", [], [("Diâmetro", F("pi_diametro")), ("Tipo", F("pi_pincas"))], Notas("pi_notas"));
            Cartao("FO", "Forro", [], [("Tipo", ""), ("Quantidade", "")], []);
        }
      </div>
      <div class="jfi-bloco jfi-notas"><div class="jfi-barra"><span>JOB-ON NOTAS</span></div><ul>@foreach (var n in Notas("notas_gerais")) {<li>@n</li>}</ul></div>
      <div class="jfi-col">
        <div class="jfi-barra"><span>CALIBRES</span></div>
        <table class="dmo-table jfi-t jfm-cal">
          <tr><th>Medida</th>@foreach (var l in calibres) {<th>@l.Nome</th>}</tr>
          <tr><th>Componentes</th>@foreach (var l in calibres) {<td>@N(l.Valor)</td>}</tr>
          <tr><th>QTD máq.</th>@foreach (var l in calibres) {<td>@V(l.QtdMaq)</td>}</tr>
        </table>
      </div>
      <div class="jfi-crescer"></div>
      <footer class="jfi-rodape"><span>FOR 05 MOL 001 (pt)</span><span>Impresso pela DMO</span></footer>
    </section>
  }

  @* ── FICHA DE ARTIGO ─────────────────────────────────────────── *@
  <section class="jfi-folha" data-jof-folha="ficha" aria-label="Ficha de Artigo">
    <header class="jfi-topo">
      <div><div class="jfi-eyebrow">DMO-MG · FICHA DE ARTIGO</div><div class="jfi-ref">@referencia</div></div>
      <div class="jfi-topo-dir"><div><span>LINHA</span><b class="jfi-linha">@jobOn.Machine</b></div><div><span>PRODUÇÃO</span><b>@jobOn.ProductionNumber</b></div></div>
    </header>
    <div class="jfi-factos">
      <div><span>Entrada</span><b>@Dia(inicio)</b></div>
      <div><span>Saída</span><b>@Dia(fim)</b></div>
      <div><span>Secções</span><b>@F("cab_seccoes")</b></div>
      <div><span>Gota</span><b>@F("cab_gota")</b></div>
      <div><span>Peso</span><b>@Peso()</b></div>
      <div><span>Cadência</span><b></b></div>
    </div>
    @* CM, MF e BQ lado a lado (Diogo 26/10). *@
    <div class="jfi-duas jfi-cmmfbq">
      @foreach (var (tipo, nome, f) in new[] { ("cm", "CONTRA-MOLDE (CM)", cm), ("mf", "MOLDE FINAL (MF)", mf) })
      {
        <div class="jfi-col">
          <div class="jfi-barra"><span>@nome</span><span>@Lote(f)</span></div>
          <table class="dmo-table jfi-t jfi-kv">
            <tr><th>Referência</th><td>@(f?.Reference)@(tipo == "mf" && F("mf_fundo_final") is { Length: > 0 } ff ? " · FF " + ff : null)</td></tr>
            <tr><th>Tipo</th><td>@F($"{tipo}_tipo")</td></tr>
            <tr><th>Reparador</th><td>@F($"{tipo}_reparador")</td></tr>
            <tr><th>Utilização</th><td>@(F($"{tipo}_utilizacao") is { Length: > 0 } u ? u.TrimEnd('%') + "%" : "")</td></tr>
            <tr><th>Inversão · Adapt.</th><td>@(string.Join(" · ", new[] { F($"{tipo}_inversao"), F($"{tipo}_adaptador") }.Where(s => s.Length > 0)))</td></tr>
            <tr><th>Diâm. exterior</th><td>@Tol($"{tipo}_exterior", $"{tipo}_exterior_tol")</td></tr>
            @if (tipo == "cm")
            {
              <tr><th>Diâm. pata</th><td>@Tol("cm_pata", "cm_pata_tol")</td></tr>
            }
            else
            {
              <tr><th>Diâm. corpo</th><td>@Tol("mf_corpo", "mf_corpo_tol")</td></tr>
            }
            <tr><th>Diâm. gargalo</th><td>@Tol($"{tipo}_gargalo", $"{tipo}_gargalo_tol")</td></tr>
            <tr><th>Folgas</th><td>@Folgas(tipo)</td></tr>
          </table>
          <div class="jfi-caixa"><b>Tratar:</b> @(string.Join("; ", Notas($"{tipo}_notas")))</div>
        </div>
      }
      <div class="jfi-col">
        <div class="jfi-barra"><span>BOQUILHA (BQ)</span><span>@Lote(bq)</span></div>
        <table class="dmo-table jfi-t jfi-kv">
          <tr><th>Referência</th><td>@bq?.Reference</td></tr>
          <tr><th>Utilização</th><td>@(F("bq_utilizacao") is { Length: > 0 } ub ? ub.TrimEnd('%') + "%" : "")</td></tr>
        </table>
        <div class="jfi-caixa"><b>Tratar:</b> @(string.Join("; ", Notas("bq_notas")))</div>
        @* O anel fica separado da BQ, com os seus comentários (Diogo 26/10). *@
        <div class="jfi-barra jfi-barra-sep"><span>ANEL (AN)</span></div>
        <table class="dmo-table jfi-t jfi-kv">
          <tr><th>Referência</th><td>@F("an_referencia")</td></tr>
        </table>
        <div class="jfi-caixa"><b>Tratar:</b> @(string.Join("; ", Notas("an_notas")))</div>
      </div>
    </div>
    <div class="jfi-tres">
      <div class="jfi-bloco"><div class="jfi-sub"><span>TAMPÕES</span></div><div class="jfi-corpo">Diâmetro @(F("tp_diametro_ps") is { Length: > 0 } tpd ? tpd : "____")<br>Calote @(Calote() is { Length: > 0 } cal ? cal : "____")</div></div>
      @* Punção e arrefecedor são um só componente, mas cada um com os seus comentários (Diogo 26/10). *@
      <div class="jfi-bloco"><div class="jfi-sub"><span>PUNÇÃO + ARREFECEDOR</span></div><div class="jfi-corpo">PU @(F("pu_referencia") is { Length: > 0 } pur ? pur : "____")@(F("pu_versao") is { Length: > 0 } puv ? " · v. " + puv : "")@foreach (var n in Notas("pu_notas")) {<div class="jfi-nota">@n</div>}</div><div class="jfi-corpo jfi-corpo-sep">ARR @(F("arr_referencia") is { Length: > 0 } arr ? arr : "____")@(F("arr_versao") is { Length: > 0 } arv ? " · v. " + arv : "")@foreach (var n in Notas("arr_notas")) {<div class="jfi-nota">@n</div>}</div></div>
      <div class="jfi-bloco"><div class="jfi-sub"><span>CAB. DE SOPRO</span></div><div class="jfi-corpo">Ref. @(F("cs_referencia") is { Length: > 0 } csr ? csr : "____")<br>Furos @(F("cs_furos") is { Length: > 0 } csf ? csf : "____") · Tubo @(F("cs_tubo") is { Length: > 0 } cst ? cst : "____")</div></div>
      <div class="jfi-bloco"><div class="jfi-sub"><span>PINÇAS</span></div><div class="jfi-corpo">Ø @(F("pi_diametro") is { Length: > 0 } pid ? pid : "____") · @(F("pi_pincas") is { Length: > 0 } pip ? pip : "____")</div></div>
    </div>
    <div class="jfi-col">
      <div class="jfi-barra"><span>CALIBRES</span></div>
      <div class="jfi-cal">
        @foreach (var l in calibres)
        {
          <div><span>@l.Nome</span><b>@N(l.Valor)</b>@if (V(l.QtdMaq) is { } q) {<small>QTD máq. @q</small>}</div>
        }
        @if (calibres.Count == 0)
        {
          <div><span>Calibres</span><b>____</b></div>
        }
      </div>
    </div>
    <div class="jfi-fundo">
      <div class="jfi-bloco jfi-notas"><div class="jfi-barra"><span>NOTAS DO JOB ON</span></div><ul>@foreach (var n in Notas("notas_gerais")) {<li>@n</li>}</ul></div>
      <div class="jfi-bloco jfi-artigo"><div class="jfi-sub"><span>ARTIGO</span></div><div class="jfi-artigo-img" data-jof-folha-artigo><span>Sem imagem do artigo</span></div></div>
    </div>
    <footer class="jfi-rodape"><span>FOR 05 MOL 001 (pt)</span><span>Impresso pela DMO</span></footer>
  </section>

  @* ── TRABALHO DE EQUIPA ──────────────────────────────────────── *@
  <section class="jfi-folha" data-jof-folha="equipa" aria-label="Trabalho de Equipa">
    <header class="jfi-topo">
      <div><div class="jfi-eyebrow">DMO-MG · TRABALHO DE EQUIPA</div><div class="jfi-ref">@referencia</div></div>
      <div class="jfi-topo-dir"><div><span>LINHA</span><b class="jfi-linha">@jobOn.Machine</b></div><div><span>PRODUÇÃO</span><b>@jobOn.ProductionNumber</b></div></div>
    </header>
    <div class="jfi-factos">
      <div><span>Entrada</span><b>@inicio?.ToString("dd/MM/yyyy")</b></div>
      <div><span>Saída</span><b>@fim?.ToString("dd/MM/yyyy")</b></div>
      <div><span>Secções</span><b>@F("cab_seccoes")</b></div>
      <div><span>Gotas</span><b>@F("cab_gota")</b></div>
      <div><span>Peso</span><b>@Peso()</b></div>
      <div><span>Cadência</span><b></b></div>
    </div>
    <div class="jfi-col">
      <div class="jfi-barra"><span>CONTRA-MOLDE</span></div>
      <table class="dmo-table jfi-t jfi-lista">
        <tr><th>Peça</th><th>Ref.</th><th>Lote</th><th>Observações</th></tr>
        <tr><td>Contra-molde</td><td>@cm?.Reference</td><td>@(cm is null ? "" : FolhaModel.Lote(cm.Lot))</td><td></td></tr>
        <tr><td>Tampão</td><td>@F("tp_referencia")</td><td></td><td>@(string.Join(" × ", new[] { F("tp_diametro_ps"), Calote() }.Where(s => s.Length > 0)))</td></tr>
        <tr><td>Punção + arrefecedor</td><td>@(string.Join(" / ", new[] { F("pu_referencia"), F("arr_referencia") }.Where(s => s.Length > 0)))</td><td></td><td>@(F("pu_versao") is { Length: > 0 } v1 ? "Versão " + v1 : "")</td></tr>
      </table>
    </div>
    <div class="jfi-col">
      <div class="jfi-barra"><span>MOLDE FINAL</span></div>
      <table class="dmo-table jfi-t jfi-lista">
        <tr><th>Peça</th><th>Ref.</th><th>Lote</th><th>Observações</th></tr>
        <tr><td>Molde final</td><td>@mf?.Reference</td><td>@(mf is null ? "" : FolhaModel.Lote(mf.Lot))</td><td></td></tr>
        <tr><td>Fundo final</td><td>@F("mf_fundo_final")</td><td></td><td></td></tr>
        <tr><td>Boquilha</td><td>@bq?.Reference</td><td>@(bq is null ? "" : FolhaModel.Lote(bq.Lot))</td><td></td></tr>
        <tr><td>Cab. de sopro</td><td>@F("cs_referencia")</td><td></td><td>@(string.Join(" · ", new[] { F("cs_furos") is { Length: > 0 } fu ? "Furos " + fu : "", F("cs_tubo") is { Length: > 0 } tu ? "Tubo " + tu : "" }.Where(s => s.Length > 0)))</td></tr>
        <tr><td>Pinça</td><td>@(F("pi_diametro") is { Length: > 0 } d1 ? "Ø " + d1 : "")</td><td></td><td>@F("pi_pincas")</td></tr>
      </table>
    </div>
    <div class="jfi-col">
      <div class="jfi-barra"><span>CALIBRES</span></div>
      <table class="dmo-table jfi-t jfi-lista">
        <tr><th>Medida</th><th>Componentes</th><th>QTD máq.</th><th>Qtd.</th></tr>
        @foreach (var l in calibres)
        {
          <tr><td>@l.Nome</td><td>@N(l.Valor)</td><td>@V(l.QtdMaq)</td><td></td></tr>
        }
        @if (calibres.Count == 0)
        {
          <tr><td>&nbsp;</td><td></td><td></td><td></td></tr>
        }
      </table>
    </div>
    <div class="jfi-crescer"></div>
    <div class="jfi-lema">TRABALHO DE EQUIPA!</div>
    <footer class="jfi-rodape"><span>FOR 05 MOL 004 (pt)</span><span>Impresso pela DMO</span></footer>
  </section>

</div>
