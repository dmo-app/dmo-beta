@model DMO.Alpha.Web.Pages.JobOn.FolhaModel
@using DMO.Alpha.Web.Pages.JobOn
@*
  AS 4 PÁGINAS DO IMPRIMIR, a preto e branco (Diogo, 27/10/2026, PDF «Job-On
  9395T194 Redesign Preto Branco»): Job-On Moldes (sai 2 vezes), Trabalho de
  equipa e Ficha de artigo. Um clique imprime as quatro. Os valores vêm todos do
  JobOnImpressao (o «gerador»: de onde vem cada linha e em que formato); aqui só
  se desenha. O que o Job On não tem fica com um traço para escrever à mão.
  Ficam escondidas no ecrã e o browser imprime-as (nunca PDF no servidor).
*@
@{
    var I = new JobOnImpressao(Model);
    var rodapeCentro = I["ref"] + " · " + I["producao"];
}
<div class="jof-impressao" data-jof-impressao hidden>
  @{
      void Topo(string nome, string caminho)
      {
          <div class="jfn-marca"><span class="jfn-logo">BA</span><b>DMO-MG</b><span class="jfn-caminho">MOLDES / @caminho</span></div>
          <header class="jfi-topo jfn-topo">
            <div><div class="jfi-eyebrow">@nome</div><div class="jfi-ref">@I["ref"]</div></div>
            <div class="jfn-topo-dir"><div class="jfn-linha"><span>LINHA</span><b>@I["linha"]</b></div><div class="jfn-prod"><span>PRODUÇÃO</span><b>@I["producao"]</b></div></div>
          </header>
          <div class="jfn-factos">
            <div><span>Entrada@(I["entrada.dia"].Length > 0 ? " · " + I["entrada.dia"] : "")</span><b>@I["entrada"]</b></div>
            <div><span>Saída</span><b>@I["saida"]</b></div>
            <div><span>Secções</span><b>@I["seccoes"]</b></div>
            <div><span>Gota</span><b>@I["gota"]</b></div>
            <div><span>Peso</span><b>@I["peso"]</b></div>
            <div><span>Cadência usada</span><b class="jfn-escrever">@I["cadencia"]</b></div>
          </div>
      }
      void Rodape(string codigo, int pagina)
      {
          <footer class="jfi-rodape jfn-rodape"><span>@codigo</span><span>@rodapeCentro</span><span>@pagina.ToString("00") / 04</span></footer>
      }
      // A coluna Ferramenta: o nome, a referência grande com o lote, e (na Ficha) Tipo e Utilização.
      void Ferramenta(string nome, string? refChave, string? loteChave, params (string Rotulo, string Chave)[] lado)
      {
          var r = refChave is null ? "" : I[refChave];
          var l = loteChave is null ? "" : I[loteChave];
          <div class="jfb-nome"><b>@nome</b>@if (r.Length > 0 || l.Length > 0) {<div class="jfb-reflote"><strong>@r</strong>@if (l.Length > 0) {<text> </text><span>Lote <i>@l</i></span>}</div>}@foreach (var (rot, ch) in lado) {<div class="jfb-lado"><span>@rot</span><i>@I[ch]</i></div>}</div>
      }
      // Os Dados técnicos: rótulo e valor, um por linha.
      void Dados(params (string Rotulo, string Valor)[] dados)
      {
          <div><table class="dmo-table jfb-dados">@foreach (var (r, v) in dados) {<tr><th>@r</th><td>@v</td></tr>}</table></div>
      }
      void Notas(string chave)
      {
          <ul class="jfb-notas">@foreach (var n in I.Linhas(chave)) {<li>@n</li>}</ul>
      }
      // Diâmetros com tolerância (Ficha de artigo), e as Folgas por baixo.
      void Dimensoes(string tipo, params (string Rotulo, string Campo)[] linhas)
      {
          <table class="dmo-table jfb-dados jfn-dim"><tr><th>Dimensão</th><th>Valor</th><th>Tol.</th></tr>@foreach (var (r, c) in linhas) {<tr><td>@r</td><td><b>@I[$"{tipo}.{c}"]</b></td><td><i class="jfn-escrever">@I[$"{tipo}.{c}_tol"]</i></td></tr>}</table>
          <div class="jfn-folgas"><span>Folgas</span><b>@I[$"{tipo}.folgas"]</b></div>
      }
      void Geral()
      {
          <div class="jfb-geral"><div class="jfi-sub"><span>Notas gerais · Job-On</span></div><ol class="jfb-geral-texto">@{ var n = 0; }@foreach (var l in I.Linhas("notas")) { n++; <li><span>@n.ToString("00")</span>@l</li> }</ol></div>
      }
      void Calibres(string classe, params (string Rotulo, string Chave)[] cal)
      {
          <div class="jfn-cal-titulo">Calibres</div>
          <div class="jfb-cal @classe">@foreach (var (r, ch) in cal) {<div><span>@r</span><i class="jfn-escrever">@I[ch]</i></div>}</div>
      }
      // A primeira linha fica sempre (com traço para escrever); as outras só com valor.
      (string, string)[] SoComValor(params (string Rotulo, string Valor)[] linhas) => linhas.Where((l, i) => i == 0 || l.Valor.Length > 0).ToArray();
      string Abertos() => string.Join(" · ", new[] { I["cs.abertos"].Length > 0 ? "Abertos " + I["cs.abertos"] : "", I["cs.fechados"].Length > 0 ? "Fechados " + I["cs.fechados"] : "" }.Where(s => s.Length > 0));
  }

  @* ── JOB-ON MOLDES (FOR 05 MOL 001), impresso 2 vezes (Diogo 26/10 21:10) ── *@
  @for (var copia = 0; copia < 2; copia++)
  {
    <section class="jfi-folha jfn-folha jfi-moldes" data-jof-folha="moldes" aria-label="Job-On Moldes">
      @{ Topo("Job-On Moldes", "JOB-ON MOLDES"); }
      <div class="jfn-tabela">
        <div class="jfb-cab"><span>Ferramenta</span><span>Dados técnicos</span><span>Intervenções / Notas</span></div>
        <div class="jfb">@{ Ferramenta("Contra-Moldes", "cm.ref", "cm.lote"); Dados(("Reparador", I["cm.reparador"]), ("Utilização", I["cm.utilizacao"]), ("Adaptador", I["cm.adaptador"]), ("Inversão / Tipo", I.Par("cm.inversao", "cm.tipo"))); Notas("cm.notas"); }</div>
        <div class="jfb">@{ Ferramenta("Tampões", "tp.ref", null); Dados(("Diâmetro", I["tp.diametro"]), ("Calote", I["tp.calote"])); Notas("tp.notas"); }</div>
        <div class="jfb">@{ Ferramenta("Moldes Finais", "mf.ref", "mf.lote"); Dados(("Fundo Final", I["mf.fundo"]), ("Reparador / Util.", I.Par("mf.reparador", "mf.utilizacao")), ("Adaptador", I["mf.adaptador"]), ("Inversão / Tipo", I.Par("mf.inversao", "mf.tipo"))); Notas("mf.notas"); }</div>
        <div class="jfb">@{ Ferramenta("Boquilhas", "bq.ref", "bq.lote"); Dados(("Utilização", I["bq.utilizacao"])); Notas("bq.notas"); }</div>
        <div class="jfb">@{ Ferramenta("Anel", null, null); Dados(SoComValor(("Referência", I["an.ref"]), ("Lote", I["an.lote"]))); Notas("an.notas"); }</div>
        <div class="jfb">@{ Ferramenta("Punções", null, null); Dados(SoComValor(("Referência", I["pu.ref"]), ("Versão", I["pu.versao"]))); Notas("pu.notas"); }</div>
        <div class="jfb">@{ Ferramenta("Arrefecedores", null, null); Dados(("Referência", I["arr.ref"])); Notas("arr.notas"); }</div>
        <div class="jfb">@{ Ferramenta("C. de Sopro", "cs.ref", null); Dados(("Abertos", I["cs.abertos"]), ("Fechados", I["cs.fechados"]), ("Tubo", I["cs.tubo"])); Notas("cs.notas"); }</div>
        <div class="jfb">@{ Ferramenta("Pinças", null, null); Dados(("Pinças", I["pi.pincas"]), ("Diâmetro", I["pi.diametro"])); Notas("pi.notas"); }</div>
      </div>
      @{ Geral(); }
      <div class="jfi-crescer"></div>
      @{ Calibres("jfn-cal4", ("BPB M. Começar", "cal.inv_mp"), ("Fundo Começar", "cal.tampao"), ("Pinça", "cal.pinca"), ("BPB M. Acabar", "cal.inv_mf")); }
      @{ Rodape(I["processo"].Length > 0 ? "FOR 05 MOL 001 (pt)   " + I["processo"] : "FOR 05 MOL 001 (pt)", copia + 1); }
    </section>
  }

  @* ── TRABALHO DE EQUIPA (FOR 05 MOL 004) ──────────────────────── *@
  <section class="jfi-folha jfn-folha" data-jof-folha="equipa" aria-label="Trabalho de equipa">
    @{ Topo("Trabalho de equipa", "TRABALHO DE EQUIPA"); }
    @{
        void C(string sigla, string nome, string valor, string lote = "", string sub = "")
        {
            <div class="jfc">
              <div class="jfc-nome"><span>@sigla</span> @nome</div>
              <div class="jfc-ref"><b>@(valor.Length > 0 ? valor : "—")</b>@if (lote.Length > 0) {<text> </text><span class="jfc-lote jfc-lote-d">Lote <b>@lote</b></span>}</div>
              @if (sub.Length > 0) {<div class="jfc-obs">@sub</div>}
            </div>
        }
    }
    <div class="jfi-duas jfi-equipa">
      <div class="jfi-col">
        <div class="jfi-barra"><span>Lado do contra-molde</span></div>
        <div class="jfc-lista">
          @{
              C("CM", "Contra-Molde", I["cm.ref"], I["cm.lote"]);
              C("TP", "Tampão", I["tp.ref"]);
              C("PU", "Punção", I["pu.ref"], sub: I["pu.versao"].Length > 0 ? "Versão " + I["pu.versao"] : "");
              C("TR", "Tub. Refrigeração", I["arr.ref"]);
          }
        </div>
      </div>
      <div class="jfi-col">
        <div class="jfi-barra"><span>Lado do molde final</span></div>
        <div class="jfc-lista">
          @{
              C("MF", "Molde Final", I["mf.ref"], I["mf.lote"]);
              C("FF", "Fundo Final", I["mf.fundo"], I["mf.lote_ff"]);
              C("BQ", "Boquilha", I["bq.ref"], I["bq.lote"]);
              C("CS", "Cab. Enchimento", I["cs.ref"], sub: string.Join(" · ", new[] { Abertos(), I["cs.tubo"].Length > 0 ? "Tubo " + I["cs.tubo"] : "" }.Where(s => s.Length > 0)));
              @* R11 (Diogo, 30/10/2026: «a impressão do Job On não traz a informação da pinça»): sem diâmetro, as
                 Pinças vão no lugar dele em vez de «—»; as notas da PI também saem. *@
              C("PI", "Pinça", I["pi.diametro"].Length > 0 ? "Ø " + I["pi.diametro"] : I["pi.pincas"],
                  sub: string.Join(" · ", new[] { I["pi.diametro"].Length > 0 ? I["pi.pincas"] : "", I["pi.notas"] }.Where(s => s.Length > 0)));
          }
        </div>
      </div>
    </div>
    @{ Calibres("jfn-cal6", ("Nível", "cal.nivel"), ("CM", "cal.inv_mp"), ("MF", "cal.inv_mf"), ("Tampão", "cal.tampao"), ("CS", "cal.cs"), ("Pinças", "cal.pinca")); }
    <div class="jfi-crescer"></div>
    @{ Rodape("FOR 05 MOL 004 (pt)", 3); }
  </section>

  @* ── FICHA DE ARTIGO (FOR 05 MOL 001) ─────────────────────────── *@
  <section class="jfi-folha jfn-folha jfi-moldes" data-jof-folha="ficha" aria-label="Ficha de artigo">
    @{ Topo("Ficha de artigo", "FICHA DE ARTIGO"); }
    <div class="jfn-tabela">
      <div class="jfb-cab"><span>Ferramenta</span><span>Dados técnicos</span><span>Notas</span></div>
      <div class="jfb">@{ Ferramenta("Contra-Moldes", "cm.ref", "cm.lote", ("Tipo", "cm.tipo"), ("Utilização", "cm.utilizacao")); }<div>@{ Dimensoes("cm", ("Diâm. Exterior", "exterior"), ("Diâm. Pata", "pata"), ("Diâm. Gargalo", "gargalo")); }</div>@{ Notas("cm.notas"); }</div>
      <div class="jfb">@{ Ferramenta("Moldes Finais", "mf.ref", "mf.lote", ("Tipo", "mf.tipo"), ("Utilização", "mf.utilizacao")); }<div><div class="jfn-ff"><span>Fundo Final</span><b>@I["mf.fundo"]</b><span>Lote</span><i class="jfn-escrever">@I["mf.lote_ff"]</i></div>@{ Dimensoes("mf", ("Diâm. Exterior", "exterior"), ("Diâm. Corpo", "corpo"), ("Diâm. Gargalo", "gargalo")); }</div>@{ Notas("mf.notas"); }</div>
      <div class="jfb">@{ Ferramenta("Tampões", "tp.ref", null); Dados(("Diâmetro", I["tp.diametro"]), ("Calote", I["tp.calote"])); Notas("tp.notas"); }</div>
      <div class="jfb">@{ Ferramenta("Boquilhas", "bq.ref", "bq.lote"); Dados(("Utilização", I["bq.utilizacao"])); Notas("bq.notas"); }</div>
      <div class="jfb">@{ Ferramenta("Anilha", null, null); Dados(SoComValor(("Referência", I["an.ref"]), ("Lote", I["an.lote"]))); Notas("an.notas"); }</div>
      <div class="jfb">@{ Ferramenta("Punções", null, null); Dados(SoComValor(("Referência", I["pu.ref"]), ("Versão", I["pu.versao"]))); Notas("pu.notas"); }</div>
      <div class="jfb">@{ Ferramenta("Tub. Refrig", null, null); Dados(("Referência", I["arr.ref"])); Notas("arr.notas"); }</div>
      <div class="jfb">@{ Ferramenta("C. de Sopro", "cs.ref", null); Dados(("Abertos", I["cs.abertos"]), ("Fechados", I["cs.fechados"]), ("Tubo", I["cs.tubo"])); Notas("cs.notas"); }</div>
      <div class="jfb">@{ Ferramenta("Pinças", null, null); Dados(("Pinças", I["pi.pincas"]), ("Diâmetro", I["pi.diametro"])); Notas("pi.notas"); }</div>
    </div>
    <div class="jfb-fim">
      @{ Geral(); }
      <div class="jfi-artigo"><div class="jfn-artigo-titulo">Artigo</div><div class="jfi-artigo-img" data-jof-folha-artigo><span>Sem imagem do artigo</span></div></div>
    </div>
    <div class="jfi-crescer"></div>
    @{ Calibres("jfn-cal5", ("Tampão", "cal.tampao"), ("Cab. enchimento", "cal.cs"), ("Pinça", "cal.pinca"), ("Inver. molde", "cal.inv_mf"), ("Inver. MP", "cal.inv_mp")); }
    @{ Rodape("FOR 05 MOL 001 (pt)", 4); }
  </section>

</div>
