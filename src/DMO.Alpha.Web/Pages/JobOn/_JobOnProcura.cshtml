@model DMO.Alpha.Web.Pages.JobOn.JobOnProcura
@* A procura ao escrever do Job On, em dois passos (Diogo, 17/10/2026:
   «deveria ser referência e depois produções»). Primeiro as referências
   encontradas; um clique numa mostra as últimas produções dela num dropdown
   à frente do campo (_JobOnProcuraProducoes). *@
@{
  var limite = DMO.Alpha.Core.Production.IProductionPickerQuery.SearchLimit;
}
@if (Model.Referencia is { } referencia)
{
  @if (Model.Linhas.Count == 0)
  {
    <p class="muted" role="status">Sem produções da referência «@referencia».</p>
  }
  @* Com produções, o dropdown fica à frente do campo (_JobOnProcuraProducoes). *@
}
else if (Model.Referencias.Count == 0)
{
  <p class="muted" role="status">Sem referências para «@Model.Termo».</p>
}
else
{
  <div class="dmo-table-wrap">
    <table class="dmo-table" id="lightProcuraReferencias" data-dmo-list="Referências encontradas">
      <thead>
        <tr><th>Referência</th><th>Produções</th><th>Última produção</th><th>Máquina</th><th>Início</th></tr>
      </thead>
      <tbody>
        @foreach (var linha in Model.Referencias)
        {
          var item = linha.Item;
          <tr data-dmo-row data-id="@item.Reference" data-dmo-open="@linha.Abrir"
              aria-label="Referência @item.Reference — um clique mostra as produções">
            <td><strong>@item.Reference</strong></td>
            <td>@item.Productions</td>
            <td>@item.LastProductionNumber</td>
            <td>@item.LastMachine</td>
            <td>@(item.LastInicioEm?.ToString("dd/MM/yyyy") ?? "Sem dia associado")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  @if (Model.Referencias.Count >= limite)
  {
    <p class="muted">Mostram-se as @limite referências mais recentes. Escreva mais para afinar.</p>
  }
}
