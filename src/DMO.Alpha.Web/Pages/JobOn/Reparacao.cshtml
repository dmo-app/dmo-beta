@page "/JobOn/Reparacao"
@model DMO.Alpha.Web.Pages.JobOn.ReparacaoModel
@{
    Layout = "_DmoShellLayout";
    ViewData["BetaPage"] = "jobon";
}
@section Head {
<link rel="stylesheet" href="~/css/dmo-jobon-folha.css" asp-append-version="true">
}
<main class="dmo-workspace jof-page" aria-labelledby="jofRiTitulo">
  @if (Model.JobOn is not { } jobOn)
  {
    <a class="jof-voltar" href="/JobOn">‹ Planeamento</a>
    <h1 id="jofRiTitulo">Reparação</h1>
    <div class="jobon-aviso" role="alert">A produção indicada não existe.</div>
  }
  else
  {
    <a class="jof-voltar" href="/JobOn/Folha?jobon_id=@jobOn.JobOnId">‹ Folha do Job On</a>
    <h1 id="jofRiTitulo">Reparação · @jobOn.Reference · Produção @jobOn.ProductionNumber · @jobOn.Machine</h1>
    <p class="resumo-hint">A Reparação Interna registada neste Job On. Só leitura.</p>
    @if (Model.Linhas.TotalCount == 0)
    {
      <p class="jof-vazio" data-jof-ri-vazio>Sem reparações registadas neste Job On.</p>
    }
    else
    {
      <div class="dmo-table-wrap dmo-card">
        <table class="dmo-table" data-dmo-list="Reparação do Job On">
          <thead><tr><th scope="col">Quando</th><th scope="col">Tipo</th><th scope="col">Número</th><th scope="col">Referência</th><th scope="col">Lote</th><th scope="col">Quem</th></tr></thead>
          <tbody>
            @foreach (var r in Model.Linhas.Items)
            {
              <tr data-jof-ri="@r.Id">
                <td>@DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(DateTime.SpecifyKind(r.RegistadoEmUtc, DateTimeKind.Utc)).ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(r.Tipo == DMO.Alpha.Core.ReparacaoInterna.ReparacaoTipo.Cm ? "CM" : "MF")</td>
                <td>@r.Numero</td>
                <td>@(r.Referencia ?? "—")</td>
                <td>@(r.Lote ?? "—")</td>
                <td>@(r.Quem ?? "—")</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      <partial name="_ListPager" model="Model.Pager" />
    }
  }
</main>
