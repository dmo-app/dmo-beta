@page "/JobOn/Folha"
@model DMO.Alpha.Web.Pages.JobOn.FolhaModel
@using DMO.Alpha.Core.Production
@using DMO.Alpha.Web.Pages.JobOn
@*
  A FOLHA DO JOB ON pelo mockup do Diogo (Job_On_v2.html): a mesma
  estrutura, ordem e aspeto (o cabeçalho com os factos, a referência e o
  dropdown das produções, as Opções; Moldes, Gargalo, Sopro e Calibres; o
  Artigo e as Notas gerais ao lado; o painel das linhas como gaveta), com
  só o que o Diogo pediu mudado: abre bloqueada e «Editar» vem nas Opções;
  TP ao lado do CS; CAL na horizontal por baixo; o lote do AN é o da BQ; a
  informação técnica recolhe no triângulo (à esquerda do texto); os
  detalhes curtos (referência, lote, %, notas); um clique na ferramenta,
  no Editar, muda-a e o duplo clique leva à ficha; Opções = Editar,
  Controlo e Reparação; clicar no artigo escolhe a imagem; a cor da linha
  é a do Planeamento; «Lote 1» sem o zero.
*@
@{
    Layout = "_DmoShellLayout";
    ViewData["BetaPage"] = "jobon";
    var culture = DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture;
    var editar = Model.Editar;
    var desenhados = new HashSet<string>(StringComparer.Ordinal);
    // As folgas com um número por espaço (JobOnFolgas): o que se mostra, e no Editar o que vai na caixa.
    var folgasVistas = new Dictionary<string, string?>(StringComparer.Ordinal);
    var espacosMf = JobOnFolgas.UmaPorEspaco(Model.Folha.Valor("mf_folga1"), Model.Folha.Valor("mf_folga2"), Model.Folha.Valor("mf_folga3"));
    for (var i = 0; i < 3; i++) folgasVistas[$"mf_folga{i + 1}"] = espacosMf[i];
}
@section Head {
<link rel="stylesheet" href="~/beta-adapter.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/dmo-jobon-folha.css" asp-append-version="true">
}
@functions {
    private static string? Vazio(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    // Os números da folha com ponto e duas casas quando têm casas, também dentro do texto
    // («70/69,4» → «70/69.40»; Diogo, 26/10/2026). O resto do texto fica como está.
    private static string? Mostra(string? v) => DMO.Alpha.Core.Runtime.DmoNumberFormat.FolhaTexto(v);

    // Os espaços das folgas, pela ordem (Diogo, 28/10/2026, com o desenho do molde): a folga, a
    // tolerância e, só no MF, a folga da flecha (hollow mill). O CM tem o hollow mill de um lado só:
    // «os espaços ficam 0.12 - 0.03, não tem o terceiro».
    private static readonly (string Curto, string Nome)[] ZonasDasFolgas =
        [("Folga", "Folga"), ("Tol.", "Tolerância"), ("Flecha", "Folga da flecha (hollow mill)")];

    // Nos Calibres o «mm» vai para o título e sai do valor, para poupar espaço (Diogo, 28/10/2026:
    // «nos calibres metemos os MM nos títulos da tabela»): «Inversão MF (mm)» e «75.20».
    private static readonly System.Text.RegularExpressions.Regex Mm = new(@"(?<=\d)\s*mm\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    private static (string Designacao, string? Valor) CalSemMm(string? designacao, string? valor)
    {
        var d = designacao ?? "";
        var v = Mostra(valor);
        if (v is null || !Mm.IsMatch(v)) return (d, v);
        return (d.Contains("mm", StringComparison.OrdinalIgnoreCase) ? d : d + " (mm)", Mm.Replace(v, ""));
    }

    // «56.40 X 58.60»: um número, o «x» por baixo e o outro número por baixo dele (Diogo, 28/10/2026:
    // «ficar número x, muda linha, número é confuso»).
    private static readonly System.Text.RegularExpressions.Regex Vezes = new(@"^(?<a>\d+(?:[.,]\d+)?)\s*[xX×]\s*(?<b>\d+(?:[.,]\d+)?)$");

    // A tolerância com um só sinal (Diogo, 28/10/2026: «as dimensões apresentam sinal +/- repetido»):
    // «±0.05» e «+0.05» mostram-se «± 0.05»; «-0.05» e «+0.05/-0.02» ficam como estão.
    private static string? Tolerancia(string? v) => Mostra(v)?.Trim() is not { Length: > 0 } t ? null
        : t.StartsWith('-') || t.Contains('/') ? t
        : "± " + t.TrimStart('±', '+', ' ');

    private static decimal? Numero(string? v) =>
        decimal.TryParse(v?.Replace(',', '.').Replace("%", "").Trim(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;
}
@{
    // O valor de um campo da folha: no Editar a caixa, bloqueada o texto (ou «—»).
    void Valor(string chave, string? rotulo = null)
    {
        var campo = JobOnFolhaCampos.Encontrar(chave)!;
        desenhados.Add(chave);
        var valor = folgasVistas.TryGetValue(chave, out var folgaVista) ? folgaVista : Model.Folha.Valor(chave);
        // O lote do AN é, por omissão, o da BQ; só muda se alguém o escrever à mão (Diogo, 26/10/2026).
        string? herdado = chave == "an_lote" && string.IsNullOrWhiteSpace(valor) ? Model.AnLoteDaBq : null;
        if (editar)
        {
            <input class="f" id="@campo.Id" name="@campo.NomeNoFormulario" type="text" maxlength="@campo.Maximo" autocomplete="off" spellcheck="false" value="@Mostra(valor)" placeholder="@herdado" aria-label="@(rotulo ?? campo.RotuloAlteracao)" />
        }
        else if (Mostra(valor ?? herdado) is { } escrito)
        {
            @* Uma medida com vários valores («54.02/52.02/…») parte depois de cada «/», nunca a meio de um número. *@
            @escrito.Replace("/", "/\u200b")
        }
        else
        {
            <span class="v-empty">—</span>
        }
    }

    // CS · Furos: Aberto/Fechado + número, no mesmo campo de texto (cs_furos), «Fechado · 4».
    // No Editar o JS junta a escolha e o número no campo escondido; um valor antigo («4 × 4») mostra-se tal e qual.
    void Furos(string chave)
    {
        var valor = Model.Folha.Valor(chave);
        var (lido, abertos, fechados) = DMO.Alpha.Core.Production.CsFurosTexto.Ler(valor);
        if (!editar)
        {
            // No ver, os abertos e os fechados um por baixo do outro, sem a «/» (Diogo, 26/10/2026).
            if (lido) { <span class="jof-furos-ver"><span>Abertos @abertos</span><span>Fechados @fechados</span></span> } else { Valor(chave); }
            return;
        }
        var campo = JobOnFolhaCampos.Encontrar(chave)!;
        desenhados.Add(chave);
        <span class="jof-furos" data-jof-furos>
          <input type="hidden" id="@campo.Id" name="@campo.NomeNoFormulario" value="@valor" data-jof-furos-valor />
          <label class="jof-furos-campo"><span>Aberto</span><input class="f" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" value="@abertos" aria-label="CS furos abertos (0 a 9)" data-jof-furos-abertos /></label>
          <label class="jof-furos-campo"><span>Fechado</span><input class="f" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" value="@fechados" aria-label="CS furos fechados (0 a 9)" data-jof-furos-fechados /></label>
          @if (!lido && Vazio(valor) is { } antigo)
          {
            <small class="jof-furos-antigo" title="Valor antigo; escreva os abertos e os fechados para o substituir">era «@antigo»</small>
          }
        </span>
    }

    void Kv(IEnumerable<(string Rotulo, string Chave)> linhas)
    {
        <dl class="kv">
          @foreach (var (rotulo, chave) in linhas)
          {
            <dt>@rotulo</dt><dd>@{ Valor(chave, rotulo); }</dd>
          }
        </dl>
    }

    void Notas(string chave)
    {
        var campo = JobOnFolhaCampos.Encontrar(chave)!;
        desenhados.Add(chave);
        var valor = Model.Folha.Valor(chave);
        if (editar)
        {
            <label class="note-box note-edit@(Vazio(valor) is null ? " is-empty" : null)" data-jof-nota><span>Notas</span><textarea class="dmo-valor" id="@campo.Id" name="@campo.NomeNoFormulario" rows="2" maxlength="@campo.Maximo" placeholder="+ Adicionar nota" aria-label="@campo.RotuloAlteracao">@valor</textarea></label>
        }
        else
        {
            @* As notas, mesmo vazias, enchem o cartão até à altura dos vizinhos;
               um clique amplia-as (Diogo, 23/10/2026). *@
            <div class="note-box note-view@(Vazio(valor) is null ? " is-empty" : null)" data-jof-campo="@chave" data-jof-nota tabindex="0"><span>Notas</span><p>@Vazio(valor)</p></div>
        }
    }

    // A utilização: o valor da folha, a barra e a marca do valor anterior (a última leitura).
    void Uso(string chave, JobOnToolFacts? f)
    {
        desenhados.Add(chave);
        var campo = JobOnFolhaCampos.Encontrar(chave)!;
        var valor = Vazio(Model.Folha.Valor(chave));
        var agora = Numero(valor);
        var antes = f?.Utilizacao;
        <div class="use">
          <div class="use-top"><span>Utilização</span>
            @if (editar)
            {
              <input class="f" id="@campo.Id" name="@campo.NomeNoFormulario" type="text" maxlength="@campo.Maximo" autocomplete="off" value="@Mostra(valor)" aria-label="@campo.RotuloAlteracao" /><text>%</text>
            }
            else
            {
              @* Com ponto e duas casas, como no resto da folha; acima de 100% com a
                 cor ligeira do uso cheio (ronda de 26/10/2026, J5). *@
              var usoTexto = valor is null ? "—" : Mostra(valor.TrimEnd('%').Trim()) + "%";
              @* Um clique no % abre o histórico do uso da ferramenta (Diogo, 27/10/2026). *@
              if (f?.ToolId is { } usoTool && valor is not null)
              {
                <a class="dmo-uso-link" href="@DMO.Alpha.Web.Presentation.UsoFerramenta.Href(usoTool)" title="O histórico do uso desta ferramenta"><b class="@(agora > 100 ? "dmo-uso-cheio" : null)" title="@(agora > 100 ? "Acima de 100%" : null)">@usoTexto</b></a>
              }
              else
              {
                <b class="@(agora > 100 ? "dmo-uso-cheio" : null)" title="@(agora > 100 ? "Acima de 100%" : null)">@usoTexto</b>
              }
              @if (antes is { } a)
              {
                <em class="was" title="A última leitura do uso">antes @a.ToString("0.##", culture)%</em>
              }
            }
          </div>
          <div class="bar" role="img" aria-label="Utilização @(valor ?? "—")%"><i style="width:@(Math.Min(agora ?? 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i>@if (antes is { } m) {<s style="left:@(Math.Min(m, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%" title="Antes @m.ToString("0.##", culture)%"></s>}</div>
        </div>
    }

    // A informação técnica: recolhe e expande pelo triângulo, à esquerda do texto.
    void TecnicaAbre(string familia, IEnumerable<string> chaves)
    {
        var resumo = string.Join(" · ", chaves
            .Select(c => (Campo: JobOnFolhaCampos.Encontrar(c)!, Valor: Vazio(Model.Folha.Valor(c))))
            .Where(x => x.Valor is not null)
            .Select(x => $"{(x.Campo.Grupo is null ? x.Campo.Rotulo : "Folgas")} {x.Valor}"));
        var classe = resumo.Length == 0 && !editar ? "more empty" : "more";
        // Fechada por omissão também no Editar e no Duplicar (Diogo, 28/10/2026: a folha tem de caber em
        // 1366×768); abre sozinha só se um dos campos dela foi recusado, para o erro se ver.
        var recusada = editar && chaves.Any(c => Model.Folha.Invalido(JobOnFolhaCampos.Encontrar(c)!.Id));
        @Html.Raw($"<details class=\"{classe}\" data-jof-tecnica=\"{familia}\"{(recusada ? " open" : "")}>")
        <summary><span class="dmo-caret" aria-hidden="true"></span><span>Informação técnica</span><span class="more-preview">@resumo</span></summary>
        @Html.Raw("<div class=\"more-body\">")
    }

    void TecnicaFecha()
    {
        @Html.Raw("</div></details>")
    }

    // A cabeça das ferramentas (CM, MF, BQ): o código, a referência e o lote.
    // Um clique, no Editar, muda a ferramenta; o duplo clique leva à ficha.
    void CabecaFerramenta(string tipo, string? toolId, string nome)
    {
        var f = Model.Fact(toolId);
        @* Quem só tem o Job On ver, sem as Ferramentas, não abre a ficha (Diogo, 27/10/2026:
           «so ve os detalhes do plnaneamento e os jobons»). *@
        var ficha = toolId is null || (!Model.PodeEditar && !Model.Capacidades.Contains(DMO.Alpha.Core.Admin.DmoCapabilities.Ferramentas)) ? null : $"/Ferramentas/Ficha?tool_id={Uri.EscapeDataString(toolId)}&voltar={Uri.EscapeDataString($"{Model.Request.Path}{Model.Request.QueryString}")}";
        <div class="jof-tool-slot" data-jof-tool-slot="@tipo">
          <button type="button" class="tool-head@(f is null ? " tool-empty" : null)" data-jof-tool="@tipo" data-jof-ficha="@ficha"
                  title="@(editar ? "Um clique muda a ferramenta; duplo clique: a ficha" : ficha is null ? null : "Abrir a ficha da ferramenta")"
                  aria-label="@nome @(f is null ? "por indicar" : $"{f.Reference} lote {FolhaModel.Lote(f.Lot)}")@(editar ? ": mudar a ferramenta" : "")">
            <span class="design-tool-heading"><span class="code">@tipo</span><span class="design-tool-name">@nome</span></span>
            @if (f is null)
            {
              <span class="muted">Sem @nome.ToLowerInvariant()</span>
            }
            else
            {
              @* Com o uso cheio, só a cor da referência e do lote muda (Diogo, 23/10/2026). *@
              <span class="hv"><small>Referência</small><b data-jof-tool-ref class="@Model.UsoCheioDe(toolId)">@f.Reference</b></span>
              <span class="hv"><small>Lote</small><b data-jof-tool-lote class="@Model.UsoCheioDe(toolId)">@FolhaModel.Lote(f.Lot)</b></span>
            }
            @if (editar)
            {
              <span class="tool-hint"><span class="dmo-caret" aria-hidden="true"></span> <span class="hint-txt">Trocar</span></span>
            }
          </button>
          @* Onde está pelo Armazém e o estado; sem registo, só um aviso com o link
             (Diogo 21/10, FER-E-03; veio da ficha antiga, nada se perde). *@
          @* Os lotes de antes da BQ já não ficam à vista no cartão (Diogo, 28/10/2026: «remover das
             boquilhas o antes desta produção»). *@
          @if (f?.OndeEsta is { } ondeEsta)
          {
            @* A posição e o estado a negrito; a posição leva ao Armazém da ferramenta, para dar
               entrada ou saída (Diogo, 28/10/2026). *@
            const string NaPosicao = "Armazém · posição ";
            var armazem = DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.MovimentosDoArmazem(f.ToolId, "Armazém");
            @* O estado primeiro, um espaço e a posição: «Reparado   4094» (Diogo, 28/10/2026: «Reparado, espaço e
               posição do armazém»); fora do Armazém, o sítio por extenso («Reparação · Moldin»). *@
            <p class="jof-onde" data-dmo-onde-esta title="@ondeEsta">@if (f.Estado is { } estado) {<b>@DMO.Alpha.Core.Armazem.ArmazemTextos.Estado(estado)</b><span class="jof-onde-espaco"> </span>}@if (ondeEsta.StartsWith(NaPosicao, StringComparison.Ordinal)) {if (armazem.PodeAbrir(Model.Capacidades)) {<a class="jof-onde-pos" href="@armazem.Href" title="@ondeEsta: dar entrada ou saída no Armazém"><b>@ondeEsta[NaPosicao.Length..]</b></a>} else {<b>@ondeEsta[NaPosicao.Length..]</b>}} else {@ondeEsta}</p>
          }
          @if (Model.MostrarAvisoArmazem && f?.AvisoArmazem is { } avisoArmazem)
          {
            <div class="jobon-aviso warn" role="status" data-dmo-aviso-armazem>@avisoArmazem@{ var link = DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.FichaFerramenta(f.ToolId, "Registar na ferramenta"); }@if (link.PodeAbrir(Model.Capacidades)) {<text> </text><a class="dmo-aviso-link" href="@link.Href">@link.Texto</a>}</div>
          }
          @if (editar)
          {
            <div class="jof-tool-procura" data-jof-tool-procura hidden>
              <select name="@(tipo.ToLowerInvariant())_tool_id" data-facts-type="@tipo" data-dmo-filter aria-label="Mudar @tipo: escreva a referência">
                <!option value="">Escreva a referência da @tipo</!option>
                @if (toolId is not null)
                {
                  <!option value="@toolId" selected="selected">@(f is null ? toolId : $"{f.Reference} · Lote {FolhaModel.Lote(f.Lot)}")</!option>
                }
              </select>
            </div>
          }
        </div>
    }

    // CM e MF: a cabeça, a utilização e as notas; as medidas e o resto na informação técnica.
    void Molde(string tipo, string? toolId, string nome)
    {
        var f = Model.Fact(toolId);
        var p = tipo.ToLowerInvariant();
        var medidas = tipo == "CM"
            ? new[] { ("Diâm. pata", "cm_pata", "cm_pata_tol"), ("Diâm. gargalo", "cm_gargalo", "cm_gargalo_tol"), ("Diâm. exterior", "cm_exterior", "cm_exterior_tol") }
            : new[] { ("Diâm. corpo", "mf_corpo", "mf_corpo_tol"), ("Diâm. gargalo", "mf_gargalo", "mf_gargalo_tol"), ("Diâm. exterior", "mf_exterior", "mf_exterior_tol") };
        // O reparador fica à vista no cartão; no MF também o FF com o lote (Diogo, 27/10/2026:
        // «mover o reparador para fora, no MF meter o FF fora com lote»).
        var fora = tipo == "CM"
            ? new[] { ("Reparador", "cm_reparador") }
            : new[] { ("Reparador", "mf_reparador"), ("FF", "mf_fundo_final"), ("Lote FF", "mf_lote_ff") };
        var resto = tipo == "CM"
            ? new[] { ("Tipo", "cm_tipo"), ("Adaptador", "cm_adaptador"), ("Inversão", "cm_inversao"), ("Parafuso", "cm_parafuso"), ("3.ª Almofada", "cm_almofada3") }
            : new[] { ("Tipo", "mf_tipo"), ("Adaptador", "mf_adaptador"), ("Inversão", "mf_inversao"), ("Parafuso", "mf_parafuso") };
        // O terceiro espaço do CM só aparece se já tiver um valor escrito de antes.
        var folgas = tipo == "MF" || Vazio(Model.Folha.Valor("cm_folga3")) is not null
            ? new[] { p + "_folga1", p + "_folga2", p + "_folga3" }
            : new[] { p + "_folga1", p + "_folga2" };
        <article class="card sec" data-jof-familia="@tipo" aria-label="@nome">
          @{ CabecaFerramenta(tipo, toolId, nome); }
          @{ Uso(p + "_utilizacao", f); }
          <div class="jof-fora" data-jof-fora="@tipo">
            @foreach (var (rotulo, chave) in fora)
            {
              <span class="hv"><small>@rotulo</small><b>@{ Valor(chave, $"{tipo} {rotulo}"); }</b></span>
            }
          </div>
          @{ Notas(p + "_notas"); }
          @{ TecnicaAbre(tipo, medidas.SelectMany(m => new[] { m.Item2, m.Item3 }).Concat(folgas).Concat(resto.Select(r => r.Item2))); }
          @if (!editar)
          {
            @* NA FOLHA DE VER: as dimensões e as folgas, «Pata 12.40 ± 0.05», ficam minimizadas dentro da
               Informação técnica, como de manhã (Diogo, 27/10/2026: «tudo a partir de dimensões pode ser
               minimizado», «as coisas estavam minimizadas e controladas»). *@
            <div class="jof-dims" data-jof-dims="@tipo">
              <span class="jof-dims-titulo">Dimensões · mm</span>
              <dl class="jof-dims-lista">
                @foreach (var (rotulo, valor, tol) in medidas)
                {
                  var curto = rotulo.Replace("Diâm. ", "", StringComparison.Ordinal);
                  curto = char.ToUpperInvariant(curto[0]) + curto[1..];
                  desenhados.Add(tol);
                  @* Um valor com vários números («54.02/52.02/…») ocupa a linha de baixo, inteiro. *@
                  <div class="jof-dim@(Mostra(Model.Folha.Valor(valor))?.Length > 14 ? " longo" : null)"><dt>@curto</dt><dd><span class="jof-dim-valor">@{ Valor(valor, $"{tipo} {rotulo}"); }</span>@if (Tolerancia(Model.Folha.Valor(tol)) is { } tolerancia) {<span class="jof-tol"> @tolerancia</span>}</dd></div>
                }
              </dl>
            </div>
            <div class="folgas"><span>Folgas</span>
              @if (folgas.All(fo => Vazio(folgasVistas.TryGetValue(fo, out var vista) ? vista : Model.Folha.Valor(fo)) is null))
              {
                <span class="folga"><span class="v-empty">—</span></span>
              }
              else
              {
                @* As zonas do desenho do molde (Diogo, 28/10/2026): a folga do vacuum vent, a tolerância e a da
                   flecha (hollow mill), cada uma no seu espaço, com o nome por cima. *@
                @foreach (var (folga, zona) in folgas.Zip(ZonasDasFolgas))
                {
                  <span class="folga" title="@zona.Nome"><small>@zona.Curto</small>@{ Valor(folga); }</span>
                }
              }
            </div>
          }
          @if (editar)
          {
            @* No ver, o valor e a tolerância numa só coluna («54.02 ± 0.05»): com duas
               colunas o cartão estreito partia a linha e o «—» aparecia duas vezes
               (Diogo, 27/10/2026). No Editar ficam as duas caixas. *@
            <div class="table-wrap"><table class="dmo-table dims"><thead><tr><th>Medida (mm)</th><th>Valor</th>@if (editar) {<th>Tol.</th>}</tr></thead><tbody>
              @foreach (var (rotulo, valor, tol) in medidas)
              {
                if (editar)
                {
                  <tr><td>@rotulo</td><td>@{ Valor(valor, $"{tipo} {rotulo}"); }</td><td>@{ Valor(tol, $"{tipo} {rotulo} tolerância"); }</td></tr>
                }
                else
                {
                  desenhados.Add(tol);
                  <tr><td>@rotulo</td><td>@{ Valor(valor, $"{tipo} {rotulo}"); }@if (Tolerancia(Model.Folha.Valor(tol)) is { } tolerancia) {<span class="jof-tol"> @tolerancia</span>}</td></tr>
                }
              }
            </tbody></table></div>
            <div class="folgas"><span>Folgas</span>
              @foreach (var folga in folgas)
              {
                if (editar) { Valor(folga); } else { <span class="folga">@{ Valor(folga); }</span> }
              }
            </div>
          }
          @{ Kv(resto); }
          @{ TecnicaFecha(); }
        </article>
    }

    // Os cartões sem ferramenta registada: a cabeça com a referência, os valores, as notas e a informação técnica.
    void Simples(string codigo, string? chaveRef, (string, string)[] linhas, (string, string)[] tecnica, bool calote = false, string? chaveLote = null)
    {
        var notas = JobOnFolhaCampos.DaFamilia(codigo).FirstOrDefault(c => c.Tipo == JobOnFolhaTipoCampo.Nota)?.Chave;
        var nome = codigo switch { "PU" => "Punção", "TP" => "Tampão", "CS" => "Cabeça de sopro", "PI" => "Pinças", "AN" => "Anel", "ARR" => "Tubo de refrigeração", _ => "" };
        <div class="sec-head"><span class="design-tool-heading"><span class="code">@codigo</span><span class="design-tool-name">@nome</span></span>
          @if (chaveRef is not null)
          {
            <span class="hv"><small>Referência</small><b>@{ Valor(chaveRef, $"{codigo} referência"); }</b></span>
          }
          @if (chaveLote is not null)
          {
            <span class="hv"><small>Lote</small><b>@{ Valor(chaveLote, $"{codigo} lote"); }</b></span>
          }
        </div>
        if (linhas.Length > 0 || calote)
        {
            <dl class="kv">
              @foreach (var (rotulo, chave) in linhas)
              {
                if (chave == "cs_furos" && !editar && Vazio(Model.Folha.Valor(chave)) is null)
                {
                  @* Como no DMO-APP, mesmo vazio: «Aberto» e «Fechado» representam o 4x4,
                     4x2…, nunca um «Furos» solto (Diogo, 27/10/2026). Escrito, fica o
                     «Abertos 4 / Fechados 0» de sempre. *@
                  desenhados.Add(chave);
                  <dt>Aberto</dt><dd><span class="v-empty">—</span></dd>
                  <dt>Fechado</dt><dd><span class="v-empty">—</span></dd>
                  continue;
                }
                <dt>@rotulo</dt><dd>@if (chave == "cs_furos") { Furos(chave); } else { Valor(chave, $"{codigo} {rotulo}"); }</dd>
              }
              @if (calote)
              {
                <dt title="Calote / altura: entra no cálculo do peso">Calote</dt>
                <dd>
                  @if (editar)
                  {
                    <input class="f" id="lightCalote" name="calote_mm" type="number" lang="en" min="0" step="any" placeholder="—" value="@(Model.JobOn?.CaloteMm is { } caloteValor ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2SemPerda(caloteValor) : null)" aria-label="Calote (mm)" />
                  }
                  else if (Model.JobOn?.CaloteMm is { } valorCalote)
                  {
                    @DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(valorCalote)
                  }
                  else if (Vazio(Model.Folha.Valor("tp_bacia_ps")) is { } caloteBacia)
                  {
                    @caloteBacia
                  }
                  else
                  {
                    <span class="v-empty">—</span>
                  }
                </dd>
              }
            </dl>
        }
        if (notas is not null)
        {
            Notas(notas);
        }
        if (tecnica.Length > 0)
        {
            TecnicaAbre(codigo, tecnica.Select(t => t.Item2));
            Kv(tecnica);
            TecnicaFecha();
        }
    }
}
@if (Model.JobOn is { } jobOnPainel && !editar && Model.Request.Query["painel"] == "1")
{
  @* NO PAINEL DESLIZANTE (Diogo, 27/10/2026: «vai servir apenas de consulta rápida e ter uma
     opção para abrir a janela»): não se copia a folha; um resumo da produção e «Abrir folha»,
     que abre a folha inteira, como está, fora do painel. *@
