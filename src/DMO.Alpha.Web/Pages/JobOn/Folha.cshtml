              <div class="pick-campo"><label class="pick-rotulo" for="lightProduction">Produção</label>
              <input class="prod-select" id="lightProduction" name="production_number" type="text" value="@(Model.NumeroEscrito ?? string.Empty)" aria-label="Número da produção" placeholder="N.º" autocomplete="off" readonly="@(Model.Experiencia ? "readonly" : null)" />
              @if (Model.Experiencia) { <span class="jof-experiencia" role="status">Experiência</span> }</div>
            }
            else if (editar)
            {
              @* No Editar não se procura nem se troca de produção: só o aviso grande (Diogo, 23/10/2026). *@
              <div class="jof-modo-editar" role="status" data-jof-modo-editar>Modo Editar</div>
            }
            else
            {
              @* Sem «Ficha de moldes»: cada caixa diz o que é, em letra pequena (Diogo, 23/10/2026). *@
              <div class="pick-campo"><label class="pick-rotulo" for="jofReferencia">Referência</label>
              <div class="ref-search" role="search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                <input type="search" form="jofProcura" name="referencia" id="jofReferencia" value="@Model.ReferenciaTotal" aria-label="Referência: escreva para procurar outra" autocomplete="off" autocapitalize="characters" spellcheck="false" data-dmo-suggest="referencias" data-dmo-suggest-submit />
              </div></div>
              <div class="pick-campo"><label class="pick-rotulo" for="jofProducoes">Produção</label>
              <select id="jofProducoes" class="prod-select" data-dmo-ir aria-label="Produção desta referência">
                @foreach (var p in Model.Producoes)
                {
                  <option value="/JobOn/Folha?jobon_id=@p.JobOnId@Model.NovoDestino" selected="@(p.JobOnId == jobOn.JobOnId ? "selected" : null)">@p.ProductionNumber · @p.Machine</option>
                }
                @if (!Model.Producoes.Any(p => p.JobOnId == jobOn.JobOnId))
                {
                  <option value="/JobOn/Folha?jobon_id=@jobOn.JobOnId@Model.NovoDestino" selected="selected">@jobOn.ProductionNumber · @jobOn.Machine</option>
                }
              </select></div>
            }
          </div>
          @if (Model.Escolher)
          {
            <div class="head-acoes"><button class="btn" type="submit" form="jofNovo">Criar</button></div>
          }
          else if (!editar)
          {
            <div class="head-acoes">
              @* Quem só tem «Job On ver» só vê a folha como está e abre ou fecha as secções: sem Imprimir (Diogo, 23/10/2026). *@
              @if (Model.PodeEditar)
              {
                @* As 4 folhas do Imprimir (Diogo, 26/10/2026): escolhe-se a folha; o browser imprime (nunca PDF no servidor). *@
                <button class="btn" type="button" data-jof-imprimir>Imprimir</button>
                <a class="btn" href="@Model.DuplicarHref" data-jof-duplicar>Duplicar</a>
                <a class="btn" href="@Model.Href(editar: true)" data-jof-editar>Editar</a>
              }
                @* Só a chefia (Job On criar) tem as Opções; quem só tem «Job On ver» não vê o Controlo, as Boquilhas nem a Reparação (Diogo, 23/10/2026). *@
                @if (Model.PodeEditar)
                {
                  <details class="menu" data-jof-opcoes>
                    <summary class="btn" aria-label="Opções do Job On @jobOn.ProductionNumber"><span class="dmo-caret" aria-hidden="true"></span> Opções</summary>
                    <div class="menu-list">
                      @if (Model.VeControlo)
                      {
                        <a href="/Controlo/Resumo?jobon_id=@jobOn.JobOnId">Controlo</a>
                      }
                      <a href="/ReparacaoInterna/Consultar?maquina=@Uri.EscapeDataString(jobOn.Machine)&amp;referencia=@Uri.EscapeDataString(jobOn.Reference)&amp;producao=@jobOn.JobOnId">Reparação</a>
                      @if (Model.Eliminar is not null)
                      {
                        <a href="#jobon-delete-dialog" role="button" data-dmo-dialog="jobon-delete-dialog">Eliminar Job On</a>
                      }
                    @* BQs: o registo da BQ desta produção (bq_id = o contexto da BQ do Job On, o filtro por Job On que as Boquilhas já têm). *@
                    @if (Model.VeBoquilhas && jobOn.BqId is { } bqId)
                    {
                      <a href="/Boquilhas?bq_id=@bqId" data-jof-bqs>Boquilhas</a>
                    }
                    </div>
                  </details>
                }
            </div>
          }
        </div>
        @if (editar)
        {
          <div class="head-tools">
            <a class="btn" href="@Model.CancelarHref">Cancelar</a>
            <button class="btn" type="submit" data-jof-guardar>Guardar</button>
          </div>
        }

      </div>
    </div>

    @if (Model.RecusaCriar is { } recusaCriar)
    {
      <div data-dmo-toast="erro" class="jobon-aviso" role="alert" data-jof-recusa>@recusaCriar</div>
    }
    @if (Model.Gravado)
    {
      <div data-dmo-toast="ok" role="status" data-jobon-gravado>Job On guardado.</div>
    }
    @* Os avisos da gravação, os mesmos do Planeamento (Diogo, 23/10/2026). *@
    <div id="jobonAvisos">
      @if (Model.AvisoSobreposicao is { } sobreposicao)
      {
        <div class="jobon-aviso warn" role="status">@sobreposicao.Message@foreach (var conflito in sobreposicao.Conflicts)
          {<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.JobOn(conflito.JobOnId, $"Editar {conflito.Reference} · nº {conflito.ProductionNumber}", editar: true)" />}</div>
      }
      @if (Model.AvisoCalote is { } avisoCalote)
      {
        <div data-dmo-toast="aviso" role="status">@avisoCalote<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.JobOn(jobOn.JobOnId, "Editar a calote", editar: true)" /></div>
      }
      @if (Model.AvisoFimAntesDoInicio is { } avisoFim)
      {
        <div data-dmo-toast="aviso" role="status">@avisoFim<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.JobOn(jobOn.JobOnId, "Editar as datas", editar: true)" /></div>
      }
    </div>
    @if (Model.Faltam.Count > 0)
    {
      <div class="jobon-aviso warn" role="status" data-jof-falta>Falta @string.Join(", ", Model.Faltam): o Job On precisa de CM, MF e BQ.@if (editar) {<partial name="_DmoHelp" model="@("Clique no cartão para escolher.")" />}</div>
    }
    @if (Model.AvisoReferencia is { } avisoReferencia)
    {
      <div class="jobon-aviso warn" role="status" data-jof-aviso-referencia>@avisoReferencia</div>
    }

    <div class="sheet">
      <div class="sheet-main"><div class="zones">
        @* Quatro colunas independentes, cada cartão com a altura do seu conteúdo (Diogo, 26/10/2026):
           CM e TP; MF e CS; BQ e AN; PU e ARR. Os Calibres, por baixo de BQ+AN e PU+ARR. *@
        <div class="fcol board" id="gMoldes">
          @{ Molde("CM", jobOn.CmToolId, "Contra molde"); }
          <article class="card sec" data-jof-familia="TP">@{ Simples("TP", null, [("Diâmetro", "tp_diametro_ps")], [], calote: true); }</article>
        </div>
        <div class="fcol board">
          @{ Molde("MF", jobOn.MfToolId, "Molde final"); }
          <article class="card sec" data-jof-familia="CS">@{ Simples("CS", "cs_referencia", [("Furos", "cs_furos"), ("Tubo", "cs_tubo")], []); }</article>
        </div>
        <div class="fright"><div class="frow">
        <div class="fcol board col-bq">
          @* A BQ e o AN, cada um no seu cartão, um por baixo do outro (AN com o lote dele; Diogo, 26/10/2026). *@
          <article class="card pair"><div class="pair-in">
            <div class="sec" data-jof-familia="BQ" aria-label="Boquilha">
              @{ CabecaFerramenta("BQ", jobOn.BqToolId, "Boquilha"); }
              @{ Uso("bq_utilizacao", bqFact); }
              @{ Notas("bq_notas"); }
            </div>
          </div></article>
          <article class="card sec" data-jof-familia="AN" aria-label="Anel">@{ Simples("AN", "an_referencia", [], [], chaveLote: "an_lote"); }</article>
        </div>
        <div class="fcol board">
          @* PU e ARR: o mesmo componente, mas cada um no seu cartão, um por baixo do outro (Diogo, 26/10/2026). *@
          <article class="card sec" data-jof-familia="PU">@{ Simples("PU", "pu_referencia", [], []); }</article>
          <article class="card sec" data-jof-familia="ARR">@{ Simples("ARR", "arr_referencia", [], [("Versão", "arr_versao"), ("N.º de desenho", "arr_desenho")]); }</article>
        </div>
        </div>
        <section class="group g-cal" aria-label="Calibres">
          <div class="board" id="gCal">
            @{ var linhas = Model.Folha.Cal.Where(l => editar || (!l.Extra && (Vazio(l.Valor) is not null || Vazio(l.QtdMaq) is not null))).ToList(); }
            <article class="card sec span-all cal-card">
              <div class="sec-head"><span class="design-tool-heading"><span class="code">CAL</span><span class="design-tool-name">Calibres</span></span></div>
              @if (linhas.Count == 0)
              {
                <p class="empty-text">Sem calibres escritos.</p>
              }
              else
              {
                <div class="table-wrap">
                  <table class="dmo-table dims calv" data-jof-cal>
                    <thead>
                      <tr><th scope="col">Medida</th><th scope="col">Componentes</th><th scope="col">QTD máq.</th></tr>
                    </thead>
                    <tbody>
                      @foreach (var l in linhas)
                      {
                        var (designacaoVista, valorVisto) = CalSemMm(l.Designacao, l.Valor);
                        <tr>
                          <th scope="row">
                            @if (editar)
                            {
                              if (l.Padrao is { } padrao)
                              {
                                <input type="hidden" name="Cal[@l.Indice].Padrao" value="@padrao" />
                              }
                              <input class="f" id="@l.IdDe(JobOnFolhaCampoCal.Designacao)" name="Cal[@l.Indice].Designacao" value="@l.Designacao" type="text" maxlength="@JobOnFolhaCampos.CalMaximo" autocomplete="off" aria-label="@(l.Extra ? "Medida nova" : $"Medida {l.Indice + 1}")" placeholder="@(l.Extra ? "+ Medida" : null)" />
                            }
                            else
                            {
                              @designacaoVista
                            }
                          </th>
                          <td>@if (editar) {<input class="f" id="@l.IdDe(JobOnFolhaCampoCal.Valor)" name="Cal[@l.Indice].Valor" value="@Mostra(l.Valor)" type="text" maxlength="@JobOnFolhaCampos.CalMaximo" autocomplete="off" aria-label="Componentes de @l.Nome" />} else if (valorVisto is not null && Vezes.Match(valorVisto) is { Success: true } vezes) {<span class="cal-vezes"><span>@vezes.Groups["a"].Value</span><span>x</span><span>@vezes.Groups["b"].Value</span></span>} else {@(valorVisto ?? "—")}</td>
                          <td>@if (editar) {<input class="f" id="@l.IdDe(JobOnFolhaCampoCal.QtdMaq)" name="Cal[@l.Indice].QtdMaq" value="@Mostra(l.QtdMaq)" type="text" maxlength="@JobOnFolhaCampos.CalMaximo" autocomplete="off" aria-label="QTD máq. de @l.Nome" />} else {@(Mostra(l.QtdMaq) ?? "—")}</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
              }
            </article>
          </div>
        </section>
        </div>
      </div></div>
      <aside class="side">
        @{ var podeImagem = Model.PodeEditar && !string.IsNullOrEmpty(Model.ReferenciaTotal); }
        <section class="card article" aria-label="Artigo">
          @* Só a foto, mais alta do que larga, ao lado das Pinças: a referência já está no topo
             (Diogo, 27/10/2026: «nao escrever referência no artigo», «os comentários são mais importantes»). *@
          @if (podeImagem) {<button type="button" class="jof-artigo-retirar" data-jof-artigo-retirar title="Retirar a imagem do artigo" aria-label="Retirar a imagem do artigo" hidden>&times;</button>}
          <label class="jof-artigo@(podeImagem ? " jof-artigo-escolher" : null)" data-jof-artigo="@Model.ReferenciaTotal" data-jof-artigo-pode="@(podeImagem ? "1" : "0")" title="@(podeImagem ? "Clique na imagem para a associar ou trocar, ou cole uma imagem (Ctrl+V); depois escolha a área a guardar. Fica na pasta das imagens dos artigos, dentro da pasta da referência, e aparece em todos os Job On dela. Na primeira vez, associe a pasta geral neste computador (Chrome ou Edge)." : null)">
            @if (podeImagem)
            {
              <input type="file" accept="image/*" class="sr-only" data-jof-artigo-ficheiro aria-label="Escolher a imagem do artigo" />
            }
            <img data-jof-artigo-img alt="Imagem do artigo @Model.ReferenciaTotal" hidden />
            <svg data-jof-artigo-vazio viewBox="0 0 120 230" role="img" aria-label="Silhueta do artigo"><g fill="var(--bottle-fill)" stroke="var(--bottle-stroke)" stroke-width="2" stroke-linejoin="round"><path d="M54 10h12v6c0 6 2 10 4 18 5 18 18 26 18 46v120c0 8-6 12-14 12H46c-8 0-14-4-14-12V80c0-20 13-28 18-46 2-8 4-12 4-18z" /><path d="M52 16h16" /><path d="M36 150h48" opacity=".5" /></g></svg>
          </label>
          <p class="jof-artigo-aviso" data-jof-artigo-aviso role="status" hidden></p>
        </section>
        <section class="card notes" aria-labelledby="notesTitle">
          @* As ajudas no triângulo, não escritas no ecrã (ronda de 26/10/2026, J8). *@
          <h2 id="notesTitle" title="@(editar ? "Uma nota por linha. Grava com Guardar." : Model.PodeEditar ? "Para mudar as notas, use Editar." : null)">Notas gerais</h2>
          @{
              desenhados.Add("notas_gerais");
              var gerais = Model.Folha.Valor("notas_gerais");
          }
          @if (editar)
          {
            <textarea class="dmo-valor jof-notas-gerais" id="jobon-notas-gerais" name="Folha.NotasGerais" rows="8" maxlength="@JobOnFolhaCampos.MaximoNotasGerais" aria-label="Notas gerais" placeholder="+ Adicionar nota">@gerais</textarea>
          }
          else
          {
            <ul>
              @if (Vazio(gerais) is null)
              {
                <li class="view empty-text">Sem notas.</li>
              }
              else
              {
                foreach (var linha in gerais!.Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0))
                {
                  <li class="view">@linha</li>
                }
              }
            </ul>
          }
        </section>
        @* O PI na coluna da direita, por baixo das Notas gerais (Diogo, 23/10/2026). *@
        <section class="group g-pinfo" aria-label="Pinças">
          <div class="board" id="gPinfo">
            <article class="card sec" data-jof-familia="PI">@{ Simples("PI", null, [("Pinças", "pi_pincas"), ("Diâmetro", "pi_diametro")], []); }</article>
          </div>
        </section>
      </aside>
    </div>
    @* No fim da folha, o resumo das alterações durante o fabrico (Diogo, 23/10/2026).
       O QUE MUDOU desde o início (veio da ficha antiga do Planeamento, Diogo
       23/10/2026): fechado; os avisos dos módulos (?vista=alteracoes) abrem-no. *@
    @if (Model.Resumo.Count > 0)
    {
      <details class="jobon-mudancas" id="fichaMudancas" open="@Model.VistaAlteracoes">
        <summary><span class="dmo-caret" aria-hidden="true"></span>O que mudou desde o início (@Model.ResumoAtivas @(Model.ResumoAtivas == 1 ? "alteração" : "alterações"))</summary>
        @* SEM BOTÕES NAS LINHAS (Diogo, 27/10/2026: «não quero botões em rows
           por todo o lado»): a ação do módulo («Rever o Controlo», «Verificar
           o Peso») é UM botão no canto, para a alteração escolhida. Um clique
           numa alteração escolhe-a (e, a quem pode, abre a janela «Remover
           por engano», como antes); a mais recente com ação vem escolhida. *@
        @{ var escolhida = Model.Resumo.FirstOrDefault(e => e.ActionHref is not null); }
        @if (escolhida is not null)
        {
          <div class="jobon-resumo-topo dmo-card-topo-acoes" data-jof-resumo-acao><a class="dmo-button" href="@escolhida.ActionHref">@escolhida.ActionLabel</a></div>
        }
        <ul class="jobon-resumo" aria-label="O que mudou">
          @foreach (var entrada in Model.Resumo)
          {
            @* REMOVER POR ENGANO (Diogo, 23/10/2026): clicar numa alteração abre a janela; a removida desaparece. *@
            var esta = ReferenceEquals(entrada, escolhida);
            <li data-jof-alteracao="@entrada.ChangeId" data-jof-alteracao-texto="@entrada.Text" data-jof-alteracao-quando="@entrada.When@(entrada.Who is { } q ? " · " + q : "")" tabindex="0" title="@(entrada.ChangeId is null ? null : "Abrir")"
                data-jof-acao-href="@entrada.ActionHref" data-jof-acao-rotulo="@(entrada.ActionHref is null ? null : entrada.ActionLabel)"
                class="@(esta ? "selected" : null)" aria-current="@(esta ? "true" : null)">
              <div>
                <strong>@entrada.Text</strong>
                <span>@entrada.When@(entrada.Who is { } quemMudou ? " · " + quemMudou : "")</span>
              </div>
            </li>
          }
        </ul>
      </details>
      @if (Model.AlteracaoRemovida)
      {
        <div data-dmo-toast="ok" role="status">Alteração removida. Os valores do Job On não mudaram.</div>
      }
    }
    </div>
  </main>
    @if (editar)
    {
      @* Os campos da folha que não aparecem neste ecrã vão como estão. *@
      foreach (var campo in JobOnFolhaCampos.Todos.Where(c => !desenhados.Contains(c.Chave)))
      {
        <input type="hidden" name="@campo.NomeNoFormulario" value="@Model.Folha.Valor(campo.Chave)" />
      }
    }
  </form>
  @if (Model.Escolher)
  {
    <form id="jofNovo" method="get" action="/JobOn/Folha" hidden data-jof-novo>
      <input type="hidden" name="novo" value="1" />
      <input type="hidden" name="etapa" value="criar" />
      @if (Model.NovoMachineId is { } nm) { <input type="hidden" name="machine_id" value="@nm" /> }
      @if (Model.NovoInicio is { } ni2) { <input type="hidden" name="inicio_em" value="@ni2.ToString("yyyy-MM-dd")" /> }
    </form>
  }
  @if (!editar)
  {
    <form id="jofProcura" method="get" action="/JobOn/Folha" hidden>
      @if (Model.NovoMachineId is int linhaProcura)
      {
        <input type="hidden" name="machine_id" value="@linhaProcura" />
      }
      else if (Model.JobOn is { } jobOnProcura)
      {
        @* Uma referência sem Job On começa o Job On novo na linha deste (Diogo, 28/10/2026). *@
        <input type="hidden" name="linha_de" value="@jobOnProcura.Machine" />
      }
      @if (Model.NovoInicio is { } inicioProcura)
      {
        <input type="hidden" name="inicio_em" value="@inicioProcura.ToString("yyyy-MM-dd")" />
      }
    </form>
    @if (!editar && !Model.Escolher && Model.PodeEditar && Model.JobOn is not null)
    {
      <partial name="_JobOnFolhasImprimir" model="Model" />
    }
    @if (Model.Eliminar is { } eliminar)
    {
      <partial name="_JobOnEliminar" model="eliminar" />
    }
    @if (Model.PodeEditar && Model.JobOn is { } jobOnRemover && Model.Resumo.Any(e => e.ChangeId is not null && !e.IsRemoved))
    {
      <partial name="_JobOnRemoverAlteracao" model="jobOnRemover.JobOnId" />
    }
  }
}
@section Scripts {
@* A arrumação da folha a 1366×768, carregada depois de todas as folhas da app (as regras do Planeamento
   também desenham a folha): ver dmo-jobon-folha-1366.css. *@
<link rel="stylesheet" href="~/css/dmo-jobon-folha-1366.css" asp-append-version="true" media="screen">
<script src="~/js/jobon-folha.js" asp-append-version="true" defer></script>
@if (Model.PodeEditar && !string.IsNullOrEmpty(Model.ReferenciaTotal))
{
<link rel="stylesheet" href="~/css/dmo-artigo-recorte.css" asp-append-version="true" media="screen" />
<script src="~/js/dmo-artigo-recorte.js" asp-append-version="true" defer></script>
}
@if (editar)
{
<script src="~/js/jobon-rascunho.js" asp-append-version="true" defer></script>
}
}
