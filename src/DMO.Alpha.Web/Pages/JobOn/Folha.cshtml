      <tbody>
        @foreach (var (codigo, toolId, chaveUso) in new[] { ("CM", jobOnPainel.CmToolId, "cm_utilizacao"), ("MF", jobOnPainel.MfToolId, "mf_utilizacao"), ("BQ", jobOnPainel.BqToolId, "bq_utilizacao") })
        {
