            <td><span class="jof-painel-uso">@UsoPainel(chaveUso)</span><span class="jof-painel-barra" aria-hidden="true"><i style="width:@BarraPainel(chaveUso).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></i></span></td>
          </tr>
        }
        <tr><th scope="row">PU</th><td><b>@(Mostra(Vazio(Model.Folha.Valor("pu_referencia"))) ?? "—")</b></td><td>—</td><td>—</td></tr>
      </tbody>
