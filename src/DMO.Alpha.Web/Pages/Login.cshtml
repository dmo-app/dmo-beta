@page
@model LoginModel
@{
    Layout = "_DmoAccountLayout";
    ViewData["Title"] = "Entrar";
}

@if (Model.SemAcesso)
{
    @* Já com sessão, numa página que a conta não pode abrir (teste do ensaio, 27/10/2026). *@
    <section class="login-form" aria-labelledby="login-title" id="login-sem-acesso">
        <h2 id="login-title">Sem acesso</h2>
        <p class="lead">A sua conta não tem acesso a esta página. Se precisar dela, peça ao ADMIN.</p>
        <a class="dmo-voltar-texto" href="/JobOn">Voltar</a>
    </section>
    return;
}

<form method="post" class="login-form" data-native-login aria-labelledby="login-title">
    <h2 id="login-title">Entrar</h2>
    <p class="lead">Introduza as suas credenciais para aceder ao Portal DMO.</p>
    <div class="dmo-field">
        <label for="identifier">Utilizador</label>
        <input id="identifier" name="identifier" type="text" value="@Model.Identifier" maxlength="256"
               autocomplete="username" placeholder="Email ou ID de operador (até 4 dígitos)" />
    </div>
    <div class="dmo-field">
        <label for="password">Palavra-passe</label>
        <div class="password-wrap">
            <input id="password" name="password" type="password" maxlength="128" autocomplete="current-password" />
            <button class="dmo-button password-toggle" type="button" aria-controls="password"
                    aria-pressed="false" data-password-toggle hidden>Mostrar</button>
        </div>
    </div>
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <button type="submit" class="dmo-button submit" data-login-submit>Entrar</button>
    @* Só «Reparação», no canto inferior direito do quadro (Diogo, 26/10/2026). *@
    <a class="dmo-button" href="/Posto" id="login-posto" aria-label="Posto de Reparação">Reparação</a>

    @if (Model.Instalado)
    {
        <div class="alert alert-success form-message" role="status">ADMIN criado. Entre com o email e a palavra-passe que escolheu.</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger form-message" role="alert">@Model.ErrorMessage</div>
    }
</form>
