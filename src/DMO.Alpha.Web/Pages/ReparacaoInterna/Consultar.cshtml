@page "/ReparacaoInterna/Consultar"
@model DMO.Alpha.Web.Pages.ReparacaoInterna.ConsultarModel
@using DMO.Alpha.Core.ReparacaoInterna
@using DMO.Alpha.Web.Pages.ReparacaoInterna
@{
    Layout = "_DmoShellLayout";
}
@section Head {
<link rel="stylesheet" href="~/css/paginas/reparacaointerna-consultar.css" asp-append-version="true">
}

@* Consultar (RI-05): os chefes veem quem reparou o quê e em que produção.
   Abre vazia, só com os filtros numa linha; a tabela só lê depois de um
   filtro. Os dropdowns e as datas aplicam ao escolher; a referência com
   Enter ou a sugestão, e o dropdown ao lado traz as últimas 5 produções dela
   (a procura em dois passos do Resumo do controlo). Os filtros ficam como a
   pessoa os deixou (data-dmo-fica) e só trocam o dropdown das produções e a
   tabela (DmoTroca); o «Limpar filtros» abre a página inteira, vazia. Na
   tabela não há botões (padrão da beta); a produção é um link para a ficha
   do Job On, para quem o tem. A marca «Por associar» (peça 4) abre a janela
   de associar a ferramenta. *@
<main class="ri-page dmo-workspace" aria-labelledby="ri-title" data-dmo-troca>

  <div class="page-head">
    <div>
      @* Haver sempre «← Voltar» (Diogo, 27/10/2026): volta à página de onde se veio
         (data-dmo-voltar); sem origem, ao início. A folha do Job On aberta daqui não conta. *@
      <a class="dmo-voltar-texto" id="riConsultaVoltar" href="/" data-dmo-voltar="consultar" data-dmo-voltar-ignorar="/JobOn/Folha">Voltar</a>
      <h1 id="ri-title">Reparação</h1>
    </div>
  </div>

  <section class="dmo-card ri-filtros-card" aria-label="Filtros da consulta">
    <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
      <form id="riConsultaFiltros" method="get" asp-page="/ReparacaoInterna/Consultar" class="dmo-filter-bar" role="search" data-dmo-reference-scope="ri" data-dmo-reference-name="referencia">
        <div class="dmo-field ri-w-referencia">
          <label for="riConsultaReferencia">Referência<partial name="_DmoHelp" model="@("Escreva o início da referência e carregue Enter (ou escolha a sugestão): «60» traz todas as que começam por 60. Depois pode escolher uma das últimas 5 produções.")" /></label>
          <input id="riConsultaReferencia" name="referencia" value="@Model.Referencia" placeholder="Ex.: 5538" autocomplete="off"
                 data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
        </div>
        @* O segundo passo: o dropdown fica sempre ao lado da referência, para
           nada mexer; desativado sem referência, com ela as últimas 5
           produções (a referência, o nº, a linha e o início). Escrever
           outra referência volta-o a «Todas» (data-dmo-depende). *@
        <div id="riConsultaProducaoZona" class="dmo-field ri-w-producao" data-dmo-regiao>
          <label for="riConsultaProducao">Produção</label>
          @if (Model.Referencia is null)
          {
            <select id="riConsultaProducao" name="producao" disabled data-dmo-reference-select>
              <option value="" data-dmo-reference-option>Produção</option>
            </select>
          }
          else if (Model.Producoes.Count == 0)
          {
            <select id="riConsultaProducao" name="producao" disabled data-dmo-reference-select>
              <option value="" data-dmo-reference-option>Sem produções desta referência</option>
            </select>
          }
          else
          {
            <select id="riConsultaProducao" name="producao" data-dmo-autosubmit data-dmo-depende="riConsultaReferencia" data-dmo-reference-select>
              <option value="" selected="@(Model.Producoes.All(p => !Model.ProducaoEscolhida(p)))" data-dmo-reference-option>Todas</option>
              @foreach (var p in Model.Producoes)
              {
                <option value="@p.JobOnId" selected="@Model.ProducaoEscolhida(p)" data-dmo-reference-option>@p.Label</option>
              }
            </select>
          }
        </div>
        <div class="dmo-field ri-w-tipo">
          <label for="riConsultaTrabalho">Tipo de trabalho</label>
          <select id="riConsultaTrabalho" name="trabalho" data-dmo-autosubmit data-dmo-reference-select>
            <option value="" selected="@(Model.Trabalho is null)" data-dmo-reference-option>Todos</option>
            <option value="reparacao" selected="@(Model.Trabalho == ReparacaoTrabalho.Reparacao)" data-dmo-reference-option>Reparação</option>
            <option value="soldar" selected="@(Model.Trabalho == ReparacaoTrabalho.Soldar)" data-dmo-reference-option>Soldar</option>
            <option value="polir" selected="@(Model.Trabalho == ReparacaoTrabalho.Polir)" data-dmo-reference-option>Polir</option>
          </select>
        </div>
        <div class="dmo-field ri-w-maquina">
          <label for="riConsultaMaquina">Linha</label>
          <select id="riConsultaMaquina" name="maquina" data-dmo-autosubmit data-dmo-reference-select>
            <option value="" selected="@(Model.Maquina is null)" data-dmo-reference-option>Todas</option>
            @foreach (var m in Model.Maquinas)
            {
              <option value="@m.Code" selected="@(Model.Maquina?.MachineId == m.MachineId)" data-dmo-reference-option>@m.Code</option>
            }
          </select>
        </div>
        @* Só os utilizadores que já registaram reparações (o nome vem do
           utilizador, nunca copiado para a reparação). *@
        <div class="dmo-field ri-w-pessoa">
          <label for="riConsultaPessoa">Quem</label>
          <select id="riConsultaPessoa" name="pessoa" data-dmo-autosubmit data-dmo-reference-select>
            <option value="" selected="@(Model.Pessoas.All(p => p.Id != Model.PessoaId))" data-dmo-reference-option>Todos</option>
            @foreach (var p in Model.Pessoas)
            {
              <option value="@p.Id" selected="@(p.Id == Model.PessoaId)" data-dmo-reference-option>@p.Nome</option>
            }
          </select>
        </div>
        <div class="dmo-field ri-w-tipo">
          <label for="riConsultaTipo">CM ou MF</label>
          <select id="riConsultaTipo" name="tipo" data-dmo-autosubmit data-dmo-reference-select>
            <option value="" selected="@(Model.Tipo is null)" data-dmo-reference-option>Todos</option>
            <option value="cm" selected="@(Model.Tipo == ReparacaoTipo.Cm)" data-dmo-reference-option>CM</option>
            <option value="mf" selected="@(Model.Tipo == ReparacaoTipo.Mf)" data-dmo-reference-option>MF</option>
          </select>
        </div>
        <div class="dmo-field ri-w-data">
          <label for="riConsultaDe">Dia de</label>
          <input id="riConsultaDe" name="de" type="date" value="@ConsultarModel.Data(Model.De)" data-dmo-autosubmit />
        </div>
        <div class="dmo-field ri-w-data">
          <label for="riConsultaAte">Até</label>
          <input id="riConsultaAte" name="ate" type="date" value="@ConsultarModel.Data(Model.Ate)" data-dmo-autosubmit />
        </div>
      </form>
    </div>
    <div class="ri-filtros-acoes">
      @* «Sem Job On» como um botão ao lado do «Limpar filtros» (Diogo, 27/10/2026): a caixa
         fica escondida e continua a ir no formulário dos filtros (form=). As reparações com a
         ferramenta escrita que ainda ninguém associou (peça 4). *@
      <label class="ri-so-por-associar" for="riConsultaPorAssociar"><input type="checkbox" id="riConsultaPorAssociar" name="por_associar" value="true" form="riConsultaFiltros" checked="@Model.PorAssociar" data-dmo-autosubmit />Sem Job On<partial name="_DmoHelp" model="@("Reparações sem Job On, com a ferramenta escrita à mão e ainda não ligada a uma ferramenta da lista. Quem tem Criar pode associá-las aqui.")" /></label>
      <a class="dmo-button" id="riConsultaLimpar" href="@Url.Page("/ReparacaoInterna/Consultar")">Limpar filtros</a>
    </div>
  </section>

  <div id="riConsultaAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.Mensagem.Length > 0)
    {
      <p data-dmo-toast="@(Model.Associou ? "ok" : "erro")" role="@(Model.Associou ? "status" : "alert")">@Model.Mensagem</p>
    }
  </div>

  <section id="riConsultaResultados" class="dmo-card ri-card" aria-labelledby="ri-consulta-title" data-dmo-regiao data-dmo-parcial>
    <h3 id="ri-consulta-title">Reparações</h3>
    @if (Model.Resumo.Count > 0)
    {
      @* O resumo repartido em colunas, uma linha por pessoa, para não empurrar a lista
         para baixo; carregar no nome filtra logo por essa pessoa (Diogo, 28/10/2026: «a
         tabela dos users deve ser repartida», «ao carregar num nome filtrar logo pelo nome»). *@
      <div id="riConsultaResumo" class="ri-resumo">
        <h4 id="ri-resumo-title">Resumo por pessoa</h4>
        <ul class="ri-resumo-pessoas" id="riConsultaResumoLista" aria-labelledby="ri-resumo-title">
          @foreach (var p in Model.Resumo)
          {
            var escolhida = p.PessoaId is not null && p.PessoaId == Model.PessoaId;
            <li class="@(escolhida ? "ativo" : null)">
              @if (p.PessoaId is { } pessoaId)
              {
                var rota = Model.Rota(null);
                rota["pessoa"] = escolhida ? null : pessoaId.ToString();
                <a class="ri-resumo-nome" data-ri-pessoa="@(escolhida ? "" : pessoaId.ToString())" href="@Url.Page("/ReparacaoInterna/Consultar", rota)" aria-current="@(escolhida ? "true" : null)" title="@(escolhida ? "Ver todas as pessoas" : $"Só as reparações de {p.Nome}")">@p.Nome</a>
              }
              else
              {
                <span class="ri-resumo-nome">@p.Nome</span>
              }
              <span class="ri-resumo-num"><b>@p.Reparacoes.ToString(System.Globalization.CultureInfo.InvariantCulture)</b> reparações</span>
              <span class="ri-resumo-num"><b>@p.Dias.ToString(System.Globalization.CultureInfo.InvariantCulture)</b> dias</span>
              <span class="ri-resumo-num"><b>@p.MediaPorDia.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</b> por dia</span>
            </li>
          }
        </ul>
      </div>
    }
    @if (!Model.ComFiltro)
    {
      <p class="ri-vazia" id="riConsultaConvite">Escolha a linha, os dias, quem, CM ou MF, ou procure a produção pela referência.</p>
    }
    else if (Model.Lista.Items.Count == 0)
    {
      <p class="ri-vazia" id="riConsultaVazia">Nenhuma reparação com estes filtros.</p>
    }
    else
    {
      <div class="dmo-table-wrap">
        <table class="dmo-table" id="riConsultaLista" data-dmo-list="Reparações">
          <thead><tr><th>Dia</th><th>Hora</th><th>Linha</th><th>Produção</th><th>CM/MF</th><th>Ferramenta</th><th>Número</th><th>Quem</th></tr></thead>
          <tbody>
          @foreach (var r in Model.Lista.Items)
          {
            var producao = $"{r.Referencia} · {r.Producao}";
            @* SEM BOTÕES NEM LINKS DE AÇÃO NAS LINHAS (DMO-580): a linha por
               associar escolhe-se com um clique e o Enter ou dois cliques
               abrem a janela «Associar ferramenta»; a marca é só texto. *@
            var porAssociar = r.Escrita is { PorAssociar: true };
            <tr data-dmo-reparacao="@r.Id" data-dmo-row="@(porAssociar ? "" : null)" data-id="@(porAssociar ? r.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)" data-dmo-abre-janela="@(porAssociar ? $"riAssociar-{r.Id}" : null)" title="@(porAssociar ? "Dois cliques (ou o Enter) para associar a ferramenta" : null)">
              <td>@ConsultarModel.Dia(r.Dia)</td>
              <td>@IndexModel.Hora(r.Hora, r.RegistadoEmUtc)</td>
              <td>@r.Maquina</td>
              <td>
                @if (r.JobOnId is null)
                {
                  @("Sem Job On")
                }
                else if (Model.AbreJobOn)
                {
                  <a href="/JobOn?jobon_id=@r.JobOnId" data-dmo-completa>@producao</a>
                }
                else
                {
                  @producao
                }
              </td>
              <td>@RiTextos.Tipo(r.Tipo)@if (r.Trabalho != ReparacaoTrabalho.Reparacao){<text> · @RiTextos.Trabalho(r.Trabalho)</text>}</td>
              <td>@if (Model.AbreFerramentas && ConsultarModel.ToolIdDaFicha(r) is { } toolId)
                {<a href="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.FichaFerramenta(toolId, string.Empty).Href" data-dmo-completa>@ConsultarModel.Ferramenta(r)</a>}
                else
                {@ConsultarModel.Ferramenta(r)}@if (r.Escrita is { PorAssociar: true })
                {<span class="ri-por-associar" data-dmo-por-associar="@r.Id">Por associar</span>}</td>
              <td><strong>@r.Numero</strong></td>
              <td>@(r.Quem ?? "—")</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
      <partial name="_ListPager" model="Model.Pager" />

      @* A janela «Associar ferramenta» de cada reparação por associar da
         página (a marca abre-a): as ferramentas do mesmo tipo da referência
         e do lote escritos; sem nenhuma, as da referência; sem nenhuma, o
         aviso com o link para a registar. Associa-se só a ferramenta. *@
      @foreach (var r in Model.Lista.Items.Where(l => l.Escrita is { PorAssociar: true }))
      {
        var escrita = r.Escrita!;
        var candidatas = escrita.Candidatas ?? [];
        var tipoTexto = RiTextos.Tipo(r.Tipo);
        var cm = r.Tipo == ReparacaoTipo.Cm;
        <dialog id="riAssociar-@r.Id" class="dmo-dialog ri-janela" aria-labelledby="riAssociarTitulo-@r.Id">
          <h3 id="riAssociarTitulo-@r.Id">Associar ferramenta</h3>
          <p>Nº <strong>@r.Numero</strong> · @tipoTexto @(cm ? "escrita" : "escrito"): <strong>@RiTextos.Escrita(escrita.Referencia, escrita.Lote)</strong></p>
          @if (candidatas.Count == 0)
          {
            <p class="dmo-aviso warn" role="status">Não há @(cm ? "nenhuma" : "nenhum") @tipoTexto @escrita.Referencia @(cm ? "registada" : "registado").<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.RegistarFerramenta(tipoTexto, escrita.Referencia, "Registar a ferramenta")" /></p>
            <div class="dmo-dialog-actions">
              <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Fechar</button>
            </div>
          }
          else
          {
            <form method="post" asp-page="/ReparacaoInterna/Consultar" asp-page-handler="Associar" asp-all-route-data="@Model.Rota(Model.Lista.PageNumber)" data-dmo-dialog-fecha-ao-enviar>
              <input type="hidden" name="operacao_id" value="@Guid.NewGuid()" />
              <input type="hidden" name="reparacao_id" value="@r.Id" />
              @if (!escrita.DoLote)
              {
                <p class="dmo-aviso warn" role="status">Não há @(cm ? "nenhuma" : "nenhum") @tipoTexto @escrita.Referencia com o lote @escrita.Lote: @(cm ? "estas são" : "estes são") da referência.</p>
              }
              <div class="dmo-field">
                <label for="riAssociarFerramenta-@r.Id">Ferramenta</label>
                <select id="riAssociarFerramenta-@r.Id" name="tool_id">
                  @foreach (var c in candidatas)
                  {
                    <option value="@c.ToolId">@tipoTexto @RiTextos.Escrita(c.Referencia, c.Lote)</option>
                  }
                </select>
              </div>
              <div class="dmo-dialog-actions">
                <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
                <button type="submit" class="dmo-button">Guardar</button>
              </div>
            </form>
          }
        </dialog>
      }
    }
  </section>
</main>
<script src="~/js/ri-consulta.js" asp-append-version="true"></script>
