@model DMO.Alpha.Web.Pages.ReparacaoInterna.DefinicoesModel
<section id="riDefViragem" class="dmo-card adm-card" aria-labelledby="ri-settings-title" data-dmo-regiao data-dmo-parcial>
    @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
    <h3 id="ri-settings-title" title="A partir desta hora, a Reparação liga as reparações à nova produção de cada linha. O padrão é 8:00.">Hora de viragem do dia</h3>

    @if (Model.Mensagem.Length > 0)
    {
        <p data-dmo-toast="@(Model.Gravou ? "ok" : "erro")" role="@(Model.Gravou ? "status" : "alert")">@Model.Mensagem</p>
    }

    <form method="post" asp-page="/ReparacaoInterna/Definicoes" asp-page-handler="SaveDayChangeHour">
        <div class="dmo-field">
            <label for="riDayChangeHour" class="dmo-visually-hidden">Hora de viragem</label>
            <select id="riDayChangeHour" name="dayChangeHour" data-dmo-autosubmit>
                @for (var h = 0; h <= 23; h++)
                {
                    <option value="@h" selected="@(Model.DayChangeHour == h || (Model.DayChangeHour is null && h == 8))">@h:00</option>
                }
            </select>
        </div>
    </form>
</section>
