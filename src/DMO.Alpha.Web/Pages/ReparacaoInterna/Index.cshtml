@page "/ReparacaoInterna"
@model DMO.Alpha.Web.Pages.ReparacaoInterna.IndexModel
@using DMO.Alpha.Core.ReparacaoInterna
@using DMO.Alpha.Web.Pages.ReparacaoInterna
@{
    Layout = "_DmoShellLayout";
}
@section Head {
<style>
.ri-page{display:flex;flex-direction:column;gap:14px;min-width:0}
/* O painel das linhas: o rail único da casa (o das Boquilhas), com uma
   segunda linha de detalhe (a CM e o MF com o lote). */
#riLinhasRail .beta-production-lines button{height:auto;min-height:72px}
.ri-card{padding:16px;min-width:0}
.ri-card h3{margin:0;font-size:17px}
.ri-card h4{margin:14px 0 6px;font-size:14px}
.ri-card .dmo-card-topo{margin:0 0 10px}
.ri-linha{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin:0 0 10px}
.ri-linha .dmo-field{margin:0}
.ri-card form{margin:0}
html body .ri-linha .dmo-field select.ri-producao{width:auto;max-width:100%}
html body .ri-linha .dmo-field input.ri-numero{width:14ch}
html body .ri-linha .dmo-field input.ri-referencia{width:14ch}
html body .ri-linha .dmo-field input.ri-lote{width:7ch}
html body .ri-linha .dmo-field input.ri-dia{width:auto}
html body .ri-linha .dmo-field input.ri-hora{width:auto}
/* O botão CM/MF: o mesmo mecanismo do tipo de movimento das Boquilhas
   (rádios com o rótulo como botão); o ativo em azul claro. */
/* CM e MF: dois botões separados (Diogo, 23/10/2026), não um interruptor colado. */
.ri-tipos{display:flex;gap:8px;margin:0;padding:0;border:0}
.ri-tipos label{position:relative;cursor:pointer}
.ri-tipos input{position:absolute;opacity:0;width:1px;height:1px}
.ri-tipos span{display:block;min-width:52px;padding:9px 12px;text-align:center;border:1px solid var(--dmo-border);background:var(--dmo-card);font-weight:750}
.ri-tipos span{border-radius:9px}
.ri-tipos input:checked+span{background:var(--dmo-brand-100,#d9e6f2);color:var(--dmo-brand-900);border-color:var(--dmo-brand-600,#3c73a8)}
.ri-tipos input:focus-visible+span{outline:3px solid var(--dmo-brand-600,#3c73a8);outline-offset:2px}
/* «É outra CM/MF»: a referência e o lote só com ela marcada (sem produção ficam sempre). */
.ri-outra-marca{display:inline-flex;gap:6px;align-items:center;margin:0 0 10px;font-size:13.5px;color:var(--dmo-text);cursor:pointer}
.ri-outra-marca input{margin:0}
.ri-registar:has(.ri-outra-check:not(:checked)) .ri-outra-campos{display:none}
.ri-ficha{color:var(--dmo-brand-900);font-weight:600}
.ri-escrita{display:inline-block;margin-left:6px;font-size:12.5px;color:var(--dmo-muted)}
/* A produção, a CM e o MF em três cartões pequenos, como os do resumo do Peso
   (Diogo, 23/10/2026: «aumentar esta informação, pode ficar dentro de cartões separados»). */
.ri-onde{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:0 0 12px}
.ri-onde div{display:flex;flex-direction:column;gap:3px;padding:10px 14px;background:var(--dmo-subtle,#f1f6fa);border-radius:8px;min-width:0}
.ri-onde dt{font-size:10.5px;font-weight:750;text-transform:uppercase;letter-spacing:.03em;color:var(--dmo-muted)}
.ri-onde dd{margin:0;font-size:16px;font-weight:750;overflow-wrap:anywhere}
@@media(max-width:600px){.ri-onde{grid-template-columns:1fr}}
/* O dia, CM e MF, o número e OK numa só linha (Diogo, 23/10/2026); «É outra CM/MF» e
   os campos dela ficam por baixo. Os dois formulários continuam separados. */
.ri-registo-linha{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin:0 0 10px}
.ri-registo-linha>form{display:contents}
.ri-registo-linha .ri-linha{margin:0}
.ri-registo-linha>form>:is(.ri-outra-marca,.ri-outra-campos){flex-basis:100%}
.ri-card .dmo-aviso{margin:0 0 12px}
.ri-card .dmo-table td{padding:5px 8px;vertical-align:middle}
.ri-card .dmo-table td:not(:last-child){white-space:nowrap}
.ri-card .dmo-table tr[data-dmo-row]{cursor:pointer}
.ri-vazia{margin:0;color:var(--dmo-muted)}
.ri-pager{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:10px}
/* Os filtros do Histórico numa linha, o «Limpar filtros» à direita. */
.ri-filtros-card{padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px 12px;align-items:flex-end}
.ri-filtros-card .dmo-filter-bar{column-gap:10px}
.ri-filtros-card>.dmo-zona>.dmo-filter-bar{flex:1 1 auto;min-width:0}
html body .ri-filtros-card .dmo-filter-bar>.dmo-field{flex:0 0 auto;margin:0}
html body .ri-filtros-card .dmo-filter-bar>.dmo-field>:is(input,select){width:100%}
.ri-w-maquina{width:96px}
.ri-w-data{width:132px}
.ri-w-referencia{width:124px}
html body .ri-filtros-card .dmo-filter-bar>.ri-w-producao{min-width:220px;max-width:100%}
html body .ri-filtros-card .dmo-filter-bar>.ri-w-producao>select{width:auto;min-width:100%}
.ri-filtros-acoes{display:flex;gap:8px;align-items:center;margin-left:auto}
html body .dmo-dialog.ri-janela h3{margin:0 0 10px}
.ri-janela .dmo-field{margin:0}
.ri-janela .dmo-field input{width:100%}
.ri-janela p{margin:0}
@@media (max-width:640px){
  html body .ri-registar .ri-linha .dmo-button{width:auto;flex:0 0 auto}
  html body .ri-linha .dmo-field input.ri-numero{width:11ch}
  .ri-card{padding:14px}
  .ri-card .dmo-table :is(td,th){padding:4px 6px}
  .ri-escrita{display:block;margin-left:0;white-space:normal}
  html body .ri-filtros-card .dmo-filter-bar>.dmo-field{flex:1 1 140px;width:auto}
  .ri-filtros-acoes{margin-left:0}
}
</style>
}

@if (Model.Historico)
{
  @* O HISTÓRICO (a tab, como nas Boquilhas): as reparações desta pessoa —
     é a página de cada reparador, por isso não há filtro de quem —, pela
     linha, os dias (de / até, livres), a referência e uma das últimas 5
     produções dela. Abre vazio; os dropdowns e as datas aplicam ao
     escolher, a referência com Enter ou a sugestão. Só a tabela e o
     dropdown das produções trocam (DmoTroca). O duplo clique numa linha
     abre a reparação (corrigir ou anular) e volta a esta vista. *@
  <main class="ri-page dmo-workspace" aria-labelledby="ri-title" data-dmo-troca>
    <div class="page-head">
      <div>
        <h1 id="ri-title">Reparação · Histórico</h1>
      </div>
    </div>

    <section class="dmo-card ri-filtros-card" aria-label="Filtros do histórico">
      <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
        <form id="riHistFiltros" method="get" asp-page="/ReparacaoInterna/Index" class="dmo-filter-bar" role="search">
          <input type="hidden" name="historico" value="1" />
          <div class="dmo-field ri-w-referencia">
            <label for="riHistReferencia">Referência<partial name="_DmoHelp" model="@("Escreva o início da referência e carregue Enter (ou escolha a sugestão). Depois pode escolher uma das últimas 5 produções.")" /></label>
            <input id="riHistReferencia" name="referencia" value="@Model.ReferenciaFiltro" placeholder="Ex.: 5538" autocomplete="off"
                   data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
          </div>
          <div id="riHistProducaoZona" class="dmo-field ri-w-producao" data-dmo-regiao>
            <label for="riHistProducao">Produção</label>
            @if (Model.ReferenciaFiltro is null)
            {
              <select id="riHistProducao" name="producao" disabled>
                <option value="">Produção</option>
              </select>
            }
            else if (Model.Producoes.Count == 0)
            {
              <select id="riHistProducao" name="producao" disabled>
                <option value="">Sem produções desta referência</option>
              </select>
            }
            else
            {
              <select id="riHistProducao" name="producao" data-dmo-autosubmit data-dmo-depende="riHistReferencia">
                <option value="" selected="@(Model.Producoes.All(p => !Model.ProducaoEscolhida(p)))">Todas</option>
                @foreach (var p in Model.Producoes)
                {
                  <option value="@p.JobOnId" selected="@Model.ProducaoEscolhida(p)">@p.Label</option>
                }
              </select>
            }
          </div>
          <div class="dmo-field ri-w-tipo">
            <label for="riHistTrabalho">Tipo de trabalho</label>
            <select id="riHistTrabalho" name="tipo_trabalho" data-dmo-autosubmit>
              <option value="" selected="@(Model.TrabalhoFiltro is null)">Todos</option>
              <option value="reparacao" selected="@(Model.TrabalhoFiltro == ReparacaoTrabalho.Reparacao)">Reparação</option>
              <option value="soldar" selected="@(Model.TrabalhoFiltro == ReparacaoTrabalho.Soldar)">Soldar</option>
              <option value="polir" selected="@(Model.TrabalhoFiltro == ReparacaoTrabalho.Polir)">Polir</option>
            </select>
          </div>
          <div class="dmo-field ri-w-maquina">
            <label for="riHistLinha">Linha</label>
            <select id="riHistLinha" name="maquina" data-dmo-autosubmit>
              <option value="" selected="@(Model.Maquina is null)">Todas</option>
              @foreach (var m in Model.Maquinas.OrderBy(m => IndexModel.Fila(m.Code)).ThenBy(m => m.Code, StringComparer.OrdinalIgnoreCase))
              {
                <option value="@m.Code" selected="@(Model.Maquina?.MachineId == m.MachineId)">@m.Code</option>
              }
            </select>
          </div>
          <div class="dmo-field ri-w-data">
            <label for="riHistDe">Dia de</label>
            <input id="riHistDe" name="de" type="date" value="@(Model.De is { } de ? IndexModel.Data(de) : null)" data-dmo-autosubmit />
          </div>
          <div class="dmo-field ri-w-data">
            <label for="riHistAte">Até</label>
            <input id="riHistAte" name="ate" type="date" value="@(Model.Ate is { } ate ? IndexModel.Data(ate) : null)" data-dmo-autosubmit />
          </div>
        </form>
      </div>
      <div class="ri-filtros-acoes">
        <a class="dmo-button" id="riHistLimpar" href="/ReparacaoInterna?historico=1">Limpar filtros</a>
      </div>
    </section>

    <partial name="_RiAvisos" model="Model" />

    <partial name="_RiHistResultados" model="Model" />

    <partial name="_RiReparacaoJanela" />
  </main>
}
else
{
  @* REGISTAR (Diogo, 22/10/2026: «um sistema similar ao das boquilhas»):
     o painel lateral com as linhas (as B, depois as C), cada uma com o que
     está em produção; um clique abre o registo dela. Gravar troca só o
     registo e a mensagem; o campo do número volta vazio e com o cursor.
     Os avisos de produção só avisam; sem produção grava-se sem Job On. *@
  <div class="beta-light-layout ri-layout" data-dmo-troca>
    <partial name="_RiLinhas" model="Model" />

    <main class="beta-light-main ri-page" aria-labelledby="ri-title">
      <div class="page-head">
        <div>
          <h1 id="ri-title">Reparação</h1>
        </div>
      </div>

      <partial name="_RiAvisos" model="Model" />

      <partial name="_RiRegisto" model="Model" />

      <partial name="_RiReparacaoJanela" />
    </main>
  </div>
}

@section Scripts {
<script src="~/js/ri-corrigir.js" asp-append-version="true"></script>
}
