@page "/ReparacaoInterna"
@model DMO.Alpha.Web.Pages.ReparacaoInterna.IndexModel
@using DMO.Alpha.Core.ReparacaoInterna
@using DMO.Alpha.Web.Pages.ReparacaoInterna
@{
    Layout = "_DmoShellLayout";
}
@section Head {
<style>
.ri-page{display:flex;flex-direction:column;gap:14px;min-width:0}
/* O painel das linhas: o rail único da casa (o das Boquilhas), com uma
   segunda linha de detalhe (a CM e o MF com o lote). */
#riLinhasRail .beta-production-lines button{height:auto;min-height:72px}
.ri-card{padding:16px;min-width:0}
.ri-card h3{margin:0;font-size:17px}
.ri-card h4{margin:14px 0 6px;font-size:14px}
.ri-card .dmo-card-topo{margin:0 0 10px}
.ri-linha{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin:0 0 10px}
.ri-linha .dmo-field{margin:0}
.ri-card form{margin:0}
html body .ri-linha .dmo-field select.ri-producao{width:auto;max-width:100%}
html body .ri-linha .dmo-field input.ri-numero{width:14ch}
html body .ri-linha .dmo-field input.ri-referencia{width:14ch}
html body .ri-linha .dmo-field input.ri-lote{width:7ch}
html body .ri-linha .dmo-field input.ri-dia{width:auto}
/* O botão CM/MF: o mesmo mecanismo do tipo de movimento das Boquilhas
   (rádios com o rótulo como botão); o ativo em azul claro. */
/* CM e MF: dois botões separados (Diogo, 23/10/2026), não um interruptor colado. */
.ri-tipos{display:flex;gap:8px;margin:0;padding:0;border:0}
.ri-tipos label{position:relative;cursor:pointer}
.ri-tipos input{position:absolute;opacity:0;width:1px;height:1px}
.ri-tipos span{display:block;min-width:52px;padding:9px 12px;text-align:center;border:1px solid var(--dmo-border);background:var(--dmo-card);font-weight:750}
.ri-tipos span{border-radius:9px}
.ri-tipos input:checked+span{background:var(--dmo-brand-100,#d9e6f2);color:var(--dmo-brand-900);border-color:var(--dmo-brand-600,#3c73a8)}
.ri-tipos input:focus-visible+span{outline:3px solid var(--dmo-brand-600,#3c73a8);outline-offset:2px}
/* «É outra CM/MF»: a referência e o lote só com ela marcada (sem produção ficam sempre). */
.ri-outra-marca{display:inline-flex;gap:6px;align-items:center;margin:0 0 10px;font-size:13.5px;color:var(--dmo-text);cursor:pointer}
.ri-outra-marca input{margin:0}
.ri-registar:has(.ri-outra-check:not(:checked)) .ri-outra-campos{display:none}
.ri-ficha{color:var(--dmo-brand-900);font-weight:600}
.ri-escrita{display:inline-block;margin-left:6px;font-size:12.5px;color:var(--dmo-muted)}
/* A produção, a CM e o MF em três cartões pequenos, como os do resumo do Peso
   (Diogo, 23/10/2026: «aumentar esta informação, pode ficar dentro de cartões separados»). */
.ri-onde{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:0 0 12px}
.ri-onde div{display:flex;flex-direction:column;gap:3px;padding:10px 14px;background:var(--dmo-subtle,#f1f6fa);border-radius:8px;min-width:0}
.ri-onde dt{font-size:10.5px;font-weight:750;text-transform:uppercase;letter-spacing:.03em;color:var(--dmo-muted)}
.ri-onde dd{margin:0;font-size:16px;font-weight:750;overflow-wrap:anywhere}
@@media(max-width:600px){.ri-onde{grid-template-columns:1fr}}
/* O dia, CM e MF, o número e OK numa só linha (Diogo, 23/10/2026); «É outra CM/MF» e
   os campos dela ficam por baixo. Os dois formulários continuam separados. */
.ri-registo-linha{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin:0 0 10px}
.ri-registo-linha>form{display:contents}
.ri-registo-linha .ri-linha{margin:0}
.ri-registo-linha>form>:is(.ri-outra-marca,.ri-outra-campos){flex-basis:100%}
.ri-card .dmo-aviso{margin:0 0 12px}
.ri-card .dmo-table td{padding:5px 8px;vertical-align:middle}
.ri-card .dmo-table td:not(:last-child){white-space:nowrap}
.ri-card .dmo-table tr[data-dmo-row]{cursor:pointer}
.ri-vazia{margin:0;color:var(--dmo-muted)}
.ri-pager{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:10px}
/* Os filtros do Histórico numa linha, o «Limpar filtros» à direita. */
.ri-filtros-card{padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px 12px;align-items:flex-end}
.ri-filtros-card .dmo-filter-bar{column-gap:10px}
.ri-filtros-card>.dmo-zona>.dmo-filter-bar{flex:1 1 auto;min-width:0}
html body .ri-filtros-card .dmo-filter-bar>.dmo-field{flex:0 0 auto;margin:0}
html body .ri-filtros-card .dmo-filter-bar>.dmo-field>:is(input,select){width:100%}
.ri-w-maquina{width:96px}
.ri-w-data{width:132px}
.ri-w-referencia{width:124px}
html body .ri-filtros-card .dmo-filter-bar>.ri-w-producao{min-width:220px;max-width:100%}
html body .ri-filtros-card .dmo-filter-bar>.ri-w-producao>select{width:auto;min-width:100%}
.ri-filtros-acoes{display:flex;gap:8px;align-items:center;margin-left:auto}
html body .dmo-dialog.ri-janela h3{margin:0 0 10px}
.ri-janela .dmo-field{margin:0}
.ri-janela .dmo-field input{width:100%}
.ri-janela p{margin:0}
@@media (max-width:640px){
  html body .ri-registar .ri-linha .dmo-button{width:auto;flex:0 0 auto}
  html body .ri-linha .dmo-field input.ri-numero{width:11ch}
  .ri-card{padding:14px}
  .ri-card .dmo-table :is(td,th){padding:4px 6px}
  .ri-escrita{display:block;margin-left:0;white-space:normal}
  html body .ri-filtros-card .dmo-filter-bar>.dmo-field{flex:1 1 140px;width:auto}
  .ri-filtros-acoes{margin-left:0}
}
</style>
}

@if (Model.Historico)
{
  @* O HISTÓRICO (a tab, como nas Boquilhas): as reparações desta pessoa —
     é a página de cada reparador, por isso não há filtro de quem —, pela
     linha, os dias (de / até, livres), a referência e uma das últimas 5
     produções dela. Abre vazio; os dropdowns e as datas aplicam ao
     escolher, a referência com Enter ou a sugestão. Só a tabela e o
     dropdown das produções trocam (DmoTroca). O duplo clique numa linha
     abre a reparação (corrigir ou anular) e volta a esta vista. *@
  <main class="ri-page dmo-workspace" aria-labelledby="ri-title" data-dmo-troca>
    <div class="page-head">
      <div>
        <h1 id="ri-title">Reparação · Histórico</h1>
      </div>
    </div>

    <section class="dmo-card ri-filtros-card" aria-label="Filtros do histórico">
      <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
        <form id="riHistFiltros" method="get" asp-page="/ReparacaoInterna/Index" class="dmo-filter-bar" role="search">
          <input type="hidden" name="historico" value="1" />
          <div class="dmo-field ri-w-maquina">
            <label for="riHistLinha">Linha</label>
            <select id="riHistLinha" name="maquina" data-dmo-autosubmit>
              <option value="" selected="@(Model.Maquina is null)">Todas</option>
              @foreach (var m in Model.Maquinas.OrderBy(m => IndexModel.Fila(m.Code)).ThenBy(m => m.Code, StringComparer.OrdinalIgnoreCase))
              {
                <option value="@m.Code" selected="@(Model.Maquina?.MachineId == m.MachineId)">@m.Code</option>
              }
            </select>
          </div>
          <div class="dmo-field ri-w-data">
            <label for="riHistDe">Dia de</label>
            <input id="riHistDe" name="de" type="date" value="@(Model.De is { } de ? IndexModel.Data(de) : null)" data-dmo-autosubmit />
          </div>
          <div class="dmo-field ri-w-data">
            <label for="riHistAte">Até</label>
            <input id="riHistAte" name="ate" type="date" value="@(Model.Ate is { } ate ? IndexModel.Data(ate) : null)" data-dmo-autosubmit />
          </div>
          <div class="dmo-field ri-w-referencia">
            <label for="riHistReferencia">Referência<partial name="_DmoHelp" model="@("Escreva o início da referência e carregue Enter (ou escolha a sugestão). Depois pode escolher uma das últimas 5 produções.")" /></label>
            <input id="riHistReferencia" name="referencia" value="@Model.ReferenciaFiltro" placeholder="Ex.: 5538" autocomplete="off"
                   data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
          </div>
          <div id="riHistProducaoZona" class="dmo-field ri-w-producao" data-dmo-regiao>
            <label for="riHistProducao">Produção</label>
            @if (Model.ReferenciaFiltro is null)
            {
              <select id="riHistProducao" name="producao" disabled>
                <option value="">Escreva primeiro a referência</option>
              </select>
            }
            else if (Model.Producoes.Count == 0)
            {
              <select id="riHistProducao" name="producao" disabled>
                <option value="">Sem produções desta referência</option>
              </select>
            }
            else
            {
              <select id="riHistProducao" name="producao" data-dmo-autosubmit data-dmo-depende="riHistReferencia">
                <option value="" selected="@(Model.Producoes.All(p => !Model.ProducaoEscolhida(p)))">Todas</option>
                @foreach (var p in Model.Producoes)
                {
                  <option value="@p.JobOnId" selected="@Model.ProducaoEscolhida(p)">@p.Label</option>
                }
              </select>
            }
          </div>
        </form>
      </div>
      <div class="ri-filtros-acoes">
        <a class="dmo-button" id="riHistLimpar" href="/ReparacaoInterna?historico=1">Limpar filtros</a>
      </div>
    </section>

    <div id="riAvisos" class="dmo-zona" data-dmo-regiao>
      @if (Model.Mensagem.Length > 0)
      {
        <p data-dmo-toast="@Model.Tom" role="@(Model.Gravou ? "status" : "alert")">@Model.Mensagem</p>
      }
    </div>

    <section id="riHistResultados" class="dmo-card ri-card" aria-labelledby="ri-hist-title" data-dmo-regiao data-dmo-parcial>
      <div class="dmo-card-topo">
        <h3 id="ri-hist-title">As minhas reparações<partial name="_DmoHelp" model="@("As reparações que registou e que contam (sem as anuladas), da mais recente para a mais antiga. O dia é o dia operacional. Duplo clique numa linha (ou escolha-a e carregue Editar) para corrigir o número ou anular.")" /></h3>
        @if (Model.Historia.Items.Count > 0)
        {
          <div class="dmo-card-topo-acoes" data-dmo-for="riHistLista">
            <a class="dmo-button" id="riHistEditar" href="#riCorrigirJanela" role="button" data-ri-editar="riHistLista">Editar</a>
          </div>
        }
      </div>
      @if (!Model.ComFiltro)
      {
        <p class="ri-vazia" id="riHistConvite">Escolha a linha, os dias, ou procure a produção pela referência.</p>
      }
      else if (Model.Historia.Items.Count == 0)
      {
        <p class="ri-vazia" id="riHistVazia">Nenhuma reparação com estes filtros.</p>
      }
      else
      {
        <div class="dmo-table-wrap">
          <table class="dmo-table" id="riHistLista" data-dmo-list="As minhas reparações" data-ri-volta="@Model.Volta">
            <thead><tr><th>Dia</th><th>Hora</th><th>Linha</th><th>Produção</th><th>CM/MF</th><th>Ferramenta</th><th>Número</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Historia.Items)
            {
              <tr data-dmo-row data-id="@r.Id" data-dmo-reparacao="@r.Id" data-ri-reparacao="@r.Id" data-ri-numero="@r.Numero" title="Duplo clique para corrigir ou anular">
                <td>@ConsultarModel.Dia(r.Dia)</td>
                <td>@IndexModel.Hora(r.RegistadoEmUtc)</td>
                <td>@r.Maquina</td>
                <td>@(r.JobOnId is null ? "Sem Job On" : $"{r.Referencia} · {r.Producao}")</td>
                <td>@RiTextos.Tipo(r.Tipo)</td>
                <td>@ConsultarModel.Ferramenta(r)</td>
                <td><strong>@r.Numero</strong></td>
              </tr>
            }
            </tbody>
          </table>
        </div>
        <partial name="_ListPager" model="Model.HistoriaPager" />
      }
    </section>

    <partial name="_RiReparacaoJanela" />
  </main>
}
else
{
  @* REGISTAR (Diogo, 22/10/2026: «um sistema similar ao das boquilhas»):
     o painel lateral com as linhas (as B, depois as C), cada uma com o que
     está em produção; um clique abre o registo dela. Gravar troca só o
     registo e a mensagem; o campo do número volta vazio e com o cursor.
     Os avisos de produção só avisam; sem produção grava-se sem Job On. *@
  <div class="beta-light-layout ri-layout" data-dmo-troca>
    <div id="riLinhas" class="dmo-zona" data-dmo-regiao data-dmo-parcial>
      @{
          var rail = new DMO.Alpha.Web.Presentation.DmoRailPresentation(
              Title: "Linhas",
              Subtitle: $"Em produção · {IndexModel.Dia(Model.DiaDoRegisto)}",
              AriaLabel: "Linhas",
              Items: Model.Linhas.Select(l => new DMO.Alpha.Web.Presentation.DmoRailItem(
                  Code: l.Maquina.Code,
                  Detail: l.Detalhe,
                  Href: Model.HrefDaLinha(l.Maquina.Code),
                  AriaLabel: l.Producao is { } p ? $"Linha {l.Maquina.Code}: {p.Referencia}, produção {p.Producao}, {l.Ferramentas}" : $"Linha {l.Maquina.Code} sem produção",
                  Key: l.Maquina.Code,
                  Extra: l.Ferramentas,
                  Selected: l.Foco)).ToList(),
              EmptyLabel: "Sem linhas registadas.",
              Id: "riLinhasRail");
      }
      <partial name="_DmoRail" model="@rail" />
    </div>

    <main class="beta-light-main ri-page" aria-labelledby="ri-title">
      <div class="page-head">
        <div>
          <h1 id="ri-title">Reparação</h1>
        </div>
      </div>

      <div id="riAvisos" class="dmo-zona" data-dmo-regiao>
        @if (Model.Mensagem.Length > 0)
        {
          <p data-dmo-toast="@Model.Tom" role="@(Model.Gravou ? "status" : "alert")">@Model.Mensagem</p>
        }
      </div>

      <div id="riRegisto" class="dmo-zona" data-dmo-regiao data-dmo-parcial>
      @if (Model.Cartao is not { } c)
      {
        <section class="dmo-card ri-card" id="riEscolha">
          <p class="ri-vazia">Escolha a linha no painel lateral para registar.</p>
        </section>
      }
      else
      {
        var codigo = c.Maquina.Code;
        var p = c.Producao;
        var cmTool = p?.Cm;
        var mfTool = p?.Mf;
        var dia = Model.DiaPedido is { } d ? IndexModel.Data(d) : null;
        <section id="riCard-@codigo" class="dmo-card ri-card ri-maquina" aria-labelledby="ri-titulo-@codigo" data-dmo-parcial data-ri-cartao="@codigo">
          <div class="dmo-card-topo">
            <h3 id="ri-titulo-@codigo">Linha @codigo</h3>
            @if (Model.Log.Items.Count > 0)
            {
              @* As ações fora da lista (data-dmo-for): um clique escolhe a linha; com dois, a reparação abre. *@
              <div class="dmo-card-topo-acoes" data-dmo-for="riLog-@codigo">
                <a class="dmo-button" id="riEditar-@codigo" href="#riCorrigirJanela" role="button" data-ri-editar="riLog-@codigo">Editar</a>
              </div>
            }
          </div>
          @if (c.SemProducao)
          {
            <p class="dmo-aviso warn" id="riSemProducao-@codigo" role="status">Não há produção na linha @codigo para @IndexModel.Dia(c.DoDia.Dia). Pode registar sem Job On, com a referência e o lote: fica por associar.<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.CriarJobOn()" /></p>
          }
          else if (p is not null)
          {
            <dl class="ri-onde">
              <div><dt>Produção</dt><dd data-dmo-producao="@p.JobOnId">@p.Producao · @p.Referencia</dd></div>
              @foreach (var (t, f) in new[] { (ReparacaoTipo.Cm, cmTool), (ReparacaoTipo.Mf, mfTool) })
              {
                <div><dt>@RiTextos.Tipo(t)</dt><dd data-dmo-ferramenta="@RiTextos.Valor(t)">@if (f is not null && f.Referencia is not null && Model.AbreFerramentas && p.ToolId(t) is { } toolId)
                  {<a class="ri-ficha" href="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.FichaFerramenta(toolId, string.Empty).Href">@RiTextos.Ferramenta(t, f)</a>}
                  else
                  {@(f is null ? $"Sem {RiTextos.Tipo(t)}" : RiTextos.Ferramenta(t, f))}</dd></div>
              }
            </dl>
          }

          @* O dia e a produção: aplicam ao escolher. As datas são livres;
             outro dia que não o de hoje só avisa. *@
          <div class="ri-registo-linha">
          <form id="riDiaForm-@codigo" method="get" asp-page="/ReparacaoInterna/Index" class="ri-linha">
            <input type="hidden" name="maquina" value="@codigo" />
            <input type="hidden" name="tipo" value="@RiTextos.Valor(c.Tipo)" />
            <div class="dmo-field">
              <label for="riDia-@codigo">Dia</label>
              <input id="riDia-@codigo" name="dia" type="date" class="ri-dia" value="@IndexModel.Data(Model.DiaDoRegisto)" data-dmo-autosubmit />
            </div>
            @if (c.DoDia.VariasProducoes)
            {
              <div class="dmo-field">
                <label for="riProducao-@codigo">Produção (há @c.DoDia.Candidatas.Count)</label>
                <select id="riProducao-@codigo" name="producao" class="ri-producao" data-dmo-autosubmit>
                  @foreach (var o in c.DoDia.Candidatas)
                  {
                    <option value="@o.JobOnId" selected="@(p?.JobOnId == o.JobOnId)">@RiTextos.Producao(o)</option>
                  }
                </select>
              </div>
            }
          </form>

          @* O botão CM/MF (como o tipo de movimento das Boquilhas: o ativo
             em azul claro), o número e OK. «É outra CM/MF» mostra a
             referência e o lote; sem produção ficam sempre, obrigatórios. *@
          <form id="riRegistar-@codigo" method="post" asp-page="/ReparacaoInterna/Index" asp-page-handler="Registar" class="ri-registar">
            <input type="hidden" name="operacao_id" value="@Model.OperacaoId" />
            <input type="hidden" name="maquina" value="@codigo" />
            @if (dia is not null)
            {
              <input type="hidden" name="dia" value="@dia" />
            }
            @if (p is not null)
            {
              <input type="hidden" name="producao" value="@p.JobOnId" />
            }
            @if (cmTool is not null)
            {
              <input type="hidden" name="contexto_cm" value="@cmTool.ContextoId" />
            }
            @if (mfTool is not null)
            {
              <input type="hidden" name="contexto_mf" value="@mfTool.ContextoId" />
            }
            @if (c.SemProducao)
            {
              <input type="hidden" name="outra" value="1" />
            }
            <div class="ri-linha">
              <fieldset class="ri-tipos">
                <legend class="dmo-visually-hidden">CM ou MF</legend>
                <label><input type="radio" id="riTipoCm-@codigo" name="tipo" value="cm" checked="@(c.Tipo == ReparacaoTipo.Cm)" /><span>CM</span></label>
                <label><input type="radio" id="riTipoMf-@codigo" name="tipo" value="mf" checked="@(c.Tipo == ReparacaoTipo.Mf)" /><span>MF</span></label>
              </fieldset>
              <div class="dmo-field">
                <label for="riNumero-@codigo">Número</label>
                <input id="riNumero-@codigo" name="numero" class="ri-numero" inputmode="numeric" maxlength="@IndexModel.NumeroAlgarismos" pattern="[0-9]{1,@IndexModel.NumeroAlgarismos}" title="Só algarismos, até @IndexModel.NumeroAlgarismos" aria-invalid="@(Model.NumeroInvalido ? "true" : null)" autocomplete="off" required autofocus
                       value="@Model.NumeroEscrito" />
              </div>
              <button type="submit" class="dmo-button" id="riOk-@codigo">OK</button>
            </div>
            @if (!c.SemProducao)
            {
              <label class="ri-outra-marca" for="riOutra-@codigo"><input type="checkbox" id="riOutra-@codigo" class="ri-outra-check" name="outra" value="1" checked="@Model.OutraMarcada" />É outra CM/MF</label>
            }
            <div class="ri-linha ri-outra-campos">
              <div class="dmo-field">
                <label for="riReferencia-@codigo">Referência</label>
                <input id="riReferencia-@codigo" name="referencia" class="ri-referencia" maxlength="@Reparacao.ReferenciaMaxLength" autocomplete="off"
                       data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" placeholder="5447T173"
                       required="@c.SemProducao" aria-invalid="@(Model.ErroReferencia ? "true" : null)" value="@Model.ReferenciaEscrita" />
              </div>
              <div class="dmo-field">
                <label for="riLote-@codigo">Lote</label>
                <input id="riLote-@codigo" name="lote" class="ri-lote" maxlength="@Reparacao.LoteMaxLength" autocomplete="off" placeholder="4"
                       required="@c.SemProducao" aria-invalid="@(Model.ErroLote ? "true" : null)" value="@Model.LoteEscrito" />
              </div>
            </div>
          </form>
          </div>
          @if (Model.OutroDia)
          {
            <p class="dmo-aviso warn" id="riOutroDia-@codigo" role="status">Está a registar no dia @IndexModel.Dia(Model.DiaDoRegisto), não no de hoje (@IndexModel.Dia(Model.Hoje)). <a href="@Model.HrefDaLinhaHoje(codigo)">Voltar a hoje</a></p>
          }

          @* O registo (log): as reparações desta pessoa nesta linha neste
             dia, a mais recente em cima. Sem botões nas linhas: o duplo
             clique (ou «Editar» com a linha escolhida) abre a reparação. *@
          <div id="riLista-@codigo" class="ri-lista">
            <h4>Registo de @IndexModel.Dia(Model.DiaDoRegisto)</h4>
            @if (Model.Log.Items.Count == 0)
            {
              <p class="ri-vazia">Ainda não registou reparações nesta linha neste dia.</p>
            }
            else
            {
              <div class="dmo-table-wrap">
                <table class="dmo-table" id="riLog-@codigo" data-dmo-list="Reparações da linha @codigo"
                       data-ri-maquina="@codigo" data-ri-producao="@p?.JobOnId" data-ri-tipo="@RiTextos.Valor(c.Tipo)" data-ri-dia="@dia" data-ri-pagina="@Model.Log.PageNumber">
                  <thead><tr><th>Hora</th><th>Produção</th><th>CM/MF</th><th>Número</th></tr></thead>
                  <tbody>
                  @foreach (var r in Model.Log.Items)
                  {
                    <tr data-dmo-row data-id="@r.Id" data-dmo-reparacao="@r.Id" data-ri-reparacao="@r.Id" data-ri-numero="@r.Numero" title="Duplo clique para corrigir ou anular">
                      <td>@IndexModel.Hora(r.RegistadoEmUtc)</td>
                      <td>@(r.JobOnId is null ? "Sem Job On" : r.Producao)</td>
                      <td>@RiTextos.Tipo(r.Tipo)@if (r.Escrita is { } e)
                        {<span class="ri-escrita">Outra: @RiTextos.Escrita(e.Referencia, e.Lote)</span>}</td>
                      <td><strong>@r.Numero</strong></td>
                    </tr>
                  }
                  </tbody>
                </table>
              </div>
              @if (Model.Log.TotalPages > 1)
              {
                <nav class="dmo-list-pager ri-pager" aria-label="Paginação da linha @codigo">
                  @if (Model.Log.PageNumber > 1)
                  {
                    <a class="dmo-button dmo-arrow" href="@Url.Page("/ReparacaoInterna/Index", new { maquina = codigo, producao = p?.JobOnId, tipo = RiTextos.Valor(c.Tipo), dia, pagina = Model.Log.PageNumber - 1 })" aria-label="Página anterior">←</a>
                  }
                  <span role="status">@Model.Log.PageNumber de @Model.Log.TotalPages</span>
                  @if (Model.Log.PageNumber < Model.Log.TotalPages)
                  {
                    <a class="dmo-button dmo-arrow" href="@Url.Page("/ReparacaoInterna/Index", new { maquina = codigo, producao = p?.JobOnId, tipo = RiTextos.Valor(c.Tipo), dia, pagina = Model.Log.PageNumber + 1 })" aria-label="Página seguinte">→</a>
                  }
                </nav>
              }
            }
          </div>
        </section>
      }
      </div>

      <partial name="_RiReparacaoJanela" />
    </main>
  </div>
}

@section Scripts {
<script src="~/js/ri-corrigir.js" asp-append-version="true"></script>
}
