@page "/ReparacaoInterna"
@model DMO.Alpha.Web.Pages.ReparacaoInterna.IndexModel
@using DMO.Alpha.Core.ReparacaoInterna
@using DMO.Alpha.Web.Pages.ReparacaoInterna
@{
    Layout = "_DmoShellLayout";
}
@section Head {
<link rel="stylesheet" href="~/css/paginas/reparacaointerna-index.css" asp-append-version="true">
}

@if (Model.Historico)
{
  @* O HISTÓRICO (a tab, como nas Boquilhas): as reparações desta pessoa —
     é a página de cada reparador, por isso não há filtro de quem —, pela
     linha, os dias (de / até, livres), a referência e uma das últimas 5
     produções dela. Abre vazio; os dropdowns e as datas aplicam ao
     escolher, a referência com Enter ou a sugestão. Só a tabela e o
     dropdown das produções trocam (DmoTroca). O duplo clique numa linha
     abre a reparação (corrigir ou anular) e volta a esta vista. *@
  <main class="ri-page dmo-workspace" aria-labelledby="ri-title" data-dmo-troca>
    <div class="page-head">
      <div>
        <h1 id="ri-title">Reparação · Histórico</h1>
      </div>
    </div>

    <section class="dmo-card ri-filtros-card" aria-label="Filtros do histórico">
      <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
        <form id="riHistFiltros" method="get" asp-page="/ReparacaoInterna/Index" class="dmo-filter-bar" role="search">
          <input type="hidden" name="historico" value="1" />
          <div class="dmo-field ri-w-referencia">
            <label for="riHistReferencia">Referência<partial name="_DmoHelp" model="@("Escreva o início da referência e carregue Enter (ou escolha a sugestão). Depois pode escolher uma das últimas 5 produções.")" /></label>
            <input id="riHistReferencia" name="referencia" value="@Model.ReferenciaFiltro" placeholder="Ex.: 5538" autocomplete="off"
                   data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
          </div>
          <div id="riHistProducaoZona" class="dmo-field ri-w-producao" data-dmo-regiao>
            <label for="riHistProducao">Produção</label>
            @if (Model.ReferenciaFiltro is null)
            {
              <select id="riHistProducao" name="producao" disabled>
                <option value="">Produção</option>
              </select>
            }
            else if (Model.Producoes.Count == 0)
            {
              <select id="riHistProducao" name="producao" disabled>
                <option value="">Sem produções desta referência</option>
              </select>
            }
            else
            {
              <select id="riHistProducao" name="producao" data-dmo-autosubmit data-dmo-depende="riHistReferencia">
                <option value="" selected="@(Model.Producoes.All(p => !Model.ProducaoEscolhida(p)))">Todas</option>
                @foreach (var p in Model.Producoes)
                {
                  <option value="@p.JobOnId" selected="@Model.ProducaoEscolhida(p)">@p.Label</option>
                }
              </select>
            }
          </div>
          <div class="dmo-field ri-w-tipo">
            <label for="riHistTrabalho">Tipo de trabalho</label>
            <select id="riHistTrabalho" name="tipo_trabalho" data-dmo-autosubmit>
              <option value="" selected="@(Model.TrabalhoFiltro is null)">Todos</option>
              <option value="reparacao" selected="@(Model.TrabalhoFiltro == ReparacaoTrabalho.Reparacao)">Reparação</option>
              <option value="soldar" selected="@(Model.TrabalhoFiltro == ReparacaoTrabalho.Soldar)">Soldar</option>
              <option value="polir" selected="@(Model.TrabalhoFiltro == ReparacaoTrabalho.Polir)">Polir</option>
            </select>
          </div>
          <div class="dmo-field ri-w-maquina">
            <label for="riHistLinha">Linha</label>
            <select id="riHistLinha" name="maquina" data-dmo-autosubmit>
              <option value="" selected="@(Model.Maquina is null)">Todas</option>
              @foreach (var m in Model.Maquinas.OrderBy(m => IndexModel.Fila(m.Code)).ThenBy(m => m.Code, StringComparer.OrdinalIgnoreCase))
              {
                <option value="@m.Code" selected="@(Model.Maquina?.MachineId == m.MachineId)">@m.Code</option>
              }
            </select>
          </div>
          <div class="dmo-field ri-w-data">
            <label for="riHistDe">Dia de</label>
            <input id="riHistDe" name="de" type="date" value="@(Model.De is { } de ? IndexModel.Data(de) : null)" data-dmo-autosubmit />
          </div>
          <div class="dmo-field ri-w-data">
            <label for="riHistAte">Até</label>
            <input id="riHistAte" name="ate" type="date" value="@(Model.Ate is { } ate ? IndexModel.Data(ate) : null)" data-dmo-autosubmit />
          </div>
        </form>
      </div>
      <div class="ri-filtros-acoes">
        <a class="dmo-button" id="riHistLimpar" href="/ReparacaoInterna?historico=1">Limpar filtros</a>
      </div>
    </section>

    <partial name="_RiAvisos" model="Model" />

    <partial name="_RiHistResultados" model="Model" />

    <partial name="_RiReparacaoJanela" />
  </main>
}
else
{
  @* REGISTAR (Diogo, 22/10/2026: «um sistema similar ao das boquilhas»):
     o painel lateral com as linhas (as B, depois as C), cada uma com o que
     está em produção; um clique abre o registo dela. Gravar troca só o
     registo e a mensagem; o campo do número volta vazio e com o cursor.
     Os avisos de produção só avisam; sem produção grava-se sem Job On. *@
  <div class="beta-light-layout ri-layout" data-dmo-troca>

    <main class="beta-light-main ri-page" aria-labelledby="ri-title">
      <div class="page-head">
        <div>
          <h1 id="ri-title">Reparação</h1>
        </div>
      </div>
      @* As linhas por baixo do título, como nos mockups (Owner, 26/10/2026): o mesmo painel, com os mesmos ids e zonas. *@
      <partial name="_RiLinhas" model="Model" />

      <partial name="_RiAvisos" model="Model" />

      <partial name="_RiRegisto" model="Model" />

      <partial name="_RiReparacaoJanela" />
    </main>
  </div>
}

@section Scripts {
<script src="~/js/ri-corrigir.js" asp-append-version="true"></script>
}
