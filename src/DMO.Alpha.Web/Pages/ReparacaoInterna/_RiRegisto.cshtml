@model DMO.Alpha.Web.Pages.ReparacaoInterna.IndexModel
@using DMO.Alpha.Core.ReparacaoInterna
@using DMO.Alpha.Web.Pages.ReparacaoInterna
<div id="riRegisto" class="dmo-zona" data-dmo-regiao data-dmo-parcial data-dmo-zonas="riAvisos">
@if (Model.Cartao is not { } c)
{
  <section class="dmo-card ri-card" id="riEscolha">
    <p class="ri-vazia">Escolha a linha acima para registar.</p>
  </section>
}
else
{
  var codigo = c.Maquina.Code;
  var p = c.Producao;
  var cmTool = p?.Cm;
  var mfTool = p?.Mf;
  var dia = Model.DiaPedido is { } d ? IndexModel.Data(d) : null;
  <section id="riCard-@codigo" class="dmo-card ri-card ri-maquina" aria-labelledby="ri-titulo-@codigo" data-dmo-parcial data-ri-cartao="@codigo">
    <div class="dmo-card-topo">
      <h3 id="ri-titulo-@codigo">Linha @codigo</h3>
      @if (Model.Log.Items.Count > 0 || !c.SemProducao)
      {
        @* As ações fora da lista (data-dmo-for): um clique escolhe a linha; com dois, a reparação abre.
           «É outra CM/MF» é um botão no canto (Diogo, 27/10/2026: sem caixas de marcar): o rótulo da
           caixa escondida do formulário, que continua a levar outra=1; abre o painel da referência e do lote. *@
        <div class="dmo-card-topo-acoes" data-dmo-for="@(Model.Log.Items.Count > 0 ? $"riLog-{codigo}" : null)">
          @if (!c.SemProducao)
          {
            <label class="dmo-button ri-outra-botao" for="riOutra-@codigo">É outra CM/MF</label>
          }
          @if (Model.Log.Items.Count > 0)
          {
            <a class="dmo-button" id="riEditar-@codigo" href="#riCorrigirJanela" role="button" data-ri-editar="riLog-@codigo">Editar</a>
          }
        </div>
      }
    </div>
    @if (c.SemProducao)
    {
      <p class="dmo-aviso warn" id="riSemProducao-@codigo" role="status">Não há produção na linha @codigo para @IndexModel.Dia(c.DoDia.Dia). Pode registar sem Job On, com a referência e o lote: fica por associar.<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.CriarJobOn()" /></p>
    }
    else if (p is not null)
    {
      <dl class="ri-onde">
        <div><dt>Produção</dt><dd data-dmo-producao="@p.JobOnId">@p.Producao · @p.Referencia</dd></div>
        @foreach (var (t, f) in new[] { (ReparacaoTipo.Cm, cmTool), (ReparacaoTipo.Mf, mfTool) })
        {
          <div><dt>@RiTextos.Tipo(t)</dt><dd data-dmo-ferramenta="@RiTextos.Valor(t)">@if (f is not null && f.Referencia is not null && Model.AbreFerramentas && p.ToolId(t) is { } toolId)
            {<a class="ri-ficha" href="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.FichaFerramenta(toolId, string.Empty).Href">@RiTextos.Ferramenta(t, f)</a>}
            else
            {@(f is null ? $"Sem {RiTextos.Tipo(t)}" : RiTextos.Ferramenta(t, f))}</dd></div>
        }
      </dl>
    }

    @* O dia e a produção: aplicam ao escolher. As datas são livres;
       outro dia que não o de hoje só avisa. Na linha ficam primeiro CM/MF,
       o trabalho e o número; o dia e a hora vêm depois, antes do OK
       (Diogo, 27/10/2026): a ordem é do CSS (order), os formulários são os mesmos. *@
    <div class="ri-registo-linha">
    <form id="riDiaForm-@codigo" method="get" asp-page="/ReparacaoInterna/Index" class="ri-linha ri-dia-form">
      <input type="hidden" name="maquina" value="@codigo" />
      <input type="hidden" name="tipo" value="@RiTextos.Valor(c.Tipo)" />
      <div class="dmo-field ri-campo-dia">
        <label for="riDia-@codigo">Dia</label>
        <input id="riDia-@codigo" name="dia" type="date" class="ri-dia" value="@IndexModel.Data(Model.DiaDoRegisto)" data-dmo-autosubmit />
      </div>
      @* A hora da reparação, ao lado do dia: vai com o registo (form=), vem com a de agora. *@
      <div class="dmo-field ri-campo-hora">
        <label for="riHora-@codigo">Hora</label>
        <input id="riHora-@codigo" name="hora" type="time" class="ri-hora" form="riRegistar-@codigo" value="@Model.HoraDoCampo"
               pattern="[0-2][0-9]:[0-5][0-9]" title="Hora (HH:mm)" aria-invalid="@(Model.HoraInvalida ? "true" : null)" required />
      </div>
      @if (c.DoDia.VariasProducoes)
      {
        <div class="dmo-field ri-campo-producao">
          <label for="riProducao-@codigo">Produção (há @c.DoDia.Candidatas.Count)</label>
          <select id="riProducao-@codigo" name="producao" class="ri-producao" data-dmo-autosubmit>
            @foreach (var o in c.DoDia.Candidatas)
            {
              <option value="@o.JobOnId" selected="@(p?.JobOnId == o.JobOnId)">@RiTextos.Producao(o)</option>
            }
          </select>
        </div>
      }
    </form>

    @* O botão CM/MF (como o tipo de movimento das Boquilhas: o ativo
       em azul claro), o número e OK. «É outra CM/MF» (o botão no canto)
       desliza o painel com a referência e o lote; sem produção ficam
       sempre na linha, obrigatórios. *@
    <form id="riRegistar-@codigo" method="post" asp-page="/ReparacaoInterna/Index" asp-page-handler="Registar" class="ri-registar">
      <input type="hidden" name="operacao_id" value="@Model.OperacaoId" />
      <input type="hidden" name="maquina" value="@codigo" />
      @if (dia is not null)
      {
        <input type="hidden" name="dia" value="@dia" />
      }
      @if (p is not null)
      {
        <input type="hidden" name="producao" value="@p.JobOnId" />
      }
      @if (cmTool is not null)
      {
        <input type="hidden" name="contexto_cm" value="@cmTool.ContextoId" />
      }
      @if (mfTool is not null)
      {
        <input type="hidden" name="contexto_mf" value="@mfTool.ContextoId" />
      }
      @if (c.SemProducao)
      {
        <input type="hidden" name="outra" value="1" />
      }
      <div class="ri-linha">
        <fieldset class="ri-tipos">
          <legend class="dmo-visually-hidden">CM ou MF</legend>
          <label><input type="radio" id="riTipoCm-@codigo" name="tipo" value="cm" checked="@(c.Tipo == ReparacaoTipo.Cm)" /><span>CM</span></label>
          <label><input type="radio" id="riTipoMf-@codigo" name="tipo" value="mf" checked="@(c.Tipo == ReparacaoTipo.Mf)" /><span>MF</span></label>
        </fieldset>
        <div class="dmo-field ri-campo-trabalho">
          <label for="riTrabalho-@codigo">Trabalho</label>
          <select id="riTrabalho-@codigo" name="trabalho" class="ri-trabalho">
            @foreach (var t in new[] { ReparacaoTrabalho.Reparacao, ReparacaoTrabalho.Soldar, ReparacaoTrabalho.Polir })
            {
              <option value="@RiTextos.TrabalhoValor(t)" selected="@(Model.Trabalho == t)">@RiTextos.Trabalho(t)</option>
            }
          </select>
        </div>
        <div class="dmo-field ri-campo-numero">
          <label for="riNumero-@codigo">Número</label>
          <input id="riNumero-@codigo" name="numero" class="ri-numero" inputmode="numeric" maxlength="@IndexModel.NumeroAlgarismos" pattern="[0-9]{1,@IndexModel.NumeroAlgarismos}" title="Só algarismos, até @IndexModel.NumeroAlgarismos" aria-invalid="@(Model.NumeroInvalido ? "true" : null)" autocomplete="off" required autofocus
                 value="@Model.NumeroEscrito" />
        </div>
        <button type="submit" class="dmo-button ri-ok" id="riOk-@codigo">OK</button>
      </div>
      @if (!c.SemProducao)
      {
        <input type="checkbox" id="riOutra-@codigo" class="ri-outra-check" name="outra" value="1" checked="@Model.OutraMarcada" />
      }
      <div class="ri-linha ri-outra-campos" id="riOutraPainel-@codigo" role="@(c.SemProducao ? null : "group")" aria-labelledby="@(c.SemProducao ? null : $"riOutraTitulo-{codigo}")">
        @if (!c.SemProducao)
        {
          <div class="ri-outra-topo">
            <h4 id="riOutraTitulo-@codigo">Outra CM/MF</h4>
            <label class="ri-outra-fechar" for="riOutra-@codigo" title="Fechar: regista com a CM/MF da produção" aria-label="Fechar o painel da outra CM/MF">×</label>
          </div>
          <p class="ri-outra-dica">A referência e o lote da CM ou do MF que está a reparar; o número fica na linha.</p>
        }
        <div class="dmo-field">
          <label for="riReferencia-@codigo">Referência</label>
          <input id="riReferencia-@codigo" name="referencia" class="ri-referencia" maxlength="@Reparacao.ReferenciaMaxLength" autocomplete="off"
                 data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" placeholder="5447T173"
                 required="@c.SemProducao" aria-invalid="@(Model.ErroReferencia ? "true" : null)" value="@Model.ReferenciaEscrita" />
        </div>
        <div class="dmo-field">
          <label for="riLote-@codigo">Lote</label>
          <input id="riLote-@codigo" name="lote" class="ri-lote" maxlength="@Reparacao.LoteMaxLength" autocomplete="off" placeholder="4"
                 required="@c.SemProducao" aria-invalid="@(Model.ErroLote ? "true" : null)" value="@Model.LoteEscrito" />
        </div>
        @if (!c.SemProducao)
        {
          <button type="submit" class="dmo-button ri-outra-ok" id="riOutraOk-@codigo">OK</button>
        }
      </div>
    </form>
    </div>
    @if (Model.OutroDia)
    {
      <p class="dmo-aviso warn" id="riOutroDia-@codigo" role="status">Está a registar no dia @IndexModel.Dia(Model.DiaDoRegisto), não no de hoje (@IndexModel.Dia(Model.Hoje)). <a href="@Model.HrefDaLinhaHoje(codigo)">Voltar a hoje</a></p>
    }

    @* O registo (log): as reparações desta pessoa nesta linha neste
       dia, a mais recente em cima. Sem botões nas linhas: o duplo
       clique (ou «Editar» com a linha escolhida) abre a reparação. *@
    <div id="riLista-@codigo" class="ri-lista">
      <h4>Registo de @IndexModel.Dia(Model.DiaDoRegisto)</h4>
      @if (Model.Log.Items.Count == 0)
      {
        <p class="ri-vazia">Ainda não registou reparações nesta linha neste dia.</p>
      }
      else
      {
        <div class="dmo-table-wrap">
          <table class="dmo-table" id="riLog-@codigo" data-dmo-list="Reparações da linha @codigo"
                 data-ri-maquina="@codigo" data-ri-producao="@p?.JobOnId" data-ri-tipo="@RiTextos.Valor(c.Tipo)" data-ri-dia="@dia" data-ri-pagina="@Model.Log.PageNumber">
            <thead><tr><th>Hora</th><th>Produção</th><th>CM/MF</th><th>Trabalho</th><th>Número</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Log.Items)
            {
              <tr data-dmo-row data-id="@r.Id" data-dmo-reparacao="@r.Id" data-ri-reparacao="@r.Id" data-ri-numero="@r.Numero" data-ri-hora="@IndexModel.Hora(r.Hora, r.RegistadoEmUtc)" title="Duplo clique para corrigir ou anular">
                <td>@IndexModel.Hora(r.Hora, r.RegistadoEmUtc)</td>
                <td>@(r.JobOnId is null ? "Sem Job On" : r.Producao)</td>
                <td>@RiTextos.Tipo(r.Tipo)@if (r.Escrita is { } e)
                  {<span class="ri-escrita">Outra: @RiTextos.Escrita(e.Referencia, e.Lote)</span>}</td>
                <td>@RiTextos.Trabalho(r.Trabalho)</td>
                <td><strong>@r.Numero</strong></td>
              </tr>
            }
            </tbody>
          </table>
        </div>
        @if (Model.Log.TotalPages > 1)
        {
          <nav class="dmo-list-pager ri-pager" aria-label="Paginação da linha @codigo">
            @if (Model.Log.PageNumber > 1)
            {
              <a class="dmo-button dmo-arrow" href="@Url.Page("/ReparacaoInterna/Index", new { maquina = codigo, producao = p?.JobOnId, tipo = RiTextos.Valor(c.Tipo), dia, pagina = Model.Log.PageNumber - 1 })" aria-label="Página anterior">←</a>
            }
            <span role="status">@Model.Log.PageNumber de @Model.Log.TotalPages</span>
            @if (Model.Log.PageNumber < Model.Log.TotalPages)
            {
              <a class="dmo-button dmo-arrow" href="@Url.Page("/ReparacaoInterna/Index", new { maquina = codigo, producao = p?.JobOnId, tipo = RiTextos.Valor(c.Tipo), dia, pagina = Model.Log.PageNumber + 1 })" aria-label="Página seguinte">→</a>
            }
          </nav>
        }
      }
    </div>
  </section>
}
</div>
