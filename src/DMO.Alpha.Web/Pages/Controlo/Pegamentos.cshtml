@page "/Controlo/Pegamentos"
@model DMO.Alpha.Web.Pages.Controlo.PegamentosModel
@using DMO.Alpha.Core.Controlo
@using DMO.Alpha.Web.Pages.Shared
@{
    Layout = "_DmoShellLayout";
}
@section Head {
  <link rel="stylesheet" href="~/css/dmo-pegamentos-prototype.css" asp-append-version="true" />
}

@* GRAVAR SEM RECARREGAR (Diogo, 17/10/2026: «atualizar só o que muda»):
   registar, corrigir e apagar uma leitura gravam e trocam só as zonas que
   mudaram (data-dmo-regiao): o cartão desse componente, o mapa, as mensagens
   e, na primeira medição, o contexto. Os outros cartões não se tocam, por
   isso o que lá está escrito fica. Ver docs/ui-reference/atualizar-so-o-que-muda.md. *@
<main class="peg-page dmo-workspace" aria-labelledby="peg-title" data-dmo-troca>

  <div class="page-head">
    <div>
      <h1 id="peg-title">Pegamentos</h1>
    </div>
  </div>

  @* ------------------------------------------------------------------ *@
  @* 0. Sem controlo selecionado: a folha vive sob um controlo_id —      *@
  @*    a produção seleciona-se no Resumo e o link traz o controlo_id.   *@
  @* ------------------------------------------------------------------ *@
  @if (Model.Sheet is null && Model.RequestedControloId is null && Model.RequestedPegamentosId is null)
  {
    @* Uma zona: a recusa de um «Abrir» sai quando a procura do Job On
       seguinte troca só o que muda (deep sweep 2, 18/10/2026, F-8). *@
    <div id="pegEscolhaAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.EscolhaRefusalMessage is { } recusaEscolha)
    {
      <div class="peg-aviso" role="alert">@recusaEscolha</div>
    }
    </div>

    @if (Model.ModoJobOn)
    {
      <section class="dmo-card peg-card" aria-labelledby="peg-jobon-title">
        <div class="dmo-modo-head">
          <h3 id="peg-jobon-title">Job On<partial name="_DmoHelp" model="@("CM, boquilha (BQ) e molde final (MF) vêm do Job On escolhido.")" /></h3>
          <partial name="_ControloModoRegisto" model="@(("/Controlo/Pegamentos", true))" />
        </div>
        <partial name="_PegamentosEscolhaJobOn" model="Model" />
      </section>
    }
    else
    {
      <section class="dmo-card peg-card" aria-labelledby="peg-tools-title">
        <div class="dmo-modo-head">
          <h3 id="peg-tools-title">Ferramentas<partial name="_DmoHelp" model="@("Escreva as referências da CM, da BQ e do MF (os Pegamentos medem sempre os três). Se uma referência tem mais de um lote, escolha o que está na máquina. Pode associar o Job On mais tarde.")" /></h3>
          <partial name="_ControloModoRegisto" model="@(("/Controlo/Pegamentos", false))" />
          @if (Model.FerramentasProntas)
          {
            <div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" form="pegCreateToolScoped">Criar Pegamentos</button></div>
          }
        </div>
        <form method="get" asp-page="/Controlo/Pegamentos" class="dmo-filter-bar">
          <div class="dmo-field">
            <label for="pegCmRef">CM — referência</label>
            <input id="pegCmRef" name="cm_ref" value="@Model.RequestedCmReference" placeholder="Ex.: 5447" data-dmo-suggest="ferramentas" data-dmo-suggest-tipo="cm" data-dmo-suggest-submit />
          </div>
          <partial name="_PegamentosLote" model="@(("pegCmRef", "cm_tool", "CM — lote", Model.CmLotes, Model.CmTool?.ToolId, Model.RequestedCmReference))" />
          <div class="dmo-field">
            <label for="pegBqRef">Boquilha (BQ) — referência</label>
            <input id="pegBqRef" name="bq_ref" value="@Model.RequestedBqReference" placeholder="Ex.: T194" data-dmo-suggest="ferramentas" data-dmo-suggest-tipo="bq" data-dmo-suggest-submit />
          </div>
          <partial name="_PegamentosLote" model="@(("pegBqRef", "bq_tool", "Boquilha (BQ) — lote", Model.BqLotes, Model.BqTool?.ToolId, Model.RequestedBqReference))" />
          <div class="dmo-field">
            <label for="pegMfRef">Molde final (MF) — referência</label>
            <input id="pegMfRef" name="mf_ref" value="@Model.RequestedMfReference" placeholder="Ex.: 5810" data-dmo-suggest="ferramentas" data-dmo-suggest-tipo="mf" data-dmo-suggest-submit />
          </div>
          <partial name="_PegamentosLote" model="@(("pegMfRef", "mf_tool", "Molde final (MF) — lote", Model.MfLotes, Model.MfTool?.ToolId, Model.RequestedMfReference))" />
          @* Escolher a sugestão mostra logo a referência e o lote, sem botão
             (Diogo, 17/10/2026: os campos de procura aplicam ao escolher). *@
          <noscript><button type="submit" class="dmo-button">Ferramentas</button></noscript>
        </form>
        @if (Model.CmTool is not null || Model.BqTool is not null || Model.MfTool is not null
             || Model.CmLotes.Count > 0 || Model.BqLotes.Count > 0 || Model.MfLotes.Count > 0)
        {
          <div class="dmo-facts peg-context-grid" style="margin-top:12px">
            <div class="dmo-fact"><span>CM</span><strong>@DMO.Alpha.Web.Pages.Controlo.PegamentosModel.FerramentaEscolhida(Model.CmTool, Model.CmLotes)</strong></div>
            <div class="dmo-fact"><span>BQ</span><strong>@DMO.Alpha.Web.Pages.Controlo.PegamentosModel.FerramentaEscolhida(Model.BqTool, Model.BqLotes)</strong></div>
            <div class="dmo-fact"><span>MF</span><strong>@DMO.Alpha.Web.Pages.Controlo.PegamentosModel.FerramentaEscolhida(Model.MfTool, Model.MfLotes)</strong></div>
          </div>
        }
        @if (Model.CmToolRequestedNotFound)
        {
          <div class="peg-aviso" role="alert">A referência da CM indicada não está registada no Ferramentas.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.RegistarFerramenta("CM", Model.RequestedCmReference, "Registar a CM em Ferramentas")" /></div>
        }
        @if (Model.BqToolRequestedNotFound)
        {
          <div class="peg-aviso" role="alert">A referência da boquilha (BQ) indicada não está registada no Ferramentas.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.RegistarFerramenta("BQ", Model.RequestedBqReference, "Registar a BQ em Ferramentas")" /></div>
        }
        @if (Model.MfToolRequestedNotFound)
        {
          <div class="peg-aviso" role="alert">A referência do molde final (MF) indicada não está registada no Ferramentas.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.RegistarFerramenta("MF", Model.RequestedMfReference, "Registar a MF em Ferramentas")" /></div>
        }
        @if (Model.FerramentasProntas)
        {
          <form method="post" asp-page="/Controlo/Pegamentos" asp-page-handler="CreateToolScoped" id="pegCreateToolScoped">
            <input type="hidden" name="cm_tool_id" value="@Model.CmTool?.ToolId" />
            <input type="hidden" name="bq_tool_id" value="@Model.BqTool?.ToolId" />
            <input type="hidden" name="mf_tool_id" value="@Model.MfTool?.ToolId" />
            <input type="hidden" name="cm_ref" value="@Model.RequestedCmReference" />
            <input type="hidden" name="bq_ref" value="@Model.RequestedBqReference" />
            <input type="hidden" name="mf_ref" value="@Model.RequestedMfReference" />
          </form>
        }
      </section>
    }
  }
  else if (Model.ControloRequestedNotFound)
  {
    <div class="peg-aviso" role="alert">O controlo indicado não existe. Nenhuma folha foi aberta.</div>
  }
  @if (Model.PdfRefusalMessage is { Length: > 0 } pdfRefusalMessage)
  {
    <div data-dmo-toast="erro" class="peg-aviso" role="alert">@pdfRefusalMessage</div>
  }
  @* Uma recusa do «Associar Job On» com a folha de uma produção à vista (os
     Pegamentos já foram associados a outra produção, por exemplo noutro
     separador): o «Associar» já não existe, por isso a recusa vai para o
     canto, como as outras (deep sweep, 18/10/2026, B-pegamentos-4). *@
  @if (Model.Sheet is { } folhaRecusa && !(folhaRecusa.SemJobOn && Model.AssociarAberto)
       && Model.EscolhaRefusalMessage is { } recusaFolha)
  {
    <div data-dmo-toast="erro" class="peg-aviso" role="alert">@recusaFolha</div>
  }

  @* ------------------------------------------------------------------ *@
  @* 1. Contexto do Job On: herdado, composto no momento da leitura.     *@
  @* ------------------------------------------------------------------ *@
  @if (Model.Sheet is { } sheet)
  {
    @* O contexto muda com a primeira medição (a dica da folha em branco, o
       PDF e a tolerância congelada): é uma zona. O PDF e o «Associar Job On»
       seguem o caminho de sempre (descarga e página inteira). *@
    <partial name="_PegamentosContexto" model="Model" />

    @* O «Associar Job On» fica como o operador o deixou (data-dmo-fica):
       registar, corrigir ou apagar uma leitura com ele aberto troca só os
       cartões, sem abrir a página inteira nem perder o que está escrito. *@
    <div id="pegAssociar" class="dmo-zona" data-dmo-fica>
    @if (sheet.SemJobOn && Model.AssociarAberto)
    {
      <section class="dmo-card peg-card" aria-labelledby="peg-associar-title">
        <div class="peg-section-head"><div>
          <h3 id="peg-associar-title">Associar Job On</h3>
          <p class="card-note">As ferramentas destes Pegamentos têm de ser as do Job On. As medições ficam como estão.</p>
        </div></div>
        @if (Model.EscolhaRefusalMessage is { } recusaAssociar)
        {
          <div data-dmo-toast="erro" class="peg-aviso" role="alert">@recusaAssociar</div>
        }
        <partial name="_PegamentosEscolhaJobOn" model="Model" />
      </section>
    }
    </div>

    <partial name="_PegamentosAvisos" model="Model" />

    @* As folhas da produção, quando a CM, a BQ ou o MF mudou a meio e há
       mais do que uma (18/10/2026); vazia com uma só. *@
    <partial name="_PegamentosFolhas" model="Model" />

    @* ---------------------------------------------------------------- *@
    @* 2. Um card por componente aplicável da combinação.                *@
    @* ---------------------------------------------------------------- *@
    @foreach (var componentContext in sheet.Components)
    {
      <partial name="_PegamentosCartao" model="new DMO.Alpha.Web.Pages.Controlo.PegamentosCartaoZona(Model, componentContext)" />
    }

    @* ---------------------------------------------------------------- *@
    @* 3. Mapa de limites — o «gráfico todo» do mockup, projetado no     *@
    @*    servidor (apresentação; a autoridade está nas regras).        *@
    @* ---------------------------------------------------------------- *@
    <partial name="_PegamentosMapa" model="Model" />
  }

</main>

@* A confirmação do × de cada leitura (pegamentos-registo.js): uma só janela
   da app, fora das zonas que trocam. *@
<dialog id="peg-apagar-janela" class="dmo-dialog" aria-labelledby="peg-apagar-titulo">
  <h3 id="peg-apagar-titulo">Apagar leitura</h3>
  <p>Apagar esta leitura?</p>
  <div class="dmo-dialog-actions">
    <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
    <button type="button" class="dmo-button" data-peg-apagar-confirmar>Apagar</button>
  </div>
</dialog>

@section Scripts {
<script src="~/js/pegamentos-registo.js" asp-append-version="true"></script>
}
