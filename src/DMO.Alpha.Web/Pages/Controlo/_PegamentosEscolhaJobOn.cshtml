@model DMO.Alpha.Web.Pages.Controlo.PegamentosModel
@* A escolha do Job On em dois passos: a referência e a máquina, depois a
   produção num dropdown só com as produções dessa referência. Nos
   Pegamentos novos abre a folha da produção; nos sem Job On associa-os.

   SEM RECARREGAR E NUMA LINHA (deep sweep 2, 18/10/2026, F-8 e F-9): a
   referência, a máquina e a produção ficam na mesma linha, com a largura do
   que levam (dmo-filter-bar-conteudo). A procura fica como o operador a
   deixou (data-dmo-fica) e vai pelo DmoTroca (data-dmo-parcial): escolher a
   referência ou a máquina troca só a produção e a mensagem, sem recarregar
   a página. O dropdown da produção é do formulário POST de baixo (form=),
   porque não há formulários dentro de formulários; abrir ou associar abre
   outra folha (controlo_id), por isso esse formulário segue como sempre
   (data-dmo-nativo). Enquanto a referência escrita não é a das produções
   (falta o Enter ou a sugestão), o dropdown e o «Associar» ficam
   desativados (data-dmo-depende): uma produção de outra referência não se
   abre nem se associa. *@
@{
    var associar = Model.Sheet is { SemJobOn: true };
    var temProducoes = Model.JobOnReferencia is not null && Model.Producoes.Count > 0;
}
<div class="dmo-zona" data-dmo-fica data-dmo-parcial>
<form method="get" asp-page="/Controlo/Pegamentos" class="dmo-filter-bar dmo-filter-bar-conteudo" id="pegJobOnProcura" data-dmo-reference-scope="controlo" data-dmo-reference-name="referencia">
  @if (associar)
  {
    <input type="hidden" name="pegamentos_id" value="@Model.Sheet!.Pegamentos?.PegamentosId" />
    <input type="hidden" name="associar" value="1" />
  }
  else
  {
    <input type="hidden" name="modo" value="@DMO.Alpha.Web.Pages.Controlo.PegamentosModel.ModoJobOnValor" />
  }
  <div class="dmo-field">
    <label for="pegJobOnReferencia">Referência</label>
    <input id="pegJobOnReferencia" data-dmo-maiusculas autocapitalize="characters" name="referencia" value="@Model.JobOnReferencia" placeholder="Ex.: 5810" autocomplete="off" required data-dmo-suggest="referencias" data-dmo-suggest-submit />
  </div>
  <div class="dmo-field dmo-field-maquina">
    <label for="pegJobOnMaquina">Máquina</label>
    <select id="pegJobOnMaquina" name="maquina" data-dmo-autosubmit data-dmo-reference-select>
      <option value="" data-dmo-reference-option>Todas</option>
      @foreach (var maquinaOpcao in Model.Maquinas)
      {
        <option value="@maquinaOpcao" selected="@(string.Equals(Model.JobOnMaquina, maquinaOpcao, StringComparison.Ordinal) ? "selected" : null)" data-dmo-reference-option>@maquinaOpcao</option>
      }
    </select>
  </div>
  @* Escolher a referência ou a máquina procura logo (sem «Procurar»). A
     produção é uma zona que existe sempre, escondida sem produções. Abrir a
     produção aplica ao escolher; associar muda o registo, por isso fica o
     botão. *@
  <div id="pegJobOnProducaoZona" class="dmo-field dmo-field-producao" data-dmo-regiao hidden="@(temProducoes ? null : "hidden")">
  @if (temProducoes)
  {
    <label for="pegJobOn">Produção</label>
    @if (associar)
    {
      <select id="pegJobOn" name="jobon_id" form="pegJobOnEscolha" required data-dmo-depende="pegJobOnReferencia" data-dmo-depende-valor="@Model.JobOnReferencia" data-dmo-reference-select>
        @foreach (var producao in Model.Producoes)
        {
          <option value="@producao.JobOnId" data-dmo-reference-option>@producao.ProductionNumber · @producao.Machine</option>
        }
      </select>
    }
    else
    {
      <select id="pegJobOn" name="jobon_id" form="pegJobOnEscolha" required data-dmo-autosubmit="valor" data-dmo-depende="pegJobOnReferencia" data-dmo-depende-valor="@Model.JobOnReferencia" data-dmo-reference-select>
        <option value="" data-dmo-reference-option>Escolher produção</option>
        @foreach (var producao in Model.Producoes)
        {
          <option value="@producao.JobOnId" data-dmo-reference-option>@producao.ProductionNumber · @producao.Machine</option>
        }
      </select>
    }
  }
  </div>
  @if (associar)
  {
    <div id="pegJobOnAssociarZona" class="dmo-field" data-dmo-regiao hidden="@(temProducoes ? null : "hidden")">
    @if (temProducoes)
    {
      <span class="dmo-label" aria-hidden="true">&nbsp;</span>
      <button type="submit" class="dmo-button" form="pegJobOnEscolha" data-dmo-depende="pegJobOnReferencia" data-dmo-depende-valor="@Model.JobOnReferencia">Associar</button>
    }
    </div>
  }
</form>
<div id="pegJobOnVazia" data-dmo-regiao>
@if (Model.JobOnReferencia is { } referenciaProcurada && Model.Producoes.Count == 0)
{
  <div class="peg-vazia" role="status" style="margin-top:12px">@(Model.JobOnMaquina is { } maquinaProcurada ? $"Não há Job Ons da referência {referenciaProcurada} na máquina {maquinaProcurada}." : $"Não há Job Ons da referência {referenciaProcurada}.")<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.CriarJobOn(referenciaProcurada)" /></div>
}
</div>
<form method="post" asp-page="/Controlo/Pegamentos" asp-page-handler="@(associar ? "Associate" : "AbrirJobOn")" id="pegJobOnEscolha" data-dmo-nativo>
  @if (associar)
  {
    <input type="hidden" name="pegamentos_id" value="@Model.Sheet!.Pegamentos?.PegamentosId" />
  }
</form>
</div>
