@model DMO.Alpha.Web.Pages.Controlo.DefinicoesModel

@{
    // Os campos de um modelo (criar e mudar usam a mesma janela).
    var listaOpcoes = Model.Listas;
    // O separador aberto (?sub=…): cada separador tem só o que a sua área usa (Diogo, 22/10/2026).
    var sub = ViewData["CtlSub"] as string ?? "peso";
    // NNPB só existe na B1 e por vezes na C3 (Diogo, 22/10/2026): as outras linhas não se mostram (os valores guardados ficam).
    var linhasNnpb = Model.PuncoesLinhas.Where(l => DMO.Alpha.Web.Pages.Controlo.DefinicoesModel.LinhasNnpb.Contains(l.Maquina)).ToList();
}
<style>
.ctl-def-page{display:flex;flex-direction:column;gap:14px}
.ctl-def-page .page-head{margin:0 0 2px}
.ctl-def-card{padding:16px 18px;min-width:0;margin:0}
.ctl-def-grade{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start;width:100%}
html body .ctl-def-grade[hidden]{display:none}
@@media(max-width:900px){.ctl-def-grade{grid-template-columns:minmax(0,1fr)}}
.ctl-def-card .dmo-card-topo h3{margin:0}
.ctl-def-card h3{margin:0 0 10px;font-size:16px}
.ctl-def-card .dmo-card-topo{margin-bottom:10px}
.ctl-def-acoes{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}
.ctl-def-acoes .dmo-field{margin:0}
.ctl-def-nota{margin:6px 0 0;color:var(--dmo-muted);font-size:12px}
.ctl-def-card .dmo-table td{padding:4px 8px;vertical-align:middle}
.ctl-def-emails{min-width:min(360px,100%)}
.ctl-def-x{padding:2px 6px;border:0;border-radius:6px;background:none;color:var(--dmo-muted);font-size:16px;line-height:1;cursor:pointer}
.ctl-def-x:hover{color:var(--dmo-danger);background:var(--dmo-danger-soft)}
/* As listas do email: o espaço normal entre os campos e as listas; cada lista abre pelo triângulo à esquerda do nome. */
.ctl-def-listas{display:grid;gap:var(--dmo-space-2);margin-top:var(--dmo-space-4)}
.ctl-def-lista{border:1px solid var(--dmo-border);border-radius:var(--dmo-r-control);background:var(--dmo-card)}
.ctl-def-lista>summary{display:flex;align-items:center;gap:var(--dmo-space-2);padding:10px 12px;cursor:pointer;list-style:none;font-weight:700}
.ctl-def-lista>summary::-webkit-details-marker{display:none}
.ctl-def-lista-conta{margin-left:auto;color:var(--dmo-muted);font-size:12px;font-weight:400}
.ctl-def-lista-corpo{padding:0 12px 12px}
.ctl-def-lista-topo{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--dmo-space-3);margin-bottom:var(--dmo-space-3)}
.ctl-def-lista-topo .dmo-field{margin:0}
.ctl-def-valor{border:0;background:none;padding:0;font:inherit;color:inherit;text-align:left;cursor:pointer;text-decoration:underline dotted}
.ctl-def-modelo{display:grid;gap:10px;min-width:min(480px,100%)}
.ctl-def-modelo .dmo-field{margin:0}
.ctl-def-modelo textarea{min-height:140px}
</style>
  <div class="ctl-def-grade" data-dmo-ctl-sub="pegamentos" data-dmo-grupo="controlo" hidden="@(sub != "pegamentos")">
  <section id="ctlDefTolerancia" class="dmo-card ctl-def-card" aria-labelledby="pegamentos-settings-title" data-dmo-regiao data-dmo-parcial>
    <div class="dmo-card-topo">
    <h3 id="pegamentos-settings-title">Pegamentos — tolerância<partial name="_DmoHelp" model="@("A tolerância (± mm) à volta do gargalo do CM, BQ e MF. A norma é 0,20 mm. Cada registo de Pegamentos guarda a tolerância com que foi criado: mudar este valor não altera registos já feitos.")" /></h3>
      <div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" id="ctlDefGuardar" form="ctlDefToleranciaForm">Guardar</button></div>
    </div>
    @if (Model.SaveResultMessage.Length > 0)
    {
      <p data-dmo-toast="@(Model.SaveSucceeded ? "ok" : Model.SaveWarned ? "aviso" : "erro")" role="@(Model.SaveSucceeded || Model.SaveWarned ? "status" : "alert")">@Model.SaveResultMessage</p>
    }
    <form id="ctlDefToleranciaForm" method="post" asp-page="/Controlo/Definicoes" asp-page-handler="SavePegamentosTolerance" class="ctl-def-acoes">
      <div class="dmo-field">
        <label for="pegamentosTolerance">Tolerância (± mm)</label>
        <input id="pegamentosTolerance" name="tolerance_mm" inputmode="decimal" value="@Model.PegamentosToleranceMm.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required />
      </div>
    </form>
    @if (Model.PegamentosToleranceIsDefault)
    {
      <p class="ctl-def-nota">Sem valor guardado: vale a norma de 0,20 mm.</p>
    }
  </section>
  </div>
  @* O ENVIO DO PDF DO PESO POR EMAIL (Diogo, 19/10/2026, D9): as listas de
     destinatários e os modelos (assunto, corpo e o email que envia). O
     «Enviar» está no Resumo do controlo. *@
  <div id="ctlDefEnvioAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.EnvioResultMessage.Length > 0)
    {
      <p data-dmo-toast="@(Model.EnvioSucceeded ? "ok" : Model.EnvioWarned ? "aviso" : "erro")" role="@(Model.EnvioSucceeded || Model.EnvioWarned ? "status" : "alert")">@Model.EnvioResultMessage</p>
    }
  </div>

  <div class="ctl-def-grade" data-dmo-ctl-sub="email" data-dmo-grupo="controlo" hidden="@(sub != "email")">
  <section id="ctlDefListas" class="dmo-card ctl-def-card" aria-labelledby="envio-listas-title" data-dmo-regiao data-dmo-parcial>
    <div class="dmo-card-topo">
    <h3 id="envio-listas-title">Envio por email — listas<partial name="_DmoHelp" model="@("Quem recebe o PDF do Peso. Escreva o nome da lista, o nome e o email da pessoa e carregue em Adicionar: uma lista nova cria-se, a uma que já existe junta-se a pessoa. Pode colar uma lista do Outlook («\"Leal, Sergio\" <sleal@fabrica.pt>; …»): cada pessoa entra com o seu nome. O que não for um email fica de fora, com aviso. Abra uma lista pelo triângulo; clique no nome ou no email de uma pessoa para os mudar (grava ao sair do campo).")" /></h3>
      <div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" id="ctlDefCriarLista" form="ctlDefCriarListaForm">Adicionar</button></div>
    </div>
    <form id="ctlDefCriarListaForm" method="post" asp-page="/Controlo/Definicoes" asp-page-handler="CriarLista" class="ctl-def-acoes">
      <div class="dmo-field">
        <label for="listaNome">Lista</label>
        <input id="listaNome" name="nome" list="ctlDefListasNomes" maxlength="@DMO.Alpha.Core.Controlo.EnvioEmailRegras.NomeMax" placeholder="Ex.: Produção" autocomplete="off" required />
        <datalist id="ctlDefListasNomes">@foreach (var l in Model.Listas) {<option value="@l.Nome"></option>}</datalist>
      </div>
      <div class="dmo-field">
        <label for="listaPessoa">Nome</label>
        <input id="listaPessoa" name="pessoa" maxlength="@DMO.Alpha.Core.Controlo.EnvioEmailRegras.NomeMax" placeholder="Ex.: Sérgio Leal" autocomplete="off" />
      </div>
      <div class="dmo-field ctl-def-emails">
        <label for="listaEmails">Email</label>
        <input id="listaEmails" name="destinatarios" placeholder="sleal@fabrica.pt" autocomplete="off" required />
      </div>
    </form>
    @if (Model.Listas.Count > 0)
    {
      @* As listas fechadas por omissão, o triângulo à esquerda do nome (Diogo, 23/10/2026). *@
      <div class="ctl-def-listas" data-dmo-listas-email>
      @foreach (var lista in Model.Listas)
      {
        var pessoas = DMO.Alpha.Core.Controlo.EnvioEmailRegras.LerLista(lista.Destinatarios);
        <details class="ctl-def-lista" data-dmo-lista-email="@lista.Id" open="@(Model.ListaAberta == lista.Id)">
          <summary><span class="dmo-caret" aria-hidden="true"></span><span class="ctl-def-lista-nome">@lista.Nome</span><span class="ctl-def-lista-conta">@pessoas.Count @(pessoas.Count == 1 ? "pessoa" : "pessoas")</span></summary>
          <div class="ctl-def-lista-corpo">
            <div class="ctl-def-lista-topo">
              <form id="ctlDefLista-@lista.Id" method="post" asp-page="/Controlo/Definicoes" asp-page-handler="MudarLista" class="dmo-field"><input type="hidden" name="lista_id" value="@lista.Id" /><label for="ctl-lista-nome-@lista.Id">Nome da lista</label><input id="ctl-lista-nome-@lista.Id" class="dmo-valor" data-dmo-valor name="nome" value="@lista.Nome" autocomplete="off" required /></form>
              <button type="button" class="ctl-def-x" data-dmo-dialog="ctl-lista-apagar-@lista.Id" aria-label="Apagar a lista @lista.Nome" title="Apagar a lista">×</button>
            </div>
            <dialog id="ctl-lista-apagar-@lista.Id" class="dmo-dialog" aria-labelledby="ctl-lista-apagar-titulo-@lista.Id">
              <h3 id="ctl-lista-apagar-titulo-@lista.Id">Apagar lista</h3>
              <p class="dmo-aviso-discreto">Apagar a lista @lista.Nome? Os envios já feitos ficam registados.</p>
              <form method="post" asp-page="/Controlo/Definicoes" asp-page-handler="ApagarLista">
                <input type="hidden" name="lista_id" value="@lista.Id" />
                <div class="dmo-dialog-actions">
                  <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
                  <button type="submit" class="dmo-button">Apagar</button>
                </div>
              </form>
            </dialog>
            <div class="dmo-table-wrap">
              <table class="dmo-table" data-dmo-pessoas-email="@lista.Id">
                <thead><tr><th>Nome</th><th>Email</th><th><span class="dmo-visually-hidden">Tirar</span></th></tr></thead>
                <tbody>
                @for (var i = 0; i < pessoas.Count; i++)
                {
                  var pessoa = pessoas[i];
                  <tr data-dmo-pessoa-email="@i">
                    <td><form id="ctlDefPessoa-@lista.Id-@i" method="post" asp-page="/Controlo/Definicoes" asp-page-handler="MudarPessoa"><input type="hidden" name="lista_id" value="@lista.Id" /><input type="hidden" name="pessoa" value="@i" /></form><input form="ctlDefPessoa-@lista.Id-@i" class="dmo-valor" data-dmo-valor name="nome" value="@pessoa.Nome" placeholder="—" autocomplete="off" aria-label="Nome de @pessoa.Email" /></td>
                    <td><input form="ctlDefPessoa-@lista.Id-@i" class="dmo-valor ctl-def-emails" data-dmo-valor name="email" value="@pessoa.Email" autocomplete="off" aria-label="Email de @(pessoa.Nome ?? pessoa.Email)" required /></td>
                    <td><form method="post" asp-page="/Controlo/Definicoes" asp-page-handler="RemoverPessoa"><input type="hidden" name="lista_id" value="@lista.Id" /><input type="hidden" name="pessoa" value="@i" /><button type="submit" class="ctl-def-x" aria-label="Tirar @(pessoa.Nome ?? pessoa.Email) da lista" title="Tirar da lista">×</button></form></td>
                  </tr>
                }
                </tbody>
              </table>
            </div>
          </div>
        </details>
      }
      </div>
    }
  </section>

  <section id="ctlDefModelos" class="dmo-card ctl-def-card" aria-labelledby="envio-modelos-title" data-dmo-regiao data-dmo-parcial>
    <div class="dmo-card-topo">
      <h3 id="envio-modelos-title">Envio por email — modelos<partial name="_DmoHelp" model="@("O assunto e o corpo do email, reutilizáveis, e o email que envia. {referencia}, {producao}, {maquina} e {peso} trocam-se pelos dados da produção ({peso} é o peso médio do vidro, por exemplo 245,30 g). A lista do modelo é a proposta ao enviar; no envio pode escolher outra. Clique no nome de um modelo para o mudar.")" /></h3>
      <div class="dmo-card-topo-acoes">
        <button type="button" class="dmo-button" data-dmo-dialog="ctl-modelo-novo">Novo modelo</button>
      </div>
    </div>
    @if (Model.Modelos.Count == 0)
    {
      <p><em>Sem modelos. Crie o primeiro para poder enviar o PDF do Peso.</em></p>
    }
    else
    {
      <div class="dmo-table-wrap">
        <table class="dmo-table" data-dmo-modelos-email>
          <thead><tr><th>Modelo</th><th>Assunto</th><th>Lista</th><th><span class="dmo-visually-hidden">Apagar</span></th></tr></thead>
          <tbody>
          @foreach (var modelo in Model.Modelos)
          {
            <tr data-dmo-modelo-email="@modelo.Id">
              <td><button type="button" class="ctl-def-valor" data-dmo-dialog="ctl-modelo-@modelo.Id">@modelo.Nome</button></td>
              <td>@modelo.Assunto</td>
              <td>@(listaOpcoes.FirstOrDefault(l => l.Id == modelo.ListaId)?.Nome ?? "—")</td>
              <td>
                <button type="button" class="ctl-def-x" data-dmo-dialog="ctl-modelo-apagar-@modelo.Id" aria-label="Apagar o modelo @modelo.Nome" title="Apagar">×</button>
                <dialog id="ctl-modelo-apagar-@modelo.Id" class="dmo-dialog" aria-labelledby="ctl-modelo-apagar-titulo-@modelo.Id">
                  <h3 id="ctl-modelo-apagar-titulo-@modelo.Id">Apagar modelo</h3>
                  <p class="dmo-aviso-discreto">Apagar o modelo @modelo.Nome? Os envios já feitos ficam registados.</p>
                  <form method="post" asp-page="/Controlo/Definicoes" asp-page-handler="ApagarModelo">
                    <input type="hidden" name="modelo_id" value="@modelo.Id" />
                    <div class="dmo-dialog-actions">
                      <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
                      <button type="submit" class="dmo-button">Apagar</button>
                    </div>
                  </form>
                </dialog>
                @await Html.PartialAsync("/Pages/Controlo/_EnvioModeloJanela.cshtml", new DMO.Alpha.Web.Pages.Controlo.EnvioModeloJanela(modelo, listaOpcoes))
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
    @await Html.PartialAsync("/Pages/Controlo/_EnvioModeloJanela.cshtml", new DMO.Alpha.Web.Pages.Controlo.EnvioModeloJanela(null, listaOpcoes))
  </section>

  </div>

  <div class="ctl-def-grade" data-dmo-ctl-sub="peso" data-dmo-grupo="controlo" hidden="@(sub != "peso")">
  @* A densidade do vidro (D15, 19/10/2026): um formulário com os dois
     processos; guardar troca só este cartão. *@
  @* Grava só com um valor (Diogo, 24/10/2026): os campos não são obrigatórios;
     o vazio fica como está. *@
  <section id="ctlDefDensidade" class="dmo-card ctl-def-card" aria-labelledby="densidade-vidro-title" data-dmo-regiao data-dmo-parcial>
    <form method="post" asp-page="/Controlo/Definicoes" asp-page-handler="SaveGlassDensity">
      <div class="dmo-card-topo">
        <h3 id="densidade-vidro-title">Densidade do vidro<partial name="_DmoHelp" model="@("A densidade do vidro (g/cm³) de cada processo da CM, usada no peso do vidro do Peso. Cada Peso guarda a densidade com que foi criado: mudar estes valores só vale para os Pesos novos e para as comparações feitas a seguir.")" /></h3>
        <div class="dmo-card-topo-acoes">
          <button type="submit" class="dmo-button" id="ctlDefDensidadeGuardar">Guardar</button>
        </div>
      </div>
      @if (Model.DensidadeResultMessage.Length > 0)
      {
        <p data-dmo-toast="@(Model.DensidadeSucceeded ? "ok" : Model.DensidadeWarned ? "aviso" : "erro")" role="@(Model.DensidadeSucceeded || Model.DensidadeWarned ? "status" : "alert")">@Model.DensidadeResultMessage</p>
      }
      <div class="ctl-def-acoes">
        <div class="dmo-field">
          <label for="densidadeNnpb">NNPB (g/cm³)</label>
          <input id="densidadeNnpb" name="densidade_nnpb" inputmode="decimal" size="8" value="@DMO.Alpha.Web.Pages.Controlo.DefinicoesModel.FormatarDensidade(Model.DensidadeNnpb)" />
        </div>
        <div class="dmo-field">
          <label for="densidadePs">PS (g/cm³)</label>
          <input id="densidadePs" name="densidade_ps" inputmode="decimal" size="8" value="@DMO.Alpha.Web.Pages.Controlo.DefinicoesModel.FormatarDensidade(Model.DensidadePs)" />
        </div>
      </div>
    </form>
  </section>

  </div>

  <div class="ctl-def-grade" data-dmo-ctl-sub="puncoes" data-dmo-grupo="controlo" hidden="@(sub != "puncoes")">
  @* AS SECÇÕES DE CADA LINHA (Diogo, 22/10/2026): a grelha das punções PU
     NNPB enche as secções da linha, 4 posições cada (A a D). *@
  <section id="ctlDefPuncoesSeccoes" class="dmo-card ctl-def-card" aria-labelledby="puncoes-seccoes-title" data-dmo-regiao data-dmo-parcial>
    <div class="dmo-card-topo">
      <h3 id="puncoes-seccoes-title">PU NNPB — secções por linha<partial name="_DmoHelp" model="@($"Só as linhas com NNPB (B1 e, por vezes, C3). As punções registadas entram pela ordem de registo nas posições da linha: A1, B1, C1, D1, A2… Cada secção tem 4 posições (A a D); as punções que passam da linha ficam na reserva. Enquanto não se guardar outro número, a linha tem {DMO.Alpha.Infrastructure.Controlo.PuncoesPosicoes.SeccoesPorOmissao} secções.")" /></h3>
      @if (linhasNnpb.Count > 0)
      {
        <div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" id="ctlDefSeccoesGuardar" form="ctlDefSeccoesForm">Guardar</button></div>
      }
    </div>
    @if (Model.SeccoesResultMessage.Length > 0)
    {
      <p data-dmo-toast="@(Model.SeccoesSucceeded ? "ok" : "erro")" role="@(Model.SeccoesSucceeded ? "status" : "alert")">@Model.SeccoesResultMessage</p>
    }
    @if (linhasNnpb.Count == 0)
    {
      <p><em>Sem linhas B1 ou C3 registadas.</em></p>
    }
    else
    {
      <form id="ctlDefSeccoesForm" method="post" asp-page="/Controlo/Definicoes" asp-page-handler="SavePuncoesSeccoesTodas">
      <div class="dmo-table-wrap">
        <table class="dmo-table" data-dmo-puncoes-seccoes>
          <thead><tr><th>Linha</th><th>Secções</th><th>Posições</th></tr></thead>
          <tbody>
          @foreach (var linha in linhasNnpb)
          {
            <tr data-dmo-linha="@linha.Maquina">
              <td>@linha.Maquina</td>
              <td>
                <input type="hidden" name="maquina" value="@linha.Maquina" />
                <input name="seccoes" inputmode="numeric" size="4" value="@linha.Seccoes" aria-label="Secções da linha @linha.Maquina" required />
              </td>
              <td>@(linha.Seccoes * DMO.Alpha.Infrastructure.Controlo.PuncoesPosicoes.PosicoesPorSeccao)@(linha.PorOmissao ? " (por omissão)" : null)</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
      </form>
    }
  </section>
  </div>
