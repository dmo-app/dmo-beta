@page "/Controlo/Puncoes"
@model DMO.Alpha.Web.Pages.Controlo.PuncoesModel
@using DMO.Alpha.Infrastructure.Controlo
@using DMO.Alpha.Web.Pages.Shared
@{
    Layout = "_DmoShellLayout";
}
@section Head {
  <link rel="stylesheet" href="~/css/dmo-puncoes.css" asp-append-version="true" />
}

@* GRAVAR SEM RECARREGAR (Diogo, 17/10/2026: «atualizar só o que muda»):
   acrescentar, marcar visto e retirar punções, guardar a identificação e
   associar gravam e trocam só #puFolha (data-dmo-regiao); o resto da página
   não se mexe. Ver docs/ui-reference/atualizar-so-o-que-muda.md. *@
<main class="pu-page dmo-workspace" aria-labelledby="pu-title" data-dmo-troca>

  <div class="page-head">
    <div>
      <h1 id="pu-title">PU NNPB</h1>
    </div>
  </div>

  @if (Model.RequestedControloId is null && Model.RequestedPuncoesId is null)
  {
    <section class="dmo-card pu-card" id="puncoes-novo" aria-labelledby="pu-escolha-title">
      <div class="dmo-modo-head">
        <h3 id="pu-escolha-title">@(Model.ModoJobOn ? "Produção do registo" : "Registo sem Job On")<partial name="_DmoHelp" model="@(Model.ModoJobOn
            ? "Procure a referência e escolha a produção. A produção e a CM vêm do Job On."
            : "Procure a referência para abrir um registo já começado ou começar um novo. Associa-se depois à mão a uma produção.")" /></h3>
        <partial name="_ControloModoRegisto" model="@(("/Controlo/Puncoes", Model.ModoJobOn))" />
        @* «+ Novo registo» no canto superior direito do cartão, na linha do
           título, nunca no fundo por baixo da lista (Diogo, 18/10/2026:
           «metem os botões em baixo aumenta espaço, sempre canto superior
           direito dentro dos cards»). Envia o formulário da referência e do
           lote (form=); o Enter num desses campos também o envia. Uma zona:
           aparece com a procura da referência. *@
        <div id="puNovoAcoes" class="dmo-zona" data-dmo-regiao>
        @if (!Model.ModoJobOn && Model.ReferenciaProcurada is not null)
        {
          <div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" form="pu-novo-form">+ Novo registo</button></div>
        }
        </div>
      </div>
      @* PROCURAR SEM RECARREGAR (deep sweep 2, 18/10/2026, F-8 e F-9): a
         referência fica como o operador a deixou (data-dmo-fica) e vai pelo
         DmoTroca (data-dmo-parcial); trocam só as recusas, a produção (com
         Job On, ao lado da referência), a lista dos registos e o «+ Novo
         registo» (sem Job On). Abrir a produção abre outra folha, por isso o
         formulário dela segue como sempre (data-dmo-nativo); a lista e o
         «+ Novo registo» estão fora de data-dmo-parcial e também abrem a
         folha como sempre. O dropdown da produção é do formulário POST de
         baixo (form=); enquanto a referência escrita não é a das produções,
         fica desativado (data-dmo-depende). *@
      <div id="puEscolhaAvisos" class="dmo-zona" data-dmo-regiao>
      @if (Model.Refusal is not null)
      {
        <div data-dmo-toast="erro" class="pu-aviso" role="alert">@Model.RefusalMessage</div>
      }
      @if (Model.JobOnRefusalMessage is { } jobOnRecusa)
      {
        <div class="pu-aviso" role="alert">@jobOnRecusa</div>
      }
      </div>
      <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
      <form method="get" asp-page="/Controlo/Puncoes" class="pu-id-form" id="pu-procura-form">
        @if (Model.ModoJobOn)
        {
          <input type="hidden" name="modo" value="@PuncoesModel.ModoJobOnValor" />
        }
        <div class="dmo-field">
          <label for="pu-procura">Referência</label>
          <input id="pu-procura" name="procura" value="@Model.ReferenciaProcurada" placeholder="Ex.: 1075C142" autocomplete="off" required data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
        </div>
        @if (Model.ModoJobOn)
        {
          @* A produção ao lado da referência: uma zona que existe sempre,
             escondida sem produções. Escolhê-la abre a folha. *@
          <div id="puProducaoZona" class="dmo-field" data-dmo-regiao hidden="@(Model.ReferenciaProcurada is not null && Model.Producoes.Count > 0 ? null : "hidden")">
          @if (Model.ReferenciaProcurada is not null && Model.Producoes.Count > 0)
          {
            <label for="pu-producao">Produção</label>
            <select id="pu-producao" name="jobon_id" form="pu-jobon-form" required data-dmo-autosubmit="valor" data-dmo-depende="pu-procura" data-dmo-depende-valor="@Model.ReferenciaProcurada">
              <option value="">Escolher a produção</option>
              @foreach (var producao in Model.Producoes)
              {
                <option value="@producao.JobOnId">@producao.ProductionNumber · @producao.Machine</option>
              }
            </select>
          }
          </div>
        }
      </form>
      @if (Model.ModoJobOn)
      {
        <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="AbrirJobOn" id="pu-jobon-form" data-dmo-nativo></form>
      }
      </div>

      <div id="puEscolhaResultados" class="dmo-zona" data-dmo-regiao>
      @if (Model.ReferenciaProcurada is { } procurada)
      {
        @if (Model.ModoJobOn)
        {
          @if (Model.Producoes.Count == 0)
          {
            <div class="pu-vazia">Não há Job Ons da referência @procurada. Crie o Job On primeiro ou use «Sem Job On».<partial name="_DmoAvisoLink" model="@DmoAvisoLink.CriarJobOn(procurada)" /></div>
          }
        }
        else
        {
          @if (Model.RegistosSemJobOn.Count > 0)
          {
            <div class="dmo-table-wrap">
              <table class="dmo-table pu-table" data-dmo-list="Registos sem Job On">
                <thead>
                  <tr><th>Referência da punção</th><th>Lote</th><th>Punções</th><th>Última alteração</th></tr>
                </thead>
                <tbody>
                  @foreach (var aberto in Model.RegistosSemJobOn)
                  {
                    <tr data-dmo-row data-id="@aberto.PuncoesId" data-dmo-open="/Controlo/Puncoes?puncoes_id=@aberto.PuncoesId"
                        aria-label="Registo @aberto.PunchReference, lote @aberto.Lot — um clique abre">
                      <td>@aberto.PunchReference</td>
                      <td class="pu-lot">@aberto.Lot</td>
                      <td>@aberto.Total</td>
                      <td>@DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(aberto.UpdatedAtUtc).ToString("dd/MM/yyyy HH:mm")@(aberto.UpdatedBy is { } quem ? $" · {quem}" : null)</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          }
          else
          {
            <div class="pu-vazia">Ainda não há registos sem Job On da referência @procurada.</div>
          }

          <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Create" class="pu-id-form pu-novo-form" id="pu-novo-form">
            <input type="hidden" name="referencia_total" value="@procurada" />
            <div class="dmo-field">
              <label for="pu-referencia">Referência da punção</label>
              <input id="pu-referencia" name="referencia" maxlength="100" required value="@(Model.EchoPunchReference ?? PuncoesHandler.DefaultPunchReference(procurada))" placeholder="Ex.: 1075" />
            </div>
            <div class="dmo-field">
              <label for="pu-lote">Lote</label>
              <input id="pu-lote" name="lote" inputmode="numeric" maxlength="12" required value="@Model.EchoLot" placeholder="Ex.: 1" />
            </div>
          </form>
        }
      }
      </div>
    </section>
  }
  else if (Model.ControloRequestedNotFound)
  {
    <div class="pu-aviso" role="alert">O controlo indicado não existe. Nenhuma folha foi aberta.</div>
  }
  else if (Model.RegistoRequestedNotFound)
  {
    <div class="pu-aviso" role="alert">O registo indicado não existe. Nenhuma folha foi aberta. <a href="/Controlo/Puncoes">Procurar um registo</a>.</div>
  }

  <div id="puFolha" class="dmo-zona" data-dmo-regiao>
  @if (Model.Standalone is { } standalone)
  {
    <section class="dmo-card pu-card" id="puncoes-identificacao" aria-labelledby="pu-id-title" data-dmo-parcial>
      <div class="pu-section-head">
        <div>
          <h3 id="pu-id-title">Identificação do registo<partial name="_DmoHelp" model="@("Registo sem Job On. A referência da punção e o lote aplicam-se às próximas punções.")" /></h3>
        </div>
        <span class="pu-step">01</span>
      </div>
      <div class="pu-facts">
        @* Só a produção (Diogo, 21/10/2026: «CM por associar nao deve existir so a producao»). *@
        <div class="pu-fact"><span>Produção</span><strong>Sem Job On</strong></div>
      </div>

      @if (Model.Refusal is not null)
      {
        <div data-dmo-toast="erro" class="pu-aviso" role="alert">@Model.RefusalMessage</div>
      }

      <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Identification" class="pu-id-form" id="pu-id-form">
        <input type="hidden" name="puncoes_id" value="@standalone.PuncoesId" />
        <div class="dmo-field">
          <label for="pu-referencia-total">Referência total</label>
          <input id="pu-referencia-total" name="referencia_total" maxlength="100" required value="@Model.ShownReference" placeholder="Ex.: 1075C142" />
        </div>
        <div class="dmo-field">
          <label for="pu-referencia">Referência da punção</label>
          <input id="pu-referencia" name="referencia" maxlength="100" required value="@Model.ShownPunchReference" placeholder="Ex.: 1075" />
        </div>
        <div class="dmo-field">
          <label for="pu-lote">Lote</label>
          <input id="pu-lote" name="lote" inputmode="numeric" maxlength="12" required value="@Model.ShownLot" placeholder="Ex.: 1" />
        </div>
        <div class="dmo-field">
          <span class="dmo-label" aria-hidden="true">&nbsp;</span>
          <button type="submit" class="dmo-button">Guardar identificação</button>
        </div>
      </form>
    </section>
  }

  @if (Model.Sheet is { } sheet)
  {
    <section class="dmo-card pu-card" id="puncoes-identificacao" aria-labelledby="pu-id-title" data-dmo-parcial>
      <div class="pu-section-head">
        <div>
          <h3 id="pu-id-title">Identificação da produção<partial name="_DmoHelp" model="@("A produção e a CM vêm do Job On. A referência da punção e o lote aplicam-se às próximas punções.")" /></h3>
        </div>
        <span class="pu-step">01</span>
      </div>
      <div class="pu-facts">
        <div class="pu-fact"><span>Produção</span><strong>@sheet.ProductionNumber</strong></div>
        <div class="pu-fact"><span>Referência total</span><strong>@sheet.Reference</strong></div>
        <div class="pu-fact"><span>Máquina</span><strong>@sheet.Machine</strong></div>
        <div class="pu-fact"><span>CM</span><strong>@(sheet.CmReference ?? "—")@(sheet.CmLot is { } cmLot ? $" · Lote {cmLot}" : null)</strong></div>
        <div class="pu-fact"><span>Processo da CM</span><strong>@(sheet.IsNnpb ? "NNPB" : sheet.CmProcess ?? "Por preencher")</strong>
          @if (sheet.NnpbSource == PuncoesNnpbSource.NomeTecnico)
          {
            <small>pelo nome técnico da CM; a ficha não tem processo</small>
          }
        </div>
      </div>

      @if (Model.Refusal is not null)
      {
        <div data-dmo-toast="erro" class="pu-aviso" role="alert">@Model.RefusalMessage</div>
      }

      @if (!Model.CanRegister)
      {
        <div class="pu-aviso warn" role="status">
          @(sheet.CmProcess is null
              ? "A CM desta produção não tem o processo preenchido. Preencha «Processo» na ficha da CM (Ferramentas) para registar as punções NNPB."
              : "Esta produção é PS. O registo das punções só existe para produções NNPB.")@if (sheet.CmProcess is null && sheet.CmToolId is { } puCmToolId) {<partial name="_DmoAvisoLink" model="@DmoAvisoLink.FichaFerramenta(puCmToolId, "Preencher o processo na ficha da CM", tecnica: true, continuar: DmoAvisoLink.Aqui(ViewContext.HttpContext.Request))" />}
        </div>
      }
      else
      {
        <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Identification" class="pu-id-form" id="pu-id-form">
          <input type="hidden" name="controlo_id" value="@sheet.ControloId" />
          <div class="dmo-field">
            <label for="pu-referencia">Referência da punção</label>
            <input id="pu-referencia" name="referencia" maxlength="100" required value="@Model.ShownPunchReference" placeholder="Ex.: 1075" />
          </div>
          <div class="dmo-field">
            <label for="pu-lote">Lote</label>
            <input id="pu-lote" name="lote" inputmode="numeric" maxlength="12" required value="@Model.ShownLot" placeholder="Ex.: 1" />
          </div>
          <div class="dmo-field">
            <span class="dmo-label" aria-hidden="true">&nbsp;</span>
            <button type="submit" class="dmo-button">Guardar identificação</button>
          </div>
        </form>
      }

      @if (sheet.Registo is null && Model.RegistosSemJobOn.Count > 0)
      {
        <div class="pu-associar-lista">
          <p class="pu-hint">Há registos sem Job On da referência @sheet.Reference. Associe à mão o desta produção:</p>
          @foreach (var aberto in Model.RegistosSemJobOn)
          {
            <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Associate" class="pu-check-form">
              <input type="hidden" name="puncoes_id" value="@aberto.PuncoesId" />
              <input type="hidden" name="controlo_id" value="@sheet.ControloId" />
              <input type="hidden" name="origem" value="controlo" />
              <button type="submit" class="dmo-button">Associar · punção @aberto.PunchReference · lote @aberto.Lot · @aberto.Total punção(ões)</button>
            </form>
          }
        </div>
      }
    </section>
  }

  @if (Model.CanRegister && Model.TargetField is { } alvo)
  {
    var registo = Model.Registo;
    {
      <div class="pu-stats" aria-label="Totais">
        <div class="pu-stat"><span>Total de punções</span><strong>@(registo?.Total ?? 0)</strong></div>
        <div class="pu-stat"><span>Punções vistas</span><strong>@(registo?.PunchSeenCount ?? 0)</strong></div>
        <div class="pu-stat"><span>Arrefecedores vistos</span><strong>@(registo?.CoolerSeenCount ?? 0)</strong></div>
      </div>

      <section class="dmo-card pu-card" id="puncoes-lista" aria-labelledby="pu-list-title" data-dmo-parcial>
        <div class="pu-section-head">
          <div>
            <h3 id="pu-list-title">Lista de punções<partial name="_DmoHelp" model="@("Ao registar, a punção e o arrefecedor ficam vistos; desmarque o que não foi visto. Um número repetido aparece como «Alteração» e pede o lote dessa punção. O lote de cima aplica-se às novas punções; as anteriores mantêm o seu.")" /></h3>
          </div>
          @* UM SÓ BOTÃO «OPÇÕES» (Diogo, 21/10/2026: «um botao com opcoes e nao
             espalhado pela pagina»): o PDF e, no registo sem Job On, o
             associar a uma produção, numa janela pequena. *@
          <div class="dmo-card-topo-acoes">
            <details class="dmo-options" data-dmo-tab-menu>
              <summary class="dmo-button" aria-label="Opções do registo das punções">Opções<span class="dmo-options-caret" aria-hidden="true">▾</span></summary>
              <div class="dmo-options-list">
                <button type="submit" class="dmo-options-item" form="pu-pdf-form" disabled="@(registo is null)">Extrair PDF</button>
                @if (Model.Standalone is not null)
                {
                  <button type="button" class="dmo-options-item" data-dmo-dialog="pu-associar-dialog">Associar a uma produção</button>
                }
              </div>
            </details>
          </div>
        </div>
        <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="GeneratePdf" id="pu-pdf-form" data-dmo-nativo>
          <input type="hidden" name="@alvo.Name" value="@alvo.Value" />
        </form>

        @* O número junta-se à identificação do cartão de cima (o mesmo POST). *@
        @* O LOTE DE UM NÚMERO REPETIDO (Diogo, 21/10/2026): outra punção com
           o mesmo número tem outro lote; o campo aparece quando o número já
           está na lista (puncoes-numero.js) e vale só para ela. *@
        <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Add" class="pu-add-form" data-pu-numeros="@string.Join("|", registo?.Rows.Select(r => r.Number).Distinct() ?? [])">
          <input type="hidden" name="@alvo.Name" value="@alvo.Value" />
          <input type="hidden" name="referencia" value="@Model.ShownPunchReference" data-pu-mirror="pu-referencia" />
          <input type="hidden" name="lote" value="@Model.ShownLot" data-pu-mirror="pu-lote" />
          <div class="dmo-field">
            <label for="pu-numero">Número da punção</label>
            <input id="pu-numero" name="numero" maxlength="40" required value="@Model.EchoNumber" placeholder="Ex.: 41" autofocus="@(Model.Refusal is not null || registo is not null ? "autofocus" : null)" />
          </div>
          <div class="dmo-field pu-lote-puncao" hidden>
            <label for="pu-lote-puncao">Lote desta punção</label>
            <input id="pu-lote-puncao" name="lote_puncao" inputmode="numeric" maxlength="12" placeholder="Ex.: 2" />
          </div>
          <div class="dmo-field">
            <span class="dmo-label" aria-hidden="true">&nbsp;</span>
            <button type="submit" class="dmo-button">+ Adicionar punção</button>
          </div>
        </form>

        <div class="dmo-table-wrap">
          <table class="dmo-table pu-table">
            <thead>
              <tr>
                <th>N.º da punção</th>
                <th>Lote</th>
                <th>Punção visto</th>
                <th>Arrefecedor visto</th>
                <th class="pu-right">Ações</th>
              </tr>
            </thead>
            <tbody>
              @if (registo is null || registo.Rows.Count == 0)
              {
                <tr><td colspan="5" class="pu-empty">Sem punções registadas. Adicione o primeiro número.</td></tr>
              }
              else
              {
                @foreach (var row in registo.Rows)
                {
                  <tr>
                    <td class="pu-number">@row.Number@if (row.IsAlteracao) {<span class="pu-alteracao">Alteração</span>}</td>
                    <td class="pu-lot">@row.Lot</td>
                    @foreach (var (campo, visto) in new[] { ("puncao", row.PunchSeen), ("arrefecedor", row.CoolerSeen) })
                    {
                      <td>
                        <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Seen" class="pu-check-form">
                          <input type="hidden" name="@alvo.Name" value="@alvo.Value" />
                          <input type="hidden" name="inspecao_id" value="@row.Id" />
                          <input type="hidden" name="campo" value="@campo" />
                          <input type="hidden" name="visto" value="@(visto ? "false" : "true")" />
                          <button type="submit" class="pu-check @(visto ? "on" : null)" aria-pressed="@(visto ? "true" : "false")"
                                  aria-label="@(campo == "puncao" ? "Punção" : "Arrefecedor da punção") @row.Number: @(visto ? "visto, carregar para desmarcar" : "por verificar, carregar para marcar")">
                            <span class="pu-box" aria-hidden="true">@(visto ? "✓" : "")</span>@(visto ? "Visto" : "Por verificar")
                          </button>
                        </form>
                      </td>
                    }
                    <td class="pu-right">
                      @* A confirmação é a janela da casa, com o texto escrito pelo
                         Razor como HTML (nunca dentro de um onclick: um número
                         com aspas correria como JavaScript). *@
                      <button type="button" class="pu-remove" data-dmo-dialog="pu-remover-@row.Id" aria-label="Remover a punção @row.Number" title="Remover">×</button>
                      <dialog id="pu-remover-@row.Id" class="dmo-dialog" aria-labelledby="pu-remover-titulo-@row.Id">
                        <h3 id="pu-remover-titulo-@row.Id">Remover punção</h3>
                        <p class="dmo-aviso-discreto">Remover a punção @row.Number · lote @row.Lot deste registo?</p>
                        <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Remove">
                          <input type="hidden" name="@alvo.Name" value="@alvo.Value" />
                          <input type="hidden" name="inspecao_id" value="@row.Id" />
                          <div class="dmo-dialog-actions">
                            <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
                            <button type="submit" class="dmo-button">Remover</button>
                          </div>
                        </form>
                      </dialog>
                    </td>
                  </tr>
                }
              }
            </tbody>
          </table>
        </div>
      </section>
    }
  }
  </div>

  @* A procura da referência e as recusas do «Associar à produção» trocam
     só esta zona (data-dmo-parcial; deep sweep, 18/10/2026). A zona só
     existe no registo sem Job On: associado, a folha passa a ser a da
     produção, com as funções do Controlo dessa produção, e a página abre
     inteira. *@
  @* ASSOCIAR NUMA JANELA PEQUENA (Diogo, 21/10/2026), aberta pelas Opções:
     a referência e depois a produção. A procura e as recusas trocam só a
     zona de dentro, com a janela aberta. *@
  @if (Model.Standalone is { } semJobOn)
  {
    <dialog id="pu-associar-dialog" class="dmo-dialog pu-associar-dialog" aria-labelledby="pu-associar-title">
    <div id="puAssociar" class="dmo-zona" data-dmo-regiao>
    <section id="puncoes-associar" data-dmo-parcial>
      <h3 id="pu-associar-title">Associar a uma produção<partial name="_DmoHelp" model="@("As punções não ficam ligadas sozinhas a uma produção: escolha à mão a produção NNPB deste registo. Depois de associado, o registo passa para a folha da produção e para o PDF do Resumo.")" /></h3>
      @if (Model.JobOnRefusalMessage is { } escolhaRecusa)
      {
        <div data-dmo-toast="erro" class="pu-aviso" role="alert">@escolhaRecusa</div>
      }
      <form method="get" asp-page="/Controlo/Puncoes" asp-fragment="puncoes-associar" class="pu-id-form">
        <input type="hidden" name="puncoes_id" value="@semJobOn.PuncoesId" />
        <div class="dmo-field">
          <label for="pu-associar-procura">Referência</label>
          <input id="pu-associar-procura" name="procura" value="@Model.ReferenciaProcurada" autocomplete="off" required data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
        </div>
      </form>
      @if (Model.Producoes.Count == 0)
      {
        <div class="pu-vazia">Não há Job Ons da referência @Model.ReferenciaProcurada. Quando a produção existir, associe-a aqui.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.CriarJobOn(Model.ReferenciaProcurada)" /></div>
      }
      else
      {
        <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="Associate" class="pu-id-form" id="pu-associar-form">
          <input type="hidden" name="puncoes_id" value="@semJobOn.PuncoesId" />
          @* A referência procurada volta com uma recusa (o redirect leva-a). *@
          <input type="hidden" name="procura" value="@Model.ReferenciaProcurada" />
          <div class="dmo-field">
            <label for="pu-associar-producao">Produção</label>
            <select id="pu-associar-producao" name="jobon_id" required>
              @foreach (var producao in Model.Producoes)
              {
                <option value="@producao.JobOnId">@producao.ProductionNumber · @producao.Machine</option>
              }
            </select>
          </div>
          <div class="dmo-field">
            <span class="dmo-label" aria-hidden="true">&nbsp;</span>
            <button type="submit" class="dmo-button" id="pu-associar">Associar à produção</button>
          </div>
        </form>
      }
    </section>
    </div>
    <div class="dmo-dialog-actions">
      <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Fechar</button>
    </div>
    </dialog>
  }
</main>

<script>
  // O número junta-se à identificação escrita no cartão de cima, mesmo antes
  // de a guardar. Por delegação: os cartões são trocados depois de gravar.
  document.addEventListener("input", function (event) {
    var source = event.target;
    if (!source || !source.id) return;
    document.querySelectorAll('[data-pu-mirror="' + source.id + '"]').forEach(function (hidden) { hidden.value = source.value; });
  });
</script>
@* O número seguinte, escrito enquanto o anterior grava, não se junta a ele nem se perde. *@
<script src="~/js/puncoes-numero.js" asp-append-version="true"></script>
