@page "/Controlo/Resumo"
@model DMO.Alpha.Web.Pages.Controlo.ResumoModel
@using DMO.Alpha.Core.Production
@using DMO.Alpha.Web.Pages.Shared
@{
    Layout = "_DmoShellLayout";
}
@section Head {
  <link rel="stylesheet" href="~/css/dmo-resumo-prototype.css" asp-append-version="true" />
}

@* GRAVAR SEM RECARREGAR (Diogo, 17/10/2026: «atualizar só o que muda»):
   escolher OK/NOK, guardar o comentário ou o link do mcaliper de uma área
   grava e troca só o cartão dessa área (data-dmo-regiao), a mensagem de uma
   recusa e o «Visto por» (a visita do operador muda a cada pedido); o resto
   da página não se mexe e a procura fica como o operador a deixou
   (data-dmo-fica). Ver docs/ui-reference/atualizar-so-o-que-muda.md. *@
<main class="resumo-page dmo-workspace" aria-labelledby="resumo-title" data-dmo-troca>

  <div class="page-head">
    <div>
      <h1 id="resumo-title">Resumo do Controlo</h1>
    </div>
  </div>

  @* ------------------------------------------------------------------ *@
  @* 1. Browser «Procurar resumo»: início da referência + recentes.     *@
  @*    Com uma produção aberta fica numa linha só (Diogo, 26/10/2026:   *@
  @*    «quando existir controlo selecionado minimizar»): o CSS usa o    *@
  @*    :has(.resumo-sheet), porque o cartão fica (data-dmo-fica).       *@
  @* ------------------------------------------------------------------ *@
  <section class="dmo-card resumo-card resumo-browser" aria-labelledby="resumo-browser-title" data-dmo-fica>
    <h3 id="resumo-browser-title">Procurar resumo</h3>
    @* A PROCURA AO ESCREVER (Diogo, 17/10/2026): as últimas 5 produções
       aparecem por baixo do campo enquanto se escreve e um clique abre a
       escolhida. O Enter continua a procurar (e a paginação também). *@
    <form method="get" asp-page="/Controlo/Resumo" class="resumo-form-grid">
      <div class="dmo-field">
        <label for="reference">Referência ou nº de produção<partial name="_DmoHelp" model="@("Escreva a referência ou o nº de produção: as últimas 5 produções aparecem em baixo. Um clique abre a produção.")" /></label>
        <input id="reference" type="search" data-dmo-maiusculas autocapitalize="characters" name="reference" value="@Model.RequestedReference" placeholder="Ex.: 1075C142 ou 202601" data-dmo-procura="@Url.Page("/Controlo/Resumo", "Procurar")" data-dmo-procura-alvo="resumoProcura" />
      </div>
    </form>
    <div id="resumoProcura" class="resumo-procura" aria-live="polite">
      @if (Model.RequestedReference is { } procurada)
      {
        <partial name="_ResumoProcura" model="@(new DMO.Alpha.Web.Pages.Controlo.ResumoProcuraView(procurada, Model.Productions, Model.TotalProductions, Model.PageNumber))" />
      }
    </div>
  </section>

  @* ------------------------------------------------------------------ *@
  @* 2. A folha: a produção explicitamente selecionada.                  *@
  @* ------------------------------------------------------------------ *@
  @if (Model.SelectedProduction is { } production)
  {
        var fmt = DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture;
        // As leituras dos controlos associados vêm do page model.
        var linkedPeso = Model.LinkedPeso;
        var pesoCandidates = Model.PesoCandidates;
        var pegamentosAvailable = Model.ControloId is not null;
        var approved = Model.Approval?.ApprovedByOperatorId is not null;
        // Os três estados (sweep de 19/10/2026, C-3): o «Não aprovar» e a
        // nota chegam a quem abre o Resumo, e não só à Revisão.
        var notApproved = Model.Approval?.NaoAprovado == true;
    @* A FOLHA com a composição do PDF do Resumo (beta.26 — o Owner
       2026-10-16: «tenta meter o ui para ficar com mesmo estilo,
       design»): cabeçalho da produção, a janela em máquina com o selo,
       os controlos associados (Peso em destaque), a combinação, o estado
       do documento e o «Visto por» em tabela. *@
    <section class="dmo-card resumo-card resumo-sheet" aria-labelledby="resumo-sheet-title">
      <div class="resumo-sheet-intro">
        <div>
          <span class="resumo-eyebrow">Produção selecionada</span>
          <h3 id="resumo-sheet-title" class="resumo-sheet-identity">
            <span>@production.Reference</span><i aria-hidden="true">·</i><span>@production.ProductionNumber</span><i aria-hidden="true">·</i><span>@production.Machine</span>
          </h3>
        </div>
        @* MENOS CLUTTER (Diogo, 17/10/2026): as folhas abrem-se pelos
           cartões dos controlos associados, a comparação faz-se no Peso e
           os PDFs, cada um em separado, ficam num só botão «Exportar». *@
        @if (Model.ControloId is { } controloDaFolha)
        {
          <div class="resumo-sheet-acoes">
          <details class="dmo-options resumo-export" data-dmo-tab-menu>
            <summary class="dmo-button"><span class="dmo-caret" aria-hidden="true"></span>Exportar</summary>
            <div class="dmo-options-list">
              @* Com registo das punções, o PDF completo traz também o PDF das
                 punções, à parte, na mesma pasta (ou nas Transferências): o
                 dmo-pasta-pdf.js trata este formulário mesmo sem pasta. *@
              <form method="post" asp-page="/Controlo/Resumo" asp-page-handler="GeneratePdf" data-dmo-pdf-acompanha="@(Model.Puncoes?.Registo is not null ? "puncoes" : null)">
                <input type="hidden" name="jobon_id" value="@production.JobOnId" />
                @* O PDF COMPLETO (Diogo, 19/10/2026): o Resumo e, a seguir, o
                   Peso, os Pegamentos e as PU NNPB que tenham registos, com
                   ligações do Resumo para cada um e de volta. *@
                <button type="submit" class="dmo-options-item">PDF completo</button>
                <button type="submit" name="apenas_resumo" value="true" class="dmo-options-item">PDF do Resumo</button>
              </form>
              @if (linkedPeso is not null)
              {
                <form method="post" asp-page="/Controlo/Peso" asp-page-handler="GeneratePdf">
                  <input type="hidden" name="controlo_id" value="@Model.ControloId" />
                  <button type="submit" class="dmo-options-item">PDF do Peso</button>
                </form>
              }
              @* «PDF Pegamentos» só com medições (Diogo, 27/10/2026, cmsg_01K75FTs9bQnbhhH7qttpgraB4cWtFy2LfgzGWkBMpzRuk):
                 sem folha das ferramentas atuais o servidor recusa o PDF (24/10), por isso o botão não aparece. *@
              @if (Model.PegamentosSheets.Any(f => f.IsCurrent))
              {
                <form method="post" asp-page="/Controlo/Pegamentos" asp-page-handler="GeneratePdf">
                  <input type="hidden" name="controlo_id" value="@Model.ControloId" />
                  <button type="submit" class="dmo-options-item">PDF Pegamentos</button>
                </form>
              }
              @if (Model.Puncoes?.Registo is not null)
              {
                <form method="post" asp-page="/Controlo/Puncoes" asp-page-handler="GeneratePdf">
                  <input type="hidden" name="controlo_id" value="@Model.ControloId" />
                  <button type="submit" class="dmo-options-item">PDF das PU NNPB</button>
                </form>
              }
            </div>
          </details>
          @* O «Enviar» do PDF do Peso por email (Diogo, 19/10/2026, D9). *@
          @if (linkedPeso is not null)
          {
            @await Component.InvokeAsync("EnvioPeso", new { jobOnId = production.JobOnId, controloId = controloDaFolha })
          }
          </div>
        }
      </div>

      @* O CABEÇALHO DA PRODUÇÃO NUM SÓ BLOCO (Diogo, 27/10/2026: «estruturar
         melhor»): uma grelha de três colunas, Início · Fim · Aprovação em cima
         e CM · MF · BQ por baixo, nas mesmas colunas; o rótulo pequeno por
         cima do valor e o título da combinação dentro do bloco. A Aprovação
         já não tem caixa própria: só a cor do valor muda (17/10/2026: o
         início e o fim, só a data; depois a combinação e os controlos). *@
      <div class="resumo-cabecalho">
        <div class="resumo-window-grid resumo-context-grid">
          <div class="resumo-mini-card">
            <span>Início</span>
            <strong>@(production.InicioEm?.ToString("d", fmt) ?? "—")</strong>
          </div>
          <div class="resumo-mini-card">
            <span>Fim</span>
            <strong>@(production.FimEm?.ToString("d", fmt) ?? (production.InicioEm is null ? "—" : "Em aberto"))</strong>
          </div>
          <div class="resumo-mini-card resumo-approval @(approved ? "approved" : notApproved ? "not-approved" : "pending")">
            <span>Aprovação</span>
            <strong>@(approved ? "Aprovado" : notApproved ? "Não aprovado" : "Por aprovar")</strong>
            @if (Model.Approval?.Detalhe(fmt) is { } aprovacaoDetalhe)
            {
              <small>@aprovacaoDetalhe</small>
            }
            @if (Model.CanApprove)
            {
              <a class="resumo-card-link" href="/Controlo/Approve?jobon_id=@production.JobOnId">@(approved || notApproved ? "Rever aprovação →" : "Aprovar →")</a>
            }
          </div>
        </div>

        @* Sem «A combinação da produção»: já está no Estado do documento (Diogo, 27/10/2026). *@
      </div>

      @* O «NÃO APROVADO» DEIXA UM AVISO (Diogo, 19/10/2026, F5: «requer que
         seja revisto ou então posto de parte. Mas nunca é razão de
         bloqueio»): só avisa, com o link para a Revisão a quem a tem. *@
      @if (notApproved)
      {
        <div class="dmo-aviso warn" role="status" data-resumo-nao-aprovado>O controlo desta produção não foi aprovado: tem de ser revisto ou posto de parte.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.Revisao(production.JobOnId)" /></div>
      }

      @if (Model.JobOnNotice is { } jobOnNotice)
      {
        <partial name="_JobOnChangeNotice" model="jobOnNotice" />
      }

      @* Os CONTROLOS ASSOCIADOS: cada um conserva a sua identidade; o
         Resumo só compõe (Peso em destaque, como no PDF). *@
      <div class="resumo-linked">
        <h4 class="resumo-section-title">Controlos associados</h4>
        @* O «REGISTAR» ABRE A PÁGINA (Diogo, 27/10/2026: como na .121): com o
           Controlo Criar, os botões de registo dos cartões (Registar e Associar
           Peso existente) navegam para a página de registo e não abrem o
           painel lateral; o «Comparar», o «Ver detalhe» e quem só tem o Ver
           continuam no painel, só de consulta (dmo-support.js). *@
        <div class="resumo-linked-grid" data-dmo-sem-painel="@(Model.CanCreate ? ".resumo-card-actions a.dmo-button:not([href*='comparacao=1'])" : null)">
          <article class="resumo-linked-card resumo-linked-peso">
            @* Os botões no canto superior direito do cartão, na linha do
               título, nunca no fundo (Diogo, 18/10/2026: «metem os botões em
               baixo aumenta espaço, sempre canto superior direito dentro dos
               cards»). *@
            <div class="resumo-linked-card-head">
              <span>Peso</span>
              <div class="dmo-card-topo-acoes resumo-card-actions">
                <span class="resumo-status">@(linkedPeso is null ? "Sem registo" : "Registado")</span>
                @* Sem o Peso das ferramentas atuais (ainda sem Peso, ou
                   depois de trocar a CM ou a BQ a meio; 18/10/2026). *@
                @if (!Model.HasCurrentPeso)
                {
                  @if (pesoCandidates.Count > 0)
                  {
                    <a class="dmo-button" href="/Controlo/Peso?controlo_id=@Model.ControloId#peso-associate-title">Associar Peso existente</a>
                  }
                  <a class="dmo-button" href="/Controlo/Peso?controlo_id=@Model.ControloId" aria-label="Registar o Peso">Registar</a>
                }
                @* A Comparação de Peso abre-se aqui, com o Peso desta produção
                   já escolhido; a referência e a produção podem mudar para
                   comparar com outra qualquer (Diogo, 21/10/2026). *@
                @if (linkedPeso is not null)
                {
                  <a class="dmo-button" href="/Controlo/Peso?controlo_id=@Model.ControloId&amp;comparacao=1" aria-label="Comparar o Peso desta produção">Comparar</a>
                }
              </div>
            </div>
            @if (linkedPeso is { } linkedPesoValue)
            {
              var average = linkedPesoValue.Averages?.AverageGlassWeightGrams;
              var deviation = DMO.Alpha.Core.Controlo.PesoCalculation.NominalDeviation(average, linkedPesoValue.NominalWeightGrams);
              @* O PESO ESTRUTURADO (Diogo, 27/10/2026: «estruturar melhor a
                 informação»): a média em destaque e, por baixo, uma tabela
                 pequena com o nominal, o controlo anterior e a produção
                 anterior (o valor e a diferença em g e em %, alinhados); as
                 leituras e a água numa linha discreta, ao lado do «Ver
                 detalhe». Sem um dos valores, a linha fica com «—»
                 (26/10/2026: o atual, o do controlo anterior e o da produção
                 anterior, cada um com o delta, e o nominal com o delta). *@
              @if (average is { } mean)
              {
                <div class="resumo-peso-media">
                  <strong class="resumo-big-number">@DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(mean)<small> g</small></strong>
                  <small>Peso médio do vidro</small>
                </div>
              }
              else
              {
                <strong>Sem leituras registadas</strong>
                <small>Ainda sem média calculada.</small>
              }
              var caAnterior = Model.ControloAnterior is { AverageGlassWeightGrams: { } caValor } ca ? (Valor: (decimal?)caValor, Numero: ca.ProductionNumber) : (Valor: (decimal?)null, Numero: (string?)null);
              var paAnterior = Model.ProducaoAnterior is { PesoGramas: { } paValor } pa ? (Valor: (decimal?)paValor, Numero: pa.ProductionNumber) : (Valor: (decimal?)null, Numero: (string?)null);
              var linhasPeso = new (string Rotulo, string? Numero, decimal? Valor, (decimal? Grams, decimal? Percent) Delta)[]
              {
                  ("Nominal", null, linkedPesoValue.NominalWeightGrams, deviation),
                  ("Controlo anterior", caAnterior.Numero, caAnterior.Valor, DMO.Alpha.Core.Controlo.PesoCalculation.NominalDeviation(average, caAnterior.Valor)),
                  ("Produção anterior", paAnterior.Numero, paAnterior.Valor, Model.ProducaoAnterior is { } paDelta ? paDelta.Delta(average) : DMO.Alpha.Core.Controlo.PesoCalculation.NominalDeviation(average, null))
              };
              <table class="dmo-table resumo-peso-tabela" data-resumo-peso-tabela>
                <thead>
                  <tr><th scope="col"><span class="resumo-sr-only">Comparação</span></th><th scope="col">Valor</th><th scope="col">Diferença g</th><th scope="col">Diferença %</th></tr>
                </thead>
                <tbody>
                  @foreach (var linha in linhasPeso)
                  {
                    <tr>
                      <th scope="row">@linha.Rotulo@if (linha.Numero is { } numeroAnterior) {<small> @numeroAnterior</small>}</th>
                      <td>@(linha.Valor is { } valor ? $"{valor.ToString("0.00", fmt)} g" : "—")</td>
                      <td>@(linha.Valor is not null && linha.Delta.Grams is { } dg ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Signed(dg) : "—")</td>
                      <td>@(linha.Valor is not null && linha.Delta.Percent is { } dp ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Signed(dp) : "—")</td>
                    </tr>
                  }
                </tbody>
              </table>
              @if (!Model.HasCurrentPeso)
              {
                <small>A CM ou a BQ mudou nesta produção: falta o Peso das ferramentas atuais.</small>
              }
              @if (Model.Pesos.Count > 1)
              {
                @* Um Peso por CM+BQ (a CM ou a BQ mudou a meio; 18/10/2026):
                   uma linha por Peso, com as ferramentas e a média dele, para
                   nenhum ficar escondido; um clique abre o Peso. *@
                <ul class="resumo-peg-folhas" aria-label="Pesos da produção">
                  @foreach (var (pesoDaLista, numero) in Model.Pesos.Select((p, i) => (p, i + 1)))
                  {
                    var mediaDaLista = pesoDaLista.Averages?.AverageGlassWeightGrams;
                    <li>
                      <a href="@Model.PesoHref(pesoDaLista)">Peso @numero</a>
                      · @DMO.Alpha.Infrastructure.Controlo.ResumoPdfGenerator.ToolsOf(pesoDaLista)
                      · @DMO.Alpha.Core.Runtime.DmoNumberFormat.Contagem(pesoDaLista.Measurements.Count, "leitura", "leituras")@(mediaDaLista is { } m ? $" · média {DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(m)} g" : "")@(pesoDaLista.IsCurrent ? "" : " · de antes da troca")
                    </li>
                  }
                </ul>
              }
              <div class="resumo-peso-rodape">
                <small>@DMO.Alpha.Core.Runtime.DmoNumberFormat.Contagem(linkedPesoValue.Measurements.Count, "leitura", "leituras") · água a @linkedPesoValue.WaterTemperatureC °C</small>
                <a class="resumo-card-link" href="@Model.PesoHref(linkedPesoValue)">Ver detalhe →</a>
              </div>
            }
            else
            {
              <strong>Ainda não registado</strong>
              @if (pesoCandidates.Count > 0)
              {
                @* A ASSOCIAÇÃO POSTERIOR (o Owner 2026-10-16): um Peso sem
                   produção com a CM deste Job On — a decisão é no Peso. *@
                <small>@(pesoCandidates.Count == 1 ? "Existe um Peso" : $"Existem {pesoCandidates.Count} Pesos") sem produção com a CM deste Job On.</small>
              }
              else
              {
                <small>Crie o Peso desta produção na folha de Peso.</small>
              }
            }
          </article>
          @{
              // Todas as folhas da produção (a CM, a BQ ou o MF mudou a meio;
              // 18/10/2026): os totais somam-nas e o tom é o da pior,
              // para nenhum alerta ficar escondido. Com uma só, como sempre.
              var pegRecord = Model.PegamentosRecord;
              var pegFolhas = Model.PegamentosSheets;
              var pegCount = pegFolhas.Sum(f => f.Measurements.Count);
              var pegAlerts = pegFolhas.Sum(f => f.Measurements.Count(m => m.Evaluation.HasAlert));
              var pegNotEvaluable = pegFolhas.Sum(f => f.Measurements.Count(m => m.Evaluation.IsNotEvaluable));
              // «Não avaliável» é cinzento, como nos Pegamentos e no PDF; o âmbar é
              // de «por verificar» (sweep de 19/10/2026, 3.16).
              var pegTone = pegCount == 0 ? "" : pegAlerts > 0 ? "nok" : pegNotEvaluable > 0 ? "na" : "ok";
          }
          <article class="resumo-linked-card resumo-linked-peg @pegTone">
            <div class="resumo-linked-card-head">
              <span>Pegamentos</span>
              <div class="dmo-card-topo-acoes resumo-card-actions">
                <span class="resumo-status">@(!pegamentosAvailable ? "Indisponível" : pegRecord is null ? "Sem registo" : "Registado")</span>
                @if (pegRecord is null && pegamentosAvailable)
                {
                  <a class="dmo-button" href="/Controlo/Pegamentos?controlo_id=@Model.ControloId" aria-label="Registar os Pegamentos">Registar</a>
                }
              </div>
            </div>
            @if (pegRecord is not null)
            {
              <strong>@(pegCount == 0 ? "Sem medições registadas"
                  : pegAlerts > 0 ? "Existem medições fora das tolerâncias"
                  : pegNotEvaluable > 0 ? "Existem medições não avaliáveis"
                  : "Todas as medições dentro das tolerâncias")</strong>
              @if (pegCount > 0)
              {
                <div class="resumo-stats">
                  <div><span>Medições</span><b>@pegCount</b></div>
                  <div><span>Em alerta</span><b>@pegAlerts</b></div>
                  <div><span>Não avaliáveis</span><b>@pegNotEvaluable</b></div>
                </div>
                @if (pegFolhas.Count < 2)
                {
                  <small>Tolerância ± @pegRecord.ToleranceMm.ToString("0.00", fmt) mm</small>
                }
              }
              @if (pegFolhas.Count > 1)
              {
                @* Uma linha por folha, com as ferramentas e a tolerância
                   dela; um clique abre a folha. *@
                <ul class="resumo-peg-folhas" aria-label="Folhas de Pegamentos">
                  @foreach (var (folha, numero) in pegFolhas.Select((f, i) => (f, i + 1)))
                  {
                    var folhaAlertas = folha.Measurements.Count(m => m.Evaluation.HasAlert);
                    var folhaNaoAvaliaveis = folha.Measurements.Count(m => m.Evaluation.IsNotEvaluable);
                    <li>
                      <a href="@(folha.IsCurrent ? $"/Controlo/Pegamentos?controlo_id={Model.ControloId}" : $"/Controlo/Pegamentos?controlo_id={Model.ControloId}&pegamentos_id={folha.PegamentosId}")">Folha @numero</a>
                      · @DMO.Alpha.Infrastructure.Controlo.ResumoPdfGenerator.ToolsOf(folha)
                      · @DMO.Alpha.Core.Runtime.DmoNumberFormat.Contagem(folha.Measurements.Count, "medição", "medições")@if (folhaAlertas > 0) {<b class="nok"> · @folhaAlertas em alerta</b>}@if (folhaNaoAvaliaveis > 0) {<b class="na"> · @DMO.Alpha.Core.Runtime.DmoNumberFormat.Contagem(folhaNaoAvaliaveis, "não avaliável", "não avaliáveis")</b>}
                      · ± @folha.ToleranceMm.ToString("0.00", fmt) mm
                    </li>
                  }
                </ul>
              }
              <a class="resumo-card-link" href="/Controlo/Pegamentos?controlo_id=@Model.ControloId">Ver detalhe →</a>
            }
            else if (!pegamentosAvailable)
            {
              <strong>Contexto indisponível</strong>
              <small>Não foi possível obter a folha de Pegamentos.</small>
            }
            else
            {
              <strong>Ainda não registado</strong>
              <small>Registe as medições desta produção na folha de Pegamentos.</small>
            }
          </article>
          @if (Model.ShowPuncoes)
          {
              var puRegisto = Model.Puncoes!.Registo;
              var puTotal = puRegisto?.Total ?? 0;
              var puPending = puTotal * 2 - (puRegisto?.PunchSeenCount ?? 0) - (puRegisto?.CoolerSeenCount ?? 0);
              var puTone = puTotal == 0 ? "" : puPending > 0 ? "warn" : "ok";
            @* O REGISTO DAS PUNÇÕES NNPB (o Owner 17/10/2026): só quando a
               CM é NNPB ou o registo já existe. *@
            <article class="resumo-linked-card resumo-linked-pu @puTone">
              <div class="resumo-linked-card-head">
                <span>PU NNPB</span>
                <div class="dmo-card-topo-acoes resumo-card-actions">
                  <span class="resumo-status">@(puRegisto is null ? "Sem registo" : "Registado")</span>
                  @if (puRegisto is null)
                  {
                    <a class="dmo-button" href="/Controlo/Puncoes?controlo_id=@Model.ControloId" aria-label="Registar as punções">Registar</a>
                  }
                </div>
              </div>
              @if (puRegisto is not null)
              {
                <strong>@(puTotal == 0 ? "Sem punções registadas" : puPending > 0 ? "Existem punções por verificar" : "Punções e arrefecedores vistos")</strong>
                @if (puTotal > 0)
                {
                  <div class="resumo-stats">
                    <div><span>Punções</span><b>@puTotal</b></div>
                    <div><span>Punções vistas</span><b>@puRegisto.PunchSeenCount</b></div>
                    <div><span>Arrefecedores</span><b>@puRegisto.CoolerSeenCount</b></div>
                  </div>
                }
                <small>Punção @puRegisto.PunchReference · lote @puRegisto.Lot</small>
                @* Duas ligações (Diogo, 22/10/2026): o registo (a verificação) e a
                   folha das punções por posição da linha (a tabela do PDF). *@
                <nav class="resumo-pu-ligacoes" aria-label="PU NNPB" data-resumo-pu-ligacoes>
                  <a class="resumo-card-link" href="/Controlo/Puncoes?controlo_id=@Model.ControloId">Registo das punções →</a>
                  <a class="resumo-card-link" href="/Controlo/Puncoes?controlo_id=@Model.ControloId&amp;vista=folha">Folha das punções →</a>
                </nav>
              }
              else
              {
                <strong>Ainda não registado</strong>
                <small>A CM desta produção é NNPB: registe as punções e os arrefecedores vistos.</small>
              }
            </article>
          }
        </div>
      </div>

       <div class="resumo-sheet-areas" id="estado-documento">
         @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
         <h4 class="resumo-section-title" title="Escolher OK ou NOK grava logo. Clique no comentário para o escrever. Sem registo, a área fica «não registado». O estado e os comentários aparecem no PDF do Resumo.">Estado do documento</h4>
         <partial name="_ResumoEstadoAvisos" model="Model" />
         @* Cada área é uma zona (.dmo-zona: a grelha não muda; a cor do
            cartão vem dentro dela). Gravar o OK/NOK, o comentário ou o link
            troca só esse cartão, com a janela fechada; o foco fica no OK/NOK
            escolhido (o mesmo id) ou volta ao botão que abriu a janela. *@
         <div class="resumo-areas" data-dmo-parcial data-dmo-zonas="resumoEstadoAvisos resumoVistoPor">
        @foreach (var areaState in Model.AreasMostradas)
        {
          <partial name="_ResumoArea" model="new DMO.Alpha.Web.Pages.Controlo.ResumoAreaZona(Model, areaState)" />
        }
         </div>
       </div>

      @* O REGISTO DE VISÃO (a decisão GATE 4 do Owner): abrir esta folha
         é ver — a visita fica registada, nunca bloqueia nada. Ao lado, quem
         aprovou (Diogo, 17/10/2026): lê-se logo junto de quem viu. O «Visto
         por» é uma zona: a visita do operador fica registada outra vez a
         cada pedido, também depois de gravar. *@
      <div class="resumo-people">
        <partial name="_ResumoVistoPor" model="Model" />
        <div class="resumo-viewings">
          <h4 class="resumo-section-title">Aprovado por</h4>
          <div class="dmo-table-wrap">
            <table class="dmo-table">
              <thead><tr><th>Operador</th><th>Aprovado a</th></tr></thead>
              <tbody>
                @if (approved)
                {
                  <tr><td>@(Model.Approval!.Quem)</td><td>@(Model.Approval.ApprovedAtUtc is { } approvedAt ? DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(approvedAt).ToString("g", fmt) : "—")</td></tr>
                }
                else if (notApproved)
                {
                  <tr><td class="resumo-nao-aprovado" colspan="2">@(Model.Approval!.Frase(fmt))</td></tr>
                }
                else
                {
                  <tr><td class="resumo-por-aprovar" colspan="2">Por aprovar.</td></tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  }
  else if (Model.JobOnRequestedNotFound)
  {
    <div class="resumo-aviso" role="alert">A produção indicada não existe. Nenhuma folha foi criada para ela.</div>
  }

</main>
