@page "/Controlo/Peso"
@model DMO.Alpha.Web.Pages.Controlo.PesoModel
@using DMO.Alpha.Core.Controlo
@using DMO.Alpha.Core.Tools
@using DMO.Alpha.Web.Pages.Shared
@{
    // Os links dos avisos para a ficha da ferramenta voltam a esta folha.
    var voltarAqui = DmoAvisoLink.Aqui(ViewContext.HttpContext.Request);
    Layout = "_DmoShellLayout";
    // Ponto decimal canónico (decisão do proprietário de 15/10/2026): 2 casas
    // na UI. As densidades são metrologia — mantêm a precisão da tabela real
    // da fábrica (decisão Owner 1b, 5 casas disponíveis).
    // Sem «.00» num inteiro (Diogo, 23/10/2026: «100 g», não «100.00 g»).
    var fmt = new Func<decimal, string>(DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2);
    var fmtDensity = new Func<decimal, string>(value =>
        value.ToString("0.#####", DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture));
    // O sinal preservado nas diferenças da Comparação_B (o alvo 22: o
    // −0.53 g / +0.18 cm³ — o sinal é o fato).
    var signed = new Func<decimal, string>(DMO.Alpha.Core.Runtime.DmoNumberFormat.Signed);
    // O APOIO TP/CALOTE (o fmt(x,3) do dmo-html): as métricas do cálculo
    // esférico a 3 casas, com o sinal preservado nas diferenças.
    // Desde 25/10/2026 (Diogo: «duas decimais mas só quando for necessário»)
    // também aqui: inteiros sem casas, com decimais sempre duas.
    var fmtCap = new Func<decimal?, string>(value => value is { } v
        ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(v)
        : "—");
    // O h do apoio pelo sítio de onde vem: o Job On, a simulação ou, sem
    // Job On, nenhum (fica «—» e o volume é só o nominal).
    string RotuloH(string origem) => origem == "Simulação" ? "h simulado" : "h Job On";
    bool SemJobOn(DMO.Alpha.Core.Controlo.PesoCapSupportReadModel apoio) => apoio.OrigemCalote == "Tool CM";
    var fmtCapSigned = new Func<decimal?, string>(value => value is { } v
        ? (v >= 0 ? "+" : "") + DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2(v)
        : "—");
    // O rótulo humano de um Peso guardado (os selects da comparação —
    // factos apenas, nunca um id; o padrão do pesoLabel do html sem o id).
    var rotuloPesoOpcao = new Func<PesoComparacaoPesoOpcao, string>(opcao =>
    {
        var partes = new List<string>();
        if (!string.IsNullOrEmpty(opcao.Reference)) { partes.Add(opcao.Reference); }
        if (!string.IsNullOrEmpty(opcao.ProductionNumber)) { partes.Add(opcao.ProductionNumber); }
        if (!string.IsNullOrEmpty(opcao.Machine)) { partes.Add(opcao.Machine); }
        if (partes.Count == 0 && !string.IsNullOrEmpty(opcao.CmToolReference)) { partes.Add($"CM {opcao.CmToolReference}"); }
        if (!string.IsNullOrEmpty(opcao.CmToolLot)) { partes.Add($"Lote {opcao.CmToolLot}"); }
        // Com vários Pesos na produção (a CM ou a BQ mudou a meio;
        // 18/10/2026), a BQ distingue dois Pesos da mesma CM.
        if (opcao.BqLabel is { } bqLabel) { partes.Add(bqLabel); }
        if (!opcao.IsCurrent) { partes.Add("de antes da troca"); }
        partes.Add($"{opcao.Leituras} CM");
        return string.Join(" · ", partes);
    });
    var cmProcessLabel = new Func<CmProcess?, string>(process => process switch
    {
        CmProcess.Nnpb => "NNPB",
        CmProcess.Ps => "PS",
        _ => "—"
    });
}
@section Head {
  <link rel="stylesheet" href="~/css/dmo-peso-prototype.css" asp-append-version="true" />
  @* O botão do apoio TP/calote — portado do dmo-html controlo-v04
     (.tp-button tal como está, sobre os tokens da casa; o corpo é o
     skin da página: peso-facts/peso-fact/hint). *@
}

@* GRAVAR SEM RECARREGAR (Diogo, 17/10/2026: «atualizar só o que muda»):
   na folha aberta, registar leituras, escolher a comparação, guardar a
   produção anterior e o «Supomos» trocam só as zonas que mudam
   (data-dmo-regiao); a leitura nova que o operador está a escrever fica
   como está (data-dmo-fica) e o resto da página não se mexe. Ver
   docs/ui-reference/atualizar-so-o-que-muda.md. *@
<main class="peso-page dmo-workspace" aria-labelledby="peso-title" data-dmo-troca>

  <div class="page-head">
    <div>
      <partial name="_VoltarAoResumo" model="@(Model.ProductionContext?.JobOnId)" />
      <h1 id="peso-title">Peso</h1>
    </div>
  </div>

  @* ------------------------------------------------------------------ *@
  @* 0. A TAB DO HISTÓRICO (?historico=1): o HISTÓRICO DO CONTROLO ao    *@
  @*    uso do dmo-html — os TRÊS tipos de registo (Peso, Pegamentos,    *@
  @*    Comparação) com a procura da oficina (referência/produção/       *@
  @*    ferramenta/tipo/data), o «Comparar Pesos guardados» e o detalhe  *@
  @*    do registo de comparação. A folha do peso apresenta APENAS a     *@
  @*    referência atual (o Owner 2026-10-13).                           *@
  @* ------------------------------------------------------------------ *@
  @if (Model.HistoricoTab)
  {
  <section class="dmo-card peso-card" aria-labelledby="peso-historico-title">
    @* O «Comparar peso» do Histórico (Diogo, 27/10/2026: «comparar peso através
       do histórico»): leva a referência escrita (data-peso-comparar-cm), posta
       pelo script ao clicar; o cabeçalho fica igual entre filtros. *@
    <div class="peso-card-heading dmo-card-topo">
      <h3 id="peso-historico-title">Histórico do Controlo</h3>
      <div class="dmo-card-topo-acoes">
        <a class="dmo-button" href="/Controlo/PesoComparar" data-peso-comparar-cm="historicoReferencia">Comparar peso</a>
      </div>
    </div>
    @* Os filtros trocam só o que muda (deep sweep, 18/10/2026): cada escolha
       pede a página com fetch (DmoTroca, pelo ouvinte do Peso abaixo) e troca
       os resultados e o dropdown das produções, que muda com a referência.
       Os campos ficam como o operador os deixou (data-dmo-fica): um filtro
       escolhido com o pedido anterior a caminho vai no pedido seguinte, e o
       ecrã mostra sempre o que se pediu. A referência e a ferramenta
       aplicam-se ao escrever, 350 ms depois da última tecla
       (data-dmo-ao-escrever; deep sweep 2, 18/10/2026, F-10); a produção
       escolhida para a referência anterior sai ao escrever (data-dmo-depende).
       O «Comparar Pesos guardados» saiu do Histórico (Diogo, 21/10/2026):
       compara-se na folha do Peso de cada produção. *@
    @{
      async Task HistoricoFiltrosCampos()
      {
        <input type="hidden" name="historico" value="1" />
        <div class="dmo-field">
          <label for="historicoReferencia">Referência</label>
          <input id="historicoReferencia" data-dmo-maiusculas autocapitalize="characters" name="referencia" value="@Model.HistoryReference" placeholder="Ex.: 1075C142" data-dmo-suggest="referencias" data-dmo-suggest-submit />
        </div>
        @* O lote, com a referência (Diogo, 27/10/2026: «falta lote»): ST100 lote 8. *@
        <div class="dmo-field peso-hist-lote">
          <label for="historicoLote">Lote</label>
          <input id="historicoLote" name="lote" value="@Model.HistoryLote" maxlength="3" inputmode="numeric" autocomplete="off" placeholder="Ex.: 8" data-dmo-maiusculas />
        </div>
        @* A procura em dois passos: primeiro a referência; depois o nº de
           produção num dropdown só com as produções dessa referência, pela
           mesma regra da tabela (o início da referência ou da parte BQ). Cada
           opção leva o nº e a referência: escolher filtra só essa produção,
           mesmo com o mesmo nº noutra referência e com o texto da referência
           alargado depois. Com várias referências (o texto é o início de mais
           do que uma), a opção também diz a referência. *@
        <div id="pesoHistoricoProducaoZona" class="dmo-field" data-dmo-regiao>
          <label for="historicoProducao">Nº de produção</label>
          @if (Model.HistoryReference is null || Model.HistorySemJobOn)
          {
            <select id="historicoProducao" name="producao" disabled>
              <option value="">Produção</option>
            </select>
          }
          else
          {
            var producoesVariasReferencias = Model.HistoryProducoesVariasReferencias;
            <select id="historicoProducao" name="producao" data-dmo-autosubmit data-dmo-depende="historicoReferencia">
              <option value="" selected="@(Model.HistoryProduction is null ? "selected" : null)">Todas</option>
              @foreach (var producaoOpcao in Model.HistoryProducoes)
              {
                <option value="@Model.HistoryProducaoValor(producaoOpcao)" selected="@(Model.HistoryProducaoEscolhida(producaoOpcao) ? "selected" : null)">@producaoOpcao.ProductionNumber@(producoesVariasReferencias ? $" · {producaoOpcao.Reference}" : "")</option>
              }
            </select>
          }
        </div>
        @* Sem o campo «Ferramenta» (Diogo, 27/10/2026: «o peso é sempre CM,
           então devemos conseguir procurar a partir da referência»): a
           referência da CM escreve-se na Referência. O ?ferramenta= dos links
           continua a filtrar. *@
        @* Um ?ferramenta= vindo de um link filtra à vista: diz qual e tira-se
           com o «×» (auditoria de 27/10/2026: o filtro ficava invisível). *@
        @if (Model.HistoryTool is not null)
        {
          var semFerramenta = string.Join("&", Request.Query
              .Where(q => q.Key is not ("ferramenta" or "pagina"))
              .SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? "")}")));
          <input type="hidden" name="ferramenta" value="@Model.HistoryTool" />
          <div class="dmo-field peso-hist-ferramenta">
            <span class="dmo-field-label">Ferramenta</span>
            <a class="peso-hist-chip" href="/Controlo/Peso?@semFerramenta" aria-label="Tirar o filtro da ferramenta @Model.HistoryTool">@Model.HistoryTool <span aria-hidden="true">×</span></a>
          </div>
        }
        <div class="dmo-field">
          <label for="historicoTipo">Tipo</label>
          <select id="historicoTipo" name="tipo" data-dmo-autosubmit>
            @{
              var tipoAtual = Model.HistoryTipo?.ToString();
            }
            <option value="" selected="@(tipoAtual is null ? "selected" : null)">Todos</option>
            <option value="Peso" selected="@(tipoAtual == "Peso" ? "selected" : null)">Peso</option>
            <option value="Pegamentos" selected="@(tipoAtual == "Pegamentos" ? "selected" : null)">Pegamentos</option>
            <option value="Comparacao" selected="@(tipoAtual == "Comparacao" ? "selected" : null)">Comparação</option>
            <option value="Resumo" selected="@(tipoAtual == "Resumo" ? "selected" : null)">Resumo</option>
          </select>
        </div>
        <div class="dmo-field">
          <label for="historicoSemJobOn">Job On</label>
          <select id="historicoSemJobOn" name="sem_jobon" data-dmo-autosubmit>
            <option value="" selected="@(Model.HistorySemJobOn ? null : "selected")">Com Job On</option>
            <option value="1" selected="@(Model.HistorySemJobOn ? "selected" : null)">Sem Job On associado</option>
          </select>
        </div>
        <div class="dmo-field">
          <label for="historicoData">Data</label>
          <input id="historicoData" name="data" type="date" value="@(Model.HistoryData is { } dataFiltro ? dataFiltro.ToString("yyyy-MM-dd") : null)" data-dmo-autosubmit />
        </div>
        @* Sem «Procurar» (Diogo, 17/10/2026): os dropdowns e a data aplicam
           logo; a referência e o lote procuram ao escrever, ao escolher
           a sugestão ou com o Enter (deep sweep 2, 18/10/2026, F-10). *@
      }
    }
    <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
    <form method="get" asp-page="/Controlo/Peso" class="dmo-filter-bar" id="pesoHistoricoFiltros" data-dmo-ao-escrever="pesoHistoricoResultados">
      @{ await HistoricoFiltrosCampos(); }
    </form>
    </div>

    <div id="pesoHistoricoResultados" data-dmo-regiao>
    @if (!Model.HistoricoComProcura)
    {
      @* Sem texto de ajuda (Diogo, 27/10/2026). *@
    }
    else if (Model.HistoryResults is { } results)
    {
      if (results.Count == 0)
      {
        @* Sem Job On, a referência (nas ferramentas do registo), a ferramenta,
           o tipo e a data também filtram: o aviso diz se a lista ficou vazia
           por eles. *@
        var semJobOnFiltrado = Model.HistoryReference is not null || Model.HistoryTool is not null || Model.HistoryLote is not null
            || Model.HistoryTipo is not null || Model.HistoryData is not null;
        <div class="peso-vazia" style="margin-top:12px">@(!Model.HistorySemJobOn ? "Sem registos para esta procura." : semJobOnFiltrado ? "Não há Pesos nem Pegamentos por associar a um Job On com estes filtros." : "Não há Pesos nem Pegamentos por associar a um Job On.")</div>
      }
      else
      {
        @* A REGRA DE UI DO OWNER (2026-10-12): nas tabelas NÃO EXISTEM
           botões — um clique ou o Enter abrem o registo (Diogo, 17/10/2026:
           «vamos fazer 1 click nao ha necessidade para dois»). *@
        <form method="get" asp-page="/Controlo/Peso" id="pesoHistoryForm">
          <div class="dmo-table-wrap" style="margin-top:12px">
            <table class="dmo-table" data-dmo-list="Histórico do Controlo">
              <thead>
                <tr>
                  <th></th>
                  @* A ferramenta primeiro (Diogo, 27/10/2026: «começar com CM ST100»). *@
                  <th>Ferramenta</th>
                  <th>Tipo</th>
                  <th>Referência / produção</th>
                  <th>Data</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var item in results)
                {
                  var rotuloLinha = $"{item.Kind} · {item.Reference} · {item.ProductionNumber}";
                  var alvoLinha = $"{item.Kind}:{item.Id}:{item.ControloId}";
                  var hrefLinha = item.Kind switch
                  {
                    ControloHistoryKind.Peso => $"/Controlo/Peso?peso_id={item.Id}",
                    // Cada linha é uma folha (18/10/2026): abre essa folha,
                    // também a de antes de uma troca da CM, da BQ ou do MF.
                    ControloHistoryKind.Pegamentos => item.ControloId is int controloPegamentos
                        ? $"/Controlo/Pegamentos?controlo_id={controloPegamentos}&pegamentos_id={item.Id}"
                        : $"/Controlo/Pegamentos?pegamentos_id={item.Id}",
                    ControloHistoryKind.Resumo => $"/Controlo/Resumo?jobon_id={item.Id}",
                    _ => $"/Controlo/Peso?historico=1&comparacao_id={item.Id}"
                  };
                  <tr data-dmo-row data-id="@alvoLinha" data-dmo-open="@hrefLinha"
                      aria-label="Registo de @rotuloLinha — um clique abre">
                    <td><input type="radio" name="abrir" value="@alvoLinha" required data-rotulo="@rotuloLinha" aria-label="Registo de @rotuloLinha" /></td>
                    <td>@(item.ToolLabel ?? "—")</td>
                    <td>@(item.Kind switch { ControloHistoryKind.Peso => "Peso", ControloHistoryKind.Pegamentos => "Pegamentos", ControloHistoryKind.Resumo => "Resumo", _ => "Comparação" })</td>
                    <td>@(item.ControloId is null ? $"Sem Job On · {item.Reference}" : $"{item.Reference} · {item.ProductionNumber} · {item.Machine}")</td>
                    <td>@(item.DataUtc is { } dataRegisto ? DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(dataRegisto).ToString("dd/MM/yyyy HH:mm") : "—")</td>
                    @* Sem a coluna Resumo; o estado é a posição no armazém, se a CM
                       lá estiver (Diogo, 27/10/2026). Fora do armazém, o Resumo
                       diz a aprovação e o que falta associar diz «Por associar». *@
                    <td>@(item.CmPosicao is { } posicaoCm ? $"Armazém · {posicaoCm}" : item.ControloId is null ? "Por associar" : item.Kind == ControloHistoryKind.Resumo ? item.Resumo ?? "—" : "—")</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
          @if (Model.HistoryPager is { } historyPager)
          {
            <partial name="_ListPager" model="historyPager" />
          }
        </form>
      }
    }

    </div>

    @* O DETALHE do registo de comparação (?comparacao_id — o open do tipo
       Comparação renderiza o resultado aqui mesmo, à diferença do papel).
       Uma zona: um filtro com o detalhe aberto troca-o como o resto. *@
    <div id="pesoHistoricoDetalhe" class="dmo-zona" data-dmo-regiao>
    @if (Model.HistoricoComparacao is { } detalheComparacao)
    {
      <section class="dmo-card peso-card" aria-labelledby="peso-historico-detalhe-title" style="margin-top:14px">
        <div class="peso-card-heading"><div>
          <h3 id="peso-historico-detalhe-title">Comparação · @detalheComparacao.Reference · @detalheComparacao.ProductionNumber</h3>
          <p class="card-note">CM @detalheComparacao.CmToolReference@(detalheComparacao.CmToolLot is { } detalheLot ? $" · Lote {detalheLot}" : null) · água a @detalheComparacao.WaterTemperatureC °C · gravada em @DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(detalheComparacao.CreatedAtUtc).ToString("dd/MM/yyyy HH:mm")</p>
        </div></div>
        @if (detalheComparacao.Note is { } notaDetalhe)
        {
          <p class="peso-hint">Nota do registo: @notaDetalhe</p>
        }
        @if (detalheComparacao.Comparabilidade is { } comparabilidadeDetalhe)
        {
          <partial name="_PesoNaoComparavel" model="@(new PesoNaoComparavelVista(comparabilidadeDetalhe, null, ComLinks: false))" />
        }
        <div class="peso-resumo">
          <div class="peso-fact"><span>Pares válidos</span><strong>@detalheComparacao.Pares.ParesValidos</strong></div>
          <div class="peso-fact"><span>Δ peso médio dos pares</span><strong>@(detalheComparacao.Pares.DeltaPesoMedioGrams is { } deltaDetalhe ? $"{signed(deltaDetalhe)} g" : "—")</strong></div>
          <div class="peso-fact"><span>Sem contraparte</span><strong>@detalheComparacao.Pares.SemContraparte</strong></div>
        </div>
        <div class="dmo-table-wrap" style="margin-top:12px">
          <table class="dmo-table">
            <thead><tr><th>N.º CM novo</th><th>N.º CM inicial</th><th>Peso novo (g)</th><th>Peso inicial (g)</th><th>Δ peso (g)</th></tr></thead>
            <tbody>
              @foreach (var linha in detalheComparacao.Pares.Rows)
              {
                <tr>
                  <td>@(string.IsNullOrEmpty(linha.CmSubject) ? "—" : linha.CmSubject)</td>
                  <td>@(linha.CmSubjectAnterior ?? "Sem par")</td>
                  <td>@fmt(linha.PesoVidroGrams)</td>
                  <td>@(linha.PesoAnteriorGrams is { } paDetalhe ? fmt(paDetalhe) : "—")</td>
                  <td>@(linha.DeltaPesoGrams is { } dlDetalhe ? signed(dlDetalhe) : "—")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
        @await Component.InvokeAsync("PesoCmDeParte", new { comparacaoId = detalheComparacao.ComparacaoId })
      </section>
    }
    </div>
  </section>

  }

  @* ------------------------------------------------------------------ *@
  @* 0C. A TAB DA COMPARAÇÃO (?comparacao=1): a superfície própria do    *@
  @*    dmo-html — o Peso inicial da produção e as novas leituras dos    *@
  @*    contra-moldes; os pares por posição do CM, o Δ peso médio e o    *@
  @*    «Sem contraparte» — calculados PELO BACKEND.                     *@
  @* ------------------------------------------------------------------ *@
  @if (Model.ComparacaoTab)
  {
    @* COMPARAR E GUARDAR SEM RECARREGAR (deep sweep, 18/10/2026, B-peso-4):
       «Comparar pesos» e «Guardar comparação» vão por fetch (DmoTroca, o
       data-dmo-parcial das leituras) e trocam só as zonas abaixo. Antes eram
       um POST nativo: com a ligação a cair, o operador via a página de erro
       do Chrome, a comparação ficava guardada sem ele saber e voltar atrás
       perdia as massas. Agora fica na página, com a mensagem de ligação no
       canto; o mesmo envio outra vez não guarda duas vezes ([EnvioUnico]) e
       as massas enviadas voltam ao formulário se a confirmação o trocar (ver
       o script abaixo).
       ESCOLHER SEM RECARREGAR (deep sweep 2, 18/10/2026, F-8): a referência
       fica como o operador a deixou (data-dmo-fica) e o formulário vai pelo
       DmoTroca (data-dmo-parcial, pelo ouvinte do Peso abaixo). Trocam só os
       dropdowns da produção e do Peso inicial (zonas dentro do formulário),
       as mensagens e o contexto do Peso inicial (#pesoComparacaoContexto),
       e as leituras, o resultado e a guardada. Antes cada referência,
       produção ou Peso inicial recarregava a página inteira. *@
    <section class="dmo-card peso-card" aria-labelledby="peso-comparacao-title">
      <div class="peso-card-heading"><div>
        <h3 id="peso-comparacao-title">Comparação de Peso</h3>
      </div></div>

      <div id="pesoComparacaoAvisos" class="dmo-zona" data-dmo-regiao>
      @if (Model.ComparacaoRefusal is not null)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.ComparacaoRefusalMessage</div>
      }

      @* A3/A4 (beta.65): uma leitura má já não anula a comparação — fica de
         fora, as outras comparam-se (e gravam-se) e o aviso diz qual. *@
      @if (Model.ComparacaoLeiturasFora.Count > 0)
      {
        <div class="peso-aviso warn" role="status" data-cmp-leituras-fora>
          <strong>@(Model.ComparacaoLeiturasFora.Count == 1 ? "Uma leitura ficou de fora" : $"{Model.ComparacaoLeiturasFora.Count} leituras ficaram de fora")@(Model.ComparacaoRefusal is not null ? "." : Model.ComparacaoLeiturasForaGuardada ? "; a comparação foi guardada sem elas." : "; as outras foram comparadas.")</strong>
          <ul style="margin:6px 0 0;padding-left:18px">
            @foreach (var foraAviso in Model.ComparacaoLeiturasFora)
            {
              <li>@foraAviso.Message</li>
            }
          </ul>
        </div>
      }

      </div>

      @* Produção e Peso inicial (os selects do html): o cascade é um GET
         — com JS auto-submete; sem JS o botão «Mostrar» faz o mesmo. Os
         dropdowns aplicam ao escolher (data-dmo-autosubmit: com as setas,
         só com o Enter ou ao sair do campo). A lista é a das referências
         que começam pelo texto escrito, ou cuja parte BQ começa por ele
         (beta.237), nunca por um pedaço do meio; uma produção que vá no
         pedido e não siga essa regra fica por escolher. *@
      <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
      <form method="get" asp-page="/Controlo/Peso" class="dmo-filter-bar" id="cmpEscolha">
        <input type="hidden" name="comparacao" value="1" />
        <div class="dmo-field">
          <label for="cmpReferencia">Referência</label>
          <input id="cmpReferencia" data-dmo-maiusculas autocapitalize="characters" name="referencia" value="@Model.ReferenciaComparacao" placeholder="Ex.: 1075C142" data-dmo-suggest="referencias" data-dmo-suggest-submit />
        </div>
        <div id="pesoComparacaoProducaoZona" class="dmo-field" data-dmo-regiao>
          <label for="cmpProducao">Produção / Job On</label>
          <select id="cmpProducao" name="jobon_id" data-dmo-autosubmit data-dmo-filter disabled="@(Model.Producoes.Count == 0 ? "disabled" : null)">
            <option value="">@(Model.ReferenciaComparacao is null ? "Indique a referência" : "Selecionar produção")</option>
            @foreach (var producao in Model.Producoes)
            {
              <option value="@producao.JobOnId" selected="@(Model.ProducaoSelecionadaJobOnId == producao.JobOnId ? "selected" : null)">@producao.Label</option>
            }
          </select>
        </div>
        <div id="pesoComparacaoInicialZona" class="dmo-field" data-dmo-regiao>
          <label for="cmpInicial">Peso inicial desta produção</label>
          <select id="cmpInicial" name="peso_inicial" data-dmo-autosubmit>
            @if (Model.Iniciais.Count == 0)
            {
              <option value="">Sem Peso guardado nesta produção</option>
            }
            else
            {
              <option value="">Selecionar registo inicial</option>
            }
            @foreach (var inicial in Model.Iniciais)
            {
              <option value="@inicial.PesoId" selected="@(Model.PesoInicialSelecionado == inicial.PesoId ? "selected" : null)">@rotuloPesoOpcao(inicial)</option>
            }
          </select>
        </div>
        <div class="dmo-field">
          <span class="dmo-label" aria-hidden="true">&nbsp;</span>
          <button type="submit" class="dmo-button">Mostrar</button>
        </div>
      </form>
      </div>

      <div id="pesoComparacaoContexto" class="dmo-zona" data-dmo-regiao>
      @if (Model.ReferenciaComparacaoSemProducoes)
      {
        <div class="peso-aviso warn" role="status" style="margin-top:10px">Sem produções para «@Model.ReferenciaComparacao».</div>
      }

      @* O contexto do Peso inicial (o cmp-initial-context do html): os
         factos humanos do registo escolhido. *@
      @if (Model.Iniciais.FirstOrDefault(i => i.PesoId == Model.PesoInicialSelecionado) is { } inicialEscolhido)
      {
        <div class="peso-facts" style="margin-top:10px">
          <div class="peso-fact"><span>Peso inicial</span><strong>@(inicialEscolhido.PesoMedioGrams is { } pmInicial ? $"{fmt(pmInicial)} g" : "—")</strong></div>
          <div class="peso-fact"><span>CM</span><strong>@(inicialEscolhido.CmToolReference ?? "—")@(inicialEscolhido.CmToolLot is { } lotInicial ? $" · Lote {lotInicial}" : null)</strong></div>
          <div class="peso-fact"><span>Leituras</span><strong>@inicialEscolhido.Leituras</strong></div>
        </div>
      }
      else
      {
        <p class="peso-hint" style="margin-top:10px">Escolha uma produção com um Peso guardado.</p>
      }

      @* A BASE CM a CM (o Diogo, 16/10: «peso e volume dos CM que foram
         medidos»): a diferença de cada CM para a média e quanto ela puxa
         a média — a CM que mais puxa fica marcada. *@
      @if (Model.BaseDaComparacao is { Averages: { } mediasBase } baseCmp && Model.ComparacaoGuardada is null)
      {
        <h4 style="margin:14px 0 6px">Base · média @fmt(mediasBase.AverageGlassWeightGrams) g · @fmt(mediasBase.AverageCapacityCm3) cm³</h4>
        <div class="dmo-table-wrap" data-cmp-base>
          <table class="dmo-table">
            <thead><tr><th>N.º CM</th><th>Massa de água (g)</th><th>Volume (cm³)</th><th>Peso (g)</th><th>Δ para a média (g)</th><th>Puxa a média (g)</th></tr></thead>
            <tbody>
              @foreach (var (leituraBase, influencia) in baseCmp.Measurements.OrderBy(m => m.RowPosition).Zip(Model.InfluenciaDaBase))
              {
                <tr class="@(influencia.MaiorEfeito ? "peso-linha-destaque" : null)">
                  <td>@(string.IsNullOrEmpty(leituraBase.CmSubject) ? "—" : leituraBase.CmSubject)@(influencia.MaiorEfeito ? " · a que mais puxa" : null)</td>
                  <td>@fmt(leituraBase.WaterWeightGrams)</td>
                  <td>@fmt(leituraBase.CapacityCm3)</td>
                  <td>@fmt(leituraBase.GlassWeightGrams)</td>
                  <td>@signed(influencia.DiferencaParaMediaGrams)</td>
                  <td>@signed(influencia.EfeitoNaMediaGrams)</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
        @* Texto para o «?»: «Puxa a média» é a média com a CM menos a média sem ela. *@
      }
      </div>
    </section>

    @* O form das leituras: visível com o peso inicial escolhido — e
       PERMANECE na recusa (o padrão do Job On: o formulário fica como
       estava, a BD inalterada). *@
    <div id="pesoComparacaoLeituras" class="dmo-zona" data-dmo-regiao data-dmo-parcial>
    @if (Model.PesoInicialSelecionado is not null || Model.ComparacaoRefusal is not null)
    {
    <section class="dmo-card peso-card" aria-labelledby="peso-comparacao-leituras-title">
      <div class="peso-card-heading"><div>
        <h3 id="peso-comparacao-leituras-title">Novas leituras dos CM</h3>
      </div>
        @* Os botões no canto superior direito do card (Diogo, 18/10/2026),
           também «Adicionar leitura» e «Remover leitura», que eram por baixo
           das leituras; são do formulário pelo form= (o ouvinte delegado usa
           botao.form). O handler de gravação no backend é a fonte única do
           cálculo. *@
        <div class="dmo-card-topo-acoes">
          <button type="button" class="dmo-button" form="cmpForm" data-cmp-add-row>Adicionar leitura</button>
          <button type="button" class="dmo-button" form="cmpForm" data-cmp-remove-row>Remover leitura</button>
          <button type="submit" class="dmo-button" form="cmpForm">Comparar pesos</button>
          <button type="submit" asp-page-handler="GuardarComparacao" class="dmo-button" form="cmpForm">Guardar comparação</button>
        </div>
      </div>

      <form method="post" asp-page="/Controlo/Peso" asp-page-handler="Comparar" class="peso-form-grid" id="cmpForm">
        <input type="hidden" name="jobon_id" value="@Model.ProducaoSelecionadaJobOnId" />
        <input type="hidden" name="peso_inicial" value="@Model.PesoInicialSelecionado" />
        @* A comparação acabada de guardar: um clique repetido em «Guardar
           comparação» que chega a esta página, sem leituras escritas, volta
           a ela sem mensagem (B-peso-2). *@
        @if (Model.ComparacaoGuardada is { } guardadaNoForm)
        {
          <input type="hidden" name="comparacao_guardada" value="@guardadaNoForm.ComparacaoId" />
          <input type="hidden" name="ignoradas" value="@Request.Query["ignoradas"]" />
        }
        <div class="dmo-field">
          <label for="cmpTool">Contra-molde a pesar</label>
          <select id="cmpTool" name="cm_tool_id" data-dmo-filter>
            <option value="">Selecionar ferramenta CM</option>
            @foreach (var candidato in Model.ContraMoldes)
            {
              <option value="@candidato.ToolId" selected="@(Model.ContraMoldeSelecionado == candidato.ToolId ? "selected" : null)">@candidato.Type.ToString().ToUpperInvariant() @candidato.Reference · Lote @candidato.Lot</option>
            }
          </select>
        </div>
        <div class="dmo-field">
          <label for="cmpTemperature">Temperatura da água (°C)</label>
          <input id="cmpTemperature" name="water_temperature" type="text" inputmode="decimal" autocomplete="off" value="@(Model.TemperaturaSubmetida ?? "20")" placeholder="Ex.: 20,4 ou 20.4" />
        </div>

        @* As leituras dos contra-moldes (o padrão do html: adicionar/
           remover ao vivo; sem JS o form nativo traz quatro linhas — as
           em branco são ignoradas pelo backend). *@
        <div class="peso-leitura-rows peso-cmp-leituras wide" data-cmp-readings>
          @for (var i = 0; i < Model.ComparacaoLinhas.Count; i++)
          {
            <div class="peso-leitura-row" data-cmp-row>
              <div class="dmo-field">
                <label for="cmpSubject-@i">N.º CM</label>
                <input id="cmpSubject-@i" name="cm_subject" value="@Model.ComparacaoLinhas[i].Subject" placeholder="Ex.: 12" />
              </div>
              <div class="dmo-field">
                <label for="cmpWater-@i">Massa de água (g)</label>
                <input id="cmpWater-@i" name="water_weight" type="text" inputmode="decimal" autocomplete="off" value="@Model.ComparacaoLinhas[i].Water" placeholder="Ex.: 199,64 ou 199.64" />
              </div>
              <span class="peso-cmp-x" role="button" tabindex="0" data-cmp-del-row aria-label="Remover esta leitura" title="Remover esta leitura">×</span>
            </div>
          }
        </div>
        <div class="dmo-field" style="max-width:520px;margin-top:10px">
          <label for="cmpNota">Nota (opcional — fica no registo guardado)</label>
          <input id="cmpNota" name="comparacao_note" value="@Model.NotaSubmetida" />
        </div>
      </form>
    </section>
    }
    </div>

    @* O RESULTADO da comparação ao vivo (o POST «Comparar pesos» — sem
       escrita; o cálculo é do backend). *@
    <div id="pesoComparacaoResultado" class="dmo-zona" data-dmo-regiao>
    @if (Model.ResultadoComparacao is { Refusal: PesoComparacaoResultado.Sucesso, Pares: { } paresResultado } resultado)
    {
      <section class="dmo-card peso-card" aria-labelledby="peso-comparacao-resultado-title">
        <div class="peso-card-heading"><div>
          <h3 id="peso-comparacao-resultado-title">Peso do vidro · controlo inicial / novas leituras</h3>
        </div></div>
        @if (resultado.FerramentaDiferente)
        {
          <div class="peso-aviso-simples" role="status" style="margin-top:10px">A referência ou as máquinas possíveis diferem das do CM inicial. Pode continuar esta comparação manualmente.</div>
        }
        @if (resultado.Comparabilidade is { } comparabilidadeResultado)
        {
          <partial name="_PesoNaoComparavel" model="@(new PesoNaoComparavelVista(comparabilidadeResultado, resultado.CmToolId, ComLinks: true))" />
        }
        <div class="peso-resumo" style="margin-top:12px">
          <div class="peso-fact"><span>Peso dos novos CM</span><strong>@(resultado.Medias is { } mediasResultado ? $"{fmt(mediasResultado.AverageGlassWeightGrams)} g" : "—")</strong></div>
          <div class="peso-fact"><span>Peso inicial</span><strong>@(resultado.PesoInicialPesoMedioGrams is { } pmResultado ? $"{fmt(pmResultado)} g" : "—")</strong></div>
          <div class="peso-fact"><span>Pares válidos</span><strong>@paresResultado.ParesValidos</strong></div>
          <div class="peso-fact"><span>Δ peso médio dos pares</span><strong>@(paresResultado.DeltaPesoMedioGrams is { } deltaResultado ? $"{signed(deltaResultado)} g" : "—")</strong></div>
          <div class="peso-fact"><span>Sem contraparte</span><strong>@paresResultado.SemContraparte</strong></div>
        </div>
        <div class="dmo-table-wrap" style="margin-top:12px">
          <table class="dmo-table">
            <thead><tr><th>N.º CM novo</th><th>N.º CM inicial</th><th>Peso novo (g)</th><th>Peso inicial (g)</th><th>Δ peso (g)</th></tr></thead>
            <tbody>
              @foreach (var linha in paresResultado.Rows)
              {
                <tr>
                  <td>@(string.IsNullOrEmpty(linha.CmSubject) ? "—" : linha.CmSubject)</td>
                  <td>@(linha.CmSubjectAnterior ?? "Sem par")</td>
                  <td>@fmt(linha.PesoVidroGrams)</td>
                  <td>@(linha.PesoAnteriorGrams is { } paResultado ? fmt(paResultado) : "—")</td>
                  <td>@(linha.DeltaPesoGrams is { } dlResultado ? signed(dlResultado) : "—")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
        @if (Model.InfluenciaDasNovas.Count > 0 && Model.BaseDaComparacao?.Averages is { } mediasInf)
        {
          <h4 style="margin:14px 0 6px">Efeito na média da base (@fmt(mediasInf.AverageGlassWeightGrams) g)</h4>
          <div class="dmo-table-wrap" data-cmp-influencia>
            <table class="dmo-table">
              <thead><tr><th>N.º CM</th><th>Peso (g)</th><th>Δ para a média (g)</th><th>Média com esta CM (g)</th><th>Efeito na média (g)</th></tr></thead>
              <tbody>
                @foreach (var novaInf in Model.InfluenciaDasNovas)
                {
                  <tr class="@(novaInf.MaiorEfeito ? "peso-linha-destaque" : null)">
                    <td>@(string.IsNullOrEmpty(novaInf.CmSubject) ? "—" : novaInf.CmSubject)@(novaInf.MaiorEfeito ? " · a que mais mexe" : null)</td>
                    <td>@fmt(novaInf.PesoVidroGrams)</td>
                    <td>@signed(novaInf.DiferencaParaMediaGrams)</td>
                    <td>@fmt(novaInf.MediaComEstaCmGrams)</td>
                    <td>@signed(novaInf.EfeitoNaMediaGrams)</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
          @* Texto para o «?»: a CM com o mesmo número na base é substituída
             pela nova leitura; sem par, a nova leitura entra como mais uma. *@
        }
        @if (paresResultado.ParesValidos == 0)
        {
          <p class="peso-hint">Sem pares para deltas — os números de CM não coincidem com os do Peso inicial. A comparação continua válida; os pesos ficam lado a lado.</p>
        }
        <p class="peso-hint">@DMO.Alpha.Core.Runtime.DmoNumberFormat.Contagem(resultado.Leituras.Count, "CM medido", "CM medidos"). Pré-visualização não guardada: usa «Guardar comparação» para registar.</p>
      </section>
    }
    </div>

    @* O REGISTO GUARDADO (?comparacao_id — o PRG do Guardar aterra com o
       resultado a partir do PERSISTIDO: os inputs congelados e os pares). *@
    <div id="pesoComparacaoGuardada" class="dmo-zona" data-dmo-regiao>
    @if (Model.ComparacaoGuardada is { } guardada)
    {
      <section class="dmo-card peso-card" aria-labelledby="peso-comparacao-guardada-title">
        <div class="peso-card-heading"><div>
          <h3 id="peso-comparacao-guardada-title">Comparação guardada · @guardada.Reference · @guardada.ProductionNumber</h3>
          <p class="card-note">CM @guardada.CmToolReference@(guardada.CmToolLot is { } lotGuardada ? $" · Lote {lotGuardada}" : null) · água a @guardada.WaterTemperatureC °C · gravada em @DMO.Alpha.Core.Runtime.DmoBusinessTime.ToLocal(guardada.CreatedAtUtc).ToString("dd/MM/yyyy HH:mm")@(guardada.Note is { } notaGuardada ? $" · nota: {notaGuardada}" : null)</p>
        </div></div>
        @if (guardada.Comparabilidade is { } comparabilidadeGuardada)
        {
          <partial name="_PesoNaoComparavel" model="@(new PesoNaoComparavelVista(comparabilidadeGuardada, null, ComLinks: false))" />
        }
        <div class="peso-resumo">
          <div class="peso-fact"><span>Peso dos novos CM</span><strong>@(guardada.Medias is { } mediasGuardada ? $"{fmt(mediasGuardada.AverageGlassWeightGrams)} g" : "—")</strong></div>
          <div class="peso-fact"><span>Pares válidos</span><strong>@guardada.Pares.ParesValidos</strong></div>
          <div class="peso-fact"><span>Δ peso médio dos pares</span><strong>@(guardada.Pares.DeltaPesoMedioGrams is { } deltaGuardada ? $"{signed(deltaGuardada)} g" : "—")</strong></div>
          <div class="peso-fact"><span>Sem contraparte</span><strong>@guardada.Pares.SemContraparte</strong></div>
        </div>
        <div class="dmo-table-wrap" style="margin-top:12px">
          <table class="dmo-table">
            <thead><tr><th>N.º CM novo</th><th>N.º CM inicial</th><th>Peso novo (g)</th><th>Peso inicial (g)</th><th>Δ peso (g)</th></tr></thead>
            <tbody>
              @foreach (var linha in guardada.Pares.Rows)
              {
                <tr>
                  <td>@(string.IsNullOrEmpty(linha.CmSubject) ? "—" : linha.CmSubject)</td>
                  <td>@(linha.CmSubjectAnterior ?? "Sem par")</td>
                  <td>@fmt(linha.PesoVidroGrams)</td>
                  <td>@(linha.PesoAnteriorGrams is { } paGuardada ? fmt(paGuardada) : "—")</td>
                  <td>@(linha.DeltaPesoGrams is { } dlGuardada ? signed(dlGuardada) : "—")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
        @if (Model.InfluenciaDasNovas.Count > 0 && Model.BaseDaComparacao?.Averages is { } mediasInf)
        {
          <h4 style="margin:14px 0 6px">Efeito na média da base (@fmt(mediasInf.AverageGlassWeightGrams) g)</h4>
          <div class="dmo-table-wrap" data-cmp-influencia>
            <table class="dmo-table">
              <thead><tr><th>N.º CM</th><th>Peso (g)</th><th>Δ para a média (g)</th><th>Média com esta CM (g)</th><th>Efeito na média (g)</th></tr></thead>
              <tbody>
                @foreach (var novaInf in Model.InfluenciaDasNovas)
                {
                  <tr class="@(novaInf.MaiorEfeito ? "peso-linha-destaque" : null)">
                    <td>@(string.IsNullOrEmpty(novaInf.CmSubject) ? "—" : novaInf.CmSubject)@(novaInf.MaiorEfeito ? " · a que mais mexe" : null)</td>
                    <td>@fmt(novaInf.PesoVidroGrams)</td>
                    <td>@signed(novaInf.DiferencaParaMediaGrams)</td>
                    <td>@fmt(novaInf.MediaComEstaCmGrams)</td>
                    <td>@signed(novaInf.EfeitoNaMediaGrams)</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
          @* Texto para o «?»: a CM com o mesmo número na base é substituída
             pela nova leitura; sem par, a nova leitura entra como mais uma. *@
        }
        @await Component.InvokeAsync("PesoCmDeParte", new { comparacaoId = guardada.ComparacaoId })
      </section>
    }
    </div>
  }

  @* ------------------------------------------------------------------ *@
  @* 1P. CORTE C — o modo production-scoped: o contexto herdado.         *@
  @*    As ferramentas NUNCA são escolhidas nesta folha.                 *@
  @* ------------------------------------------------------------------ *@
  @if (Model.ProductionContext is { } productionCtx)
  {
    <section class="dmo-card peso-card" aria-labelledby="peso-production-title">
      <div class="peso-card-heading"><div>
        <h3 id="peso-production-title">Produção @productionCtx.ProductionNumber</h3>
      </div>
        @* A superfície própria da comparação (a secção comparacao do
           dmo-html): o atalho da folha, no canto superior direito do card;
           o aterrismo pré-seleciona a produção e o peso inicial dela. *@
        @* Um só cartão (Diogo, 21/10/2026: «deixar apenas o card de cima»):
           o «Exportar PDF» e o «Abrir o Peso atual» do Peso aberto vivem
           aqui, à direita da «Comparação de Peso». *@
        <div class="dmo-card-topo-acoes">
          @if (Model.Peso is { } pesoDoTopo && Model.PesoAnterior && Model.PesoAtual is not null)
          {
            <a class="dmo-button" href="/Controlo/Peso?controlo_id=@pesoDoTopo.ControloId">Abrir o Peso atual</a>
          }
          <a class="dmo-button" href="/Controlo/Peso?controlo_id=@Model.ControloIdFromQuery&comparacao=1@(Model.PesoIdNoEndereco is { } comparacaoPesoInicial ? $"&peso_inicial={comparacaoPesoInicial}" : null)">Comparação de Peso</a>
          @* O «Comparar peso» (Diogo, 27/10/2026): abre ao lado as CM compatíveis
             e o tampão simulado (PesoComparar). *@
          @if (Model.Peso is { } pesoComparar)
          {
            <a class="dmo-button" href="/Controlo/PesoComparar?peso_id=@pesoComparar.PesoId">Comparar peso</a>
          }
          @if (Model.Peso is not null)
          {
            <button type="submit" class="dmo-button" form="pesoPdfForm">Exportar PDF</button>
          }
        </div>
      </div>

      @* A referência é o campo DO JOB ON (o Owner 2026-10-12: «esta
         informação é retirada do jobon_id, entao app nao precis de
         verificar se esta certo ou nao apenas inserir os dados do jobon
         nos sitios correctos») — o campo direto, sem composição nem
         verificação: o operador digitou a referência total na criação.
         O CARTÃO: o nº, a referência total, a máquina, a CM COM O SEU
         LOTE (a ferramenta física: 1075C142 e ST100 são factos
         distintos), o processo — o MF e a Boquilha não se repetem.
         Um Peso de antes de uma troca da CM ou da BQ (18/10/2026) mostra a
         CM e os valores congelados nele, os que o cálculo dele usou. *@
      @{
        var pesoDeAntes = Model.PesoAnterior ? Model.Peso : null;
      }
      <div class="peso-facts peso-context-grid">
        <div class="peso-fact"><span>Nº de produção</span><strong>@productionCtx.ProductionNumber</strong></div>
        <div class="peso-fact"><span>Referência</span><strong>@productionCtx.Reference</strong></div>
        <div class="peso-fact"><span>Máquina</span><strong>@productionCtx.Machine</strong></div>
        <div class="peso-fact"><span>CM</span><strong>@(pesoDeAntes is not null ? pesoDeAntes.CmToolReference ?? "—" : Model.CmTool?.Reference ?? "—")</strong></div>
        <div class="peso-fact"><span>Lote da CM</span><strong>@(pesoDeAntes is not null ? pesoDeAntes.CmToolLot ?? "—" : Model.CmTool?.Lot ?? Model.Peso?.CmToolLot ?? "—")</strong></div>
        <div class="peso-fact"><span>Processo</span><strong>@(Model.Peso?.Process ?? cmProcessLabel(Model.CmTechnical?.Process))</strong></div>
      </div>

      @* O PAINEL DE FACTOS (o renderFacts do dmo-html): os volumes da BQ
         (marisa) e da CM (punção), a densidade do vidro com o processo da
         CM visível e o botão do apoio TP/calote — APOIO SEPARADO: o
         cálculo é do backend (a query canónica + PesoCapCalculation) e
         NUNCA bloqueia o Peso. *@
      <div class="peso-facts" style="margin-top:10px">
        <div class="peso-fact"><span>Volume Marisa / BQ (cm³)</span><strong>@((pesoDeAntes?.VolumeMarisaCm3 ?? Model.BqTechnical?.VolumeMarisaCm3) is { } painelMarisa ? fmt(painelMarisa) : "—")</strong></div>
        <div class="peso-fact"><span>Volume Punção / CM (cm³)</span><strong>@((pesoDeAntes?.VolumePuncaoCm3 ?? Model.CmTechnical?.VolumePuncaoCm3) is { } painelPuncao ? fmt(painelPuncao) : "—")</strong></div>
        <div class="peso-fact">
          <span>Densidade do vidro (g/cm³)</span>
          <strong>@((pesoDeAntes?.GlassDensityGramsPerCm3 ?? Model.ConfiguredGlassDensity) is { } painelDensidade ? fmtDensity(painelDensidade) : "—")</strong>
          <small>@(pesoDeAntes is not null ? pesoDeAntes.Process : cmProcessLabel(Model.CmTechnical?.Process))</small>
        </div>
        @* O APOIO TP/CALOTE (o «TP / calote · Apoio separado» do dmo-html):
           abre-se com a calote efetiva — a do Job On quando existe, senão a
           h_ref da Tool — calculada PELO BACKEND; a simulação (cap_h) é um
           GET do backend, nunca matemática no browser e nunca gravada. Sem
           JS tudo funciona pelo form nativo (progressive enhancement).
           O apoio fica como o operador o deixou (data-dmo-fica): aberto e
           com a calote simulada, depende de cap_h no endereço, e a gravação
           ou a comparação seguinte não o trazem. Sem isto, a primeira troca
           depois do «Calcular» abria a página inteira. *@
        <div class="dmo-zona" data-dmo-fica>
        <details class="tp-support" data-cap-url="@Url.Page("/Controlo/Peso", "CapSupport")" data-cap-params="controlo_id=@Model.ControloIdFromQuery@(Model.PesoIdNoEndereco is { } capPesoParam ? $"&peso_id={capPesoParam}" : null)" open="@(Model.CapAberto ? "open" : null)">
          <summary class="tp-button">
            <span><span class="dmo-caret" aria-hidden="true"></span>TP / calote · Apoio separado</span>
            @if (Model.CapSupport is { TemReferencia: true } botaoCap)
            {
              <strong>@(fmtCap(botaoCap.VolumeEfetivoCm3)) cm³</strong>
              <small>D @(fmtCap(botaoCap.DiametroMm)) · h @(fmtCap(botaoCap.AlturaEfetivaMm)) · @botaoCap.OrigemCalote</small>
            }
            else
            {
              <strong>Referência por completar</strong>
              <small>Não bloqueia o Peso</small>
            }
          </summary>
          <div class="tp-support-body">
            @if (Model.CapSupport is { TemReferencia: true } apoioCap)
            {
              @* «h referencia fica nominal, o efetivo fica jobon»; «por baixo
                 apenas mostramos volume do nominal, volume do jobon e o delta»
                 (Diogo, 26/10/2026): a origem do h vai para a dica. *@
              <div class="peso-facts">
                <div class="peso-fact"><span>D</span><strong>@(fmtCap(apoioCap.DiametroMm)) mm</strong></div>
                <div class="peso-fact"><span>h nominal</span><strong>@(fmtCap(apoioCap.AlturaReferenciaMm)) mm</strong></div>
                <div class="peso-fact"><span>@(RotuloH(apoioCap.OrigemCalote))<partial name="_DmoHelp" model="@($"Origem do h: {apoioCap.OrigemCalote}. O volume calcula-se com o D e o h; não é aplicada uma tolerância oculta.")" /></span><strong>@(SemJobOn(apoioCap) ? "—" : fmtCap(apoioCap.AlturaEfetivaMm) + " mm")</strong></div>
              </div>
              <div class="peso-facts" data-cap-result>
                <div class="peso-fact"><span>Volume nominal</span><strong>@(fmtCap(apoioCap.VolumeReferenciaCm3)) cm³</strong></div>
                <div class="peso-fact"><span>Volume @(RotuloH(apoioCap.OrigemCalote)[2..])</span><strong>@(SemJobOn(apoioCap) ? "—" : fmtCap(apoioCap.VolumeEfetivoCm3) + " cm³")</strong></div>
                <div class="peso-fact"><span>Δ volume</span><strong>@(SemJobOn(apoioCap) ? "—" : fmtCapSigned(apoioCap.DeltaVolumeCm3) + " cm³")</strong></div>
              </div>
              <form method="get" asp-page="/Controlo/Peso" class="tp-sim-form">
                @* O «Calcular» abre a folha de novo: leva a comparação e o
                   «Supomos» escolhidos, para não se perderem. Escolhem-se sem
                   recarregar, por isso estes campos são uma zona. *@
                <div id="pesoCapContexto" class="dmo-zona" data-dmo-regiao>
                  <input type="hidden" name="controlo_id" value="@Model.ControloIdFromQuery" />
                  @if (Model.PesoIdNoEndereco is { } capPesoId)
                  {
                    <input type="hidden" name="peso_id" value="@capPesoId" />
                  }
                  @if (Model.Comparison is { } capComparison)
                  {
                    <input type="hidden" name="comparar" value="@capComparison.HistoricalPesoId" />
                  }
                  @if (Model.SuporCaloteParaLevar is { } capSupor)
                  {
                    <input type="hidden" name="supor_calote" value="@capSupor" />
                  }
                </div>
                <div class="dmo-field">
                  <label for="capSimulada">Calote simulada h (mm)</label>
                  <input id="capSimulada" name="cap_h" type="text" inputmode="decimal" autocomplete="off"
                         value="@(Model.CapSimulada is { } simulada ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2SemPerda(simulada) : (apoioCap.AlturaEfetivaMm is { } efetiva ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2SemPerda(efetiva) : null))"
                         placeholder="Usar @apoioCap.OrigemCalote" />
                </div>
                <div class="dmo-field">
                  <span class="dmo-label" aria-hidden="true">&nbsp;</span>
                  <button type="submit" class="dmo-button">Calcular</button>
                </div>
              </form>
            }
            else
            {
              <div class="peso-aviso-simples" role="status">Complete o diâmetro e a calote do tampão na Folha do Job On (bloco TP). O Peso pode continuar sem este apoio.@if (productionCtx.JobOnId > 0) {<partial name="_DmoAvisoLink" model="@DmoAvisoLink.JobOn(productionCtx.JobOnId, "Completar no Job On", editar: true)" />}</div>
            }
            @if (Model.CapSimuladaIlegivel)
            {
              <div class="peso-aviso-simples" role="status" style="margin-top:10px">O valor da calote simulada não é utilizável — escreve uma calote em mm (0 ou mais). O apoio segue com o h efetivo.</div>
            }
          </div>
        </details>
        </div>
      </div>

      @* Os avisos que vêm no endereço (?associado, recusas): uma zona, para a
         primeira leitura gravada depois deles não abrir a página inteira. *@
      <div id="pesoProducaoAvisos" class="dmo-zona" data-dmo-regiao>
      @if (Model.ProductionRefusal is not null)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.ProductionRefusalMessage</div>
      }

      @if (Model.PesoAssociated && Model.Peso is not null)
      {
        <div data-dmo-toast="ok" class="peso-aviso-simples" role="status">Peso associado a esta produção. O mesmo registo aparece agora no Resumo do Controlo.</div>
      }

      @if (Model.AssociationRefusal is not null)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.AssociationRefusalMessage</div>
      }

      @if (Model.MeasurementRefusal is not null && Model.Peso is null)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.MeasurementRefusalMessage</div>
      }
      </div>

      @* A ASSOCIAÇÃO POSTERIOR (o Owner 2026-10-16: «quando existir um
         jobon com CM_ID que usa o tool_id perguntar se quero associar»):
         os Pesos sem produção desta CM são propostos; associar é o botão
         explícito, e criar um Peso novo continua disponível em baixo.
         Nas tabelas NÃO EXISTEM botões (o Owner 2026-10-12): um clique
         escolhe a linha (o rádio escondido, peso_id) e o duplo clique abre o
         Peso (a lista tem um bloco de ações fora, data-dmo-for); o único
         «Associar a esta produção» fica no canto superior direito do cartão
         (Diogo, 18/10/2026) e envia o formulário (form=).
         Com um só Peso, a linha já vem escolhida; com vários, sem escolha
         o browser pede que se escolha uma linha (required).
         Depois de uma troca da CM ou da BQ (a produção já tem um Peso), os
         propostos são os da CM e da BQ que a produção tem ou teve antes da
         troca, cuja combinação ainda não tem Peso (resposta R16-6 do
         especialista, 18/10/2026). *@
      @if (Model.Peso is null && Model.AssociationCandidates.Count > 0)
      {
        var umSoCandidato = Model.AssociationCandidates.Count == 1;
        var depoisDaTroca = Model.Pesos.Count > 0;
        <section class="dmo-card peso-card" aria-labelledby="peso-associate-title" style="margin-top:14px">
          <div class="peso-card-heading"><div>
            <h3 id="peso-associate-title">@(depoisDaTroca ? "Pesos sem produção destas ferramentas" : "Pesos sem produção desta CM")<partial name="_DmoHelp" model="@("Um clique escolhe o Peso; duplo clique abre-o.")" /></h3>
            <p class="card-note">@(Model.AssociationCandidates.Count == 1 ? "Existe um Peso" : $"Existem {Model.AssociationCandidates.Count} Pesos") registado@(Model.AssociationCandidates.Count == 1 ? "" : "s") com @(depoisDaTroca ? "a CM e a BQ que esta produção tem ou teve antes da troca" : "a CM deste Job On") e ainda sem produção. Quer associar a esta produção?</p>
          </div>
            <div class="dmo-card-topo-acoes" data-dmo-for="pesoAssociateList"><button type="submit" class="dmo-button" form="pesoAssociateForm">Associar a esta produção</button></div>
          </div>
          <form method="post" asp-page="/Controlo/Peso" asp-page-handler="Associate" id="pesoAssociateForm">
            <input type="hidden" name="controlo_id" value="@Model.ControloIdFromQuery" />
            <div class="dmo-table-wrap">
              <table class="dmo-table" id="pesoAssociateList" data-dmo-list="Pesos sem produção">
                <thead>
                  <tr><th></th><th>Peso</th><th>CM</th><th>BQ</th><th>Leituras</th></tr>
                </thead>
                <tbody>
                  @foreach (var candidate in Model.AssociationCandidates)
                  {
                    <tr data-dmo-row data-id="@candidate.PesoId" data-dmo-open="/Controlo/Peso?peso_id=@candidate.PesoId"
                        class="@(umSoCandidato ? "selected" : null)" aria-selected="@(umSoCandidato ? "true" : "false")"
                        aria-label="Peso @candidate.PesoId — um clique escolhe, duplo clique abre">
                      <td><input type="radio" name="peso_id" value="@candidate.PesoId" required checked="@umSoCandidato" aria-label="Peso @candidate.PesoId" /></td>
                      <td>Peso @candidate.PesoId</td>
                      <td>@(candidate.CmReference ?? "—")@(candidate.CmLot is { } cmLot ? $" · Lote {cmLot}" : "")</td>
                      <td>@(candidate.BqReference ?? "—")@(candidate.BqLot is { } bqLot ? $" · Lote {bqLot}" : "")</td>
                      <td>@candidate.MeasurementCount</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </form>
        </section>
      }

      @if (Model.Peso is null && productionCtx.CmToolId is not null && productionCtx.BqToolId is not null)
      {
        @* O Peso baseline desta produção ainda não existe: o formulário
           pede a temperatura medida e completa os técnicos em falta (regra
           Ferramentas: gravam no tool_id owner). O get-or-open é
           idempotente — o MESMO peso_id volta sempre. *@
        <section class="dmo-card peso-card" aria-labelledby="peso-create-production-title" style="margin-top:14px">
          <div class="peso-card-heading"><div>
            <h3 id="peso-create-production-title">Novo Peso da produção</h3>
            @* Depois de trocar a CM ou a BQ a meio da produção (18/10/2026):
               as ferramentas novas têm o seu Peso, e o anterior fica como
               estava, na lista «Pesos desta produção». *@
            @if (Model.FerramentasMudaramTexto is { } ferramentasMudaram)
            {
              <p class="card-note" data-peso-ferramentas-mudaram>@ferramentasMudaram nesta produção; @(Model.Pesos.Count == 1 ? "o Peso anterior ficou como estava" : "os Pesos anteriores ficaram como estavam").</p>
            }
          </div>
            <div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" form="pesoCreateForControlo">Criar Peso</button></div>
          </div>

          <form method="post" asp-page="/Controlo/Peso" asp-page-handler="CreateForControlo" class="peso-form-grid" id="pesoCreateForControlo">
            <input type="hidden" name="controlo_id" value="@Model.ControloIdFromQuery" />
            <div class="dmo-field">
              <label for="waterTemperature">Temperatura da água (°C)</label>
              <input id="waterTemperature" name="water_temperature" type="text" inputmode="decimal" autocomplete="off" required placeholder="Ex.: 20,4 ou 20.4" value="@Model.EchoTemperature" />
            </div>
            @if (Model.CmTechnical?.Process is null)
            {
              <div class="dmo-field">
                <label for="cmProcess">Processo da CM (em falta)</label>
                <select id="cmProcess" name="cm_process" required>
                  <option value="">Selecionar</option>
                  <option value="NNPB" selected="@(Model.EchoCmProcess == "NNPB" ? "selected" : null)">NNPB</option>
                  <option value="PS" selected="@(Model.EchoCmProcess == "PS" ? "selected" : null)">PS</option>
                </select>
              </div>
            }
            @if (Model.CmTechnical?.VolumePuncaoCm3 is null)
            {
              <div class="dmo-field">
                <label for="cmVolumePuncao">Volume punção cm³ (em falta)</label>
                <input id="cmVolumePuncao" name="cm_volume_puncao" type="text" inputmode="decimal" autocomplete="off" required placeholder="Ex.: 70,00 ou 70.00" value="@Model.EchoVolumePuncao" />
              </div>
            }
            @if (Model.CmTechnical?.NominalWeightGrams is null)
            {
              <div class="dmo-field">
                <label for="cmNominalWeight">Peso nominal g (opcional)</label>
                <input id="cmNominalWeight" name="cm_nominal_weight" type="text" inputmode="decimal" autocomplete="off" placeholder="Ex.: 200,00 ou 200.00" value="@Model.EchoNominalWeight" />
              </div>
            }
            @if (Model.BqTechnical?.VolumeMarisaCm3 is null)
            {
              <div class="dmo-field">
                <label for="bqVolumeMarisa">Volume marisa cm³ (em falta)</label>
                <input id="bqVolumeMarisa" name="bq_volume_marisa" type="text" inputmode="decimal" autocomplete="off" required placeholder="Ex.: 10,00 ou 10.00" value="@Model.EchoVolumeMarisa" />
              </div>
            }
            <div class="peso-form-grid wide" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-top:12px">
              <div class="peso-fact"><span>Densidade da água</span><strong>Tabela de densidades (5–35 °C, grau inteiro)</strong></div>
              <div class="peso-fact">
                <span>Densidade do vidro</span>
                <strong>@(Model.ConfiguredGlassDensity is { } density ? $"{fmtDensity(density)} g/cm³" : "não configurada")</strong>
              </div>
            </div>
          </form>
        </section>
      }
      else if (Model.Peso is null)
      {
        @* Sem CM ou sem BQ no Job On o «Novo Peso da produção» não aparece
           (o cálculo precisa das duas): o aviso diz porquê em vez de a
           secção desaparecer sem explicação. *@
        <div class="peso-aviso warn" role="status" style="margin-top:14px" data-peso-sem-ferramentas>
          O «Novo Peso da produção» não aparece porque o Job On desta produção não tem @(productionCtx.CmToolId is null && productionCtx.BqToolId is null ? "CM nem boquilha (BQ)" : productionCtx.CmToolId is null ? "CM" : "boquilha (BQ)"). O cálculo do Peso precisa das duas ferramentas: complete o Job On e volte a esta folha.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.JobOn(productionCtx.JobOnId, "Editar o Job On", editar: true)" />
        </div>
      }
    </section>
  }
  else if (!Model.HistoricoTab && !Model.ComparacaoTab)
  {
  @* ------------------------------------------------------------------ *@
  @* 0. Novo Peso: sem Job On (as ferramentas escritas à mão) ou         *@
  @*    associado a um Job On (a produção abre pelo seu controlo_id e   *@
  @*    CM, BQ e calote vêm do Job On).                                  *@
  @* ------------------------------------------------------------------ *@
  @if (Model.ModoJobOn)
  {
  <section class="dmo-card peso-card" aria-labelledby="peso-jobon-title">
    <div class="dmo-modo-head">
      <h3 id="peso-jobon-title">Job On<partial name="_DmoHelp" model="@("CM, boquilha (BQ) e calote vêm do Job On escolhido.")" /></h3>
      @if (Model.Peso is null)
      {
        <partial name="_ControloModoRegisto" model="@(("/Controlo/Peso", true))" />
      }
    </div>
    @* SEM RECARREGAR E NUMA LINHA (deep sweep 2, 18/10/2026, F-8 e F-9):
       como nos Pegamentos (_PegamentosEscolhaJobOn). A referência, a
       máquina e a produção na mesma linha, com a largura do que levam; a
       procura fica (data-dmo-fica) e vai pelo DmoTroca (data-dmo-parcial),
       e trocam só a recusa, a produção e a mensagem. O dropdown da produção
       é do formulário POST de baixo (form=), que abre a folha da produção
       como sempre (data-dmo-nativo). Enquanto a referência escrita não é a
       das produções, o dropdown fica desativado (data-dmo-depende). *@
    <div id="pesoJobOnAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.JobOnEscolhaRefusal is { } jobOnRecusa)
    {
      <div class="peso-aviso" role="alert">@jobOnRecusa</div>
    }
    </div>
    <div class="dmo-zona" data-dmo-fica data-dmo-parcial>
    <form method="get" asp-page="/Controlo/Peso" class="dmo-filter-bar dmo-filter-bar-conteudo" id="pesoJobOnProcura">
      <input type="hidden" name="modo" value="@PesoModel.ModoJobOnValor" />
      <div class="dmo-field">
        <label for="pesoJobOnReferencia">Referência</label>
        <input id="pesoJobOnReferencia" name="referencia" value="@Model.JobOnReferencia" placeholder="Ex.: 5810" autocomplete="off" required data-dmo-maiusculas autocapitalize="characters" data-dmo-suggest="referencias" data-dmo-suggest-submit />
      </div>
      <div class="dmo-field dmo-field-maquina">
        <label for="pesoJobOnMaquina">Máquina</label>
        <select id="pesoJobOnMaquina" name="maquina" data-dmo-autosubmit>
          <option value="">Todas</option>
          @foreach (var maquinaOpcao in Model.Maquinas)
          {
            <option value="@maquinaOpcao" selected="@(string.Equals(Model.JobOnMaquina, maquinaOpcao, StringComparison.Ordinal) ? "selected" : null)">@maquinaOpcao</option>
          }
        </select>
      </div>
      @* Escolher a referência ou a máquina procura logo (sem «Procurar»),
         como nos Pegamentos. A produção é uma zona que existe sempre,
         escondida sem produções; escolhê-la abre-a (sem «Abrir produção»). *@
      <div id="pesoJobOnProducaoZona" class="dmo-field dmo-field-producao" data-dmo-regiao hidden="@(Model.JobOnReferencia is not null && Model.ProducoesJobOn.Count > 0 ? null : "hidden")">
      @if (Model.JobOnReferencia is not null && Model.ProducoesJobOn.Count > 0)
      {
        <label for="pesoJobOn">Produção</label>
        <select id="pesoJobOn" name="jobon_id" form="pesoJobOnEscolha" required data-dmo-autosubmit="valor" data-dmo-depende="pesoJobOnReferencia" data-dmo-depende-valor="@Model.JobOnReferencia">
          <option value="">Escolher produção</option>
          @foreach (var producao in Model.ProducoesJobOn)
          {
            <option value="@producao.JobOnId">@producao.ProductionNumber · @producao.Machine</option>
          }
        </select>
      }
      </div>
    </form>
    <div id="pesoJobOnVazia" data-dmo-regiao>
    @if (Model.JobOnReferencia is { } referenciaProcurada && Model.ProducoesJobOn.Count == 0)
    {
      <div class="peso-aviso-simples" role="status" style="margin-top:12px">@(Model.JobOnMaquina is { } maquinaProcurada ? $"Não há Job Ons da referência {referenciaProcurada} na máquina {maquinaProcurada}." : $"Não há Job Ons da referência {referenciaProcurada}.") Crie o Job On primeiro ou use «Sem Job On».<partial name="_DmoAvisoLink" model="@DmoAvisoLink.CriarJobOn(referenciaProcurada)" /></div>
    }
    </div>
    <form method="post" asp-page="/Controlo/Peso" asp-page-handler="AbrirJobOn" id="pesoJobOnEscolha" data-dmo-nativo></form>
    </div>
  </section>
  }
  else
  {
  @* ------------------------------------------------------------------ *@
  @* 1. Ferramentas da pesagem: escolha pela REFERÊNCIA humana (P2-5 —  *@
  @*    o operador escreve o que vê nas folhas: ST100, C142).            *@
  @* ------------------------------------------------------------------ *@
  @* Com o Peso iniciado, as referências já não se escrevem: o cartão sai
     (Diogo, 27/10/2026: «depois de iniciar o peso não devia aparecer isto»). *@
  @if (Model.Peso is null)
  {
  <section class="dmo-card peso-card" aria-labelledby="peso-tools-title">
    <div class="dmo-modo-head">
      <h3 id="peso-tools-title">Ferramentas</h3>
      @if (Model.Peso is null && Model.ComparacaoDePesoId is null)
      {
        <partial name="_ControloModoRegisto" model="@(("/Controlo/Peso", false))" />
      }
    </div>
    @if (Model.ComparacaoDePesoId is not null)
    {
      <p class="card-note" data-peso-so-comparacao>Peso só para comparação: não fica associado a nenhum Job On.</p>
    }
    <form method="get" asp-page="/Controlo/Peso" class="dmo-filter-bar">
      @if (Model.ComparacaoDePesoId is { } comparacaoDeFerramentas)
      {
        <input type="hidden" name="comparacao_de" value="@comparacaoDeFerramentas" />
      }
      <div class="dmo-field">
        <label for="cmToolId">CM — referência</label>
        <input id="cmToolId" name="cm_tool_id" value="@Model.RequestedCmToolId" placeholder="Ex.: ST100" data-dmo-suggest="ferramentas" data-dmo-suggest-tipo="cm" data-dmo-suggest-submit />
      </div>
      <partial name="_PegamentosLote" model="@(("cmToolId", "cm_lote", "CM — lote", Model.CmLotes, Model.CmTool?.ToolId, Model.RequestedCmToolId))" />
      <div class="dmo-field">
        <label for="bqToolId">Boquilha (BQ) — referência</label>
        <input id="bqToolId" name="bq_tool_id" value="@Model.RequestedBqToolId" placeholder="Ex.: C142" data-dmo-suggest="ferramentas" data-dmo-suggest-tipo="bq" data-dmo-suggest-submit />
      </div>
      @* O lote da BQ só quando os lotes têm marisas diferentes (Diogo, 27/10/2026). *@
      <partial name="_PegamentosLote" model="@(("bqToolId", "bq_lote", "BQ — lote", Model.BqLotes, Model.BqTool?.ToolId, Model.RequestedBqToolId))" />
      @* Escolher a sugestão ou o Enter mostram a ferramenta (como nos
         Pegamentos); o botão fica só sem script. *@
      <noscript><button type="submit" class="dmo-button">Ferramentas</button></noscript>
    </form>

    @* AS FERRAMENTAS NUMA FAIXA (Diogo, 27/10/2026: o cartão estava
       desarrumado): a CM e a BQ escolhidas numa só linha, como a
       «Combinação» do estudo do Controlo, sem o tipo repetido por baixo da
       referência. Com as duas, os volumes ficam só na faixa de baixo; com
       uma só, ficam aqui (Diogo, 27/10/2026, cartão de decisão). P2-4: o facto da ferramenta é a REFERÊNCIA humana
       (o que as folhas mostram); o id opaco vive no registo e no POST. *@
    @{ var ambasFerramentas = Model.CmTool is not null && Model.BqTool is not null; }
    @if (Model.CmTool is not null || Model.BqTool is not null)
    {
      <div class="peso-facts" data-peso-ferramentas>
        @if (Model.CmTool is { } cmTool)
        {
          <div class="peso-fact"><span>CM</span><strong>@cmTool.Reference</strong></div>
          <div class="peso-fact"><span>Lote</span><strong>@cmTool.Lot</strong></div>
          <div class="peso-fact"><span>Processo</span><strong>@cmProcessLabel(Model.CmTechnical?.Process)</strong></div>
          @if (!ambasFerramentas)
          {
            <div class="peso-fact"><span>Volume punção (cm³)</span><strong>@(Model.CmTechnical?.VolumePuncaoCm3 is { } vp ? fmt(vp) : "—")</strong></div>
          }
          <div class="peso-fact"><span>Peso nominal (g)</span><strong>@(Model.CmTechnical?.NominalWeightGrams is { } nw ? fmt(nw) : "—")</strong></div>
        }
        @if (Model.BqTool is { } bqTool)
        {
          <div class="peso-fact peso-fact-grupo"><span>Boquilha (BQ)</span><strong>@bqTool.Reference</strong></div>
          @if (!ambasFerramentas)
          {
            <div class="peso-fact"><span>Volume marisa (cm³)</span><strong>@(Model.BqTechnical?.VolumeMarisaCm3 is { } vm ? fmt(vm) : "—")</strong></div>
          }
        }
      </div>
    }
    @if (Model.CmToolRequestedNotFound)
    {
      <div class="peso-aviso-simples" role="alert">A referência da CM indicada não está registada no Ferramentas. Nenhum Peso pode ser criado para ela.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.RegistarFerramenta("CM", Model.RequestedCmToolId, "Registar a CM em Ferramentas")" /></div>
    }
    @if (Model.BqMarisasDiferentes)
    {
      <div class="peso-aviso-simples" role="status" data-peso-bq-marisas>Os lotes desta boquilha (BQ) têm volumes de marisa diferentes: escolha o lote.</div>
    }
    @if (Model.BqToolRequestedNotFound)
    {
      <div class="peso-aviso-simples" role="alert">A referência da boquilha (BQ) indicada não está registada no Ferramentas.<partial name="_DmoAvisoLink" model="@DmoAvisoLink.RegistarFerramenta("BQ", Model.RequestedBqToolId, "Registar a BQ em Ferramentas")" /></div>
    }

    @* O PAINEL DE FACTOS no modo tool-scoped (as duas ferramentas
       resolvidas): os volumes consolidados com a densidade do vidro e o
       processo da CM, e o apoio TP/calote — sem Job On, a calote efetiva
       é a h_ref da Tool (o html: «Tool CM»). O apoio nunca bloqueia. *@
    @if (ambasFerramentas)
    {
      <div class="peso-facts">
        <div class="peso-fact"><span>Volume Marisa / BQ (cm³)</span><strong>@(Model.BqTechnical?.VolumeMarisaCm3 is { } painelMarisaTool ? fmt(painelMarisaTool) : "—")</strong></div>
        <div class="peso-fact"><span>Volume Punção / CM (cm³)</span><strong>@(Model.CmTechnical?.VolumePuncaoCm3 is { } painelPuncaoTool ? fmt(painelPuncaoTool) : "—")</strong></div>
        <div class="peso-fact">
          <span>Densidade do vidro (g/cm³)</span>
          <strong>@(Model.ConfiguredGlassDensity is { } painelDensidadeTool ? fmtDensity(painelDensidadeTool) : "—")</strong>
          <small>@cmProcessLabel(Model.CmTechnical?.Process)</small>
        </div>
        <details class="tp-support" data-cap-url="@Url.Page("/Controlo/Peso", "CapSupport")" data-cap-params="cm_tool_id=@Model.RequestedCmToolId" open="@(Model.CapAberto ? "open" : null)">
          <summary class="tp-button">
            <span><span class="dmo-caret" aria-hidden="true"></span>TP / calote · Apoio separado</span>
            @if (Model.CapSupport is { TemReferencia: true } botaoCapTool)
            {
              <strong>@(fmtCap(botaoCapTool.VolumeEfetivoCm3)) cm³</strong>
              <small>D @(fmtCap(botaoCapTool.DiametroMm)) · h @(fmtCap(botaoCapTool.AlturaEfetivaMm)) · @botaoCapTool.OrigemCalote</small>
            }
            else
            {
              <strong>Referência por completar</strong>
              <small>Não bloqueia o Peso</small>
            }
          </summary>
          <div class="tp-support-body">
            @if (Model.CapSupport is { TemReferencia: true } apoioCapTool)
            {
              @* «h referencia fica nominal, o efetivo fica jobon»; «por baixo
                 apenas mostramos volume do nominal, volume do jobon e o delta»
                 (Diogo, 26/10/2026): a origem do h vai para a dica. *@
              <div class="peso-facts">
                <div class="peso-fact"><span>D</span><strong>@(fmtCap(apoioCapTool.DiametroMm)) mm</strong></div>
                <div class="peso-fact"><span>h nominal</span><strong>@(fmtCap(apoioCapTool.AlturaReferenciaMm)) mm</strong></div>
                <div class="peso-fact"><span>@(RotuloH(apoioCapTool.OrigemCalote))<partial name="_DmoHelp" model="@($"Origem do h: {apoioCapTool.OrigemCalote}. O volume calcula-se com o D e o h; não é aplicada uma tolerância oculta.")" /></span><strong>@(SemJobOn(apoioCapTool) ? "—" : fmtCap(apoioCapTool.AlturaEfetivaMm) + " mm")</strong></div>
              </div>
              <div class="peso-facts" data-cap-result>
                <div class="peso-fact"><span>Volume nominal</span><strong>@(fmtCap(apoioCapTool.VolumeReferenciaCm3)) cm³</strong></div>
                <div class="peso-fact"><span>Volume @(RotuloH(apoioCapTool.OrigemCalote)[2..])</span><strong>@(SemJobOn(apoioCapTool) ? "—" : fmtCap(apoioCapTool.VolumeEfetivoCm3) + " cm³")</strong></div>
                <div class="peso-fact"><span>Δ volume</span><strong>@(SemJobOn(apoioCapTool) ? "—" : fmtCapSigned(apoioCapTool.DeltaVolumeCm3) + " cm³")</strong></div>
              </div>
              <form method="get" asp-page="/Controlo/Peso" class="tp-sim-form">
                <input type="hidden" name="cm_tool_id" value="@Model.RequestedCmToolId" />
                <input type="hidden" name="bq_tool_id" value="@Model.RequestedBqToolId" />
                @if (Model.ComparacaoDePesoId is { } comparacaoDeCalote)
                {
                  <input type="hidden" name="comparacao_de" value="@comparacaoDeCalote" />
                }
                <div class="dmo-field">
                  <label for="capSimulada">Calote simulada h (mm)</label>
                  <input id="capSimulada" name="cap_h" type="text" inputmode="decimal" autocomplete="off"
                         value="@(Model.CapSimulada is { } simuladaTool ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2SemPerda(simuladaTool) : (apoioCapTool.AlturaEfetivaMm is { } efetivaTool ? DMO.Alpha.Core.Runtime.DmoNumberFormat.Decimal2SemPerda(efetivaTool) : null))"
                         placeholder="Usar @apoioCapTool.OrigemCalote" />
                </div>
                <div class="dmo-field">
                  <span class="dmo-label" aria-hidden="true">&nbsp;</span>
                  <button type="submit" class="dmo-button">Calcular</button>
                </div>
              </form>
            }
            else
            {
              <div class="peso-aviso-simples" role="status">Sem tampão registado para esta CM: o tampão escreve-se na Folha do Job On. O Peso pode continuar sem este apoio.</div>
            }
            @if (Model.CapSimuladaIlegivel)
            {
              <div class="peso-aviso-simples" role="status" style="margin-top:10px">O valor da calote simulada não é utilizável — escreve uma calote em mm (0 ou mais). O apoio segue com o h efetivo.</div>
            }
          </div>
        </details>
      </div>
    }
  </section>

  }

  @* ------------------------------------------------------------------ *@
  @* 2. Novo Peso tool-scoped (ambas as ferramentas resolvidas).        *@
  @* ------------------------------------------------------------------ *@
  @if (Model.CmTool is not null && Model.BqTool is not null)
  {
    <section class="dmo-card peso-card" aria-labelledby="peso-create-title">
      @* A nota fica por baixo do título, como nos outros cartões. *@
      <div class="peso-card-heading"><div><h3 id="peso-create-title">Novo Peso</h3><p class="card-note">@(Model.ComparacaoDePesoId is null ? "Sem produção associada." : "Só para comparação: sem produção e sem Job On.")</p></div><div class="dmo-card-topo-acoes"><button type="submit" class="dmo-button" form="pesoCreate">Criar Peso</button></div></div>

      @if (Model.CreateRefusal is not null)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.CreateRefusalMessage</div>
      }

      <form method="post" asp-page="/Controlo/Peso" asp-page-handler="Create" class="peso-form-grid" id="pesoCreate">
        <input type="hidden" name="cm_tool_id" value="@Model.CmTool.ToolId" />
        <input type="hidden" name="bq_tool_id" value="@Model.BqTool.ToolId" />
        @if (Model.ComparacaoDePesoId is { } comparacaoDeCriar)
        {
          <input type="hidden" name="comparacao_de" value="@comparacaoDeCriar" />
        }
        <div class="dmo-field">
          <label for="waterTemperature">Temperatura da água (°C)</label>
          <input id="waterTemperature" name="water_temperature" type="text" inputmode="decimal" autocomplete="off" required placeholder="Ex.: 20,4 ou 20.4" value="@Model.EchoTemperature" />
        </div>
        @if (Model.CmTechnical?.Process is null)
        {
          <div class="dmo-field">
            <label for="cmProcess">Processo da CM (em falta)</label>
            <select id="cmProcess" name="cm_process" required>
              <option value="">Selecionar</option>
              <option value="NNPB" selected="@(Model.EchoCmProcess == "NNPB" ? "selected" : null)">NNPB</option>
              <option value="PS" selected="@(Model.EchoCmProcess == "PS" ? "selected" : null)">PS</option>
            </select>
          </div>
        }
        @if (Model.CmTechnical?.VolumePuncaoCm3 is null)
        {
          <div class="dmo-field">
            <label for="cmVolumePuncao">Volume punção cm³ (em falta)</label>
            <input id="cmVolumePuncao" name="cm_volume_puncao" type="text" inputmode="decimal" autocomplete="off" required placeholder="Ex.: 70,00 ou 70.00" value="@Model.EchoVolumePuncao" />
          </div>
        }
        @if (Model.CmTechnical?.NominalWeightGrams is null)
        {
          <div class="dmo-field">
            <label for="cmNominalWeight">Peso nominal g (opcional)</label>
            <input id="cmNominalWeight" name="cm_nominal_weight" type="text" inputmode="decimal" autocomplete="off" placeholder="Ex.: 200,00 ou 200.00" value="@Model.EchoNominalWeight" />
          </div>
        }
        @if (Model.BqTechnical?.VolumeMarisaCm3 is null)
        {
          <div class="dmo-field">
            <label for="bqVolumeMarisa">Volume marisa cm³ (em falta)</label>
            <input id="bqVolumeMarisa" name="bq_volume_marisa" type="text" inputmode="decimal" autocomplete="off" required placeholder="Ex.: 10,00 ou 10.00" value="@Model.EchoVolumeMarisa" />
          </div>
        }
        <div class="peso-form-grid wide" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-top:12px">
          <div class="peso-fact"><span>Densidade da água</span><strong>Tabela de densidades (5–35 °C, grau inteiro)</strong></div>
          <div class="peso-fact">
            <span>Densidade do vidro</span>
            <strong>@(Model.ConfiguredGlassDensity is { } density ? $"{fmtDensity(density)} g/cm³" : "não configurada")</strong>
            @if (Model.CmTechnical?.Process is not null && Model.ConfiguredGlassDensity is null)
            {
              <small>Configuração do Controlo para o processo @cmProcessLabel(Model.CmTechnical.Process) — sem valor configurado, o Peso não é criado.</small>
            }
          </div>
        </div>
      </form>
    </section>
  }
  } @* fim do else — o modo sem Job On (secções 1 e 2) *@
  } @* fim do else — o modo tool-scoped (secções 0, 1 e 2) *@

  @* Os Pesos da produção, quando há mais do que um (a CM ou a BQ mudou a
     meio; 18/10/2026). *@
  <partial name="_PesoPesos" model="Model" />

  @* ------------------------------------------------------------------ *@
  @* 3. O Peso aberto: contexto consumido, leituras e cálculo.          *@
  @* ------------------------------------------------------------------ *@
  @if (Model.Peso is { } peso)
  {
    decimal? diferencaNominal = peso.Averages is { } pesoAv && peso.NominalWeightGrams is { } nom
        ? pesoAv.AverageGlassWeightGrams - nom
        : (decimal?)null;
    @if (Model.JobOnNotice is { } jobOnNotice)
    {
      <partial name="_JobOnChangeNotice" model="jobOnNotice" />
    }
    @* Registar leituras grava e troca as leituras, o resumo e os cartões
       gravados; a leitura nova (data-dmo-fica) só é limpa pelo peso-live.js
       quando a gravação passou, por isso uma recusa ou outra parte da página
       trocada não apagam o que o operador escreveu. *@
    <section class="dmo-card peso-card" aria-labelledby="peso-open-title" data-peso-live data-peso-id="@peso.PesoId" data-preview-url="@Url.Page("/Controlo/Peso", "Preview")" data-dmo-parcial>
      @{ var umSoCartao = Model.ProductionContext is not null; }
      @* Sem notas para mostrar, o cabeçalho do cartão não ocupa lugar. *@
      <div class="peso-card-heading@(umSoCartao && !Model.PesoAnterior && !Model.ShowPesos ? " peso-sem-cabecalho" : null)"><div>
        @if (umSoCartao)
        {
          @* Com produção, a produção, a referência, a máquina e a CM já estão no
             cartão de cima: não se repetem aqui. *@
          <h3 id="peso-open-title" class="visually-hidden-peso">Peso — CM @(peso.CmToolReference ?? "—")</h3>
        }
        else
        {
        <h3 id="peso-open-title">Peso — CM @(peso.CmToolReference ?? "—")</h3>
        @* Sem produção, a nota «sem associação a produção — CM · Lote» saiu
           (Diogo, 27/10/2026, «remover»): a CM já está no título. *@
        @if ((Model.ProductionContext ?? Model.OpenedPesoProduction) is { } pc)
        {
        <p class="card-note">
          Produção @pc.ProductionNumber · @pc.Reference · @pc.Machine
          — CM @(peso.CmToolReference ?? "—")@(peso.CmToolReference is null ? "" : $" · Lote {peso.CmToolLot}")@(Model.ShowPesos ? $" · BQ {peso.BqToolReference ?? "—"}" + (peso.BqToolReference is null ? "" : $" · Lote {peso.BqToolLot}") : null)
        </p>
        }
        }
        @* Um Peso de antes de uma troca da CM ou da BQ fica como estava: as
           leituras gravadas ainda se corrigem, mas as novas vão para o Peso
           atual (resposta R16-3 do especialista, 18/10/2026). *@
        @if (Model.PesoAnterior)
        {
          <p class="card-note" data-peso-anterior>Peso @Model.PesoNumber(peso) de @Model.Pesos.Count · de antes da troca da CM ou da BQ: fica como estava e já não recebe leituras.</p>
        }
        else if (Model.ShowPesos)
        {
          <p class="card-note">Peso @Model.PesoNumber(peso) de @Model.Pesos.Count · ferramentas atuais.</p>
        }
      </div>
        @if (!umSoCartao)
        {
        <div class="dmo-card-topo-acoes">
          @if (Model.PesoAnterior && Model.PesoAtual is not null)
          {
            <a class="dmo-button" href="/Controlo/Peso?controlo_id=@peso.ControloId">Abrir o Peso atual</a>
          }
          <a class="dmo-button" href="/Controlo/PesoComparar?peso_id=@peso.PesoId">Comparar peso</a>
          <button type="submit" class="dmo-button" form="pesoPdfForm">Exportar PDF</button>
        </div>
        }
      </div>

      @* Os INPUTS técnicos (processo, densidades, volumes, peso nominal)
         vivem na ficha da ferramenta e no PDF — a folha mostra APENAS os
         RESULTADOS da pesagem (o Owner 2026-10-12: «deveria apenas ter
         informação relacionada aos resultados do peso»). *@

      <div id="pesoLeituras" class="dmo-zona" data-dmo-regiao>
      @if (Model.AssociationRefusal is not null && Model.ControloIdFromQuery is null)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.AssociationRefusalMessage</div>
      }

      @* Um Peso só para comparação (o Diogo, 22/10/2026): não pede Job On;
         registadas as leituras, volta-se ao Peso que ele compara. *@
      @if (peso.ComparacaoDoPesoId is not null)
      {
        <div class="peso-aviso-simples" role="status" style="margin-bottom:12px" data-peso-so-comparacao>
          <strong>Peso só para comparação: não é associado a nenhum Job On.</strong>
          @if (Model.ComparacaoVoltarUrl is { } voltarComparacao)
          {
            <a class="dmo-button" href="@voltarComparacao" data-peso-comparacao-voltar>Voltar ao Peso e comparar</a>
          }
        </div>
      }

      @* Peso sem produção cuja CM já está num Job On: a app PERGUNTA (o
         Owner 2026-10-16) — nunca associa sozinha; sem resposta, o Peso
         continua disponível na ferramenta. *@
      @if (Model.ProductionCandidates.Count > 0)
      {
        @* SEM BOTÕES NAS LINHAS (Diogo, 27/10/2026: «não quero botões em rows
           por todo o lado»): como os «Pesos sem produção» da folha da
           produção, um clique escolhe a produção e um só «Associar» no canto
           envia a escolhida (R16). *@
        var umaProducao = Model.ProductionCandidates.Count == 1;
        <div class="peso-card peso-associar-producao" data-peso-associar>
          <div class="peso-card-heading"><div>
            <h4>@(umaProducao ? "Existe um Job On" : $"Existem {Model.ProductionCandidates.Count} Job Ons") com esta CM e ainda sem Peso. Quer associar este Peso?</h4>
          </div>
            <div class="dmo-card-topo-acoes" data-dmo-for="pesoAssociarProducao"><button type="submit" class="dmo-button" form="pesoAssociarProducaoForm">Associar</button></div>
          </div>
          <form method="post" asp-page="/Controlo/Peso" asp-page-handler="Associate" id="pesoAssociarProducaoForm">
            <input type="hidden" name="peso_id" value="@peso.PesoId" />
            <div class="dmo-table-wrap">
              <table class="dmo-table" id="pesoAssociarProducao" data-dmo-list="Job Ons sem Peso">
                <thead>
                  <tr><th></th><th>Produção</th><th>Referência</th><th>Máquina</th></tr>
                </thead>
                <tbody>
                  @foreach (var production in Model.ProductionCandidates)
                  {
                    <tr data-dmo-row data-id="@production.JobOnId" class="@(umaProducao ? "selected" : null)" aria-selected="@(umaProducao ? "true" : "false")"
                        aria-label="Produção @production.ProductionNumber · @production.Reference · @production.Machine — um clique escolhe">
                      <td><input type="radio" name="jobon_id" value="@production.JobOnId" required checked="@umaProducao" aria-label="Produção @production.ProductionNumber" /></td>
                      <td>@production.ProductionNumber</td>
                      <td>@production.Reference</td>
                      <td>@production.Machine</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </form>
        </div>
      }

      @if (Model.NominalIlegivelAviso)
      {
        @* A5 (beta.65): o nominal é opcional — o Peso foi criado sem o valor ilegível ou ≤ 0. *@
        <div class="peso-aviso warn" role="status">@Model.NominalIlegivelMessage<partial name="_DmoAvisoLink" model="@DmoAvisoLink.FichaFerramenta(peso.CmToolId, "Abrir a ficha da CM", tecnica: true, continuar: voltarAqui)" /></div>
      }

      @if (Model.MeasurementRefusal is not null)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.MeasurementRefusalMessage</div>
      }


      @if (Model.LeituraRefusal)
      {
        @* A auditoria do Codex: a massa não utilizável é recusa tipada com
           o ECHO — o typo do operador não desaparece em silêncio. *@
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@Model.LeituraRefusalMessage</div>
      }

      @* A resposta diz ao peso-live.js que o registo foi recusado: a
         mensagem vai para o canto, esta marca fica na zona. Sem ela, um
         cartão gravado por outra pessoa entretanto parecia a gravação
         deste registo e a leitura a corrigir era limpa. *@
      @if (Model.MeasurementRefusal is not null || Model.LeituraRefusal)
      {
        <span hidden data-peso-registo-recusado></span>
      }

      <div class="peso-section-heading"><div>
        <h4>Leituras por CM</h4>
      </div></div>
      @if (peso.Measurements.Count == 0)
      {
        <div class="peso-vazia">@(Model.PesoAnterior ? "Sem leituras." : "Ainda sem leituras. Registe a primeira leitura real abaixo.")</div>
      }
      else
      {
        <div class="dmo-table-wrap">
          <table class="dmo-table" data-peso-leituras>
            @* A primeira tabela é a dos moldes controlados (o Owner
               2026-10-17): o peso e o VOLUME de cada CM ficam à vista,
               porque o volume vai para o mcaliper; a massa de água é o
               input da medição, não o resultado (o Owner 2026-10-12). A comparação com outra
               produção tem a sua própria tabela mais abaixo. *@
            <thead>
              <tr>
                <th>N.º CM</th>
                <th>Volume (cm³)</th>
                <th>Peso do vidro (g)</th>
                <th>Δ peso / média (g)</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var measurement in peso.Measurements)
              {
                decimal? rowDelta = peso.Averages is { } rowAverages
                    ? measurement.GlassWeightGrams - rowAverages.AverageGlassWeightGrams
                    : null;
                <tr>
                  <td>@(string.IsNullOrEmpty(measurement.CmSubject) ? "—" : measurement.CmSubject)</td>
                  <td>@fmtCap(measurement.CapacityCm3)</td>
                  <td><strong>@fmt(measurement.GlassWeightGrams)</strong></td>
                  <td>@(rowDelta is { } rd ? signed(rd) : "—")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      </div>

      @* A camada viva: o estado inicial é o persistido e as leituras em
         curso atualizam-no ao vivo; cada linha do formulário mostra logo o
         seu volume e peso. Zero escrita: o registo é o POST nativo
         «Registar leitura». *@
      <div class="peso-live-region">
        <div class="peso-live-area" aria-live="polite">
          <div id="pesoLeituraResumo" class="dmo-zona" data-dmo-regiao>
          <div class="peso-live-strip" data-peso-strip>
            @* A ESTRUTURA É ESTÁVEL: o servidor renderiza os mesmos blocos
               que o peso-live.js escreve ao vivo (os mesmos rótulos na
               mesma ordem). *@
            <div class="peso-fact"><span>Leituras válidas</span><strong>@peso.Measurements.Count</strong></div>
            <div class="peso-fact"><span>Média em água</span><strong>@(peso.Averages is { } la ? $"{fmt(la.AverageWaterWeightGrams)} g" : "—")</strong></div>
            <div class="peso-fact"><span>Peso estimado em vidro</span><strong>@(peso.Averages is { } lb ? $"{fmt(lb.AverageGlassWeightGrams)} g" : "—")</strong></div>
            <div class="peso-fact"><span>Capacidade média</span><strong>@(peso.Averages is { } lc ? $"{fmtCap(lc.AverageCapacityCm3)} cm³" : "—")</strong></div>
          </div>
          <div class="peso-resumo" data-peso-summary>
            <div class="peso-fact"><span>Peso nominal</span><strong>@(peso.NominalWeightGrams is { } nominalSumario ? $"{fmt(nominalSumario)} g" : "—")</strong></div>
            <div class="peso-fact"><span>Diferença nominal</span><strong>@(diferencaNominal is { } diferenca ? signed(diferenca) + " g" : "—")</strong></div>
            <div class="peso-fact" data-peso-comparison><span>Comparação anterior</span><strong>@(Model.Comparison is { } comparacaoStrip && !string.IsNullOrEmpty(comparacaoStrip.HistoricalProductionNumber) ? comparacaoStrip.HistoricalProductionNumber : "Por criar")</strong></div>
          </div>
          </div>
          @* Sem barra «Há leituras com massa de água não utilizável» por cima
             do formulário: aparecia e saía ao escrever e empurrava as
             leituras (regra 85, B-peso-6, deep sweep 18/10/2026). Cada
             leitura recusada já o diz no próprio cartão. *@
        </div>

        @* O registo das leituras como na referência acordada (o Owner
           2026-10-17): cada leitura gravada fica num cartão com o N.º CM, a
           massa de água e, por baixo, o volume e o peso dessa CM; o cartão
           tracejado no fim é a leitura nova, com «+» e «−» e «Registar
           leitura». As massas gravadas são só de leitura (value, sem name).
           Um Peso de antes de uma troca não tem o registo: as leituras dele
           estão na tabela acima (18/10/2026). *@
        @if (!Model.PesoAnterior)
        {
        <form method="post" asp-page="/Controlo/Peso" asp-page-handler="RegisterMeasurement" class="peso-leitura-form" data-peso-rows-form>
          <input type="hidden" name="peso_id" value="@peso.PesoId" />
          @* A comparação escolhida e o «Supomos» mudam sem recarregar: os
             campos que os levam de volta depois de gravar são uma zona. Na
             folha da produção e no Peso aberto pelo Histórico (peso_id). *@
          <div id="pesoLeituraContexto" class="dmo-zona" data-dmo-regiao>
          @if (Model.ProductionContext is not null && Model.ControloIdFromQuery is { } leituraControloId)
          {
            <input type="hidden" name="controlo_id" value="@leituraControloId" />
          }
          @if (Model.Comparison is { } leituraComparison)
          {
            <input type="hidden" name="comparar" value="@leituraComparison.HistoricalPesoId" />
          }
          @if (Model.SuporCaloteParaLevar is { } leituraSupor)
          {
            <input type="hidden" name="supor_calote" value="@leituraSupor" />
          }
          </div>
          <div class="peso-leitura-grade" data-peso-leitura-cartoes>
            @* As leituras gravadas já estão na tabela «Leituras por CM»: por baixo
               não se repetem (Diogo, 27/10/2026, «remover o duplicado»). A zona
               fica, com uma marca escondida por leitura, para a gravação sem
               recarregar saber que a leitura ficou gravada (peso-live.js); só
               mostra a leitura enviada enquanto grava («A gravar…»). *@
            <div id="pesoLeiturasGravadas" class="dmo-zona" data-dmo-regiao>
            @foreach (var gravada in peso.Measurements)
            {
              <span hidden data-peso-leitura-gravada>@gravada.CmSubject=@gravada.WaterWeightGrams.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
            }
            </div>
            <div class="peso-leitura-nova" data-dmo-fica>
              <div class="peso-leitura-rows" data-peso-rows>
                <div class="peso-leitura-row" data-peso-row>
                  <div class="dmo-field">
                    <label for="cmSubject">N.º CM</label>
                    <input id="cmSubject" name="cm_subject" placeholder="Ex.: 12" value="@Model.EchoLeituraSubject" />
                  </div>
                  <div class="dmo-field">
                    <label for="waterWeight">Massa de água (g)</label>
                    <input id="waterWeight" name="water_weight" type="text" inputmode="decimal" autocomplete="off" required placeholder="Ex.: 70.5" value="@Model.EchoLeituraWater" />
                  </div>
                  <output class="peso-leitura-chip" data-peso-row-result></output>
                </div>
              </div>
              @* «Registar» com menos padding e, ao lado, o + e o − um em cima do
                 outro, com a altura do «Registar» (Diogo, 21/10/2026). *@
              <div class="peso-leitura-actions">
                <button type="submit" class="dmo-button peso-registar">Registar leitura</button>
                <div class="peso-row-buttons">
                  <button type="button" class="dmo-button peso-row-button" data-peso-add-row aria-label="Adicionar leitura" title="Adicionar leitura">+</button>
                  <button type="button" class="dmo-button peso-row-button" data-peso-remove-row aria-label="Remover leitura" title="Remover leitura">−</button>
                </div>
              </div>
            </div>
          </div>
        </form>
        }
      </div>
    </section>
  }

  @* ------------------------------------------------------------------ *@
  @* 3B. A comparação com outro controlo: o dropdown em tempo real com  *@
  @*     «Aplicar» à frente, a tabela por CM da produção escolhida e a   *@
  @*     produção anterior com o peso do SAP (o Owner 2026-10-17).       *@
  @* ------------------------------------------------------------------ *@
  @if (Model.ProducaoDaComparacao is { } producaoAtual && Model.Peso is { } currentPesoForComparison)
  {
    @* Escolher a comparação (GET), guardar a produção anterior e o «Supomos»
       trocam só as zonas deste cartão; uma leitura gravada troca a tabela, o
       delta e o «Supomos», e o peso da produção anterior ainda por guardar
       fica como o operador o escreveu. *@
    var mostrarCaloteTampo = false;
    var semProducaoAnteriorTopo = Model.ProducaoAnteriorOpcoes.Count == 0 && Model.ProducaoAnteriorEscolhida is null;
    <section class="dmo-card peso-card peso-compare" aria-labelledby="peso-comparacao-title" data-dmo-parcial>
      @* Os botões do cartão no canto superior direito, um de cada (Diogo, 23/10/2026). *@
      <div class="peso-card-heading dmo-card-topo"><h3 id="peso-comparacao-title">Comparação com outro controlo</h3>
        <div class="dmo-card-topo-acoes">
          <a class="dmo-button" href="/Controlo/Peso?comparacao_de=@currentPesoForComparison.PesoId" data-peso-comparacao-criar>Criar</a>
          @if (!semProducaoAnteriorTopo)
          {
            @* O id deixa o foco no «Guardar» depois de gravar sem recarregar. *@
            <button type="submit" form="pesoAnteriorForm" class="dmo-button" id="producaoAnteriorGuardar">Guardar</button>
          }
        </div>
      </div>
      <div id="pesoComparacao" class="dmo-zona" data-dmo-regiao>
      @* «Criar» (o Diogo, 22/10/2026): sem Pesos anteriores não havia
         comparação. Abre o Novo Peso sem Job On; o Peso criado fica só para
         comparar com este, nunca pede um Job On, e volta-se aqui com ele
         escolhido. *@
      @if (Model.ComparisonCandidates.Count == 0)
      {
        <p class="card-note">Sem Pesos anteriores para esta referência.</p>
      }
      else
      {
        <form method="get" asp-page="/Controlo/Peso" class="peso-inline-form peso-procura-larga">
          @if (Model.ControloIdFromQuery is { } compararControloId)
          {
            <input type="hidden" name="controlo_id" value="@compararControloId" />
            @* Um Peso de antes de uma troca volta pelo peso_id dele (18/10/2026). *@
            @if (Model.PesoIdNoEndereco is { } compararPesoAnterior)
            {
              <input type="hidden" name="peso_id" value="@compararPesoAnterior" />
            }
          }
          else
          {
            <input type="hidden" name="peso_id" value="@currentPesoForComparison.PesoId" />
          }
          @if (Model.SuporCaloteParaLevar is { } suporEcho)
          {
            <input type="hidden" name="supor_calote" value="@suporEcho" />
          }
          <div class="dmo-field">
            <label for="compararDropdown">Produção a comparar (@producaoAtual.Reference)</label>
            <select id="compararDropdown" name="comparar" data-auto-submit data-dmo-filter>
              <option value="" selected="@(Model.Comparison is null ? "selected" : null)">Procurar produção…</option>
              @foreach (var candidate in Model.ComparisonCandidates)
              {
                var selected = Model.Comparison is { } c && c.HistoricalPesoId == candidate.PesoId;
                <option value="@candidate.PesoId" selected="@(selected ? "selected" : null)">
                  @* A procura já mostra as diferenças (o Owner 2026-10-17: «ao
                     procurar aparecer as diferenças»): o volume e o peso médios
                     dessa produção e o Δ do peso para a atual. *@
                  @candidate.ProductionNumber@(string.IsNullOrEmpty(candidate.CmLot) ? null : $" · Lote {candidate.CmLot}")@(candidate.CompatibleMachines is { Count: > 0 } maquinas ? $" · {string.Join(" ", maquinas)}" : string.IsNullOrEmpty(candidate.Machine) ? null : $" · {candidate.Machine}")@(candidate.AverageGlassWeightGrams is { } candPeso ? $" · Peso {fmt(candPeso)} g" + (currentPesoForComparison.Averages is { } atualPeso ? $" (Δ {signed(atualPeso.AverageGlassWeightGrams - candPeso)})" : "") : null)@(candidate.AverageCapacityCm3 is { } candCap ? $" · Volume {fmtCap(candCap)} cm³" + (currentPesoForComparison.Averages is { } atualCap ? $" (Δ {signed(atualCap.AverageCapacityCm3 - candCap)})" : "") : null)
                </option>
              }
            </select>
          </div>
          @* Escolher aplica logo (o Owner 2026-10-17: «o aplicar é redundante»); o «Criar» está no canto do cartão. *@
        </form>
      }

      @if (Model.Comparison is { } comparison && currentPesoForComparison.Averages is not null)
      {
        var historicoRotulo = comparison.HistoricalProductionNumber;
        @* A produção escolhida é só a procura; a tabela compara CM com CM
           pela ordem das leituras, sem exigir o mesmo número de CM (o Owner
           2026-10-17: «comparando cm com cm, não precisa de ser par»), com o
           volume, o peso e a diferença entre o atual e o anterior, e as
           médias no fim. As produções do dropdown são as das máquinas
           compatíveis na ficha da CM (ToolMachineLink). *@
        <div class="dmo-table-wrap" style="margin-top:8px">
          <table class="dmo-table" data-peso-comparacao-tabela>
            <thead>
              <tr>
                <th>CM atual</th>
                <th>Volume atual (cm³)</th>
                <th>Peso atual (g)</th>
                <th>CM anterior · @historicoRotulo</th>
                <th>Volume anterior (cm³)</th>
                <th>Peso anterior (g)</th>
                <th>Δ volume (cm³)</th>
                <th>Δ peso (g)</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var measurement in currentPesoForComparison.Measurements)
              {
                var anterior = comparison.Rows.FirstOrDefault(r => r.Position == measurement.RowPosition);
                <tr>
                  <td>@(string.IsNullOrEmpty(measurement.CmSubject) ? "—" : measurement.CmSubject)</td>
                  <td>@fmtCap(measurement.CapacityCm3)</td>
                  <td>@fmt(measurement.GlassWeightGrams)</td>
                  <td>@(anterior is { } a1 && !string.IsNullOrEmpty(a1.HistoricalCmSubject) ? a1.HistoricalCmSubject : "—")</td>
                  <td>@(anterior?.HistoricalCapacityCm3 is { } hcap ? fmtCap(hcap) : "—")</td>
                  <td>@(anterior is { } a2 ? fmt(a2.HistoricalGlassWeightGrams) : "—")</td>
                  <td>@(anterior?.HistoricalCapacityCm3 is { } hcap2 ? signed(measurement.CapacityCm3 - hcap2) : "—")</td>
                  <td><strong>@(anterior is { } a3 ? signed(measurement.GlassWeightGrams - a3.HistoricalGlassWeightGrams) : "—")</strong></td>
                </tr>
              }
            </tbody>
            <tfoot data-peso-comparacao-medias>
              <tr>
                <th scope="row">Média</th>
                <td>@(comparison.CurrentAverages is { } ca ? fmtCap(ca.AverageCapacityCm3) : "—")</td>
                <td>@(comparison.CurrentAverages is { } ca1 ? fmt(ca1.AverageGlassWeightGrams) : "—")</td>
                <td></td>
                <td>@(comparison.HistoricalAverages is { } ha ? fmtCap(ha.AverageCapacityCm3) : "—")</td>
                <td>@(comparison.HistoricalAverages is { } ha1 ? fmt(ha1.AverageGlassWeightGrams) : "—")</td>
                <td>@(comparison.Deltas.CapacityDifferenceCm3 is { } cd ? signed(cd) : "—")</td>
                <td><strong class="@(comparison.Deltas.GlassWeightDifferenceGrams is { } gd && gd < 0 ? "peso-valor-negativo" : null)">@(comparison.Deltas.GlassWeightDifferenceGrams is { } gd2 ? signed(gd2) : "—")@(comparison.Deltas.GlassWeightVariationPercent is { } gv ? $" ({signed(gv)} %)" : null)</strong></td>
              </tr>
            </tfoot>
          </table>
        </div>
      }
      </div>

      @* A PRODUÇÃO ANTERIOR (o Owner 2026-10-17): o contexto vem do Job On
         anterior (número, máquina, início e fim) e o peso que essa produção
         usou é escrito à mão a partir do SAP. O delta é contra o peso médio
         atual, e o registo vai para o PDF. *@
      <div class="peso-section-heading" style="margin-top:16px"><div>
        <h4 id="peso-producao-anterior-title">Produção anterior</h4>
      </div></div>
      @{
        var semProducaoAnterior = Model.ProducaoAnteriorOpcoes.Count == 0 && Model.ProducaoAnteriorEscolhida is null;
        var escolhida = Model.ProducaoAnteriorEscolhida;
        var guardada = Model.ProducaoAnterior;
      }
      @* As mensagens, o formulário e o delta são zonas separadas: uma leitura
         gravada muda o delta (contra o peso médio atual) e tira a mensagem do
         endereço sem mexer no peso já escrito e ainda por guardar. O
         formulário fica como o operador o deixou (data-dmo-fica): a produção
         escolhida e o peso escritos e ainda por guardar não se perdem ao
         escolher a comparação, no «Supomos» nem ao registar uma leitura,
         também depois de uma recusa (o echo vem só no endereço). Só os campos
         escondidos que levam a folha de volta (a comparação, o «Supomos»)
         são uma zona, #pesoAnteriorContexto. *@
      <div id="pesoAnteriorAvisos" class="dmo-zona" data-dmo-regiao>
      @if (Model.ProducaoAnteriorRefusal is { } anteriorRecusa)
      {
        <div data-dmo-toast="erro" class="peso-aviso" role="alert">@anteriorRecusa</div>
      }
      @if (Model.ProducaoAnteriorGuardada)
      {
        <div data-dmo-toast="ok" class="peso-aviso-simples" role="status">Produção anterior guardada.</div>
      }
      </div>
      <div class="peso-anterior-linha">
      <div id="pesoAnterior" class="dmo-zona" data-dmo-fica>
      @if (semProducaoAnterior)
      {
        <p class="card-note">Sem produções anteriores desta referência.</p>
      }
      else
      {
        var pesoGuardadoDaEscolhida = escolhida is not null && guardada?.JobOnId == escolhida.JobOnId ? guardada.PesoGramas : null;
        // O peso do SAP da escolhida (média pelos dias e moda); sem peso
        // guardado, o campo vem com a média, para guardar ou mudar.
        var sapDaEscolhida = escolhida is not null && Model.ProducaoAnteriorSap.TryGetValue(escolhida.JobOnId, out var sapEsc) ? sapEsc : null;
        var pesoEcho = Model.ProducaoAnteriorEcho
            ?? (pesoGuardadoDaEscolhida is { } pg ? pg.ToString("0.##", DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture) : null)
            ?? (sapDaEscolhida is not null ? fmt(sapDaEscolhida.MediaGramas) : null);
        <form id="pesoAnteriorForm" method="post" asp-page="/Controlo/Peso" asp-page-handler="GuardarProducaoAnterior" class="peso-inline-form" data-producao-anterior>
          <div id="pesoAnteriorContexto" class="dmo-zona" data-dmo-regiao>
            <input type="hidden" name="peso_id" value="@currentPesoForComparison.PesoId" />
            <input type="hidden" name="controlo_id" value="@Model.ControloIdFromQuery" />
            @* Um Peso de antes de uma troca volta pelo peso_id dele (18/10/2026). *@
            @if (Model.PesoIdNoEndereco is not null)
            {
              <input type="hidden" name="peso_anterior" value="1" />
            }
            @if (Model.Comparison is { } anteriorComparison)
            {
              <input type="hidden" name="comparar" value="@anteriorComparison.HistoricalPesoId" />
            }
            @if (Model.SuporCaloteParaLevar is { } anteriorSupor)
            {
              <input type="hidden" name="supor_calote" value="@anteriorSupor" />
            }
          </div>
          <div class="dmo-field">
            <label for="producaoAnterior">Produção anterior</label>
            <select id="producaoAnterior" name="anterior" data-producao-anterior-select>
              @foreach (var opcao in Model.ProducaoAnteriorOpcoes)
              {
                <option value="@opcao.JobOnId"
                        data-inicio="@(opcao.InicioEm?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")"
                        data-fim="@(opcao.FimEm?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")"
                        selected="@(escolhida?.JobOnId == opcao.JobOnId ? "selected" : null)">@opcao.ProductionNumber · @opcao.Machine</option>
              }
            </select>
          </div>
          <div class="dmo-field">
            @* Sem rótulo à vista (o Owner 2026-10-17: «remove»); o nome fica no aria-label. *@
            <input id="producaoAnteriorPeso" name="anterior_peso" type="text" inputmode="decimal" autocomplete="off" placeholder="Peso usado (g)" aria-label="Peso usado na produção (g)" value="@pesoEcho" />
          </div>
          @* O Peso completo da produção anterior (Diogo, 26/10/2026: «caso não exista, criar, que abre uma página onde criamos, podendo assim associar a um Job On»):
             abre a folha de Peso dessa produção (CM, tampão, calote e temperatura), gravada no Job On escolhido. *@
          <button type="submit" class="dmo-button" formaction="@Url.Page("/Controlo/Peso", "AbrirJobOn")" formtarget="_self" formnovalidate data-peso-anterior-abrir>Abrir o Peso desta produção</button>
        </form>
        <p class="peso-hint" style="margin:6px 0 0" data-producao-anterior-periodo>Início <span data-inicio>@(escolhida?.InicioEm?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span> · Fim <span data-fim>@(escolhida?.FimEm?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span></p>
        @* O PESO DA PRODUÇÃO (Diogo, 21/10/2026; 26/10/2026): pelas datas da
           produção escolhida e a referência, a média pelos dias de cada ordem
           e a moda (o peso com mais dias). A caixa mostra só a média com a
           diferença do peso de hoje; ao carregar abre uma janela pequena com a
           moda e a sua diferença, como no Histórico de produções da ferramenta. *@
        var pesoAtualSap = currentPesoForComparison.Averages?.AverageGlassWeightGrams;
        string deltaSapTexto(decimal pesoSapRef)
        {
            var (dg, dp) = DMO.Alpha.Core.Controlo.PesoCalculation.NominalDeviation(pesoAtualSap, pesoSapRef);
            return dg is { } g ? $"Hoje {signed(g)} g" + (dp is { } pc ? $" ({signed(pc)} %)" : null) : "";
        }
        <div class="peso-sap-caixa" id="pesoAnteriorSap" data-producao-anterior-sap data-peso-atual="@(pesoAtualSap is { } pa ? fmt(pa) : null)">
          <div data-sap-com hidden="@(sapDaEscolhida is null ? "hidden" : null)">
            <button type="button" class="peso-sap-abrir" data-dmo-dialog="pesoSapModa" aria-label="Peso da produção: moda e diferença">
              <span class="peso-sap-titulo">Peso da produção <span class="peso-hint">(<span data-sap-dias>@sapDaEscolhida?.Dias</span> dias)</span></span>
              <span class="peso-sap-opcao">Média <strong data-sap-media>@(sapDaEscolhida is null ? null : fmt(sapDaEscolhida.MediaGramas))</strong> g <span class="peso-sap-delta" data-sap-delta="media">@(sapDaEscolhida is null ? null : deltaSapTexto(sapDaEscolhida.MediaGramas))</span></span>
              <partial name="_DmoHelp" model="@("Carrega para ver a moda (o peso com mais dias) e a diferença do peso de hoje para ela.")" />
            </button>
            <dialog id="pesoSapModa" class="dmo-dialog" aria-labelledby="pesoSapModa-title">
              <h3 id="pesoSapModa-title">Peso da produção</h3>
              <div class="peso-sap-opcoes">
                <span class="peso-sap-opcao">Média <strong data-sap-media-dialog>@(sapDaEscolhida is null ? null : fmt(sapDaEscolhida.MediaGramas))</strong> g <span class="peso-sap-delta" data-sap-delta="media-dialog">@(sapDaEscolhida is null ? null : deltaSapTexto(sapDaEscolhida.MediaGramas))</span></span>
                <span class="peso-sap-opcao">Moda <strong data-sap-moda>@(sapDaEscolhida is null ? null : fmt(sapDaEscolhida.ModaGramas))</strong> g <span class="peso-sap-delta" data-sap-delta="moda">@(sapDaEscolhida is null ? null : deltaSapTexto(sapDaEscolhida.ModaGramas))</span></span>
              </div>
              <div class="dmo-dialog-actions">
                <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Fechar</button>
              </div>
            </dialog>
          </div>
          <span data-sap-sem hidden="@(sapDaEscolhida is null ? null : "hidden")">Ainda não há o peso desta produção. <a class="dmo-button" href="/Definicoes?secao=computador">Ler a pasta da produção</a></span>
          @* O peso da produção de cada produção do select, para trocar sem pedir ao servidor. *@
          @foreach (var (sapJobOnId, sapOpcao) in Model.ProducaoAnteriorSap)
          {
            <span hidden data-sap-opcao="@sapJobOnId" data-sap-media="@fmt(sapOpcao.MediaGramas)" data-sap-moda="@fmt(sapOpcao.ModaGramas)" data-sap-dias="@sapOpcao.Dias"></span>
          }
        </div>
      }
      </div>
      <div id="pesoAnteriorDelta" class="dmo-zona" data-dmo-regiao>
      @if (!semProducaoAnterior && guardada is { PesoGramas: { } pesoSap })
      {
        var deltaSap = guardada.Delta(currentPesoForComparison.Averages?.AverageGlassWeightGrams);
        <div class="peso-resumo" data-producao-anterior-delta>
          <div class="peso-fact"><span>Peso usado — @(guardada.ProductionNumber ?? "produção anterior")@(string.IsNullOrEmpty(guardada.Machine) ? null : $" · {guardada.Machine}")</span><strong>@fmt(pesoSap) g</strong></div>
          <div class="peso-fact"><span>Diferença para a anterior</span><strong class="@(deltaSap.Grams is < 0 ? "peso-valor-negativo" : null)">@(deltaSap.Grams is { } dg ? $"{signed(dg)} g" : "—")</strong></div>
          <div class="peso-fact"><span>Variação</span><strong>@(deltaSap.Percent is { } dpc ? $"{signed(dpc)} %" : "—")</strong></div>
        </div>
      }
      </div>
      </div>

      @* O «SUPOMOS» (o Diogo, 16/10): e se a calote do tampão desta
         produção fosse outra? O backend recalcula o peso médio com a
         calote suposta e a diferença para a produção escolhida. Nada é
         gravado: o Peso e o Job On ficam como estão. *@
      @* A «Calote Tampo» (antes «Supomos») sai deste cartão (Diogo, 23/10/2026: é uma
         comparação de pesos já feitos, não fica na «Comparação com outro controlo»).
         O cálculo e esta vista ficam guardados até o Diogo dizer para onde vão. *@
      @if (mostrarCaloteTampo)
      {
      <div id="pesoSupomos" class="peso-supomos" data-peso-supomos data-dmo-regiao style="margin-top:16px">
        <h4 style="margin:0 0 6px">Supomos</h4>
        @if (Model.CaloteDaComparacao is { TemReferencia: true } caloteAtual)
        {
          @* Texto para o «?»: E se a calote do tampão fosse outra? A massa
             de água já traz a calote com que se pesou; a app troca a parte
             do peso que vem dela pela da calote suposta. É só uma
             simulação: o Peso não muda. *@
          <p class="card-note">Calote atual: @(fmtCap(caloteAtual.AlturaEfetivaMm)) mm (@caloteAtual.OrigemCalote)</p>
          <form method="get" asp-page="/Controlo/Peso" class="dmo-field" style="max-width:420px">
            @if (Model.ControloIdFromQuery is { } suporControloId)
            {
              <input type="hidden" name="controlo_id" value="@suporControloId" />
              @if (Model.PesoIdNoEndereco is { } suporPesoAnterior)
              {
                <input type="hidden" name="peso_id" value="@suporPesoAnterior" />
              }
            }
            else
            {
              <input type="hidden" name="peso_id" value="@currentPesoForComparison.PesoId" />
            }
            @if (Model.Comparison is { } comparacaoSupor)
            {
              <input type="hidden" name="comparar" value="@comparacaoSupor.HistoricalPesoId" />
            }
            <label for="suporCalote">Calote do tampão suposta (mm)</label>
            <input id="suporCalote" name="supor_calote" type="text" inputmode="decimal" autocomplete="off"
                   value="@Model.SuporCaloteTexto" placeholder="ex.: 5,2" />
            <button type="submit" class="dmo-button" id="suporCaloteVer">Ver a diferença</button>
          </form>
          @if (Model.SuposicaoIlegivel)
          {
            @* Na pilha do canto, como as outras recusas da folha: a mensagem
               não empurra o «Exportar PDF» nem o resto para baixo. *@
            <div data-dmo-toast="erro" class="peso-aviso" role="alert">A calote suposta «@Model.SuporCaloteTexto» não é um número válido. Escreve um valor em mm, por exemplo 5,2.</div>
          }
          @if (Model.Suposicao is { } sup)
          {
            <div class="peso-resumo" style="margin-top:10px">
              <div class="peso-fact"><span>Calote</span><strong>@(fmtCap(sup.CaloteAtualMm)) → @(fmtCap(sup.CaloteSupostaMm)) mm</strong></div>
              <div class="peso-fact"><span>Volume da calote</span><strong>@(fmtCap(sup.VolumeAtualCm3)) → @(fmtCap(sup.VolumeSupostoCm3)) cm³</strong></div>
              <div class="peso-fact"><span>Parte do peso que vem da calote</span><strong>@($"{fmt(sup.PesoDaCaloteAtualGrams)} → {fmt(sup.PesoDaCaloteSupostaGrams)} g")</strong></div>
              <div class="peso-fact"><span>Efeito no peso</span><strong class="@(sup.DeltaPesoGrams < 0 ? "peso-valor-negativo" : null)">@($"{signed(sup.DeltaPesoGrams)} g")</strong></div>
              <div class="peso-fact"><span>Peso médio de @producaoAtual.ProductionNumber</span><strong>@($"{fmt(sup.PesoMedioAtualGrams)} → {fmt(sup.PesoMedioSupostoGrams)} g")</strong></div>
              @if (Model.Comparison is { } comparacaoSup && sup.DiferencaSupostaGrams is { } difSup)
              {
                <div class="peso-fact"><span>Diferença para @comparacaoSup.HistoricalProductionNumber</span><strong>@(sup.DiferencaAtualGrams is { } difAtual ? signed(difAtual) : "—") → @($"{signed(difSup)} g")</strong></div>
                <div class="peso-fact"><span>Variação com a calote suposta</span><strong>@(sup.VariacaoSupostaPercent is { } varSup ? $"{signed(varSup)} %" : "—")</strong></div>
              }
            </div>
            @* Texto para o «?»: escolha uma produção em cima para ver também
               a diferença entre as duas. *@
          }
        }
        else
        {
          @* Texto para o «?»: para simular a calote, complete D, R do
             desenho e h de referência na ferramenta CM. *@
          <p class="card-note">Tampão sem diâmetro nem calote.</p>
        }
      </div>
      }
    </section>
  }

  @if (Model.Peso is not null)
  {
    @* O PDF da folha: gerado em memória e descarregado localmente, com a
       comparação escolhida em cima e a produção anterior (SAP). Serve a
       folha da produção (?controlo_id) e o Peso aberto pelo histórico
       (?peso_id). Uma zona, porque leva a comparação escolhida; o envio é o
       do browser (fora de data-dmo-parcial): o PDF descarrega sem sair da
       página. *@
    <div id="pesoPdf" class="dmo-zona" data-dmo-regiao>
    @if (Model.PdfSavedPath is { } savedPath)
    {
      <div class="peso-aviso-simples" role="status" style="margin-top:14px">
        <strong>PDF guardado:</strong> <code>@savedPath</code>
      </div>
    }
    @if (Model.PdfRefusal is not null && Model.PdfRefusalMessage.Length > 0)
    {
      <div data-dmo-toast="erro" class="peso-aviso" role="alert" style="margin-top:14px">@Model.PdfRefusalMessage</div>
    }

    @* O botão «Exportar PDF» está no canto superior direito do card do
       Peso (form="pesoPdfForm"); aqui fica o formulário com o que leva. *@
    <form method="post" asp-page="/Controlo/Peso" asp-page-handler="GeneratePdf" id="pesoPdfForm">
      @if (Model.ProductionContext is not null && Model.ControloIdFromQuery is { } formControloId)
      {
        <input type="hidden" name="controlo_id" value="@formControloId" />
      }
      <input type="hidden" name="peso_id" value="@Model.Peso.PesoId" />
      @if (Model.Comparison is { } selectedComparison)
      {
        <input type="hidden" name="comparar" value="@selectedComparison.HistoricalPesoId" />
      }
    </form>
    </div>
  }

  @* OS HISTÓRICOS DA FOLHA SAÍRAM (o Owner 2026-10-13: «o historico de
     pesos esta em dois lados... na pagina de peso deve apenas apresentar
     a referencia atual»): a folha apresenta APENAS a pesagem atual; o
     histórico vive SÓ na tab (?historico=1 — a procura pelo total). *@

@section Scripts {
<script src="~/peso-live.js" asp-append-version="true"></script>
<script>
// O «Comparar peso» do Histórico leva a referência que está escrita agora.
(() => {
  const atualizar = () => document.querySelectorAll('a[data-peso-comparar-cm]').forEach(link => {
    const campo = document.getElementById(link.dataset.pesoCompararCm);
    const url = new URL(link.getAttribute('href'), location.href);
    if (campo && campo.value.trim()) url.searchParams.set('cm', campo.value.trim()); else url.searchParams.delete('cm');
    link.setAttribute('href', url.pathname + url.search);
  });
  document.addEventListener('input', event => { if (event.target.id === 'historicoReferencia') atualizar(); });
  document.addEventListener('pointerdown', event => { if (event.target.closest('a[data-peso-comparar-cm]')) atualizar(); }, true);
  document.addEventListener('focusin', event => { if (event.target.closest('a[data-peso-comparar-cm]')) atualizar(); });
})();
// A COMPARAÇÃO DE PESO (progressive enhancement, o padrão do html):
// as leituras adicionam/removem ao vivo e os selects de contexto
// auto-submetem o GET do cascade. Sem JS tudo funciona pelo form nativo
// (quatro linhas e o botão «Mostrar»).
(function () {
  // Os ouvintes abaixo são delegados no document: a produção anterior e a
  // comparação estão em zonas trocadas sem recarregar (data-dmo-regiao; as
  // leituras da comparação desde o deep sweep, 18/10/2026, B-peso-4).

  var seqLinha = 1000;
  function adicionarLinha(readings) {
    var ultima = readings.querySelector('[data-cmp-row]:last-child');
    var modelo = ultima || readings.querySelector('[data-cmp-row]');
    if (!modelo) { return null; }
    var clone = modelo.cloneNode(true);
    seqLinha++;
    clone.querySelectorAll('input').forEach(function (input) {
      input.value = '';
      input.id = (input.name === 'cm_subject' ? 'cmpSubject-' : 'cmpWater-') + seqLinha;
      var rotulo = clone.querySelector('label[for="' + input.id + '"]');
      var campo = input.closest('.dmo-field');
      var l = campo && campo.querySelector('label');
      if (l) { l.setAttribute('for', input.id); }
    });
    readings.appendChild(clone);
    return clone;
  }
  function tirarLinha(readings, linha) {
    var rows = readings.querySelectorAll('[data-cmp-row]');
    if (rows.length > 1) { linha.remove(); return; }
    // A última linha não sai: limpa-se.
    linha.querySelectorAll('input').forEach(function (input) { input.value = ''; });
  }

  function aoCarregar(event) {
    var alvo = event.target.closest && event.target.closest('[data-cmp-add-row], [data-cmp-remove-row], [data-cmp-del-row]');
    if (!alvo) { return; }
    var form = alvo.form || alvo.closest('form') || document.getElementById('cmpForm');
    var readings = form && form.querySelector('[data-cmp-readings]');
    if (!readings) { return; }
    event.preventDefault();
    if (alvo.hasAttribute('data-cmp-add-row')) {
      var nova = adicionarLinha(readings);
      var campo = nova && nova.querySelector('input');
      if (campo) { campo.focus(); }
      return;
    }
    if (alvo.hasAttribute('data-cmp-del-row')) { tirarLinha(readings, alvo.closest('[data-cmp-row]')); return; }
    var rows = readings.querySelectorAll('[data-cmp-row]');
    if (rows.length > 1) { rows[rows.length - 1].remove(); }
  }
  document.addEventListener('click', aoCarregar);
  document.addEventListener('keydown', function (event) {
    if ((event.key === 'Enter' || event.key === ' ') && event.target.hasAttribute && event.target.hasAttribute('data-cmp-del-row')) { aoCarregar(event); }
  });

  // A LIGAÇÃO FALHOU AO COMPARAR OU GUARDAR (deep sweep, 18/10/2026,
  // B-peso-4). A confirmação (um GET da comparação, que não traz o
  // resultado nem a comparação guardada) pode trazer o formulário vazio: o
  // que o operador enviou volta a ele, com as mesmas linhas. Carregar outra
  // vez em «Guardar comparação» é o mesmo envio, com a mesma chave: o
  // servidor não guarda duas vezes ([EnvioUnico]) e mostra a guardada.
  var enviosDaComparacao = {};
  document.addEventListener('dmo:fila', function (event) {
    var form = event.target;
    if (!(form instanceof HTMLFormElement) || form.id !== 'cmpForm' || !event.detail) { return; }
    enviosDaComparacao[event.detail.envio] = { form: form, escrito: Array.from(event.detail.corpo.entries()) };
  });
  document.addEventListener('dmo:fim', function (event) {
    var detail = event.detail || {};
    var enviado = enviosDaComparacao[detail.envio];
    if (!enviado) { return; }
    delete enviosDaComparacao[detail.envio];
    var form = document.getElementById('cmpForm');
    if (!detail.semResposta || !form || form === enviado.form) { return; }
    reporComparacao(form, enviado.escrito);
    if (window.DmoTroca && window.DmoTroca.mesmoEnvio) { window.DmoTroca.mesmoEnvio(enviado.form, form); }
  });
  function reporComparacao(form, escrito) {
    var readings = form.querySelector('[data-cmp-readings]');
    var quantas = escrito.filter(function (par) { return par[0] === 'cm_subject'; }).length;
    if (readings && quantas > 0) {
      while (readings.querySelectorAll('[data-cmp-row]').length < quantas && adicionarLinha(readings)) { }
      var rows = readings.querySelectorAll('[data-cmp-row]');
      for (var r = rows.length - 1; r >= quantas; r--) { rows[r].remove(); }
    }
    var usados = {};
    Array.prototype.forEach.call(form.elements, function (campo) {
      if (!campo.name || /^(hidden|submit|button|reset|image|file|checkbox|radio)$/.test(campo.type)) { return; }
      var valores = escrito.filter(function (par) { return par[0] === campo.name; });
      var i = usados[campo.name] || 0;
      usados[campo.name] = i + 1;
      if (i < valores.length && typeof valores[i][1] === 'string') { campo.value = valores[i][1]; }
    });
  }

  // A produção anterior: o início e o fim mudam com a produção escolhida.
  document.addEventListener('change', function (event) {
    var anterior = event.target.closest && event.target.closest('[data-producao-anterior-select]');
    var periodo = document.querySelector('[data-producao-anterior-periodo]');
    if (!anterior || !periodo) { return; }
    var option = anterior.options[anterior.selectedIndex];
    if (!option) { return; }
    periodo.querySelector('[data-inicio]').textContent = option.getAttribute('data-inicio') || '—';
    periodo.querySelector('[data-fim]').textContent = option.getAttribute('data-fim') || '—';
    // O peso do SAP da produção escolhida.
    var sap = document.querySelector('[data-producao-anterior-sap]');
    if (!sap) { return; }
    var dados = sap.querySelector('[data-sap-opcao="' + option.value + '"]');
    var media = dados && dados.getAttribute('data-sap-media');
    sap.querySelector('[data-sap-com]').hidden = !media;
    sap.querySelector('[data-sap-sem]').hidden = !!media;
    if (media) {
      sap.querySelector('strong[data-sap-media]').textContent = media;
      sap.querySelector('strong[data-sap-media-dialog]').textContent = media;
      sap.querySelector('strong[data-sap-moda]').textContent = dados.getAttribute('data-sap-moda') || '';
      sap.querySelector('span[data-sap-dias]').textContent = dados.getAttribute('data-sap-dias') || '';
      deltasSap(sap);
    }
  });

  // A caixa do peso da produção: a média na caixa e, na janela, a moda,
  // cada uma com a diferença do peso de hoje para ela.
  function deltasSap(sap) {
    var atual = parseFloat(sap.getAttribute('data-peso-atual'));
    [['media', 'media'], ['media-dialog', 'media'], ['moda', 'moda']].forEach(function (par) {
      var delta = sap.querySelector('[data-sap-delta="' + par[0] + '"]');
      var valor = sap.querySelector('strong[data-sap-' + par[0] + ']');
      if (!delta || !valor) { return; }
      var ref = parseFloat(valor.textContent);
      if (isNaN(atual) || isNaN(ref)) { delta.textContent = ''; return; }
      var g = atual - ref;
      var sinal = function (v) { var r = Math.round(v * 100) / 100; return (r >= 0 ? '+' : '\u2212') + Math.abs(r).toFixed(2); };
      delta.textContent = 'Hoje ' + sinal(g) + ' g' + (ref ? ' (' + sinal(g / ref * 100) + ' %)' : '');
    });
  }
  (function () {
    var sap = document.querySelector('[data-producao-anterior-sap]');
    if (sap) { deltasSap(sap); }
  })();

  // Um formulário GET dentro de data-dmo-parcial (escolher a comparação, o
  // «Supomos» e, desde o deep sweep 2 de 18/10/2026 (F-8), a referência e a
  // máquina do «Novo Peso a partir de Job On» e a referência, a produção e o
  // Peso inicial da Comparação) pede o mesmo endereço que o browser pediria
  // e troca só as zonas (DmoTroca.ir); a leitura nova que está a ser escrita
  // fica. Os filtros do Histórico procuram ao escrever pelo ligarFiltro, que
  // trata o envio antes deste ouvinte.
  // O campo com o foco quando o pedido saiu (o filtro do combo da
  // comparação: a zona nova não o traz, ver dmo:troca abaixo).
  var focoNoPedido = null;
  function abrirParcial(form, origem) {
    var url = new URL(form.getAttribute('action') || window.location.pathname, window.location.href);
    url.search = new URLSearchParams(new FormData(form)).toString();
    focoNoPedido = document.activeElement && document.activeElement.id ? document.activeElement.id : null;
    window.DmoTroca.ir(url.href, origem || form);
  }
  function parcialGet(form) {
    return form && window.DmoTroca && (form.getAttribute('method') || 'get').toLowerCase() === 'get'
      && form.closest('[data-dmo-parcial]') !== null;
  }

  document.addEventListener('change', function (event) {
    var select = event.target.closest && event.target.closest('select[data-auto-submit]');
    if (!select || !select.form) { return; }
    if (parcialGet(select.form)) { abrirParcial(select.form, select); }
    else { select.form.submit(); }
  });

  document.addEventListener('submit', function (event) {
    var form = event.target;
    if (event.defaultPrevented || !(form instanceof HTMLFormElement) || !parcialGet(form)) { return; }
    event.preventDefault();
    abrirParcial(form, event.submitter || form);
  });

  // Uma zona trocada traz o dropdown da comparação sem o campo de filtrar:
  // liga-o como no arranque (dmo-suggest.js). Se o foco estava nele (o
  // operador escolheu a produção no combo), volta ao campo novo, sem abrir
  // a lista; se o operador já foi para outro sítio, fica onde está.
  document.addEventListener('dmo:troca', function () {
    if (!window.DMOSuggest) { return; }
    window.DMOSuggest.init();
    var id = focoNoPedido;
    focoNoPedido = null;
    var ativo = document.activeElement;
    if (!id || (ativo && ativo !== document.body)) { return; }
    var campo = document.getElementById(id);
    if (campo && campo.classList.contains('dmo-suggest-combo') && window.DMOSuggest.focar) { window.DMOSuggest.focar(campo); }
  });
})();
</script>
@* O SEGUNDO BLOCO de script da folha precisa de ser ABERTO (a B2 repair — o
   órfão que o review R-B2 apanhou): sem esta tag o IIFE do apoio TP/CALOTE
   ficava fora de qualquer <script>, ou seja, Razor deitava-o como TEXTO da
   pagina ao lado do markup. *@
<script>
// O APOIO TP/CALOTE (progressive enhancement): a simulação responde ao
// vivo — o cálculo é SEMPRE do backend (o endpoint ?handler=CapSupport
// reutiliza o PesoCapCalculation; zero fórmula em JS); o JS apenas
// apresenta o que o backend devolveu. Sem JS tudo funciona pelo form
// nativo «Calcular» (o GET recalcula pelo backend e mantém o apoio aberto).
(function () {
  var details = document.querySelector('.tp-support[data-cap-url]');
  if (!details) return;
  var input = details.querySelector('#capSimulada');
  var result = details.querySelector('[data-cap-result]');
  var url = details.getAttribute('data-cap-url');
  var params = details.getAttribute('data-cap-params') || '';
  if (!input || !result || !url) return;

  // Os números da app: inteiros sem casas, os outros com duas e ponto.
  function num(value) {
    var n = Number(value);
    return Number.isInteger(n) ? String(n) : n.toFixed(2);
  }
  function fmt(value, unit) {
    if (value === null || value === undefined) return "—";
    return num(value) + unit;
  }
  function signed(value, unit) {
    if (value === null || value === undefined) return "—";
    return (Number(value) >= 0 ? "+" : "") + num(value) + unit;
  }
  function metric(label, value) {
    return '<div class="peso-fact"><span>' + label + '</span><strong>' + value + '</strong></div>';
  }

  // SÓ A ÚLTIMA CALOTE ESCRITA CONTA (sweep do Codex, 19/10/2026, ponto 1):
  // a resposta de «5» que chegasse depois da de «5,2» mostrava os valores de
  // 5 com 5,2 no campo. Cada tecla invalida logo as respostas anteriores,
  // ainda durante a espera, como a procura partilhada.
  var timer = null;
  var pedido = 0;
  // Sem resposta, ou sem apoio para esta calote, os valores à vista eram os
  // da calote anterior: ficam «—» até à tecla seguinte ou ao «Calcular».
  function semValores() {
    result.innerHTML =
      metric('Volume nominal', '—') +
      metric('Volume simulado', '—') +
      metric('Δ volume', '—');
  }
  input.addEventListener('input', function () {
    if (timer) clearTimeout(timer);
    var meu = ++pedido;
    timer = setTimeout(function () {
      var query = new URLSearchParams(params);
      query.set('calote', input.value.replace(',', '.'));
      fetch(url + (url.indexOf('?') >= 0 ? '&' : '?') + query.toString(), { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Apoio da calote indisponível');
          return response.json();
        })
        .then(function (data) {
          if (meu !== pedido) return;
          if (!data || !data.temReferencia) { semValores(); return; }
          result.innerHTML =
            metric('Volume nominal', fmt(data.volumeReferenciaCm3, ' cm³')) +
            metric('Volume simulado', fmt(data.volumeEfetivoCm3, ' cm³')) +
            metric('Δ volume', signed(data.deltaVolumeCm3, ' cm³'));
        })
        .catch(function () { if (meu === pedido) semValores(); });
    }, 300);
  });
})();
</script>
}
</main>
