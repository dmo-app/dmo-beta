@model DMO.Alpha.Web.Pages.Controlo.PegamentosModel
@* Só as zonas pedidas pelo GET que segue uma gravação (E11, beta.189:
   cabeçalho X-Dmo-Zonas), pela ordem pedida, com os mesmos partials da
   página. Ver docs/ui-reference/atualizar-so-o-que-muda.md. *@
@foreach (var zona in Model.ZonasPedidas)
{
  if (zona == DMO.Alpha.Web.Pages.Controlo.PegamentosModel.ZonaContexto)
  {
    <partial name="_PegamentosContexto" model="Model" />
  }
  else if (zona == DMO.Alpha.Web.Pages.Controlo.PegamentosModel.ZonaAvisos)
  {
    <partial name="_PegamentosAvisos" model="Model" />
  }
  else if (zona == DMO.Alpha.Web.Pages.Controlo.PegamentosModel.ZonaMapa)
  {
    <partial name="_PegamentosMapa" model="Model" />
  }
  else if (zona == DMO.Alpha.Web.Pages.Controlo.PegamentosModel.ZonaFolhas)
  {
    <partial name="_PegamentosFolhas" model="Model" />
  }
  else
  {
    <partial name="_PegamentosCartao" model="new DMO.Alpha.Web.Pages.Controlo.PegamentosCartaoZona(Model, Model.Sheet!.Components.Single(c => DMO.Alpha.Web.Pages.Controlo.PegamentosModel.ZonaCartao(c.Component) == zona))" />
  }
}
