@model DMO.Alpha.Core.Controlo.PegamentosSheetReadModel
@* O Mapa de limites (Diogo, 19/10/2026: «os pegamentos o gráfico» e «grafico
   dos pegamentos com resumo do que foi medido»), o mesmo desenho e o mesmo
   resumo da página dos Pegamentos, da folha atual. Na Revisão e na Consulta
   dos Pegamentos. *@
@if (Model.Pegamentos is { Measurements.Count: > 0 })
{
  var input = DMO.Alpha.Infrastructure.Controlo.PegamentosPdfGenerator.FromSheet(Model);
  var mapa = DMO.Alpha.Web.Pages.Controlo.PegamentosMapSummary.From(Model);
  @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
  <h3 class="revisao-section" title="Uma linha por componente: a faixa é o corredor permitido (nominal ± tolerância) e os pontos são as medições.">Mapa de limites</h3>
  @* O mesmo gráfico da página dos Pegamentos (Diogo, 27/10/2026: «arranjar o gráfico»). *@
  <partial name="_PegamentosGrafico" model="@(DMO.Alpha.Web.Pages.Controlo.PegamentosGrafico.From(input) with { MostrarNotaSemMedicoes = false })" />
  <div class="peg-map-status @(mapa.HasAlerts ? "alert" : Model.Pegamentos.Measurements.Any(m => m.Evaluation.IsNotEvaluable) ? null : "ok")"><strong>@mapa.SummaryText</strong></div>
}
