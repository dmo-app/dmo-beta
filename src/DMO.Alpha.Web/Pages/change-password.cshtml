@page
@model ChangePasswordModel
@{
    Layout = "_DmoAccountLayout";
    ViewData["Title"] = "Mudar palavra-passe";
}

<form method="post" class="login-form" aria-labelledby="change-password-title" data-password-change>
    <h2 id="change-password-title">Mudar palavra-passe</h2>
    <p class="lead">Defina a nova palavra-passe da sua conta.</p>

    @if (Model.RequiresPasswordChange)
    {
        <div class="alert alert-warning form-message" role="status">
            A sua palavra-passe é temporária. Defina a nova para continuar.
        </div>
    }

    <div class="dmo-field">
        <label for="newPassword">Nova palavra-passe</label>
        <input id="newPassword" name="newPassword" type="password" minlength="@ChangePasswordModel.MinimumLength" maxlength="128" autocomplete="new-password" aria-describedby="newPasswordHint" required />
        <p id="newPasswordHint" class="lead">Pelo menos @ChangePasswordModel.MinimumLength caracteres.</p>
    </div>
    <div class="dmo-field">
        <label for="confirmPassword">Confirmar nova palavra-passe</label>
        <input id="confirmPassword" name="confirmPassword" type="password" minlength="@ChangePasswordModel.MinimumLength" maxlength="128" autocomplete="new-password" required />
    </div>

    <button type="submit" class="dmo-button submit" data-password-change-submit>Guardar</button>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger form-message" role="alert">@Model.ErrorMessage</div>
    }
</form>
