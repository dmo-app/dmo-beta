@page "/Armazem/Ultimos"
@model DMO.Alpha.Web.Pages.Armazem.UltimosModel
@using DMO.Alpha.Core.Armazem
@using DMO.Alpha.Web.Pages.Armazem
@{
    Layout = "_DmoShellLayout";
}
@section Head {
<link rel="stylesheet" href="~/css/paginas/armazem-ultimos.css" asp-append-version="true">
}

@* Os Movimentos só leem. À esquerda o que está fora em reparação (é o agora,
   sem filtro); à direita as últimas entradas e saídas, do mais recente para
   o mais antigo. Os filtros aplicam ao escolher (o texto com Enter) e só o
   cartão da direita troca (data-dmo-regiao + data-dmo-parcial). Sem botões
   nas linhas; a linha da esquerda abre a ficha da ferramenta (só com as
   Ferramentas). *@
<main class="dmo-workspace" aria-labelledby="arm-mov-title" data-dmo-troca>

  <div class="page-head">
    <div>
      <h1 id="arm-mov-title">Movimentos</h1>
    </div>
  </div>

  <div class="arm-mov">
    <section id="armRepFora" class="dmo-card arm-card" aria-labelledby="arm-rep-fora-title" data-dmo-regiao>
      <div class="arm-card-head">
        @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
        <h3 id="arm-rep-fora-title" title="@("As CM e os MF cujo último movimento no armazém é uma Saída para Reparação: o reparador e o dia em que saiu. As BQ seguem-se nas Boquilhas." + (Model.AbreFicha ? " Um clique na linha abre a ficha da ferramenta." : ""))">Fora, em reparação</h3>
      </div>
      @if (Model.Fora.Count == 0)
      {
        <p id="armRepForaVazio"><em>Nenhuma CM ou MF fora, em reparação.</em></p>
      }
      else
      {
        <div class="dmo-table-wrap">
          <table class="dmo-table" id="armRepForaLista" data-dmo-list="Fora, em reparação">
            <thead><tr><th>Ferramenta</th><th>Linha</th><th>% uso</th><th>Reparador</th><th>Saiu</th></tr></thead>
            <tbody>
            @foreach (var f in Model.Fora)
            {
              @* Os data-* não desaparecem com null no Razor: sem as Ferramentas, a linha nasce sem destino. *@
              if (Model.AbreFicha)
              {
              <tr data-dmo-row data-dmo-fora="@f.ToolId" data-dmo-open="@Url.Page("/Ferramentas/Ficha", new { tool_id = f.ToolId })">
                <td><strong>@DMO.Alpha.Web.Presentation.FerramentaNome.Curto(f.Tipo, f.Referencia, f.Lote)</strong></td>
                <td>@DMO.Alpha.Web.Presentation.FerramentaNome.Linhas(Model.LinhasEUso, f.ToolId)</td>
                <td>@DMO.Alpha.Web.Presentation.UsoFerramenta.Link(f.ToolId, DMO.Alpha.Web.Presentation.FerramentaNome.Uso(Model.LinhasEUso, f.ToolId))</td>
                <td>@(f.Reparador ?? "—")</td>
                <td>@MovimentosModel.Dia(f.SaiuEmUtc)</td>
              </tr>
              }
              else
              {
              <tr data-dmo-row data-dmo-fora="@f.ToolId">
                <td><strong>@DMO.Alpha.Web.Presentation.FerramentaNome.Curto(f.Tipo, f.Referencia, f.Lote)</strong></td>
                <td>@DMO.Alpha.Web.Presentation.FerramentaNome.Linhas(Model.LinhasEUso, f.ToolId)</td>
                <td>@DMO.Alpha.Web.Presentation.UsoFerramenta.Link(f.ToolId, DMO.Alpha.Web.Presentation.FerramentaNome.Uso(Model.LinhasEUso, f.ToolId))</td>
                <td>@(f.Reparador ?? "—")</td>
                <td>@MovimentosModel.Dia(f.SaiuEmUtc)</td>
              </tr>
              }
            }
            </tbody>
          </table>
        </div>
      }
    </section>

    <section id="armMovimentos" class="dmo-card arm-card" aria-labelledby="arm-mov-lista-title" data-dmo-regiao data-dmo-parcial>
      <div class="arm-card-head">
        <h3 id="arm-mov-lista-title" title="Todas as entradas e saídas do armazém, do mais recente para o mais antigo. Na Entrada, a posição onde ficou; na Saída para Reparação e na Entrada que volta dela, o reparador. Os filtros aplicam ao escolher; a referência e o lote com Enter.">Últimas entradas e saídas</h3>
        @if (Model.ComFiltro)
        {
          <a class="dmo-button" id="armMovLimpar" href="@Url.Page("/Armazem/Ultimos")">Limpar filtros</a>
        }
      </div>

      <form id="armMovFiltros" method="get" asp-page="/Armazem/Ultimos" class="arm-filtros" role="search" data-dmo-reference-scope="armazem" data-dmo-reference-name="referencia">
        @if (!string.IsNullOrWhiteSpace(Model.ToolId))
        {
          <input type="hidden" name="ferramenta" value="@Model.ToolId" />
          @if (DMO.Alpha.Web.Services.LocalUrl.IsSafe(Model.Request.Query["voltar"].ToString()))
          {
            <input type="hidden" name="voltar" value="@Model.Request.Query["voltar"]" />
          }
        }
        <div class="dmo-field">
          <label for="armMovReferencia">Referência</label>
          <input id="armMovReferencia" name="referencia" class="arm-curto" value="@Model.Referencia" autocomplete="off" data-dmo-maiusculas autocapitalize="characters"
                 placeholder="5447" data-dmo-suggest="ferramentas" data-dmo-suggest-submit />
        </div>
        <div class="dmo-field">
          <label for="armMovLote">Lote</label>
          <input id="armMovLote" name="lote" class="arm-lote" value="@Model.Lote" autocomplete="off" data-dmo-maiusculas autocapitalize="characters" placeholder="3" />
        </div>
        <div class="dmo-field">
          <label for="armMovTipo">Tipo</label>
          <select id="armMovTipo" name="tipo" data-dmo-autosubmit data-dmo-reference-select>
            <option value="" selected="@(Model.Tipo is null)" data-dmo-reference-option>Todos</option>
            @foreach (var t in new[] { "CM", "MF", "BQ" })
            {
              <option value="@t" selected="@(Model.TipoTexto == t)" data-dmo-reference-option>@t</option>
            }
          </select>
        </div>
        <div class="dmo-field">
          <label for="armMovDe">De</label>
          <input id="armMovDe" name="de" type="date" value="@UltimosModel.Data(Model.De)" data-dmo-autosubmit />
        </div>
        <div class="dmo-field">
          <label for="armMovAte">Até</label>
          <input id="armMovAte" name="ate" type="date" value="@UltimosModel.Data(Model.Ate)" data-dmo-autosubmit />
        </div>
        <div class="dmo-field">
          <label for="armMovLinha">Linha</label>
          <select id="armMovLinha" name="linha" data-dmo-autosubmit data-dmo-reference-select>
            <option value="" selected="@string.IsNullOrWhiteSpace(Model.Linha)" data-dmo-reference-option>Todas</option>
            @foreach (var l in Model.Linhas)
            {
              <option value="@l" selected="@(Model.Linha == l)" data-dmo-reference-option>@l</option>
            }
          </select>
        </div>
        <div class="dmo-field">
          <label for="armMovReparador">Reparador</label>
          <select id="armMovReparador" name="reparador" data-dmo-autosubmit data-dmo-reference-select>
            <option value="" selected="@string.IsNullOrWhiteSpace(Model.Reparador)" data-dmo-reference-option>Todos</option>
            @foreach (var r in Model.Reparadores)
            {
              <option value="@r" selected="@(Model.Reparador == r)" data-dmo-reference-option>@r</option>
            }
          </select>
        </div>
        @* Sem botão de envio o Enter não aplicava o Lote (DMO-649): este, escondido, é o que o Enter carrega. *@
        <input type="submit" id="armMovAplicar" value="Aplicar" hidden tabindex="-1" aria-hidden="true" />
      </form>

      @if (!string.IsNullOrWhiteSpace(Model.ToolId))
      {
        @* «Adicionar sempre opção de voltar à página anterior» (Diogo, 27/10/2026): aberta
           filtrada a partir de outra página (a ficha da ferramenta), um «← Voltar» discreto
           ao lado do filtro. Com ?voltar= (um caminho desta aplicação) vai para lá; sem ele,
           o dmo-live.js põe a página de onde se veio (data-dmo-voltar) e, sem origem
           conhecida, fica a lista sem filtro. *@
        var voltarPedido = Model.Request.Query["voltar"].ToString();
        var voltarSeguro = DMO.Alpha.Web.Services.LocalUrl.IsSafe(voltarPedido) ? voltarPedido : null;
        <p class="arm-filtro-ferramenta" id="armMovFerramenta">Só @(Model.FerramentaDoFiltro ?? "esta ferramenta").
          @if (voltarSeguro is not null)
          {
            <a class="arm-voltar" id="armMovVoltar" href="@voltarSeguro">Voltar</a>
          }
          else
          {
            <a class="arm-voltar" id="armMovVoltar" href="@Url.Page("/Armazem/Ultimos")" data-dmo-voltar="@Model.ToolId" data-dmo-voltar-ignorar="/Armazem/Ultimos">Voltar</a>
          }
        </p>
      }

      @if (Model.Lista.Items.Count == 0)
      {
        <p id="armMovVazio"><em>@(Model.ComFiltro ? "Nenhuma entrada ou saída com esse filtro." : "Ainda não há entradas nem saídas.")</em></p>
      }
      else
      {
        <div class="dmo-table-wrap">
          <table class="dmo-table" id="armMovLista" data-dmo-list="Últimas entradas e saídas">
            <thead><tr><th>Dia</th><th>Ferramenta</th><th>Linha</th><th>% uso</th><th>Movimento</th><th>Reparador</th><th>Posição</th></tr></thead>
            <tbody>
            @foreach (var m in Model.Lista.Items)
            {
              @* Um clique na linha abre a ficha (só com as Ferramentas e com a ferramenta). *@
              if (Model.AbreFicha && m.ToolId is { } movTool)
              {
              <tr data-dmo-movimento="@m.Id" data-dmo-row title="@m.Descricao" data-dmo-open="@Url.Page("/Ferramentas/Ficha", new { tool_id = movTool })">
                <td>@MovimentosModel.Dia(m.OcorridoEmUtc)</td>
                <td><strong>@DMO.Alpha.Web.Presentation.FerramentaNome.Curto(m.Tipo, m.Referencia, m.Lote)</strong>@if (m.Eliminada) {<text> </text><span class="muted">(eliminada)</span>}</td>
                <td>@DMO.Alpha.Web.Presentation.FerramentaNome.Linhas(Model.LinhasEUso, m.ToolId)</td>
                <td>@DMO.Alpha.Web.Presentation.UsoFerramenta.Link(m.ToolId, DMO.Alpha.Web.Presentation.FerramentaNome.Uso(Model.LinhasEUso, m.ToolId))</td>
                <td>@UltimosModel.Movimento(m)</td>
                <td>@(m.Reparador ?? "—")</td>
                <td>@if (m.Movimento == ArmazemMovimentoTipo.Entrada && m.Posicao is not null) {<span class="arm-pos">@m.Posicao</span>} else {<text>—</text>}</td>
              </tr>
              }
              else
              {
              <tr data-dmo-movimento="@m.Id" title="@m.Descricao">
                <td>@MovimentosModel.Dia(m.OcorridoEmUtc)</td>
                <td><strong>@DMO.Alpha.Web.Presentation.FerramentaNome.Curto(m.Tipo, m.Referencia, m.Lote)</strong>@if (m.Eliminada) {<text> </text><span class="muted">(eliminada)</span>}</td>
                <td>@DMO.Alpha.Web.Presentation.FerramentaNome.Linhas(Model.LinhasEUso, m.ToolId)</td>
                <td>@DMO.Alpha.Web.Presentation.UsoFerramenta.Link(m.ToolId, DMO.Alpha.Web.Presentation.FerramentaNome.Uso(Model.LinhasEUso, m.ToolId))</td>
                <td>@UltimosModel.Movimento(m)</td>
                <td>@(m.Reparador ?? "—")</td>
                <td>@if (m.Movimento == ArmazemMovimentoTipo.Entrada && m.Posicao is not null) {<span class="arm-pos">@m.Posicao</span>} else {<text>—</text>}</td>
              </tr>
              }
            }
            </tbody>
          </table>
        </div>
        <partial name="_ListPager" model="Model.Pager" />
      }
    </section>
  </div>
</main>
