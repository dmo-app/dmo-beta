@model IReadOnlyList<DMO.Alpha.Core.Armazem.ArmazemProcuraItem>
@using DMO.Alpha.Core.Armazem
@* As ferramentas encontradas ao escrever: onde estão, o tipo, a
   referência, o lote, o estado, as linhas e o % de uso (Diogo,
   21/10/2026). Um clique ou Enter abre a ferramenta, com a Entrada ou a
   Saída conforme está fora ou numa posição. *@
@if (Model.Count == 0)
{
  // O tipo e o texto vêm do pedido (a página e a procura ao escrever levam os dois).
  var tipoProcura = DMO.Alpha.Web.Pages.Armazem.MovimentosModel.TipoDe(Context.Request.Query["tipo"]);
  var textoProcura = ((string?)Context.Request.Query["q"])?.Trim();
  <p class="dmo-aviso warn" role="status" id="armProcuraVazia">@(tipoProcura switch { DMO.Alpha.Core.Tools.ToolType.Mf => "Nenhum MF encontrado.", { } tp => $"Nenhuma {ArmazemTextos.Tipo(tp)} encontrada.", _ => "Nenhuma ferramenta encontrada." }) O Armazém só regista entradas e saídas: uma ferramenta nova regista-se primeiro nas Ferramentas.<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.RegistarFerramenta(ArmazemTextos.Tipo(tipoProcura ?? DMO.Alpha.Core.Tools.ToolType.Cm), textoProcura is { Length: 4 } t4 && t4.All(char.IsAsciiDigit) ? null : textoProcura, "Registar nas Ferramentas")" /></p>
}
else
{
  <div class="dmo-table-wrap">
    <table class="dmo-table" id="armProcuraResultados" data-dmo-list="Ferramentas encontradas">
      <thead>
        <tr><th>Onde está</th><th>Ferramenta</th><th>Lote</th><th>Estado</th><th>Linhas</th><th>% uso</th></tr>
      </thead>
      <tbody>
        @foreach (var item in Model)
        {
          <tr data-dmo-row data-dmo-ferramenta="@item.ToolId" data-dmo-open="@Url.Page("/Armazem/Movimentos", new { ferramenta = item.ToolId })"
              aria-label="@ArmazemTextos.Ferramenta(item.Tipo, item.Referencia, item.Lote), @item.OndeEsta — um clique abre">
            <td><span class="dmo-pill @(item.NoArmazem ? "active" : "inactive")">@item.OndeEsta</span></td>
            <td><strong>@ArmazemTextos.Tipo(item.Tipo) @item.Referencia</strong></td>
            <td>@item.Lote</td>
            <td>@(item.Estado is { } estado ? ArmazemTextos.Estado(estado) : "—")</td>
            <td>@(item.Maquinas is { Count: > 0 } maquinas ? string.Join(" ", maquinas) : "Todas")</td>
            <td>@(item.Utilizacao is { } uso ? uso.ToString("0.##", DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture) + " %" : "—")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  @if (Model.Count >= DMO.Alpha.Infrastructure.Armazem.ArmazemMovimentos.ProcuraLimite)
  {
    <p class="muted">Mostram-se as primeiras @DMO.Alpha.Infrastructure.Armazem.ArmazemMovimentos.ProcuraLimite. Escreva mais para afinar.</p>
  }
}
