@model IReadOnlyList<DMO.Alpha.Core.Armazem.ArmazemProcuraItem>
@using DMO.Alpha.Core.Armazem
@* As ferramentas encontradas ao escrever: onde estão, o tipo, a
   referência, o lote, o estado, as linhas e o % de uso (Diogo,
   21/10/2026). Um clique ou Enter abre a ferramenta, com a Entrada ou a
   Saída conforme está fora ou numa posição. *@
@if (Model.Count == 0)
{
  // O tipo e o texto vêm do pedido (a página e a procura ao escrever levam os dois).
  var tipoProcura = DMO.Alpha.Web.Pages.Armazem.MovimentosModel.TipoDe(Context.Request.Query["tipo"]);
  var textoProcura = ((string?)Context.Request.Query["q"])?.Trim();
  <p class="dmo-aviso warn" role="status" id="armProcuraVazia">@(tipoProcura switch { DMO.Alpha.Core.Tools.ToolType.Mf => "Nenhum MF encontrado.", { } tp => $"Nenhuma {ArmazemTextos.Tipo(tp)} encontrada.", _ => "Nenhuma ferramenta encontrada." }) Se é novo, «Criar novo»: quem tem as Ferramentas aprova.<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.RegistarFerramenta(ArmazemTextos.Tipo(tipoProcura ?? DMO.Alpha.Core.Tools.ToolType.Cm), textoProcura is { Length: 4 } t4 && t4.All(char.IsAsciiDigit) ? null : textoProcura, "Registar nas Ferramentas")" /></p>
  @* REGISTAR LOTE NOVO (Diogo, 22/10/2026: «chega CM 5447 Lote 13 ... nao
     existe o registo no armazem. o operador regista com esses dados aparece
     um notice quem tem modulo ferramentas»). O Armazém não cria a
     ferramenta: guarda a referência, o lote e a posição como «por criar»; o
     tipo é o do cartão. O texto procurado vai para a referência. *@
  @if (tipoProcura is { } tipoLote)
  {
    var tipoLoteTexto = ArmazemTextos.Tipo(tipoLote);
    // «5447» tanto é uma referência como uma posição: o texto procurado vai
    // para a referência (o caso do Diogo); a posição escreve-se sempre.
    var refLote = ViewData["LoteNovoReferencia"] as string ?? textoProcura;
    var loteLote = ViewData["LoteNovoLote"] as string;
    var posLote = ViewData["LoteNovoPosicao"] as string;
    <form id="armLoteNovo" class="arm-lote-novo" method="post" asp-page="/Armazem/Movimentos" asp-page-handler="LoteNovo" asp-route-tipo="@tipoLoteTexto" aria-labelledby="arm-lote-novo-title">
      <div class="dmo-card-topo">
        <h4 id="arm-lote-novo-title">Criar novo · @tipoLoteTexto<partial name="_DmoHelp" model="@($"Chegou {(tipoLote == DMO.Alpha.Core.Tools.ToolType.Mf ? "um" : "uma")} {tipoLoteTexto} que ainda não está nas Ferramentas? Escreva a referência, o lote e a posição onde fica. O registo fica «Por criar» e quem tem o módulo Ferramentas recebe um aviso para criar a ferramenta; nessa altura a entrada fica registada nesta posição.")" /></h4>
        <div class="dmo-card-topo-acoes">
          <button type="submit" class="dmo-button" id="armLoteNovoRegistar">Criar novo</button>
        </div>
      </div>
      <div class="arm-linha">
        <div class="dmo-field">
          <label for="armLoteRef">Referência</label>
          <input id="armLoteRef" name="referencia" class="arm-procura" required maxlength="@ArmazemLoteNovo.ReferenciaMaxLength" autocomplete="off" data-dmo-maiusculas autocapitalize="characters" value="@refLote" placeholder="@(tipoLote == DMO.Alpha.Core.Tools.ToolType.Bq ? "Ex.: T173" : "Ex.: 5447")" />
        </div>
        <div class="dmo-field">
          <label for="armLoteLote">Lote</label>
          <input id="armLoteLote" name="lote" class="arm-curto" required maxlength="@ArmazemLoteNovo.LoteMaxLength" autocomplete="off" value="@loteLote" placeholder="Ex.: 13" />
        </div>
        <div class="dmo-field">
          <label for="armLotePosicao">Posição</label>
          <input id="armLotePosicao" name="posicao" class="arm-curto" required maxlength="4" inputmode="numeric" pattern="[0-9]{4}" autocomplete="off" value="@posLote" placeholder="0042" />
        </div>
      </div>
    </form>
  }
}
else
{
  <div class="dmo-table-wrap">
    <table class="dmo-table" id="armProcuraResultados" data-dmo-list="Ferramentas encontradas">
      <thead>
        <tr><th>Onde está</th><th>Ferramenta</th><th>Estado</th><th>Linhas</th><th>% uso</th></tr>
      </thead>
      <tbody>
        @foreach (var item in Model)
        {
          <tr data-dmo-row data-dmo-ferramenta="@item.ToolId" data-arm-no-armazem="@(item.NoArmazem ? "1" : "0")" data-dmo-open="@Url.Page("/Armazem/Movimentos", new { ferramenta = item.ToolId })"
              aria-label="@ArmazemTextos.Ferramenta(item.Tipo, item.Referencia, item.Lote), @item.OndeEsta — um clique abre">
            <td><span class="dmo-pill @(item.NoArmazem ? "active" : "inactive")">@item.OndeEsta</span></td>
            <td>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.Nome(item.Tipo, item.Referencia, item.Lote)</td>
            <td>@(item.Estado is { } estado ? ArmazemTextos.Estado(estado) : "—")</td>
            <td>@(item.Maquinas is { Count: > 0 } maquinas ? string.Join(" ", maquinas) : "Todas")</td>
            <td>@(item.Utilizacao is { } uso ? uso.ToString("0.##", DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture) + " %" : "—")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  @if (Model.Count >= DMO.Alpha.Infrastructure.Armazem.ArmazemMovimentos.ProcuraLimite)
  {
    <p class="muted">Mostram-se as primeiras @DMO.Alpha.Infrastructure.Armazem.ArmazemMovimentos.ProcuraLimite. Escreva mais para afinar.</p>
  }
}
