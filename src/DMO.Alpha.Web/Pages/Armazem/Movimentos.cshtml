@page "/Armazem/Movimentos"
@model DMO.Alpha.Web.Pages.Armazem.MovimentosModel
@using DMO.Alpha.Core.Armazem
@using DMO.Alpha.Core.Tools
@using DMO.Alpha.Web.Pages.Armazem
@{
    Layout = "_DmoShellLayout";
    var s = Model.Situacao;
    var ferramenta = s is null ? null : ArmazemTextos.Ferramenta(s.Tipo, s.Referencia, s.Lote);
    var recusaEntrada = Model.RecusaDe == "entrada";
    var recusaSaida = Model.RecusaDe == "saida";
    var recusaCorrigir = Model.RecusaDe == "corrigir";
    // O que o formulário mostra: o que a pessoa escreveu, senão o que a app propõe.
    var origem = recusaEntrada ? Model.OrigemEscolhida : s?.OrigemProposta is { } o ? MovimentosModel.Valor(o) : null;
    var estadoEntrada = recusaEntrada ? Model.EstadoEscolhido : s?.EstadoProposto is { } e ? MovimentosModel.Valor(e) : null;
    var estadoSucata = recusaSaida ? Model.EstadoEscolhido : MovimentosModel.Valor(FerramentaEstadoTipo.Sucatado);
    var criarPosicao = Model.Recusa == ArmazemMovimentoResultado.PosicaoNaoExiste;
    // A Linha da Saída para Produção: a escolhida, senão a única da ficha.
    var linhaSaida = recusaSaida ? Model.LinhaEscolhida
        : s is { LinhasDaFerramenta.Count: 1 } ? s.LinhasDaFerramenta[0].ToString(System.Globalization.CultureInfo.InvariantCulture) : null;
    // A Entrada mostra a Linha e o reparador com que a ferramenta vem (os da
    // última Saída), já preenchidos e sempre editáveis.
    var mostrarVinda = recusaEntrada ? Model.LinhaEscolhida is not null || Model.ReparadorDaVinda is not null || s?.UltimaSaida is not null
        : s?.UltimaSaida is not null;
    var linhaVinda = recusaEntrada ? Model.LinhaEscolhida : s?.VindaLinhaId?.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var reparadorVinda = recusaEntrada ? Model.ReparadorDaVinda : s?.VindaReparador;
}
@section Head {
<style>
.arm-page{display:flex;flex-direction:column;gap:14px;min-width:0}
#armMovProcura .dmo-card-topo{justify-content:space-between}
.arm-log{width:auto}
.arm-log .dmo-table{width:100%}
.arm-log .dmo-table tbody tr[data-dmo-open]{cursor:pointer}
.arm-card{padding:18px;width:100%;min-width:0;max-width:100%;box-sizing:border-box}
.arm-card h3{margin:0 0 12px;font-size:16px}
.arm-card .dmo-card-topo{margin:0 0 12px}
.arm-card .dmo-card-topo h3{margin:0}
.arm-linha{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin:0 0 12px}
.arm-linha .dmo-field{margin:0}
html body .arm-linha .dmo-field input.arm-curto{width:12ch}
html body .arm-linha .dmo-field select.arm-fab{width:76px}
html body .arm-linha .dmo-field input.arm-pos{width:7ch;font-variant-numeric:tabular-nums}
.arm-entrada-linha{margin:0 0 8px}
.arm-entrada-linha .dmo-button{align-self:end}
.arm-nota{margin:0 0 6px;font-size:12.5px;color:var(--dmo-muted)}
#armProcuraLista.arm-so-fora tr[data-arm-no-armazem="1"]{display:none}
#armEntrada .dmo-aviso{margin:0 0 8px}
.arm-modo{display:flex;gap:8px;align-items:end;align-self:end}
.arm-modo-direita{margin-left:auto;order:1}
#armEntEstadoAviso[hidden]{display:none}
.arm-de-onde{align-self:end;margin:0 0 10px;white-space:nowrap}
.dmo-ferr-ref{font-size:12px;font-weight:500;color:var(--dmo-muted);margin-left:4px}
html body .arm-linha .dmo-field input.arm-procura{width:min(320px,100%)}
html body .arm-linha .dmo-field input.arm-data{width:auto}
html body .arm-linha .dmo-field input.arm-obs{width:min(360px,100%)}
.arm-card .dmo-table{width:100%;min-width:100%}
.arm-card .dmo-table td{padding:4px 8px;vertical-align:middle}
.arm-onde{display:flex;gap:18px;flex-wrap:wrap;margin:0 0 14px}
.arm-onde div{display:flex;flex-direction:column;gap:2px}
.arm-onde span{font-size:12.5px;color:var(--dmo-muted)}
.arm-subtitulo{margin:14px 0 8px;font-size:14px}
.arm-onde a{color:var(--dmo-brand-900)}
.dmo-ferr-ref{font-size:12px;font-weight:500;color:var(--dmo-muted);margin-left:4px}
.arm-par{display:flex;align-items:center;gap:8px;margin:0 0 12px;font-weight:600}
.arm-acoes{display:flex;gap:10px;flex-wrap:wrap}
.arm-lote-novo{margin:12px 0 0;padding:12px 0 0;border-top:1px solid var(--dmo-border)}
.arm-lote-novo .dmo-card-topo{justify-content:space-between;align-items:center}
.arm-lote-novo h4{margin:0;font-size:14px}
.arm-lote-novo .arm-linha{margin:0}
</style>
}

@* REGISTO (Diogo, 22/10/2026: «similar ao Reparação interna... cartões com
   Tipo Ferramenta. CM MF BQ. por baixo o log de entrada e saída de cada»):
   o painel lateral com CM, MF e BQ; um clique abre o registo desse tipo.
   Procurar a ferramenta (só desse tipo), ver onde está e registar: a Entrada
   quando está fora, a Saída quando está numa posição. O tipo vem do cartão:
   a pessoa não o escolhe. O Armazém só regista movimentos; uma ferramenta
   nova regista-se nas Ferramentas. Corrigir localização fica no «Corrigir».
   Os avisos ficam no cartão da ferramenta depois de gravar; as recusas
   voltam com o que a pessoa escreveu. Por baixo, as últimas entradas e
   saídas do tipo (todas as pessoas); um clique numa linha abre a
   ferramenta, com o «Corrigir localização». *@
<div class="beta-light-layout arm-layout" data-dmo-troca>

<main class="beta-light-main arm-page" aria-labelledby="arm-mov-title">

  <div class="page-head">
    <div>
      <h1 id="arm-mov-title">Registo do Armazém</h1>
    </div>
  </div>
  @* As linhas por baixo do título, como nos mockups (Owner, 26/10/2026): o mesmo painel, com os mesmos ids e zonas. *@
  <div id="armTipos" class="dmo-zona" data-dmo-regiao data-dmo-parcial>
    @{
        var rail = new DMO.Alpha.Web.Presentation.DmoRailPresentation(
            Title: "Tipo de ferramenta",
            Subtitle: "Entrada e saída",
            AriaLabel: "Tipo de ferramenta",
            Items: MovimentosModel.Tipos.Select(t => new DMO.Alpha.Web.Presentation.DmoRailItem(
                Code: ArmazemTextos.Tipo(t),
                Detail: $"Registar {ArmazemTextos.Tipo(t)}",
                Href: Url.Page("/Armazem/Movimentos", new { tipo = MovimentosModel.TipoValor(t) }),
                AriaLabel: $"Registar entrada ou saída de {ArmazemTextos.Tipo(t)}",
                Key: MovimentosModel.TipoValor(t),
                Selected: Model.Tipo == t)).ToList(),
            Id: "armTiposRail");
    }
    <partial name="_DmoRail" model="@rail" />
  </div>

  <div id="armMovAvisos" class="dmo-zona" data-dmo-regiao>
    @if (Model.Mensagem.Length > 0)
    {
      <p data-dmo-toast="@(Model.Gravou ? "ok" : "erro")" role="@(Model.Gravou ? "status" : "alert")">@Model.Mensagem</p>
    }
  </div>

  <div id="armRegisto" class="dmo-zona arm-page" data-dmo-regiao data-dmo-parcial>
  @if (Model.Tipo is not { } tipoEscolhido)
  {
    <section class="dmo-card arm-card" id="armEscolha">
      @if (Model.FerramentaNaoExiste)
      {
        <p class="dmo-aviso warn" id="armNaoExiste">Esta ferramenta já não existe. Uma ferramenta nova regista-se nas Ferramentas.<partial name="_DmoAvisoLink" model="@(new DMO.Alpha.Web.Pages.Shared.DmoAvisoLink("Abrir as Ferramentas", "/Ferramentas", DMO.Alpha.Core.Admin.DmoCapabilities.Ferramentas))" /></p>
      }
      <p class="muted">Escolha CM, MF ou BQ para registar.</p>
    </section>
  }
  else
  {
    var tipoTexto = ArmazemTextos.Tipo(tipoEscolhido);
    // O MF é masculino; a CM e a BQ, femininas.
    var masc = tipoEscolhido == ToolType.Mf;
    // Com a ferramenta aberta, a Entrada ou a Saída que o formulário do registo mostra.
    var formEntrada = s is not null && (recusaEntrada || (!recusaSaida && (Model.Acao switch { "entrada" => true, "saida" => false, _ => !s.NoArmazem })));
    var entradaEscolhida = s is null ? !Model.ModoSaida : formEntrada;
  <section id="armMovProcura" class="dmo-card arm-card" aria-labelledby="arm-mov-procura-title" data-dmo-regiao data-dmo-parcial data-arm-tipo="@tipoTexto">
    <div class="dmo-card-topo">
      @* Sem os círculos da ajuda nos títulos (Diogo, 27/10/2026); o texto passa ao title do título. *@
      <h3 id="arm-mov-procura-title" title="@($"Escreva a referência, o lote ou a posição de {(masc ? "um" : "uma")} {tipoTexto}. Primeiro escolha Entrada ou Saída: a Entrada mostra só as que estão fora do armazém; a Saída, só as que estão numa posição. Um clique na ferramenta abre-a já com o formulário escolhido. Na Entrada, {(masc ? "um" : "uma")} {tipoTexto} que não existe regista-se como lote novo: fica «Por criar» até quem tem o módulo Ferramentas a criar.")">Registar @tipoTexto</h3>
    </div>
    @* A procura fica sempre no topo (Diogo, 22/10/2026): filtra as
       ferramentas registadas do tipo enquanto se escreve; sem resultados,
       «Criar novo» (o lote novo por criar). O cartão da ferramenta só
       aparece depois de a escolher (ou com ?ferramenta=).
       Primeiro a posição (4 algarismos), depois a referência (Diogo,
       22/10/2026): com a posição escrita, a lista mostra só as que estão
       fora do armazém, com de onde vêm, e a escolhida abre com a Entrada
       já nessa posição. *@
    @* ENTRADA | SAÍDA PRIMEIRO (Diogo, 23/10/2026: «No armazém deveria
       primeiro aparecer entrada saída porque isso ajuda a filtrar o que
       existe para entrar e sair»): a Entrada mostra só as que estão fora do
       armazém (e o lote novo); a Saída, só as que estão numa posição, e a
       Posição procura o que lá está. O modo vai no endereço (?modo=) e
       segue na procura; sem script, os dois são links. Na mesma linha, à
       direita (primeiro no código, que é o que se escolhe primeiro); o escolhido com o aspeto invertido (o do hover).
       Com a ferramenta aberta (Diogo, 27/10/2026: um só Entrada | Saída, à esquerda) os mesmos dois
       trocam o formulário do registo dessa ferramenta, como os do formulário (que ficam escondidos). *@
    <form method="get" asp-page="/Armazem/Movimentos" class="arm-linha" role="search" id="armProcuraForm">
      <input type="hidden" name="tipo" value="@tipoTexto" />
      <input type="hidden" name="modo" value="@Model.Modo" />
      <div class="arm-modo-linha">
        @* «Registar» junto ao Entrada | Saída, antes dele, como nas Boquilhas (Diogo,
           27/10/2026: «registar do armazem fica perto de onde selecionamos entrada e
           saida»). Envia o formulário do registo pelo atributo form. *@
        @if (s is not null)
        {
          var formDoRegisto = formEntrada ? "armEntrada" : Model.Destino is null ? "armSaidaSemDestino" : "armSaida";
          if (!formEntrada)
          {
            <button type="submit" class="dmo-button" id="armSaiRegistar" form="@formDoRegisto">Registar</button>
          }
          else if (recusaEntrada && criarPosicao)
          {
            <button type="submit" class="dmo-button" id="armEntCriar" form="@formDoRegisto" name="criar_posicao" value="1">Criar e registar</button>
          }
          else
          {
            <button type="submit" class="dmo-button" id="armEntRegistar" form="@formDoRegisto">Registar</button>
          }
          <span class="arm-modo-separador" aria-hidden="true"></span>
        }
      <div class="arm-modo arm-modo-direita" role="group" aria-label="Entrada ou saída" id="armProcuraModo">
        <a class="dmo-button@(entradaEscolhida ? " arm-modo-ativo" : null)" id="armProcuraModoEntrada" aria-pressed="@(entradaEscolhida ? "true" : "false")" href="@(s is not null ? Url.Page("/Armazem/Movimentos", new { ferramenta = s.ToolId, acao = "entrada" }) : Url.Page("/Armazem/Movimentos", new { tipo = tipoTexto, modo = "entrada", q = Model.Procura, pos = Model.PosicaoPedidaValida }))">Entrada</a>
        <a class="dmo-button@(!entradaEscolhida ? " arm-modo-ativo" : null)" id="armProcuraModoSaida" aria-pressed="@(!entradaEscolhida ? "true" : "false")" href="@(s is not null ? Url.Page("/Armazem/Movimentos", new { ferramenta = s.ToolId, acao = "saida" }) : Url.Page("/Armazem/Movimentos", new { tipo = tipoTexto, modo = "saida", q = Model.Procura, pos = Model.PosicaoPedidaValida }))">Saída</a>
      </div>
      </div>
      <div class="dmo-field">
        <label for="armProcura">Referência</label>
        <input id="armProcura" name="q" type="search" class="arm-procura" value="@Model.Procura" data-dmo-maiusculas autocapitalize="characters" autofocus="@(s is null)"
               placeholder="@(tipoEscolhido == ToolType.Bq ? "Ex.: T173 ou 0042" : "Ex.: 5447, T173 ou 0042")" data-dmo-procura="@Url.Page("/Armazem/Movimentos", "Procurar", new { tipo = tipoTexto, modo = Model.Modo })" data-dmo-procura-alvo="armProcuraLista" />
      </div>
      <div class="dmo-field">
        <label for="armRapPosicao">Posição</label>
        <input id="armRapPosicao" name="pos" type="text" class="arm-pos" maxlength="4" inputmode="numeric" pattern="[0-9]{4}" autocomplete="off"
               title="@(Model.ModoSaida ? "A posição de onde sai: 4 algarismos, por exemplo 0042" : "4 algarismos, por exemplo 0042")" value="@Model.PosicaoPedidaValida" placeholder="0042" />
      </div>
    </form>
    <div id="armProcuraLista" aria-live="polite" data-dmo-parcial data-arm-modo="@Model.Modo" class="@(!Model.ModoSaida && Model.PosicaoPedidaValida is not null ? "arm-so-fora" : null)">
      @if (Model.ModoSaida && s is null && !Model.FerramentaNaoExiste && string.IsNullOrWhiteSpace(Model.Procura) && Model.PosicaoPedidaValida is not null && Model.LoteNovoRecusa is null)
      {
        <partial name="_ArmazemProcura" model="Model.Encontradas" />
      }
      @if (!string.IsNullOrWhiteSpace(Model.Procura) || Model.LoteNovoRecusa is not null)
      {
        <partial name="_ArmazemProcura" model="Model.Encontradas" />
      }
    </div>
  </section>

  @if (Model.FerramentaNaoExiste)
  {
    <section id="armMovFerramenta" class="dmo-card arm-card" data-dmo-regiao>
      <p class="dmo-aviso warn">Esta ferramenta já não existe. Procure outra acima; uma ferramenta nova regista-se nas Ferramentas.<partial name="_DmoAvisoLink" model="@DMO.Alpha.Web.Pages.Shared.DmoAvisoLink.RegistarFerramenta(ArmazemTextos.Tipo(Model.Tipo ?? ToolType.Cm), null, "Abrir as Ferramentas")" /></p>
    </section>
  }
  else if (s is not null)
  {
    <section id="armMovFerramenta" class="dmo-card arm-card" aria-labelledby="arm-mov-ferr-title" data-dmo-regiao data-dmo-parcial data-dmo-ferramenta="@s.ToolId">
      <div class="dmo-card-topo">
        <h3 id="arm-mov-ferr-title">@MovimentosModel.Nome(s.Tipo, s.Referencia, s.Lote)</h3>
        @* «← Voltar» à página de onde se veio (Diogo, 27/10/2026: da Localização
           da ficha da ferramenta abre-se aqui, e volta-se à ficha). Com ?voltar=
           (um caminho desta aplicação) vai para lá; sem ele, o dmo-live.js põe a
           página anterior (data-dmo-voltar) e, sem origem, fica o Registar. *@
        @{
          var voltarPedidoMov = Model.Request.Query["voltar"].ToString();
          var voltarSeguroMov = DMO.Alpha.Web.Services.LocalUrl.IsSafe(voltarPedidoMov) ? voltarPedidoMov : null;
        }
        <div class="dmo-card-topo-acoes">
          @if (voltarSeguroMov is not null)
          {
            <a class="arm-voltar" id="armRegVoltar" href="@voltarSeguroMov">Voltar</a>
          }
          else
          {
            <a class="arm-voltar" id="armRegVoltar" href="@Url.Page("/Armazem/Movimentos")" data-dmo-voltar="@s.ToolId" data-dmo-voltar-ignorar="/Armazem/Movimentos">Voltar</a>
          }
        </div>
      </div>

      @foreach (var aviso in Model.Avisos)
      {
        <p class="dmo-aviso warn" data-dmo-aviso>@aviso</p>
      }

      @{
          var mostrarEntrada = formEntrada;
          var deOnde = s.UltimaSaida switch
          {
              ArmazemDestino.Reparacao => s.UltimaSaidaReparador is { Length: > 0 } rep ? $"Reparação · {rep}" : "Reparação",
              { } ultima => ArmazemTextos.Destino(ultima),
              null => null
          };
      }
      <div class="arm-onde" id="armOnde">
        <div><span>Último movimento</span>
          <strong data-dmo-onde>@s.OndeEsta</strong></div>
        @{ var desde = s.NoArmazem ? s.NaPosicaoDesdeUtc : s.LocalizacaoDesdeUtc; }
        @if (desde is { } d)
        {
          <div><span>Desde</span><strong>@MovimentosModel.Dia(d)</strong></div>
        }
        <div><span>Estado</span><strong data-dmo-estado>@(s.Estado is { } est ? ArmazemTextos.Estado(est) : "—")</strong></div>
        @if (deOnde is not null)
        {
          <div><span>Última saída</span><strong id="armEntDeOnde">@deOnde</strong></div>
        }
        @* A utilização da última leitura, com a barra (mockup 06). *@
        @if (Model.LinhasEUso.TryGetValue(s.ToolId, out var usoDaFerramenta) && usoDaFerramenta.Uso is { } usoPct)
        {
          var barra = Math.Clamp(usoPct, 0m, 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
          <div class="arm-uso" id="armUso"><span>Utilização</span><strong>@DMO.Alpha.Web.Presentation.UsoFerramenta.Link(s.ToolId, DMO.Alpha.Web.Presentation.FerramentaNome.Uso(Model.LinhasEUso, s.ToolId))</strong><span class="arm-uso-barra" aria-hidden="true"><span style="width:@(barra)%"></span></span></div>
        }
      </div>

      @* UMA LINHA (Diogo, 22/10/2026): Entrada | Saída · Posição (só na
         Entrada) · as opções da escolhida · «Registar»; «Corrigir» no canto. O botão
         escolhido fica com o aspeto invertido (o do hover). A origem, a data
         e as observações ficam no «Corrigir», com o «Corrigir localização». *@
      @if (s.Localizacao == FerramentaLocalizacaoTipo.Sucata && mostrarEntrada)
      {
        <p class="dmo-aviso warn">Esta ferramenta foi para a Sucata. Se foi engano, use «Corrigir».</p>
      }
      <form id="armSaidaDestino" method="get" asp-page="/Armazem/Movimentos" hidden>
        <input type="hidden" name="ferramenta" value="@s.ToolId" />
        <input type="hidden" name="acao" value="saida" />
      </form>
      <form id="@(mostrarEntrada ? "armEntrada" : Model.Destino is null ? "armSaidaSemDestino" : "armSaida")" method="post" asp-page="/Armazem/Movimentos" asp-page-handler="@(mostrarEntrada ? "Entrada" : "Saida")">
        <input type="hidden" name="operacao_id" value="@Model.OperacaoId" />
        <input type="hidden" name="ferramenta" value="@s.ToolId" />
        @* O título do registo; «Corrigir» e «Registar» no canto superior direito do cartão (mockup 06,
           Owner 26/10/2026; Diogo, 27/10/2026). «Corrigir» só abre a janela: type="button", não envia
           o formulário; o primeiro botão de envio continua a ser o «Registar» (Enter). *@
        <div class="arm-registar-topo">
          <h3 class="arm-registar-titulo">@(mostrarEntrada ? "Registar entrada" : "Registar saída")</h3>
          <div class="arm-registar-acoes">
            <button type="button" class="dmo-button" id="armCorrigirBotao" data-dmo-dialog="arm-corrigir-dialog">Corrigir</button>
          </div>
        </div>
        @if (!mostrarEntrada && Model.Destino is { } destinoEscolhido)
        {
          <input type="hidden" name="destino" value="@MovimentosModel.Valor(destinoEscolhido)" />
        }
        <div class="arm-linha arm-entrada-linha">
          <div class="arm-modo" role="group" aria-label="Entrada ou saída">
            <a class="dmo-button@(mostrarEntrada ? " arm-modo-ativo" : null)" id="armModoEntrada" aria-pressed="@(mostrarEntrada ? "true" : "false")" href="@Url.Page("/Armazem/Movimentos", new { ferramenta = s.ToolId, acao = "entrada" })">Entrada</a>
            <a class="dmo-button@(!mostrarEntrada ? " arm-modo-ativo" : null)" id="armModoSaida" aria-pressed="@(!mostrarEntrada ? "true" : "false")" href="@Url.Page("/Armazem/Movimentos", new { ferramenta = s.ToolId, acao = "saida" })">Saída</a>
          </div>
          @if (mostrarEntrada)
          {
          <div class="dmo-field">
            <label for="armEntPosicao">Posição</label>
            @* A posição escreve-se: 4 algarismos, sem lista. *@
            <input id="armEntPosicao" name="posicao" type="text" class="arm-pos" maxlength="4" minlength="4" inputmode="numeric" pattern="[0-9]{4}" autocomplete="off"
                   title="4 algarismos, por exemplo 0042" value="@(recusaEntrada ? Model.Posicao : Model.PosicaoPedidaValida)" placeholder="0042" required />
          </div>
          }
          @if (mostrarEntrada)
          {
        <div class="dmo-field">
          <label for="armEntEstado">Estado</label>
          <select id="armEntEstado" name="estado" required data-arm-sugerido="@(s.ListaProgramada is not null ? MovimentosModel.Valor(FerramentaEstadoTipo.Reparado) : null)">
            <option value="" selected="@string.IsNullOrEmpty(estadoEntrada)">Escolha…</option>
            @foreach (var opcao in ArmazemTextos.EstadosDaEntrada)
            {
              <option value="@MovimentosModel.Valor(opcao)" selected="@(estadoEntrada == MovimentosModel.Valor(opcao))">@ArmazemTextos.Estado(opcao)</option>
            }
          </select>
        </div>
            @if (mostrarVinda)
            {
              <input type="hidden" name="vinda" value="1" />
              <div class="dmo-field">
                <label for="armEntLinha">Linha</label>
                <select id="armEntLinha" name="linha">
                  <option value="" selected="@string.IsNullOrEmpty(linhaVinda)">—</option>
                  @foreach (var l in s.Linhas)
                  {
                    var lv = l.Id.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    <option value="@lv" selected="@(linhaVinda == lv)">@l.Codigo</option>
                  }
                </select>
              </div>
              <div class="dmo-field">
                <label for="armEntReparador">Reparador</label>
                <input id="armEntReparador" name="reparador_vinda" class="arm-curto" list="armEntReparadores" maxlength="@Reparador.NomeMaxLength" autocomplete="off" value="@reparadorVinda" />
                <datalist id="armEntReparadores">
                  @foreach (var r in s.Reparadores)
                  {
                    <option value="@r.Nome"></option>
                  }
                </datalist>
              </div>
            }
            @* Volta de um Empréstimo: a fábrica da BA de onde vem, a última e pequena,
               a da Saída (senão MG). Diogo, 28/10/2026. *@
            @if (Model.Fabricas.Count > 0 && (s.Localizacao == FerramentaLocalizacaoTipo.Emprestado || (recusaEntrada && Model.Fabrica is not null)))
            {
              var fabricaEntrada = recusaEntrada ? Model.Fabrica : s.VindaFabrica ?? Model.FabricaPorOmissao;
              <div class="dmo-field">
                <label for="armEntFabrica">Fábrica</label>
                <select id="armEntFabrica" name="fabrica" class="arm-fab">
                  @if (fabricaEntrada is not null && Model.Fabricas.All(f => f.Sigla != fabricaEntrada))
                  {
                    <option value="@fabricaEntrada" selected>@fabricaEntrada</option>
                  }
                  @foreach (var f in Model.Fabricas)
                  {
                    <option value="@f.Sigla" title="@f.Nome" selected="@(fabricaEntrada == f.Sigla)">@f.Sigla</option>
                  }
                </select>
              </div>
            }
          }
          else
          {
            <div class="dmo-field">
              <label for="armSaiDestino">Destino</label>
              <select id="armSaiDestino" name="destino" form="armSaidaDestino" data-dmo-autosubmit>
                <option value="" selected="@(Model.Destino is null)">Escolha…</option>
                @foreach (var opcao in ArmazemTextos.Destinos)
                {
                  <option value="@MovimentosModel.Valor(opcao)" selected="@(Model.Destino == opcao)">@ArmazemTextos.Destino(opcao)</option>
                }
              </select>
            </div>
            @if (Model.Destino == ArmazemDestino.Producao)
            {
              <div class="dmo-field">
                <label for="armSaiLinha">Linha</label>
                <select id="armSaiLinha" name="linha">
                  <option value="" selected="@string.IsNullOrEmpty(linhaSaida)">Escolha…</option>
                  @foreach (var l in s.Linhas)
                  {
                    var lv = l.Id.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    <option value="@lv" selected="@(linhaSaida == lv)">@l.Codigo</option>
                  }
                </select>
              </div>
            }
            @if (Model.Destino == ArmazemDestino.Reparacao)
            {
              <div class="dmo-field">
                <label for="armSaiReparador">Reparador</label>
                <select id="armSaiReparador" name="reparador" required>
                  <option value="">Escolha…</option>
                  @foreach (var r in s.Reparadores)
                  {
                    <option value="@r.Id" selected="@(recusaSaida && Model.ReparadorEscolhido == r.Id.ToString(System.Globalization.CultureInfo.InvariantCulture))">@r.Nome</option>
                  }
                </select>
              </div>
            }
            @if (Model.Destino == ArmazemDestino.Emprestado)
            {
              <div class="dmo-field">
                @* A fábrica da BA, pequena, só a sigla, por omissão MG (Diogo, 28/10/2026).
                   Sem fábricas nas Definições, fica o texto livre de antes. *@
                <label for="armSaiFabrica">Fábrica</label>
                @if (Model.Fabricas.Count > 0)
                {
                  var fabricaSaida = recusaSaida ? Model.Fabrica : Model.FabricaPorOmissao;
                  <select id="armSaiFabrica" name="fabrica" class="arm-fab">
                    @foreach (var f in Model.Fabricas)
                    {
                      <option value="@f.Sigla" title="@f.Nome" selected="@(fabricaSaida == f.Sigla)">@f.Sigla</option>
                    }
                  </select>
                }
                else
                {
                  <input id="armSaiFabrica" name="fabrica" class="arm-curto" maxlength="@ArmazemMovimento.FabricaMaxLength" autocomplete="off" value="@(recusaSaida ? Model.Fabrica : null)" placeholder="Ex.: LE" />
                }
              </div>
            }
            @if (Model.Destino == ArmazemDestino.Sucata)
            {
              <div class="dmo-field">
                <label for="armSaiEstado">Estado</label>
                <select id="armSaiEstado" name="estado">
                  <option value="@MovimentosModel.Valor(FerramentaEstadoTipo.Sucatado)" selected="@(estadoSucata == MovimentosModel.Valor(FerramentaEstadoTipo.Sucatado))">Sucatado</option>
                  <option value="" selected="@string.IsNullOrEmpty(estadoSucata)">Não mudar o estado</option>
                </select>
              </div>
            }
          }
        </div>
        @if (mostrarEntrada && s.ListaProgramada is { } reparadorDaLista)
        {
          @* Na Reparação Programada a Entrada propõe «Reparado»; a pessoa pode
             mudar, e o aviso aparece antes de gravar. Nunca bloqueia. *@
          <p class="arm-nota" id="armEntProgramada">Reparação Programada de @reparadorDaLista: entra «Reparado».</p>
          <p class="dmo-aviso warn" id="armEntEstadoAviso" role="status" hidden="@(estadoEntrada == MovimentosModel.Valor(FerramentaEstadoTipo.Reparado) ? "hidden" : null)">Vem da Reparação Programada: o sugerido é «Reparado».</p>
        }
        @if (!mostrarEntrada && Model.Destino == ArmazemDestino.Reparacao && s.Reparadores.Count == 0)
        {
          <p class="dmo-aviso warn">Ainda não há reparadores para esta ferramenta.
            @if (s.Tipo == ToolType.Bq)
            {
              <a class="dmo-aviso-link" href="/Definicoes?secao=boquilhas">Criar nas Definições das Boquilhas</a>
            }
            else
            {
              <a class="dmo-aviso-link" href="/Definicoes?secao=armazem">Criar nas Definições do Armazém</a>
            }
          </p>
        }
      </form>

      @if (s.UltimosMovimentos.Count > 0)
      {
        <h4 class="arm-subtitulo">Últimos movimentos</h4>
        <div class="dmo-table-wrap">
          <table class="dmo-table" id="armUltimos" data-dmo-list="Últimos movimentos">
            <thead><tr><th>Data</th><th>Movimento</th><th>Observações</th><th>Registado por</th></tr></thead>
            <tbody>
            @foreach (var m in s.UltimosMovimentos)
            {
              <tr data-dmo-movimento="@m.Id">
                <td>@MovimentosModel.DataLocal(m.OcorridoEmUtc)</td>
                <td>@m.Descricao</td>
                <td>@(m.Observacoes ?? "—")</td>
                <td>@(m.RegistadoPor ?? "—")</td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      }
    </section>

    var semOrigemEstado = mostrarEntrada && string.IsNullOrEmpty(origem);
    var abrirCorrigir = recusaCorrigir || (recusaEntrada && semOrigemEstado);
    @* «Corrigir» (Diogo, 22/10/2026): no lugar do «Opções». Na Entrada traz
       a origem, o estado, a data e as observações da entrada (enviados com o
       formulário da Entrada, pelo atributo form) e, por baixo, o «Corrigir
       localização». *@
    <dialog id="arm-corrigir-dialog" class="dmo-dialog" aria-labelledby="arm-corrigir-title" data-dmo-dialog-aberta="@(abrirCorrigir ? "1" : null)">
      <h3 id="arm-corrigir-title">@(recusaEntrada && semOrigemEstado && !recusaCorrigir ? "Origem da entrada" : "Corrigir")</h3>
      @if (mostrarEntrada)
      {
        <h4 class="arm-subtitulo">Entrada</h4>
        <div class="arm-linha" id="armEntCorrigir">
          <div class="dmo-field">
            <label for="armEntOrigem">Origem</label>
            <select id="armEntOrigem" name="origem" form="armEntrada" required>
              <option value="" selected="@string.IsNullOrEmpty(origem)">Escolha…</option>
              @foreach (var opcao in ArmazemTextos.Origens)
              {
                <option value="@MovimentosModel.Valor(opcao)" selected="@(origem == MovimentosModel.Valor(opcao))">@ArmazemTextos.Origem(opcao)</option>
              }
            </select>
          </div>
          <div class="dmo-field">
            <label for="armEntData">Data e hora reais</label>
            <input id="armEntData" name="data" form="armEntrada" type="datetime-local" class="arm-data" value="@(recusaEntrada ? Model.Data : null)" />
          </div>
          <div class="dmo-field">
            <label for="armEntObs">Observações</label>
            <input id="armEntObs" name="observacoes" form="armEntrada" class="arm-obs" maxlength="@ArmazemMovimento.ObservacoesMaxLength" autocomplete="off" value="@(recusaEntrada ? Model.Observacoes : null)" />
          </div>
        </div>
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button" data-dmo-dialog-close>Fechar</button>
          <button type="submit" class="dmo-button" form="armEntrada" id="armEntCorrigirRegistar">Registar</button>
        </div>
      }
      else
      {
        <h4 class="arm-subtitulo">Saída</h4>
        <div class="arm-linha" id="armSaiCorrigir">
          <div class="dmo-field">
            <label for="armSaiData">Data e hora reais</label>
            <input id="armSaiData" name="data" form="armSaida" type="datetime-local" class="arm-data" value="@(recusaSaida ? Model.Data : null)" />
          </div>
          <div class="dmo-field">
            <label for="armSaiObs">Observações</label>
            <input id="armSaiObs" name="observacoes" form="armSaida" class="arm-obs" maxlength="@ArmazemMovimento.ObservacoesMaxLength" autocomplete="off" value="@(recusaSaida ? Model.Observacoes : null)" placeholder="Ex.: enviado para LE" />
          </div>
        </div>
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button" data-dmo-dialog-close>Fechar</button>
          <button type="submit" class="dmo-button" form="armSaida" id="armSaiCorrigirRegistar">Registar</button>
        </div>
      }
      <h4 class="arm-subtitulo">Corrigir localização</h4>
      <p class="dmo-aviso-discreto">Para um engano: a ferramenta passa para a posição certa, ou sai do armazém. Fica um movimento novo; o anterior não se apaga.</p>
      @if (recusaCorrigir && Model.Mensagem.Length > 0)
      {
        <p class="dmo-aviso erro" role="alert">@Model.Mensagem</p>
      }
      <form id="armCorrigir" method="post" asp-page="/Armazem/Movimentos" asp-page-handler="Corrigir" data-dmo-parcial>
        <input type="hidden" name="operacao_id" value="@Model.OperacaoId" />
        <input type="hidden" name="ferramenta" value="@s.ToolId" />
        <div class="arm-linha">
          <div class="dmo-field">
            <label for="armCorPosicao" title="Deixe vazio se a ferramenta não está no armazém.">Posição certa</label>
            <input id="armCorPosicao" name="posicao" class="arm-curto" maxlength="4" inputmode="numeric" autocomplete="off" value="@(recusaCorrigir ? Model.Posicao : null)" placeholder="Não está" title="Deixe vazio se a ferramenta não está no armazém." />
          </div>
          <div class="dmo-field">
            <label for="armCorObs">Observações</label>
            <input id="armCorObs" name="observacoes" class="arm-obs" maxlength="@ArmazemMovimento.ObservacoesMaxLength" autocomplete="off" value="@(recusaCorrigir ? Model.Observacoes : null)" />
          </div>
        </div>
        <div class="dmo-dialog-actions">
          <button type="button" class="dmo-button dmo-dialog-cancel" data-dmo-dialog-close>Cancelar</button>
          @if (recusaCorrigir && criarPosicao)
          {
            <button type="submit" class="dmo-button" id="armCorCriar" name="criar_posicao" value="1">Criar e corrigir</button>
          }
          else
          {
            <button type="submit" class="dmo-button" id="armCorGravar">Corrigir</button>
          }
        </div>
      </form>
    </dialog>
  }

  @if (Model.MostraLog)
  {
  <section id="armLog" class="dmo-card arm-card arm-log" aria-labelledby="arm-log-title" data-dmo-parcial>
    <div class="dmo-card-topo">
      <h3 id="arm-log-title" title="@($"As entradas e saídas de {tipoTexto} de todas as pessoas, da mais recente para a mais antiga. Um clique numa linha abre a ferramenta, onde pode corrigir a localização.")">Últimas entradas e saídas de @tipoTexto</h3>
    </div>
    @if (Model.Log.Items.Count == 0 && Model.PorCriar.Count == 0)
    {
      <p class="muted" id="armLogVazio">Ainda não há entradas nem saídas de @tipoTexto.</p>
    }
    else
    {
      <div class="dmo-table-wrap">
        <table class="dmo-table" id="armLogLista" data-dmo-list="Últimas entradas e saídas de @tipoTexto">
          <thead><tr><th>Data</th><th>Ferramenta</th><th>Linha</th><th>% uso</th><th>Movimento</th><th>Estado</th><th>Reparador</th><th>Posição</th><th>Registado por</th></tr></thead>
          <tbody>
          @* Os lotes novos por criar no topo: ainda não são ferramenta nem
             movimento; a entrada fica registada quando a ferramenta for
             criada nas Ferramentas. *@
          @foreach (var l in Model.PorCriar)
          {
            <tr data-dmo-row data-dmo-lote-novo="@l.Id" title="Lote novo por criar nas Ferramentas">
              <td>@MovimentosModel.DataHora(l.RegistadoEmUtc)</td>
              <td><strong>@DMO.Alpha.Web.Presentation.FerramentaNome.Curto(Model.Tipo, l.Referencia, l.Lote)</strong></td>
              <td>—</td>
              <td>—</td>
              <td><span class="dmo-pill inactive">Por criar</span></td>
              <td>—</td>
              <td>—</td>
              <td>@l.Posicao</td>
              <td>@(l.RegistadoPor ?? "—")</td>
            </tr>
          }
          @foreach (var m in Model.Log.Items)
          {
            @* Os data-* não desaparecem com null no Razor: a ferramenta eliminada nasce sem destino. *@
            if (m.ToolId is { } logTool)
            {
            <tr data-dmo-row data-id="@m.Id" data-dmo-movimento="@m.Id" data-dmo-open="@(Model.AbreFicha ? Url.Page("/Ferramentas/Ficha", new { tool_id = logTool }) : Url.Page("/Armazem/Movimentos", new { ferramenta = logTool }))" title="@m.Descricao">
              <td>@MovimentosModel.DataHora(m.OcorridoEmUtc)</td>
              <td><strong>@DMO.Alpha.Web.Presentation.FerramentaNome.Curto(m.Tipo ?? Model.Tipo, m.Referencia, m.Lote)</strong></td>
              <td>@DMO.Alpha.Web.Presentation.FerramentaNome.Linhas(Model.LinhasEUso, m.ToolId)</td>
              <td>@DMO.Alpha.Web.Presentation.UsoFerramenta.Link(m.ToolId, DMO.Alpha.Web.Presentation.FerramentaNome.Uso(Model.LinhasEUso, m.ToolId))</td>
              <td>@MovimentosModel.Movimento(m)</td>
              <td>@(m.Estado is { } estMov ? ArmazemTextos.Estado(estMov) : "—")</td>
              <td>@(m.Reparador ?? "—")</td>
              <td>@(m.Posicao ?? "—")</td>
              <td>@(m.RegistadoPor ?? "—")</td>
            </tr>
            }
            else
            {
            <tr data-dmo-row data-id="@m.Id" data-dmo-movimento="@m.Id" title="@m.Descricao">
              <td>@MovimentosModel.DataHora(m.OcorridoEmUtc)</td>
              <td><strong>@DMO.Alpha.Web.Presentation.FerramentaNome.Curto(m.Tipo ?? Model.Tipo, m.Referencia, m.Lote)</strong> <span class="muted">(eliminada)</span></td>
              <td>—</td>
              <td>—</td>
              <td>@MovimentosModel.Movimento(m)</td>
              <td>@(m.Estado is { } estMov ? ArmazemTextos.Estado(estMov) : "—")</td>
              <td>@(m.Reparador ?? "—")</td>
              <td>@(m.Posicao ?? "—")</td>
              <td>@(m.RegistadoPor ?? "—")</td>
            </tr>
            }
          }
          </tbody>
        </table>
      </div>
      @* A paginação da casa («1 de 5»), com os links do próprio tipo: depois de uma recusa, o pedido é um POST.
         A procura (q, pos) e o modo vão com a página: sem eles, a página 2 perdia o log (auditoria de 27/10/2026). *@
      <nav data-dmo-parcial class="dmo-list-pager" aria-label="Paginação" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:12px">
        @if (Model.Log.PageNumber > 1)
        {
          <a class="dmo-button dmo-arrow" href="@Url.Page("/Armazem/Movimentos", new { tipo = tipoTexto, ferramenta = Model.ToolId, q = Model.Procura, pos = Model.PosicaoPedida, modo = Model.ModoTexto, pagina = Model.Log.PageNumber - 1 })" aria-label="Página anterior">Anterior</a>
        }
        else
        {
          <span class="dmo-button dmo-arrow" aria-disabled="true" aria-label="Página anterior">Anterior</span>
        }
        <span role="status" aria-label="Página @Model.Log.PageNumber de @Model.Log.TotalPages">@Model.Log.PageNumber de @Model.Log.TotalPages</span>
        @if (Model.Log.PageNumber < Model.Log.TotalPages)
        {
          <a class="dmo-button dmo-arrow" href="@Url.Page("/Armazem/Movimentos", new { tipo = tipoTexto, ferramenta = Model.ToolId, q = Model.Procura, pos = Model.PosicaoPedida, modo = Model.ModoTexto, pagina = Model.Log.PageNumber + 1 })" aria-label="Página seguinte">Seguinte</a>
        }
        else
        {
          <span class="dmo-button dmo-arrow" aria-disabled="true" aria-label="Página seguinte">Seguinte</span>
        }
      </nav>
    }
  </section>
  }
  }
  </div>
</main>
</div>
<script>
  // A Entrada de uma ferramenta da Reparação Programada: mudar o estado
  // sugerido («Reparado») mostra o aviso antes de gravar (só aviso).
  // A posição escrita antes da referência: a lista mostra só as que estão
  // fora, e a linha escolhida abre com a posição (?pos=) já na Entrada.
  if (!window.armPosLigada) {
    window.armPosLigada = true;
    var armPos = function () {
      var campo = document.getElementById("armRapPosicao");
      var v = campo ? campo.value.trim() : "";
      return /^[0-9]{4}$/.test(v) ? v : "";
    };
    document.addEventListener("input", function (event) {
      if (!event.target || event.target.id !== "armRapPosicao") return;
      event.target.value = event.target.value.replace(/[^0-9]/g, "").slice(0, 4);
      var lista = document.getElementById("armProcuraLista");
      if (lista) lista.classList.toggle("arm-so-fora", armPos() !== "");
    });
    var juntaPos = function (event) {
      var linha = event.target && event.target.closest && event.target.closest("#armProcuraLista tr[data-dmo-open]");
      if (!linha) return;
      var url = new URL(linha.getAttribute("data-dmo-open"), location.href);
      if (armPos()) url.searchParams.set("pos", armPos()); else url.searchParams.delete("pos");
      linha.setAttribute("data-dmo-open", url.pathname + url.search);
    };
    document.addEventListener("click", juntaPos, true);
    document.addEventListener("keydown", juntaPos, true);
  }
  // Sem origem, «Registar» abre o «Corrigir» para a escolher.
  if (!window.armEntCorrigirLigado) {
    window.armEntCorrigirLigado = true;
    document.addEventListener("click", function (event) {
      var botao = event.target && event.target.closest && event.target.closest("#armEntRegistar, #armEntCriar");
      if (!botao) return;
      var o = document.getElementById("armEntOrigem");
      var janela = document.getElementById("arm-corrigir-dialog");
      if (janela && o && !o.value) {
        event.preventDefault();
        if (!janela.open) janela.showModal();
        o.focus();
      }
    }, true);
  }
  if (!window.armSugeridoLigado) {
    window.armSugeridoLigado = true;
    document.addEventListener("change", function (event) {
      var campo = event.target;
      if (!campo || campo.id !== "armEntEstado" || !campo.dataset.armSugerido) return;
      var aviso = document.getElementById("armEntEstadoAviso");
      if (aviso) aviso.hidden = campo.value === campo.dataset.armSugerido;
    });
  }
</script>
