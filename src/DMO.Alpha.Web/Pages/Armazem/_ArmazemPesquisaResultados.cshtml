@model DMO.Alpha.Web.Pages.Armazem.PesquisarModel
@using DMO.Alpha.Core.Armazem
<div id="armPesqResultados" data-dmo-regiao>
@if (!Model.Pedida)
{
}
else if (Model.Encontradas.Count == 0)
{
  <p id="armPesqNada"><em>Nenhuma ferramenta encontrada.</em></p>
}
else
{
  <div class="dmo-table-wrap">
    <table class="dmo-table" id="armPesqLista" data-dmo-list="Ferramentas encontradas">
      <thead>
        <tr><th>Onde está</th><th>Ferramenta</th><th>Estado</th><th>Linha</th><th>% uso</th></tr>
      </thead>
      <tbody>
        @foreach (var item in Model.Encontradas)
        {
          <tr data-dmo-row data-dmo-ferramenta="@item.ToolId" data-dmo-open="@Url.Page("/Armazem/Movimentos", new { ferramenta = item.ToolId, acao = item.NoArmazem ? "saida" : "entrada" })"
              aria-label="@ArmazemTextos.Ferramenta(item.Tipo, item.Referencia, item.Lote), @item.OndeEsta — um clique abre o registo">
            <td><span class="dmo-pill @(item.NoArmazem ? "active" : "inactive")">@item.OndeEsta</span></td>
            <td><strong>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.NomeCurto(item.Tipo, item.Referencia, item.Lote)</strong></td>
            <td>@(item.Estado is { } estado ? ArmazemTextos.Estado(estado) : "—")</td>
            <td>@(item.Maquinas is { Count: > 0 } maquinas ? string.Join(" ", maquinas) : "Todas")</td>
            <td>@DMO.Alpha.Web.Presentation.UsoFerramenta.Link(item.ToolId, item.Utilizacao is { } uso ? uso.ToString("0.##", DMO.Alpha.Core.Runtime.DmoNumberFormat.Culture) + " %" : "—")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  @if (Model.Encontradas.Count >= DMO.Alpha.Infrastructure.Armazem.ArmazemMovimentos.ProcuraLimite)
  {
    <p class="muted">Mostram-se as primeiras @DMO.Alpha.Infrastructure.Armazem.ArmazemMovimentos.ProcuraLimite. Escreva mais para afinar.</p>
  }
}
</div>
