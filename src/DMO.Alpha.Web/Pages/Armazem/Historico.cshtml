@page "/Armazem/Historico"
@model DMO.Alpha.Web.Pages.Armazem.HistoricoModel
@using DMO.Alpha.Core.Armazem
@{
    Layout = "_DmoShellLayout";
}
@section Head {
<style>
.arm-page{display:flex;flex-direction:column;gap:14px}
.arm-card{padding:18px}
.arm-card h3{margin:0 0 12px;font-size:16px}
.arm-filtros{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin:0 0 12px}
.arm-filtros .dmo-field{margin:0}
html body .arm-filtros .dmo-field input.arm-texto{width:22ch}
.arm-card .dmo-table td{padding:6px 8px;vertical-align:top}
.arm-card .dmo-table td a{color:var(--dmo-brand-900);font-weight:600}
.arm-filtro-ferramenta{margin:0 0 12px}
.arm-filtro-ferramenta a{color:var(--dmo-brand-900);font-weight:600}
</style>
}

@* O Histórico só lê. Os dropdowns e as datas aplicam ao escolher; o texto
   aplica com Enter (data-dmo-suggest-submit). Cada ferramenta abre os seus
   movimentos; uma ferramenta eliminada fica com a referência e o lote
   guardados, sem link. *@
<main class="arm-page dmo-workspace" aria-labelledby="arm-hist-title" data-dmo-troca>

  <div class="page-head">
    <div>
      <h1 id="arm-hist-title">Histórico do Armazém</h1>
    </div>
  </div>

  <section id="armHistorico" class="dmo-card arm-card" aria-labelledby="arm-hist-lista-title" data-dmo-regiao data-dmo-parcial>
    <h3 id="arm-hist-lista-title">Movimentos<partial name="_DmoHelp" model="@("Todos os movimentos do armazém, do mais recente para o mais antigo. Procure pela referência, pelo lote ou pelo código da posição (Enter aplica); o movimento, o destino e os dias aplicam ao escolher. Escolher um destino mostra só as Saídas.")" /></h3>

    <form id="armHistFiltros" method="get" asp-page="/Armazem/Historico" class="arm-filtros" role="search">
      @if (!string.IsNullOrWhiteSpace(Model.ToolId))
      {
        <input type="hidden" name="ferramenta" value="@Model.ToolId" />
      }
      <div class="dmo-field">
        <label for="armHistTexto">Referência, lote ou posição</label>
        <input id="armHistTexto" name="q" class="arm-texto" value="@Model.Texto" autocomplete="off" data-dmo-maiusculas autocapitalize="characters"
               placeholder="5447, 3 ou 0042" data-dmo-suggest="ferramentas" data-dmo-suggest-submit />
      </div>
      <div class="dmo-field">
        <label for="armHistMovimento">Movimento</label>
        <select id="armHistMovimento" name="movimento" data-dmo-autosubmit>
          <option value="" selected="@(Model.Movimento is null)">Todos</option>
          @foreach (var tipo in new[] { ArmazemMovimentoTipo.Entrada, ArmazemMovimentoTipo.Saida, ArmazemMovimentoTipo.Corrigir })
          {
            <option value="@tipo" selected="@(Model.Movimento == tipo)">@ArmazemTextos.Movimento(tipo)</option>
          }
        </select>
      </div>
      <div class="dmo-field">
        <label for="armHistDestino">Destino</label>
        <select id="armHistDestino" name="destino" data-dmo-autosubmit>
          <option value="" selected="@(Model.Destino is null)">Todos</option>
          @foreach (var destino in ArmazemTextos.Destinos)
          {
            <option value="@destino" selected="@(Model.Destino == destino)">@ArmazemTextos.Destino(destino)</option>
          }
        </select>
      </div>
      <div class="dmo-field">
        <label for="armHistDe">Desde</label>
        <input id="armHistDe" name="de" type="date" value="@DMO.Alpha.Web.Pages.Armazem.HistoricoModel.Data(Model.De)" data-dmo-autosubmit />
      </div>
      <div class="dmo-field">
        <label for="armHistAte">Até</label>
        <input id="armHistAte" name="ate" type="date" value="@DMO.Alpha.Web.Pages.Armazem.HistoricoModel.Data(Model.Ate)" data-dmo-autosubmit />
      </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ToolId))
    {
      <p class="arm-filtro-ferramenta" id="armHistFerramenta">Só @(Model.FerramentaDoFiltro ?? "esta ferramenta"). <a href="@Url.Page("/Armazem/Historico")">Ver todas</a></p>
    }

    @if (Model.Lista.Items.Count == 0)
    {
      <p id="armHistVazio"><em>@(Model.ComFiltro ? "Nenhum movimento com esse filtro." : "Ainda não há movimentos no armazém.")</em></p>
    }
    else
    {
      <div class="dmo-table-wrap">
        <table class="dmo-table" id="armHistLista" data-dmo-list="Histórico do Armazém">
          <thead><tr><th>Data</th><th>Ferramenta</th><th>Movimento</th><th>Observações</th><th>Registado por</th></tr></thead>
          <tbody>
          @foreach (var m in Model.Lista.Items)
          {
            var ferramenta = m.Tipo is { } tipo ? ArmazemTextos.Ferramenta(tipo, m.Referencia, m.Lote) : $"{m.Referencia} · lote {m.Lote}";
            <tr data-dmo-movimento="@m.Id">
              <td>@DMO.Alpha.Web.Pages.Armazem.MovimentosModel.DataLocal(m.OcorridoEmUtc)</td>
              <td>
                @if (m.Eliminada)
                {
                  <span>@ferramenta</span> <span class="muted">(eliminada)</span>
                }
                else
                {
                  <a href="@Url.Page("/Armazem/Movimentos", new { ferramenta = m.ToolId })">@ferramenta</a>
                }
              </td>
              <td>@m.Descricao</td>
              <td>@(m.Observacoes ?? "—")</td>
              <td>@(m.RegistadoPor ?? "—")</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
      <partial name="_ListPager" model="Model.Pager" />
    }
  </section>
</main>
