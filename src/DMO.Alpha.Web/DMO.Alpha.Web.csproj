<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="../../version.props" />
  <Import Project="../../build/VersionMetadata.targets" />

  <ItemGroup>
    <EmbeddedResource Include="ReleaseNotes.json" />
    <Content Remove="ReleaseNotes.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DMO.Alpha.Core\DMO.Alpha.Core.csproj" />
    <ProjectReference Include="..\DMO.Alpha.Infrastructure\DMO.Alpha.Infrastructure.csproj" />
  </ItemGroup>

  <!-- EF Core design-time tooling (dotnet ef) needs this in the startup
       project; PrivateAssets keeps it out of the published application. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
