# DMO — nomes das variáveis de configuração do serviço Railway
# EXEMPLO APENAS. Nunca guardar passwords ou chaves reais neste ficheiro.
# Não existe assistente Setup na aplicação.

ASPNETCORE_ENVIRONMENT=Production
Dmo__EnvironmentLabel=DMO
Dmo__AuthenticationProvider=Supabase

# API Supabase usada na autenticação
Dmo__SupabaseUrl=https://<ref-do-projeto>.supabase.co
Dmo__SupabasePublishableKey=<definir-no-Railway>
Dmo__SupabaseSecretKey=<definir-no-Railway>

# Ligação PostgreSQL existente. Não criar outra base de dados por inferência.
ConnectionStrings__DmoDatabase=Host=<host>;Port=5432;Database=postgres;Username=<utilizador>;Password=<definir-no-Railway>;SSL Mode=Require

# Opcionais. No arranque, o log diz o nome de cada variável obrigatória em
# falta (nunca o valor); nada trava o arranque.

# Chave-mestra portátil das sessões: base64 do PFX e a sua palavra-passe.
# Sem ela, as chaves das sessões ficam guardadas sem cifra (na base).
Dmo__DataProtectionCertPfx=<definir-no-Railway>
Dmo__DataProtectionCertPassword=<definir-no-Railway>
# Guardar as chaves das sessões numa pasta em vez da base.
# Dmo__DataProtectionKeyRingPath=/caminho/da/pasta

# Só no DMO-DEV: ligar pelo pooler do Supabase e contar utilizadores e
# produções no arranque (só leitura, só para o log).
# Dmo__DevPoolerHost=aws-0-eu-west-1.pooler.supabase.com
# Dmo__DevConnectionProbe=true
